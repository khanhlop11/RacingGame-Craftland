// ResetButton.fcg
// Gắn vào: Tay cầm UI (Nút "Khôi phục vị trí")
// Platform: Client

import "StdLibrary.fcc" as std
import "Player.fcc" as player
import "Hud.fcc" as hud
import "EditorGenLib.fcc" as EditorGenLib
import "./Kart/KartInputActions.fcg" as KartInputActions

[platform_client]
graph ResetButton {

    event OnAwake() {
        thisEntity<hud.UIWidget>.IsVisible = true
    }

    // Khi nhận thao tác Click / Press
    event OnPressed(p entity<Player>) {
        KartInputActions.ResetCar(p)
    }

    event OnClick(p entity<Player>) {
        KartInputActions.ResetCar(p)
    }
}
