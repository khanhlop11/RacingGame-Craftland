[platform_client]
graph ResetButton {
    
    // Khi nhận thao tác Click
    event OnPressed(p entity<Player>) {
        // Gửi thông báo từ UI lên RacingMovementServer (đang ở Server)
        DispatchEventToEntity(onResetCar, p, PlatformType.Server, nil)
