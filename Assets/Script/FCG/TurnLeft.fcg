// TurnLeft.fcg — Gắn vào Button rẽ trái trong UI
// Platform: Client

import "StdLibrary.fcc" as std
import "Player.fcc" as player
import "Hud.fcc" as hud
import "EditorGenLib.fcc" as EditorGenLib
import "./Kart/KartInputActions.fcg" as KartInputActions

[platform_client]
graph TurnLeft {
    event OnPressed(p entity<Player>) {
        KartInputActions.PressTurnLeft(p)
    }

    // // NHẤN ĐÚP: Kích hoạt Drift khi nhấp đúp rẽ trái
    // event OnDoubleTapped(p entity<Player>) {
    //     KartInputActions.DoubleTapTurnLeft(p)
    // }
    
    event OnReleased(p entity<Player>) {
        KartInputActions.ReleaseTurnLeft(p)
    }
}
