// KartInputActions.fcg — Shared UI input actions for kart controls
// Platform: Client
// Purpose: keep button scripts thin; state still belongs to RacingMovement.

import "StdLibrary.fcc" as std
import "Player.fcc" as player
import "../Main_Script/VehicleController.fcg" as vc

[platform_client]
static graph KartInputActions {
    func IsLocalPlayer(p entity<Player>) bool {
        if p != std.GetLocalPlayer() { return false }
        return true
    }

    func PressTurnLeft(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsTurningLeft = true
            p<vc>.IsTurningRight = false
        }
    }

    func ReleaseTurnLeft(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsTurningLeft = false
        }
    }

    func DoubleTapTurnLeft(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsTurningLeft = true
            p<vc>.IsTurningRight = false
            p<vc>.IsBraking = true
            p<vc>.BrakeTapTimer = 0.40
        }
    }

    func PressTurnRight(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsTurningRight = true
            p<vc>.IsTurningLeft = false
        }
    }

    func ReleaseTurnRight(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsTurningRight = false
        }
    }

    func DoubleTapTurnRight(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsTurningRight = true
            p<vc>.IsTurningLeft = false
            p<vc>.IsBraking = true
            p<vc>.BrakeTapTimer = 0.40
        }
    }

    func PressBrake(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsBraking = true
            p<vc>.BrakeTapTimer = 0.40
        }
    }

    func ReleaseBrake(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsBraking = false
        }
    }

    func PressReverse(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsReversing = true
            p<vc>.IsBraking = true
        }
    }

    func ReleaseReverse(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsReversing = false
            p<vc>.IsBraking = false
        }
    }

    func PressBoost(p entity<Player>) {
        if IsLocalPlayer(p) {
            if p<vc>.CurrentNitro > 5.0 {
                p<vc>.IsBoosting = true
            }
        }
    }

    func ReleaseBoost(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.IsBoosting = false
        }
    }

    func ResetCar(p entity<Player>) {
        if IsLocalPlayer(p) {
            p<vc>.ResetToStart()
        }
    }
}

