//RacingMovement_MarioKart.fcg - Mario Kart Style Vehicle Control
//Simplified, arcade-style physics based on Mario Kart 8
import "Math.fcc" as math
import "Physics.fcc" as physics
import "StdLibrary.fcc" as std
import "Time.fcc" as time
import "EditorGenLib.fcc" as EditorGenLib
import "Camera.fcc" as camera

[platform_client]
graph RacingMovement_MarioKart {

    event RequestRaceState(playerEnt entity<Player>) {}

    // =========================================================
    // MARIO KART STYLE PARAMETERS - Simple & Direct
    // =========================================================
    
    // SPEED SETTINGS (km/h)
    DesiredMaxSpeed     float = 75.0     // Normal top speed
    BoostSpeed          float = 90.0     // Boost top speed
    CurrentSpeed        float = 0.0      // Current speed (lerped)
    
    // ACCELERATION
    AccelRate           float = 0.5      // How fast to reach max speed
    DecelRate           float = 0.01     // How fast to slow down (coasting)
    BrakeRate           float = 0.03     // Braking deceleration
    
    // STEERING
    RotateStrength      float = 80.0     // Turning speed (degrees per second)
    DriftRotateStrength float = 5.0      // Reduced turning while drifting
    
    // DRIFT SETTINGS
    DriftForce          float = 50000.0  // Lateral force during drift
    DriftTime           float = 0.0      // How long drifting
    DriftDirection      int = 0          // -1 left, 0 none, 1 right
    IsDrifting          bool = false     // Currently drifting
    
    // BOOST SETTINGS  
    BoostTime           float = 0.0      // Remaining boost time
    IsBoosting          bool = false     // Currently boosting
    
    // GRAVITY & GROUNDING
    DownwardForce       float = 5000.0   // Constant downward force
    GroundRayDist       float = 2.0      // Ground check distance
    IsGrounded          bool = false     // On ground
    
    // VISUAL & REFERENCES
    [preview]
    KartModel           entity<Entity>
    
    MyClientCam         entity<camera.CustomCamera> = nil
    
    // INPUT STATE
    InputHorizontal     float = 0.0      // -1 to 1
    InputAccel          bool = false     // Space/accelerate
    InputBrake          bool = false     // S/brake
    InputDrift          bool = false     // V/drift
    
    // RACE STATE
    IsRaceStarted       bool = false
    IsMovementLocked    bool = false
    
    // =========================================================
    // INITIALIZATION
    // =========================================================
    
    event OnAwake() {
        if KartModel == nil {
            std.LogInfo("[MarioKart] ERROR: KartModel not assigned!")
            return
        }
        
        CurrentSpeed = 0.0
        DriftTime = 0.0
        BoostTime = 0.0
        IsDrifting = false
        IsBoosting = false
        IsRaceStarted = false
        IsMovementLocked = false
        
        std.LogInfo("[MarioKart] Vehicle control initialized - Mario Kart style!")
    }
    
    // =========================================================
    // MAIN UPDATE LOOP
    // =========================================================
    
    event OnUpdate() {
        if KartModel == nil { return }
        if IsMovementLocked { return }
        if !IsRaceStarted { return }
        
        var dt = 0.033
        // Get input
        ReadInput()
        
        // Check grounding
        CheckGround()
        
        // Update systems
        UpdateSpeed(dt)
        UpdateSteering(dt)
        UpdateDrift(dt)
        UpdateMovement(dt)
        UpdateGravity(dt)
    }
    
    // =========================================================
    // INPUT HANDLING
    // =========================================================
    
    func ReadInput() {
        // Placeholder - will be connected to actual input system
        // For now, assume external system sets these variables
        // InputHorizontal = -1 to 1 (left/right)
        // InputAccel = true when accelerating
        // InputBrake = true when braking
        // InputDrift = true when drift button held
    }
    
    // =========================================================
    // GROUNDING CHECK - Mario Kart Style (Simple Raycast)
    // =========================================================
    
    func CheckGround() {
        if KartModel == nil { return }
        
        var pos = KartModel<Transform>.Position
        var down = Vector3{0.0, -1.0, 0.0}
        
        physics.SingleRaycast(pos, down, GroundRayDist, nil, false,
            out var hitEnt, out var hitPos, out var hitDist, out var hitNorm)
        
        IsGrounded = hitEnt != nil && hitNorm.Y > 0.5
    }
    
    // =========================================================
    // SPEED CONTROL - Mario Kart Style (Direct Lerp)
    // =========================================================
    
    func UpdateSpeed(dt float) {
        var targetSpeed = 0.0
        var lerpRate = DecelRate
        
        // Determine target speed based on input and state
        if IsBoosting {
            targetSpeed = BoostSpeed
            lerpRate = AccelRate * 2.0  // Faster acceleration when boosting
            BoostTime -= dt
            if BoostTime <= 0.0 {
                IsBoosting = false
                BoostTime = 0.0
            }
        } else if InputAccel && IsGrounded {
            targetSpeed = DesiredMaxSpeed
            lerpRate = AccelRate
        } else if InputBrake {
            targetSpeed = 0.0
            lerpRate = BrakeRate
        } else {
            targetSpeed = 0.0
            lerpRate = DecelRate
        }
        
        // If not grounded, limit speed
        if !IsGrounded && !IsBoosting {
            targetSpeed = 30.0
            lerpRate = AccelRate
        }
        
        // Lerp current speed to target
        CurrentSpeed = math.Lerp(CurrentSpeed, targetSpeed, lerpRate) as float
    }
    
    // =========================================================
    // STEERING - Mario Kart Style (Direct Rotation)
    // =========================================================
    
    func UpdateSteering(dt float) {
        if KartModel == nil { return }
        if math.Abs(InputHorizontal) < 0.01 { return }
        
        var rotateSpeed = RotateStrength
        
        // Reduce steering while drifting
        if IsDrifting {
            rotateSpeed = DriftRotateStrength
        }
        
        // Apply rotation - Mario Kart style direct transform rotate
        var rotateAmount = InputHorizontal * rotateSpeed * dt
        var currentRot = KartModel<Transform>.Rotation
        var currentEuler = KartModel<Transform>.Rotation
        
        var newYaw = currentEuler.Y + rotateAmount
        var newQuat = math.EulerAngleToQuaternion(Vector3{currentEuler.X, newYaw, currentEuler.Z})
        
        KartModel<Transform>.Rotation = math.QuaternionToEulerAngle(newQuat)
    }
    
    // =========================================================
    // DRIFT MECHANICS - Mario Kart Style
    // =========================================================
    
    func UpdateDrift(dt float) {
        if KartModel == nil { return }
        
        // Drift initiation - Press drift button + have horizontal input + speed > 40
        if !IsDrifting && InputDrift && math.Abs(InputHorizontal) > 0.1 && CurrentSpeed > 40.0 && IsGrounded {
            // Start drifting
            IsDrifting = true
            DriftTime = 0.0
            if InputHorizontal > 0.0 { DriftDirection = 1 } else { DriftDirection = -1 }
            std.LogInfo("[MarioKart] Drift started - Direction: " + DriftDirection)
        }
        
        // Drift active - Hold drift button
        if IsDrifting && InputDrift && IsGrounded && CurrentSpeed > 40.0 && math.Abs(InputHorizontal) > 0.1 {
            DriftTime += dt
            
            // Apply drift force perpendicular - Mario Kart style
            var rb = KartModel as entity<Rigidbody>
            if rb != nil {
                var driftForceDir = 0.0
                if DriftDirection > 0 { driftForceDir = -1.0 } else { driftForceDir = 1.0 }
                var rightQuat = math.EulerAngleToQuaternion(KartModel<Transform>.Rotation)
                var rightVec = math.RotateVector(Vector3{1.0, 0.0, 0.0}, rightQuat)
                physics.AddForce(rb as PhysicalObject,
                    Vector3{rightVec.X * driftForceDir * DriftForce * dt,
                            0.0,
                            rightVec.Z * driftForceDir * DriftForce * dt},
                    ForceType.Acceleration)
        }
            }
        
        // Drift end - Release button or conditions not met
        if IsDrifting && (!InputDrift || !IsGrounded || CurrentSpeed <= 40.0) {
            // End drift and grant boost based on drift time
            if DriftTime > 1.0 {
                BoostTime = 1.0  // Grant boost
                IsBoosting = true
                std.LogInfo("[MarioKart] Drift boost granted! Time: " + DriftTime)
            }
            
            IsDrifting = false
            DriftTime = 0.0
            DriftDirection = 0
        }
    }
    
    // =========================================================
    // MOVEMENT APPLICATION - Mario Kart Style (Direct Velocity)
    // =========================================================
    
    func UpdateMovement(dt float) {
        if KartModel == nil { return }
        
        var rb = KartModel as entity<Rigidbody>
        if rb == nil { return }
        
        var currentVel = rb<Rigidbody>.Velocity
        var fwdQuat = math.EulerAngleToQuaternion(KartModel<Transform>.Rotation)
        var fwd = math.RotateVector(Vector3{0.0, 0.0, 1.0}, fwdQuat)
        
        var newVel = Vector3{fwd.X * CurrentSpeed, currentVel.Y, fwd.Z * CurrentSpeed}
        
        rb<Rigidbody>.Velocity = newVel
    }
    
    // =========================================================
    // GRAVITY - Mario Kart Style (Constant Downward Force)
    // =========================================================
    
    func UpdateGravity(dt float) {
        if KartModel == nil { return }
        
        var rb = KartModel as entity<Rigidbody>
        if rb == nil { return }
        
        // Always apply downward force - Mario Kart style
        // This keeps the kart pressed to the ground
        physics.AddForce(rb as PhysicalObject,
            Vector3{0.0, -DownwardForce * dt, 0.0},
            ForceType.Acceleration)
    }
    
    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================
    
    func StartBoost(duration float) {
        BoostTime = duration
        IsBoosting = true
        std.LogInfo("[MarioKart] Boost activated for " + duration + " seconds")
    }
    
    func ResetKart() {
        CurrentSpeed = 0.0
        DriftTime = 0.0
        BoostTime = 0.0
        IsDrifting = false
        IsBoosting = false
        
        if KartModel != nil {
            var rb = KartModel as entity<Rigidbody>
            if rb != nil {
                rb<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}
                rb<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
            }
        }
        
        std.LogInfo("[MarioKart] Kart reset")
    }
    
    func SetRaceStarted(started bool) {
        IsRaceStarted = started
        if started {
            std.LogInfo("[MarioKart] Race started!")
        }
    }
    
    func SetMovementLocked(locked bool) {
        IsMovementLocked = locked
        if locked {
            ResetKart()
        }
    }
    
    // =========================================================
    // INPUT SETTERS (Call from external input system)
    // =========================================================
    
    func SetInputHorizontal(value float) {
        InputHorizontal = value
    }
    
    func SetInputAccel(pressed bool) {
        InputAccel = pressed
    }
    
    func SetInputBrake(pressed bool) {
        InputBrake = pressed
    }
    
    func SetInputDrift(pressed bool) {
        InputDrift = pressed
    }
    
    // =========================================================
    // GETTERS (For UI and other systems)
    // =========================================================
    
    func GetCurrentSpeed() float {
        return CurrentSpeed
    }
    
    func GetIsDrifting() bool {
        return IsDrifting
    }
    
    func GetIsBoosting() bool {
        return IsBoosting
    }
    
    func GetIsGrounded() bool {
        return IsGrounded
    }
}

