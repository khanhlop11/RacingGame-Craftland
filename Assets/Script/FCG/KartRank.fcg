import "StdLibrary.fcc" as std
import "Database.fcc" as database
import "Convert.fcc" as convert
import "Math.fcc" as math
import "List.fcc" as list

// ============================================================
// KartRank.fcg
// Quản lý đọc/ghi kỷ lục thời gian đua vào Bảng Xếp Hạng (TimerRank)
// Platform: Server
// ============================================================
[platform_server]
static graph KartRank {
    LeaderboardSheetName string = "TimerRank"
    MapCode string = ""

    // Chuyển đổi milliseconds thành chuỗi hiển thị mm:ss.fff
    func FormatTimeMs(timeMs int) string {
        if timeMs <= 0 {
            return "00:00.000"
        }
        var totalSec = timeMs / 1000
        var ms = timeMs % 1000
        var m = totalSec / 60
        var s = totalSec % 60

        var mStr = convert.ToString(m)
        if m < 10 {
            mStr = "0" + mStr
        }
        var sStr = convert.ToString(s)
        if s < 10 {
            sStr = "0" + sStr
        }
        var msStr = convert.ToString(ms)
        if ms < 10 {
            msStr = "00" + msStr
        } else if ms < 100 {
            msStr = "0" + msStr
        }
        return mStr + ":" + sStr + "." + msStr
    }

    RecordedUIDs List<string> = List<string>{}

    func HasRecordedPlayer(uid string) bool {
        if RecordedUIDs == nil { return false }
        var cnt = list.Length(RecordedUIDs as List<object>)
        for i = 0, cnt, 1 {
            if RecordedUIDs[i] == uid {
                return true
            }
        }
        return false
    }

    // Đọc kỷ lục hiện tại của người chơi từ Leaderboard (bao gồm cả số lần chơi Attempts)
    // Gán kết quả vào: out var hasRecord bool, out var oldTimeMs int, out var oldTimeFormatted string, out var attempts int
    async func GetPlayerRecord(player entity<Player>, out var hasRecord bool, out var oldTimeMs int, out var oldTimeFormatted string, out var attempts int) {
        hasRecord = false
        oldTimeMs = -1
        oldTimeFormatted = ""
        attempts = 0

        if player == nil {
            return
        }

        var uidStr = convert.ToString(player<Player>.UserUID)
        database.ReadFromLeaderboardAssociation(LeaderboardSheetName, uidStr, out var result, MapCode, out var statusCode, out var assocStatusCode)

        // Nếu bảng dùng association trả về dữ liệu
        if statusCode == StatusCode.NoError && result != nil && list.Length(result) >= 3 {
            var valObj = result[2]
            if valObj != nil {
                var colList = valObj as List<object>
                if colList != nil && list.Length(colList) > 0 {
                    // Cột chính (Int): Thời gian ms để xếp hạng
                    oldTimeMs = colList[0] as int
                    // Cột phụ 'Time' (String): Chuỗi mm:ss.fff
                    if list.Length(colList) > 1 && colList[1] != nil {
                        oldTimeFormatted = convert.ToString(colList[1])
                    } else {
                        oldTimeFormatted = FormatTimeMs(oldTimeMs)
                    }
                    // Cột phụ 'Attempts' (Int): Số lần chơi
                    if list.Length(colList) > 2 && colList[2] != nil {
                        attempts = colList[2] as int
                    }
                    if oldTimeMs >= 999999990 {
                        hasRecord = false
                        oldTimeMs = -1
                        oldTimeFormatted = ""
                    } else {
                        hasRecord = true
                    }
                    return
                } else {
                    oldTimeMs = valObj as int
                    if oldTimeMs >= 999999990 {
                        hasRecord = false
                        oldTimeMs = -1
                        oldTimeFormatted = ""
                    } else {
                        oldTimeFormatted = FormatTimeMs(oldTimeMs)
                        hasRecord = true
                    }
                    return
                }
            }
        }

        // Dự phòng: Đọc bằng ReadFromLeaderboard thường nếu bảng chưa kịp link association
        database.ReadFromLeaderboard(LeaderboardSheetName, uidStr, out var singleResult, MapCode, out var scSingle)
        if scSingle == StatusCode.NoError && singleResult != nil && list.Length(singleResult) >= 3 {
            var sVal = singleResult[2]
            if sVal != nil {
                oldTimeMs = sVal as int
                if oldTimeMs >= 999999990 {
                    hasRecord = false
                    oldTimeMs = -1
                    oldTimeFormatted = ""
                } else {
                    oldTimeFormatted = FormatTimeMs(oldTimeMs)
                    hasRecord = true
                }
            }
        }
    }

    // Đếm số lần vào game cho người chơi (chỉ cần vào game là +1, không cần hoàn thành cuộc đua)
    async func RecordPlayerJoin(player entity<Player>) {
        if player == nil { return }

        var uidStr = convert.ToString(player<Player>.UserUID)
        if HasRecordedPlayer(uidStr) {
            return
        }

        list.Append(RecordedUIDs as List<object>, uidStr as object)

        // 1. Đọc dữ liệu hiện tại từ Leaderboard
        GetPlayerRecord(player, out var hasRecord, out var oldTimeMs, out var oldFormatted, out var curAttempts)

        // 2. Tăng số lần chơi lên 1
        var newAttempts = curAttempts + 1
        LogInfo("[KartRank] 🎮 Player " + uidStr + " tham gia game! Số lần chơi: " + convert.ToString(curAttempts) + " -> " + convert.ToString(newAttempts))

        var saveTimeMs = oldTimeMs
        var saveFormatted = oldFormatted

        if !hasRecord || saveTimeMs <= 0 {
            // Chưa có kỷ lục thời gian nào -> dùng sentinel lớn để không ảnh hưởng top thời gian
            saveTimeMs = 999999999
            saveFormatted = "--:--.---"
        }

        // 3. Cập nhật vào Leaderboard (giữ nguyên kỷ lục cũ nếu có, cập nhật Attempts mới)
        database.WriteToLeaderboardAssociation(LeaderboardSheetName, uidStr, List<object>{saveTimeMs as object, saveFormatted as object, newAttempts as object}, MapCode, out var sc, out var asc)
        if sc == StatusCode.NoError {
            LogInfo("[KartRank] ✅ Đã lưu số lần chơi thành công cho player " + uidStr + " (" + convert.ToString(newAttempts) + " lần)")
        } else {
            LogInfo("[KartRank] ⚠️ Ghi số lần chơi thất bại, status: " + convert.ToString(sc) + ", assoc: " + convert.ToString(asc))
        }
    }

    // Kiểm tra và ghi kỷ lục cho người chơi khi về đích
    // timeMs: thời gian hoàn thành cuộc đua (milliseconds)
    // Gán kết quả vào: out var isNewRecord bool
    async func CheckAndSaveRecord(player entity<Player>, timeMs int, out var isNewRecord bool) {
        isNewRecord = false

        if player == nil || timeMs <= 0 {
            return
        }

        var uidStr = convert.ToString(player<Player>.UserUID)
        var formatted = FormatTimeMs(timeMs)

        // 1. Đọc dữ liệu kỷ lục cũ và số lần chơi
        GetPlayerRecord(player, out var hasOldRecord, out var oldTimeMs, out var oldFormatted, out var curAttempts)

        if !hasOldRecord || oldTimeMs <= 0 || oldTimeMs >= 999999990 {
            // Chưa có kỷ lục -> Chắc chắn là kỷ lục đầu tiên của người chơi
            isNewRecord = true
            LogInfo("[KartRank] 🌟 Kỷ lục đầu tiên của player " + uidStr + ": " + formatted + " (" + convert.ToString(timeMs) + " ms)")
        } else if timeMs < oldTimeMs {
            // Thời gian mới NHANH HƠN kỷ lục cũ
            isNewRecord = true
            LogInfo("[KartRank] 🏆 KỶ LỤC MỚI! Cũ: " + oldFormatted + " (" + convert.ToString(oldTimeMs) + " ms) -> Mới: " + formatted + " (" + convert.ToString(timeMs) + " ms)")
        } else {
            // Không nhanh hơn kỷ lục cũ
            LogInfo("[KartRank] Không phá kỷ lục (Kỷ lục hiện tại: " + oldFormatted + " / " + convert.ToString(oldTimeMs) + " ms, Lần này: " + formatted + ")")
            return
        }

        // 2. Ghi kỷ lục mới vào Leaderboard TimerRank, bảo lưu Attempts hiện tại
        if isNewRecord {
            database.WriteToLeaderboardAssociation(LeaderboardSheetName, uidStr, List<object>{timeMs as object, formatted as object, curAttempts as object}, MapCode, out var sc, out var asc)
            if sc != StatusCode.NoError {
                // Dự phòng nếu bảng không bật cột phụ liên kết
                database.WriteToLeaderboard(LeaderboardSheetName, uidStr, timeMs, MapCode, out var sc2)
                LogInfo("[KartRank] Ghi bằng WriteToLeaderboard, status: " + convert.ToString(sc2))
            } else {
                LogInfo("[KartRank] Đã lưu kỷ lục mới thành công vào TimerRank! Attempts: " + convert.ToString(curAttempts))
            }
        }
    }
}
