        WpX[72] = -7.7; WpY[72] = 2.25; WpZ[72] = 46.76
    }

    func CatmullRomSpline(p0 Vector3, p1 Vector3, p2 Vector3, p3 Vector3, t float) Vector3 {
        var t2 = t * t
        var t3 = t2 * t
        var x = 0.5 * ((2.0 * p1.X) + (-p0.X + p2.X) * t + (2.0 * p0.X - 5.0 * p1.X + 4.0 * p2.X - p3.X) * t2 + (-p0.X + 3.0 * p1.X - 3.0 * p2.X + p3.X) * t3)
        var y = 0.5 * ((2.0 * p1.Y) + (-p0.Y + p2.Y) * t + (2.0 * p0.Y - 5.0 * p1.Y + 4.0 * p2.Y - p3.Y) * t2 + (-p0.Y + 3.0 * p1.Y - 3.0 * p2.Y + p3.Y) * t3)
        var z = 0.5 * ((2.0 * p1.Z) + (-p0.Z + p2.Z) * t + (2.0 * p0.Z - 5.0 * p1.Z + 4.0 * p2.Z - p3.Z) * t2 + (-p0.Z + 3.0 * p1.Z - 3.0 * p2.Z + p3.Z) * t3)
        return Vector3{x, y, z}
    }

    func InitFlybyDistances() {
        InitClientLists()
        var totalSegments = FlybyStartWp
        if totalSegments < 2 { totalSegments = 2 }
        var neededLen = totalSegments + 2
        if FlybyDist == nil || list.Length(FlybyDist as List<object>) < neededLen {
            FlybyDist = list.New(neededLen, neededLen) as List<float>
        }
        FlybyDist[0] = 0.0
        var accum = 0.0
        // Đoạn 0 .. FlybyStartWp - 2: từ FlybyStartWp ngược về WP 1
        for i = 0, FlybyStartWp - 1, 1 {
            var fromWp = FlybyStartWp - i
            var toWp = fromWp - 1
            if fromWp >= 0 && toWp >= 1 && fromWp < WpTotalWaypoints && toWp < WpTotalWaypoints {
                var dx = WpX[fromWp] - WpX[toWp]
                var dy = WpY[fromWp] - WpY[toWp]
                var dz = WpZ[fromWp] - WpZ[toWp]
                var d = math.Sqrt(dx * dx + dy * dy + dz * dz)
                if d < 1.0 { d = 1.0 }
                accum += d
            } else {
                accum += 15.0
            }
            FlybyDist[i + 1] = accum
        }
        // Segment cuối cùng (FlybyStartWp - 1): WP 1 -> carCamPos (vị trí 4.8m sau xe)
        var carPos = Vector3{WpX[0], WpY[0], WpZ[0]}
        var carYaw = 0.0
        if KartModel != nil {
            carPos = KartModel<Transform>.Position
            var euler = math.QuaternionToEulerAngle(PhysicsQuat)
            carYaw = euler.Y
        } else if HasCpRespawn && (math.Abs(CpRespawnX) > 0.1 || math.Abs(CpRespawnZ) > 0.1) {
            carPos = Vector3{CpRespawnX, CpRespawnY + 0.85, CpRespawnZ}
            carYaw = CpRespawnYaw
        }
        var carRotQ = math.EulerAngleToQuaternion(Vector3{0.0, carYaw, 0.0})
        var carCamOffset = math.RotateVector(Vector3{0.0, BaseCamHeight, -4.8}, carRotQ)
        var carCamPos = Vector3{carPos.X + carCamOffset.X, carPos.Y + carCamOffset.Y, carPos.Z + carCamOffset.Z}
        var lastDx = WpX[1] - carCamPos.X
        var lastDy = (WpY[1] + FlybyCamHeight) - carCamPos.Y
        var lastDz = WpZ[1] - carCamPos.Z
        var lastD = math.Sqrt(lastDx * lastDx + lastDy * lastDy + lastDz * lastDz)
        if lastD < 5.0 { lastD = 25.0 }
        accum += lastD
        FlybyDist[totalSegments] = accum
        FlybyTotalDist = accum
    }

    func LerpAngleDeg(curAngle float, targetAngle float, t float) float {
        var diff = NormalizeYawClient(targetAngle - curAngle)
        return curAngle + diff * t
    }

    func UpdateFinalSectorFlyby(dt float) {
        if WpTotalWaypoints < (FlybyStartWp + 1) {
            LoadDefaultTrackWaypoints()
        }
        if MyClientCam == nil || WpTotalWaypoints < 4 || WpX == nil { return }
        if FlybyDist == nil || FlybyTotalDist < 10.0 {
            InitFlybyDistances()
        }
        if FlybyDist == nil { return }

        var camEntity = MyClientCam as entity<Entity>
        var totalSegments = FlybyStartWp
        if totalSegments < 2 { totalSegments = 2 }

        if !FlybyInitialized {
            FlybyInitialized = true
            HasStartedFinalSectorFlyby = true

            // GIAI ĐOẠN 3: Tự động co giãn thời lượng Flycam theo thời gian phòng chờ còn lại
            var remainingTime = LobbySmoothTimer
            if remainingTime < 5.0 {
                remainingTime = 10.0 // Giới hạn an toàn tối thiểu nếu phòng chờ sắp hết
            }
            FlybyTotalDuration = remainingTime
            FlybyRunTimer = 0.0
            InitFlybyDistances()
            FlybySpeedMult = 1.0

            // Cắt thẳng góc quay điện ảnh (Cut) sang WP bắt đầu, không lerp kéo lê qua bản đồ
            var initP1 = Vector3{WpX[FlybyStartWp], WpY[FlybyStartWp] + FlybyCamHeight, WpZ[FlybyStartWp]}
            var initP2 = Vector3{WpX[FlybyStartWp - 1], WpY[FlybyStartWp - 1] + FlybyCamHeight, WpZ[FlybyStartWp - 1]}
            var initDirX = initP2.X - initP1.X
            var initDirZ = initP2.Z - initP1.Z
            // Reverse Flycam: Ống kính quay ngược 180° (-initDirX, -initDirZ) để bay lùi dẫn đường nhìn về sau
            var initYaw = math.ATan2(-initDirX, -initDirZ)
            FlybyCurrentCamPos = initP1
            FlybyCurrentCamRot = Vector3{5.0, initYaw, 0.0}
            camEntity<Transform>.Position = initP1
            camEntity<Transform>.Rotation = Vector3{5.0, initYaw, 0.0}
            camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0)
        }

        // Tự động tăng đều đặn theo khung hình local của Client (chậm rãi, êm dịu theo FlybyTotalDuration = 40.0s)
        FlybyRunTimer += dt
        var u = FlybyRunTimer / FlybyTotalDuration
        if u < 0.0 { u = 0.0 }
        if u > 1.0 { u = 1.0 }

        var totalDist = FlybyTotalDist
        if totalDist < 10.0 { totalDist = 2000.0 }
        var targetDist = u * totalDist

        var seg = 0
        for i = 0, totalSegments, 1 {
            if targetDist <= FlybyDist[i + 1] {
                seg = i
                break
            }
        }
        if seg >= totalSegments { seg = totalSegments - 1 }

        var dStart = FlybyDist[seg]
        var dEnd   = FlybyDist[seg + 1]
        var segLen = dEnd - dStart
        if segLen < 0.1 { segLen = 0.1 }
        var frac = (targetDist - dStart) / segLen
        if frac < 0.0 { frac = 0.0 }
        if frac > 1.0 { frac = 1.0 }

        // Vị trí và góc nhìn chuẩn phía sau xe của mình
        var carPos = Vector3{WpX[0], WpY[0], WpZ[0]}
        var carYaw = 0.0
        if KartModel != nil {
            carPos = KartModel<Transform>.Position
            var euler = math.QuaternionToEulerAngle(PhysicsQuat)
            carYaw = euler.Y
        } else if HasCpRespawn && (math.Abs(CpRespawnX) > 0.1 || math.Abs(CpRespawnZ) > 0.1) {
            carPos = Vector3{CpRespawnX, CpRespawnY + 0.85, CpRespawnZ}
            carYaw = CpRespawnYaw
        }
        var carRotQ = math.EulerAngleToQuaternion(Vector3{0.0, carYaw, 0.0})
        var carFwdVec = math.RotateVector(Vector3{0.0, 0.0, 1.0}, carRotQ)
        var carCamOffset = math.RotateVector(Vector3{0.0, BaseCamHeight, -4.8}, carRotQ)
        var carCamPos = Vector3{carPos.X + carCamOffset.X, carPos.Y + carCamOffset.Y, carPos.Z + carCamOffset.Z}
        var carCamEuler = Vector3{BaseCamPitch, carYaw, 0.0}

        var p0 = Vector3{0.0, 0.0, 0.0}
        var p1 = Vector3{0.0, 0.0, 0.0}
        var p2 = Vector3{0.0, 0.0, 0.0}
        var p3 = Vector3{0.0, 0.0, 0.0}

        if seg < (totalSegments - 1) {
            // Chặng giữa các Waypoint (WP 20 -> WP 19 -> ... -> WP 1)
            var fromWp = FlybyStartWp - seg
            var toWp = fromWp - 1
            var p0Idx = fromWp + 1
            if p0Idx >= WpTotalWaypoints { p0Idx = fromWp }
            p0 = Vector3{WpX[p0Idx], WpY[p0Idx] + FlybyCamHeight, WpZ[p0Idx]}
            p1 = Vector3{WpX[fromWp], WpY[fromWp] + FlybyCamHeight, WpZ[fromWp]}
            p2 = Vector3{WpX[toWp],   WpY[toWp] + FlybyCamHeight,   WpZ[toWp]}
            if toWp > 1 {
                var p3Idx = toWp - 1
                p3 = Vector3{WpX[p3Idx],  WpY[p3Idx] + FlybyCamHeight,  WpZ[p3Idx]}
            } else {
                p3 = carCamPos
            }
        } else {
            // Chặng cuối: WP 1 -> carCamPos (đáp thẳng và mượt mà vào đúng vị trí 4-5 mét sau xe!)
            p0 = Vector3{WpX[2], WpY[2] + FlybyCamHeight, WpZ[2]}
            p1 = Vector3{WpX[1], WpY[1] + FlybyCamHeight, WpZ[1]}
            p2 = carCamPos
            p3 = Vector3{carCamPos.X + carFwdVec.X * 5.0, carCamPos.Y + carFwdVec.Y * 5.0, carCamPos.Z + carFwdVec.Z * 5.0}
        }

        // Quỹ đạo đường cong Catmull-Rom C1 liên tục
        var targetPos = CatmullRomSpline(p0, p1, p2, p3, frac)

        // Hướng nhìn phía trước đường bay theo tiếp tuyến Spline
        var tAhead = frac + 0.04
        if tAhead > 1.0 { tAhead = 1.0 }
        var pAhead = CatmullRomSpline(p0, p1, p2, p3, tAhead)
        var dirX = pAhead.X - targetPos.X
        var dirY = pAhead.Y - targetPos.Y
        var dirZ = pAhead.Z - targetPos.Z
        var distXZ = math.Sqrt(dirX * dirX + dirZ * dirZ)
        if distXZ < 0.05 { distXZ = 0.05 }

        // Reverse Flycam: Ống kính quay ngược 180° (-dirX, -dirZ) để nhìn ngoái lại phía sau như máy quay lùi dẫn đường
        var yawTarget = math.ATan2(-dirX, -dirZ)
        var pitchTarget = math.ATan2(dirY, distXZ) + 4.5
        var currentTargetFOV = 68.0

        if seg == (totalSegments - 1) {
            // Chặng cuối (WP 1 -> sau xe 4-5 mét): đảm bảo góc nhìn luôn hướng về phía trước theo hướng xe, tuyệt đối không xoay 180 độ
            var yawDiff = NormalizeYawClient(yawTarget - carCamEuler.Y)
            if math.Abs(yawDiff) > 90.0 {
                yawTarget = NormalizeYawClient(yawTarget + 180.0)
            }
            var blendT = frac * frac * (3.0 - 2.0 * frac)
            yawTarget = LerpAngleDeg(yawTarget, carCamEuler.Y, blendT)
            pitchTarget = math.Lerp(pitchTarget, carCamEuler.X, blendT)
            currentTargetFOV = math.Lerp(68.0, CurrentFOV, blendT)

            // Viền đen điện ảnh mở chậm dần ra ngoài mép màn hình khi đáp về sau xe / vạch xuất phát
            var barFrac = frac * frac * (3.0 - 2.0 * frac)
            CinematicBarTargetHeight = math.Lerp(110.0, 0.0, barFrac)
            if frac >= 0.98 {
                CinematicBarTargetHeight = 0.0
            }
        } else {
            // Các chặng giữa Flycam (WP 20 -> WP 1): duy trì viền đen rạp phim 21:9
            CinematicBarTargetHeight = 110.0
        }

        var finalPos = targetPos
        var finalRot = Vector3{pitchTarget, yawTarget, 0.0}

        // Bộ lọc Lerp mượt mà khung hình Exponential Smoothing (Triệt tiêu rung giật)
        var posLerpRate = 12.0 * dt
        if posLerpRate > 1.0 { posLerpRate = 1.0 }
        FlybyCurrentCamPos = math.LerpVector3(FlybyCurrentCamPos, finalPos, posLerpRate)

        var rotLerpRate = 10.0 * dt
        var nextRotX = math.Lerp(FlybyCurrentCamRot.X, finalRot.X, rotLerpRate)
        var nextRotY = LerpAngleDeg(FlybyCurrentCamRot.Y, finalRot.Y, rotLerpRate)
        FlybyCurrentCamRot = Vector3{nextRotX, nextRotY, 0.0}

        camEntity<Transform>.Position = FlybyCurrentCamPos
        camEntity<Transform>.Rotation = FlybyCurrentCamRot
        MyClientCam<camera.CustomCamera>.FOV = currentTargetFOV

        UpdateCinematicLetterbox(dt)
    }

    func UpdateCinematicLetterbox(dt float) {
        if !IsIntroCamActive || HasSwitchedStartCamera {
            CinematicBarTargetHeight = 0.0
            CinematicBarCurrentHeight = 0.0
            return
        }

        // Tốc độ lerp chậm rãi, êm dịu, quý phái để người chơi thư thái thưởng thức
        var lerpSpeed = 2.5 * dt
        if CinematicBarTargetHeight < 5.0 {
            lerpSpeed = 2.0 * dt
        }
        if lerpSpeed > 1.0 { lerpSpeed = 1.0 }

        CinematicBarCurrentHeight = math.Lerp(CinematicBarCurrentHeight, CinematicBarTargetHeight, lerpSpeed)
        if math.Abs(CinematicBarCurrentHeight - CinematicBarTargetHeight) < 0.3 {
            CinematicBarCurrentHeight = CinematicBarTargetHeight
        }
    }

    func UpdateIntroCamera(dt float) {
        if !HasScannedIntroCameras {
            ScanIntroCameras()
        }
        if MyClientCam == nil { return }

        // NẾU ĐÃ KÍCH HOẠT FLYCAM (do đã chiếu xong toàn bộ góc Intro Camera):
        if HasStartedFinalSectorFlyby {
            if WpTotalWaypoints < (FlybyStartWp + 1) {
                LoadDefaultTrackWaypoints()
            }
            if WpTotalWaypoints >= 4 && WpX != nil {
                UpdateFinalSectorFlyby(dt)
                return
            }
        }

        // GIAI ĐOẠN CHUYỂN TIẾP (SHUTTER BLACKOUT): Đóng chậm rãi -> Cut camera sang WP 20 -> Mở chậm rãi
        if IsIntroShutterActive {
            IntroShutterTimer += dt

            if IntroShutterTimer <= 0.95 {
                // Pha 1 (0.0s -> 0.95s): 2 thanh đen từ từ khép lại từ 110px vào giữa màn hình (400px)
                var tClose = IntroShutterTimer / 0.95
                if tClose < 0.0 { tClose = 0.0 }
                if tClose > 1.0 { tClose = 1.0 }
                var smoothClose = tClose * tClose * (3.0 - 2.0 * tClose)
                CinematicBarCurrentHeight = math.Lerp(110.0, 400.0, smoothClose)
            } else if IntroShutterTimer <= 1.25 {
                // Pha 2 (0.95s -> 1.25s): Giữ màn hình đen tĩnh lặng hoàn toàn trong 0.30s & Cut camera tức thì
                CinematicBarCurrentHeight = 400.0
                if !IntroShutterCutDone {
                    IntroShutterCutDone = true
                    if WpTotalWaypoints < (FlybyStartWp + 1) {
                        LoadDefaultTrackWaypoints()
                    }
                    var initP1 = Vector3{WpX[FlybyStartWp], WpY[FlybyStartWp] + FlybyCamHeight, WpZ[FlybyStartWp]}
                    var initP2 = Vector3{WpX[FlybyStartWp - 1], WpY[FlybyStartWp - 1] + FlybyCamHeight, WpZ[FlybyStartWp - 1]}
                    var initDirX = initP2.X - initP1.X
                    var initDirZ = initP2.Z - initP1.Z
                    var initYaw = math.ATan2(-initDirX, -initDirZ)

                    FlybyCurrentCamPos = initP1
                    FlybyCurrentCamRot = Vector3{5.0, initYaw, 0.0}
                    var camEntity = MyClientCam as entity<Entity>
                    camEntity<Transform>.Position = initP1
                    camEntity<Transform>.Rotation = Vector3{5.0, initYaw, 0.0}
                    MyClientCam<camera.CustomCamera>.FOV = 68.0

                    // Chuẩn bị các biến cho Flycam
                    FlybyRunTimer = 0.0
                    FlybyInitialized = false
                }
            } else {
                // Pha 3 (1.25s -> 2.20s): 2 thanh đen từ từ mở chậm rãi ra lại mức 110px hé lộ đường đua Flycam
                var tOpen = (IntroShutterTimer - 1.25) / 0.95
                if tOpen < 0.0 { tOpen = 0.0 }
                if tOpen > 1.0 { tOpen = 1.0 }
                var smoothOpen = tOpen * tOpen * (3.0 - 2.0 * tOpen)
                CinematicBarCurrentHeight = math.Lerp(400.0, 110.0, smoothOpen)

                if IntroShutterTimer >= IntroShutterDuration {
                    IsIntroShutterActive = false
                    CinematicBarCurrentHeight = 110.0
                    CinematicBarTargetHeight = 110.0
                    HasStartedFinalSectorFlyby = true
                    UpdateFinalSectorFlyby(dt)
                    return
                }
            }
            return
        }

        // GIAI ĐOẠN 1: 20 giây đầu giữ nguyên camera mặc định của xe, không can thiệp góc quay & ẩn viền đen
        if InitialDefaultCamTimer < InitialDefaultCamDuration {
            InitialDefaultCamTimer += dt
            if !HasScannedIntroCameras {
                ScanIntroCameras()
            }
            CinematicBarTargetHeight = 0.0
            UpdateCinematicLetterbox(dt)
            return
        }

        // GIAI ĐOẠN 2: Sau 20s, bắt đầu chuyển sang góc Intro Camera đầu tiên & hiện viền đen điện ảnh
        if !HasSwitchedToIntroCam {
            HasSwitchedToIntroCam = true
            IntroWatchdogTimer = 0.0
            IntroShotIndex = 0
            IntroShotTimer = 0.0
            CinematicBarTargetHeight = 110.0
            if MyClientCam != nil && TotalIntroShots > 0 {
                var camEnt = MyClientCam as entity<Entity>
                camEnt<Transform>.Position = IntroP_Start[0]
                camEnt<Transform>.Rotation = IntroR_Start[0]
                camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0)
            }
        }

        // Nếu scene thực sự không có camera Intro nào sau 2.5s scan -> Fallback bật Flycam
        if TotalIntroShots <= 0 {
            IntroWatchdogTimer += dt
            if IntroWatchdogTimer >= 2.5 {
                HasStartedFinalSectorFlyby = true
                UpdateFinalSectorFlyby(dt)
            }
            UpdateCinematicLetterbox(dt)
            return
        }

        IntroWatchdogTimer += dt
        if IntroWatchdogTimer >= 2.0 {
            IntroWatchdogTimer = 0.0
            camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0)
        }

        IntroShotTimer += dt
        if IntroShotTimer >= IntroShotDuration {
            IntroShotTimer = 0.0
            IntroShotIndex += 1
            if IntroShotIndex >= TotalIntroShots {
                // ĐÃ CHIẾU XONG TẤT CẢ GÓC INTRO (CHỈ CHIẾU 1 LẦN DUY NHẤT)!
                // Bắt đầu Shutter Blackout Transition (đóng sập màn hình đen, cắt máy quay tức thì sang WP 20)
                IntroAllShotsCompleted = true
                IsIntroShutterActive = true
                IntroShutterTimer = 0.0
                IntroShutterCutDone = false
                CinematicBarTargetHeight = 400.0
                UpdateCinematicLetterbox(dt)
                return
            }
        }

        CinematicBarTargetHeight = 110.0

        var t = IntroShotTimer / IntroShotDuration
        if t < 0.0 { t = 0.0 }
        if t > 1.0 { t = 1.0 }

        // Smoothstep interpolation (khởi đầu êm, lướt mượt, kết thúc êm)
        var smoothT = t * t * (3.0 - 2.0 * t)

        var curIdx = IntroShotIndex
        if curIdx < 0 || curIdx >= TotalIntroShots { curIdx = 0 }

        var pStart = IntroP_Start[curIdx]
        var pEnd   = IntroP_End[curIdx]
        var rStart = IntroR_Start[curIdx]
        var rEnd   = IntroR_End[curIdx]

        var curPos = math.LerpVector3(pStart, pEnd, smoothT)
        var qStart = math.EulerAngleToQuaternion(rStart)
        var qEnd   = math.EulerAngleToQuaternion(rEnd)
        var curRotQ = math.SlerpQuaternion(qStart, qEnd, smoothT)
        var curRotEuler = math.QuaternionToEulerAngle(curRotQ)

        var camEntity = MyClientCam as entity<Entity>
        camEntity<Transform>.Position = curPos
        camEntity<Transform>.Rotation = curRotEuler
        MyClientCam<camera.CustomCamera>.FOV = 65.0

        UpdateCinematicLetterbox(dt)
    }

    // =========================================================
    // REGION: MAIN ORCHESTRATOR UPDATE LOOP
    // Execution order notes:
    // - Do not reorder blocks casually. Current gameplay feel depends on timing.
    // - Intended future order: Lifecycle guards -> Visual wheel anim -> Grounding -> Drift -> Nitro -> Physics -> Visual mesh -> Camera -> NetworkSync.
    // - Phase 0 keeps all code inline and preserves exact behavior/update order.
    // =========================================================
    // VÒNG LẶP CHÍNH (ON UPDATE)
    // =========================================================
    event OnUpdate() {
        if !IsRunning  { return }
        // --- DeltaTime chuẩn xác theo thời gian thực (đo FPS tự động, khử 100% sai lệch tốc độ giữa PC và Mobile) ---
        FpsFrameCount += 1
        var secNow = time.GetLocalTimestamp()
        if secNow != FpsLastSec {
            if FpsFrameCount >= 20 && FpsFrameCount <= 240 {
                MeasuredFrameRate = FpsFrameCount as float
            }
            FpsFrameCount = 0
            FpsLastSec = secNow
        }

        var realDt = 1.0 / MeasuredFrameRate
        if realDt < 0.008 { realDt = 0.008 }
        if realDt > 0.050 { realDt = 0.050 }

        // Cập nhật mượt mà đếm ngược phòng chờ cho Flycam (dùng realDt theo thời gian thực)
        if IsLobbyActive {
            if LobbySmoothTimer > 0.0 {
                LobbySmoothTimer -= realDt
                if LobbySmoothTimer < 0.0 { LobbySmoothTimer = 0.0 }
            }
        }

        // --- Intro Flycam (Cinematic phòng chờ: dùng realDt theo thời gian thực) ---
        if IsIntroCamActive && !HasSwitchedStartCamera {
            UpdateIntroCamera(realDt)
        }

        // --- DeltaTime vật lý xe: Khôi phục chuẩn gốc 0.033s (30 FPS physics tick) ---
        // Đảm bảo 100% độ gắt khi bẻ lái, ôm cua và cảm giác rê bánh drift nguyên bản đã tune
        var dt = 0.033

        if PendingSpawnAtStart && !HasSpawnedAtStartSlot {
            SpawnRetryTimer -= dt
            if SpawnRetryTimer <= 0.0 {
                SpawnRetryTimer = 0.35
                if math.Abs(CpRespawnX) > 0.1 || math.Abs(CpRespawnZ) > 0.1 {
                    HasSpawnedAtStartSlot = true
                    PendingSpawnAtStart = false
                    SpawnKartAtRespawn()
                    SpawnDropTimer = 1.5
                    if !IsRaceStarted {
                        IsExternallyLocked = true
                    }
                    if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, true) }
                }
            }
        }
        if RaceStartUiTimer > 0.0 {
            // Giảm nhẹ để tạo hoạt ảnh Pop mượt mà, dừng lại ở cận dưới cho đến khi Server gửi bước tiếp theo
            var minTimer = (LastCountdownStep - 1) as float
            if minTimer < 0.0 { minTimer = 0.0 }
            RaceStartUiTimer -= dt * 0.7
            if RaceStartUiTimer < minTimer + 0.05 { RaceStartUiTimer = minTimer + 0.05 }
        }
        if RaceGoUiTimer > 0.0 {
            RaceGoUiTimer -= dt
            if RaceGoUiTimer < 0.0 { RaceGoUiTimer = 0.0 }
        }
        if StartCameraDelayTimer > 0.0 {
            StartCameraDelayTimer -= dt
            if HasCpRespawn {
                if KartModel == nil {
                    SpawnKartAtRespawn()
                } else {
                    var startDx = KartModel<Transform>.Position.X - CpRespawnX
                    var startDz = KartModel<Transform>.Position.Z - CpRespawnZ
                    var startDistSq = startDx * startDx + startDz * startDz
                    if startDistSq > 25.0 { SpawnKartAtRespawn() }
                }
            }
            if StartCameraDelayTimer <= 0.0 {
                StartCameraDelayTimer = 0.0
                if !HasSwitchedStartCamera && KartModel != nil {
                    HasSwitchedStartCamera = true
                    if MyClientCam != nil { camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0) }
                    SnapCameraToKartNow()
                }
            }
        }
        if ClientVisualCar != nil && KartModel != nil && std.GetParent(ClientVisualCar) == nil {
            AttachVisualCarToKart()
        }
        if KartModel == nil { return }

        if RespawnCooldown > 0.0 {
            RespawnCooldown -= dt
            if RespawnCooldown < 0.0 { RespawnCooldown = 0.0 }
        }

        if !HasScannedResetZones {
            ResetZoneScanRetryTimer -= dt
            if ResetZoneScanRetryTimer <= 0.0 {
                ResetZoneScanRetryTimer = 1.0
                ScanResetZones()
            }
        }

        // Tự động hồi sinh ngay lập tức khi xe văng khỏi map (tọa độ Y < -5.0 hoặc lọt vào ResetZones)
        if !IsLocalResetting && RespawnCooldown <= 0.0 {
            var curKartY = KartModel<Transform>.Position.Y
            if curKartY < -5.0 {
                TriggerFallOffMapRespawn()
                return
            }
            if IsCarInsideResetZones() {
                TriggerFallOffMapRespawn()
                return
            }
        }

        // -----------------------------------------------------
        // UPDATE BLOCK: TIME / CAMERA LAYER / RESET UNLOCK / MOVEMENT LOCK
        // Dependencies:
        // - dt feeds every subsystem below.
        // - unlock request talks to RaceManager after local reset wakeup.
        // - movement lock zeroes velocity and prevents gameplay update while still allowing network sync later.
        // -----------------------------------------------------

        if TargetHiddenLayer != -1 && MyClientCam != nil {
            camera.SetCustomCameraCullingMaskLayer(MyClientCam, TargetHiddenLayer, false)
            TargetHiddenLayer = -1 
        }

        // Watchdog tự động khôi phục Camera xe nếu bị Free Fire reset về camera nhân vật (khi tắt màn hình/vào lại)
        CameraWatchdogTimer += dt
        if CameraWatchdogTimer >= 2.0 {
            CameraWatchdogTimer = 0.0
            if MyClientCam != nil && HasSwitchedStartCamera {
                camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0)
            }
        }

        if UnlockRequestTimer > 0.0 {
            UnlockRequestTimer -= dt
            if UnlockRequestTimer <= 0.0 {
                UnlockRequestTimer = 0.0
                var rmgrEnt = globalEntity
                if rmgrEnt != nil {
                    std.DispatchEventToEntity(RequestRaceState, rmgrEnt, PlatformType.Server, List<entity<Player>>{thisEntity as entity<Player>})
                }
            }
        }

        // Đếm ngược kết thúc trận đấu khi người đầu tiên về đích
        if FirstFinishTimeoutActive {
            if FirstFinishTimer > 0.0 {
                FirstFinishTimer -= dt
                if FirstFinishTimer < 0.0 { FirstFinishTimer = 0.0 }
            } else if FirstFinishWaitTimer > 0.0 {
                FirstFinishWaitTimer -= dt
                if FirstFinishWaitTimer < 0.0 { FirstFinishWaitTimer = 0.0 }
            }
        }

        // Hiệu ứng ẩn và chớp tắt luân phiên khi Reset/Hồi sinh
        if RespawnBlinkTimer > 0.0 {
            RespawnBlinkTimer -= dt
            if RespawnInitialHideTimer > 0.0 {
                RespawnInitialHideTimer -= dt
                if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, false) }
            } else {
                RespawnBlinkInterval -= dt
                if RespawnBlinkInterval <= 0.0 {
                    RespawnBlinkInterval = 0.10
                    RespawnBlinkVisible = !RespawnBlinkVisible
                    if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, RespawnBlinkVisible) }
                }
            }
            if RespawnBlinkTimer <= 0.0 {
                RespawnBlinkTimer = 0.0
                RespawnBlinkVisible = true
                if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, true) }
            }
        }

        if SpawnDropTimer > 0.0 {
            SpawnDropTimer -= dt
            if KartModel != nil {
                // Áp dụng trọng lực thật để xe rơi tự do tiếp đất tự nhiên trước khi đếm 3 2 1
                KartPhysics.ApplyAirGravity(KartModel as entity<Rigidbody>, Gravity, ExtraAirGravity)
                var curPos = KartModel<Transform>.Position
                physics.SingleRaycast(curPos, Vector3{0.0, -1.0, 0.0}, 2.5, nil, false,
                    out var gEnt, out var gPos, out var gDist, out var gNorm)
                var hasLanded = false
                if KartGroundProbe.IsValidHit(gEnt, KartModel as entity<Rigidbody>) && gDist <= 0.83 {
                    hasLanded = true
                }
                if hasLanded || SpawnDropTimer <= 0.0 {
                    SpawnDropTimer = 0.0
                    if hasLanded {
                        KartModel<Transform>.Position = Vector3{curPos.X, gPos.Y + 0.80, curPos.Z}
                    }
                    KartModel<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}
                    KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
                    KartModel<Rigidbody>.Constrain = 127 as RigidbodyConstrainType
                    physics.Sleep(KartModel as entity<Rigidbody>)
                    if !IsIntroCamActive {
                        SnapCameraToKartNow()
                    }
                }
            }
        }

        if IsRaceStarted && IsExternallyLocked && !IsLocalResetting && !CpIsRaceFinished {
            IsExternallyLocked = false
            if KartModel != nil {
                KartModel<Rigidbody>.Constrain = 0 as RigidbodyConstrainType
                physics.Wakeup(KartModel as entity<Rigidbody>)
            }
        }

        var isDroppingAtSpawn = SpawnDropTimer > 0.0
        var isMovementLocked = IsExternallyLocked || IsLocalResetting || (CpIsRaceFinished && !IsAiAutopilot)
        if isMovementLocked {
            DriveForwardSpeed = 0.0
            LastClientFwdSpd = 0.0
            CurrentSpeedKmh = 0.0
            UISpeedKmh = 0.0
            if isDroppingAtSpawn {
                if KartModel != nil {
                    KartModel<Rigidbody>.Constrain = 112 as RigidbodyConstrainType
                    physics.Wakeup(KartModel as entity<Rigidbody>)
                }
            } else {
                KartPhysics.StopMovementForLock(KartModel as entity<Rigidbody>)
                if KartModel != nil && !IsLocalResetting {
                    KartModel<Rigidbody>.Constrain = 127 as RigidbodyConstrainType
                    physics.Sleep(KartModel as entity<Rigidbody>)
                }
            }
        }

        var localFwdSpeed = 0.0
        var isDrift = false
        var isDriftActive = false
        var turnInput = 0.0
        var isDriftTurningRaw = false
        var isDriftTurning = false

        if !isMovementLocked {

            // -------------------------------------------------
            // UPDATE BLOCK: VISUAL WHEEL ANIMATION PRE-PHYSICS
            // Future target: Kart/KartVisual.fcg
            // Timing notes:
            // - Runs before physics so wheels respond immediately to current input/speed state.
            // - Uses CurrentSpeedKmh from previous frame; do not move after speedometer update without testing feel.
            // -------------------------------------------------
            if StuntCooldown > 0.0 {
                StuntCooldown -= dt
            }

            if !WheelNodesInited { InitWheelSystem() }

            var isCoastingAfterFinish = IsAiAutopilot && (PostFinishCoastTimer > 0.0)
            if isCoastingAfterFinish {
                PostFinishCoastTimer -= dt
                UpdateAiAutopilot(dt)
            }

            if IsAiAutopilot && !isCoastingAfterFinish && ReplayTotalFrames >= 10 {
                // TÁI HIỆN VÒNG ĐUA GHOST REPLAY (Có 1.5s lerp mượt mà từ vị trí trôi vào quỹ đạo replay)
                UpdateReplayPlayback(dt)
                isDrift = GetReplayDrift(ReplayPlayFrame)
                isDriftActive = isDrift
                isDriftTurningRaw = isDrift
                isDriftTurning = isDrift
                turnInput = CurrentSteerAngle / 30.0
            } else {
                if IsAiAutopilot && !isCoastingAfterFinish {
                    UpdateAiAutopilot(dt)
                } else if IsRaceStarted && !CpIsRaceFinished {
                    RecordReplayFrame(dt)
                }

                var animTurnInput = KartMath.CalcTurnInput(IsTurningLeft, IsTurningRight)
            var visualSpeed = KartMath.DisplaySpeedToPhysSpeed(CurrentSpeedKmh, SpeedUnitScale)
            var rollDir = KartVisualMath.CalcRollDirection(IsReversing)
            var rollSpeedMultiplier = 150.0
            CurrentRollAngle = KartVisualMath.CalcWheelRollAngleNext(CurrentRollAngle, visualSpeed, rollDir, dt, rollSpeedMultiplier)

            var targetSteer = KartSteeringMath.CalcVisualSteerTarget(animTurnInput)
            var steerLerpT = KartSteeringMath.CalcVisualSteerLerpT(dt)
            CurrentSteerAngle = KartSteeringMath.LerpVisualSteerAngle(CurrentSteerAngle, targetSteer, steerLerpT)

            KartVisual.ApplySteeringWheelVisuals(SteeringNodes, InitSteerRot, CurrentSteerAngle)
            KartVisual.ApplyWheelRollVisuals(WheelNodes, InitWheelRot, CurrentRollAngle)

            // -------------------------------------------------
            // UPDATE BLOCK: VELOCITY READBACK / SPEED ESTIMATION
            // Future target: Kart/KartPhysics.fcg
            // Timing notes:
            // - Reads Rigidbody velocity before raycasts and before modifying DriveForwardSpeed.
            // - clientFwdSpd is used by speedometer and crash response.
            // -------------------------------------------------
            // OLD PHYSICS LOGIC (Velocity-based)
            // -----------------------------------------------------------
            var vel = KartModel<Rigidbody>.Velocity
            var telemetryInputVel = vel

            // DEBUG Point 1: Log true physics velocity
            var dbgVelMag = math.Sqrt(vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z) as float
            var dbgTrueKmh = KartMath.PhysSpeedToDisplaySpeed(dbgVelMag, SpeedUnitScale)
            if dbgTrueKmh > 400.0 {
                // LogInfo("[VELOCITY] TRUE: " + dbgTrueKmh + " km/h")
            }

            vel = KartPhysics.ClampTerminalVelocity(KartModel as entity<Rigidbody>, vel, -50.0)
            vel = KartPhysics.ClampGroundBounceVelocity(KartModel as entity<Rigidbody>, vel, LastContactNy, 0.6)

            var fwdVecFlat = math.RotateVector(Vector3{0.0, 0.0, 1.0}, PhysicsQuat)
            var rgtVecFlat = math.RotateVector(Vector3{1.0, 0.0, 0.0}, PhysicsQuat)
            var fwdX = fwdVecFlat.X; var fwdZ = fwdVecFlat.Z
            var rgtX = rgtVecFlat.X; var rgtZ = rgtVecFlat.Z

            localFwdSpeed = vel.X * fwdVecFlat.X + vel.Y * fwdVecFlat.Y + vel.Z * fwdVecFlat.Z

            ShakeTime += dt 
            var clientFwdSpd = localFwdSpeed

            // -------------------------------------------------
            // UPDATE BLOCK: GROUNDING / WALL PROBES / SURFACE NORMALS
            // Future target: Kart/KartGrounding.fcg
            // Timing notes:
            // - Must run before Drift, Nitro, Physics force, Visual mesh, and Camera.
            // - Publishes Frame_IsStrictlyGrounded, Frame_RaycastHit, Frame_IsCrashing, surface normal, suspension force.
            // Risk notes:
            // - This is high-risk to extract because anti-gravity, drift validity, camera landing, and downforce depend on it.
            // -------------------------------------------------
            var pos    = KartModel<Transform>.Position
            var rayY      = pos.Y - 0.12
            var rayDist   = 1.3

            physics.SingleRaycast(Vector3{pos.X + fwdX * 0.5 - rgtX * 0.4, rayY, pos.Z + fwdZ * 0.5 - rgtZ * 0.4}, Vector3{-LastContactNx, -LastContactNy, -LastContactNz}, rayDist, nil, false,
                out var flEnt, out var flPos, out var flDist, out var flNorm)
            physics.SingleRaycast(Vector3{pos.X + fwdX * 0.5 + rgtX * 0.4, rayY, pos.Z + fwdZ * 0.5 + rgtZ * 0.4}, Vector3{-LastContactNx, -LastContactNy, -LastContactNz}, rayDist, nil, false,
                out var frEnt, out var frPos, out var frDist, out var frNorm)
            physics.SingleRaycast(Vector3{pos.X - fwdX * 0.4 - rgtX * 0.4, rayY, pos.Z - fwdZ * 0.4 - rgtZ * 0.4}, Vector3{-LastContactNx, -LastContactNy, -LastContactNz}, rayDist, nil, false,
                out var blEnt, out var blPos, out var blDist, out var blNorm)
            physics.SingleRaycast(Vector3{pos.X - fwdX * 0.4 + rgtX * 0.4, rayY, pos.Z - fwdZ * 0.4 + rgtZ * 0.4}, Vector3{-LastContactNx, -LastContactNy, -LastContactNz}, rayDist, nil, false,
                out var brEnt, out var brPos, out var brDist, out var brNorm)

            // --- RAYCAST CẠ TƯỜNG (2 BÁNH TRƯỚC BẮN SANG 2 BÊN) ---
            // Đặt gốc chiếu tại 2 bánh trước (cao độ ngang trục bánh xe pos.Y - 0.15)
            var flWheelOrigin = Vector3{pos.X + fwdX * 0.65 - rgtX * 0.45, pos.Y - 0.15, pos.Z + fwdZ * 0.65 - rgtZ * 0.45}
            var frWheelOrigin = Vector3{pos.X + fwdX * 0.65 + rgtX * 0.45, pos.Y - 0.15, pos.Z + fwdZ * 0.65 + rgtZ * 0.45}

            // BÊN TRÁI: Quét cả vuông góc ngang (-rgt) lẫn chéo trước-trái (30°) để bắt tường khi lao xiên
            physics.SingleRaycast(flWheelOrigin, Vector3{-rgtX, 0.0, -rgtZ}, WheelScrapeRayDist, nil, false,
                out var scrpLftEnt, out var scrpLftPos, out var scrpLftDist, out var scrpLftNorm)
            var isLftSideHit = KartGroundProbe.IsValidHit(scrpLftEnt, KartModel as entity<Rigidbody>) && scrpLftDist > 0.01 && scrpLftNorm.Y < 0.80

            physics.SingleRaycast(flWheelOrigin, Vector3{-rgtX * 0.866 + fwdX * 0.5, 0.0, -rgtZ * 0.866 + fwdZ * 0.5}, WheelScrapeRayDist, nil, false,
                out var scrpLftDiagEnt, out var scrpLftDiagPos, out var scrpLftDiagDist, out var scrpLftDiagNorm)
            var isLftDiagHit = KartGroundProbe.IsValidHit(scrpLftDiagEnt, KartModel as entity<Rigidbody>) && scrpLftDiagDist > 0.01 && scrpLftDiagNorm.Y < 0.80

            // Giới hạn góc cạ tường bên trái: nhận diện cạ lướt và đâm chéo (từ góc rất nông tới 75°)
            if isLftSideHit {
                var lftSideInto = -(fwdX * scrpLftNorm.X + fwdZ * scrpLftNorm.Z)
                var lftSideFace = rgtX * scrpLftNorm.X + rgtZ * scrpLftNorm.Z
                if lftSideInto > 0.965 || lftSideFace <= 0.02 { isLftSideHit = false }
            }
            if isLftDiagHit {
                var lftDiagInto = -(fwdX * scrpLftDiagNorm.X + fwdZ * scrpLftDiagNorm.Z)
                var lftDiagFace = rgtX * scrpLftDiagNorm.X + rgtZ * scrpLftDiagNorm.Z
                if lftDiagInto > 0.965 || lftDiagFace <= 0.02 { isLftDiagHit = false }
            }

            var isScrpLft = isLftSideHit || isLftDiagHit

            // BÊN PHẢI: Quét cả vuông góc ngang (rgt) lẫn chéo trước-phải (30°) để bắt tường khi lao xiên
            physics.SingleRaycast(frWheelOrigin, Vector3{rgtX, 0.0, rgtZ}, WheelScrapeRayDist, nil, false,
                out var scrpRgtEnt, out var scrpRgtPos, out var scrpRgtDist, out var scrpRgtNorm)
            var isRgtSideHit = KartGroundProbe.IsValidHit(scrpRgtEnt, KartModel as entity<Rigidbody>) && scrpRgtDist > 0.01 && scrpRgtNorm.Y < 0.80

            physics.SingleRaycast(frWheelOrigin, Vector3{rgtX * 0.866 + fwdX * 0.5, 0.0, rgtZ * 0.866 + fwdZ * 0.5}, WheelScrapeRayDist, nil, false,
                out var scrpRgtDiagEnt, out var scrpRgtDiagPos, out var scrpRgtDiagDist, out var scrpRgtDiagNorm)
            var isRgtDiagHit = KartGroundProbe.IsValidHit(scrpRgtDiagEnt, KartModel as entity<Rigidbody>) && scrpRgtDiagDist > 0.01 && scrpRgtDiagNorm.Y < 0.80

            // Giới hạn góc cạ tường bên phải: nhận diện cạ lướt và đâm chéo (từ góc rất nông tới 75°)
            if isRgtSideHit {
                var rgtSideInto = -(fwdX * scrpRgtNorm.X + fwdZ * scrpRgtNorm.Z)
                var rgtSideFace = rgtX * scrpRgtNorm.X + rgtZ * scrpRgtNorm.Z
                if rgtSideInto > 0.965 || rgtSideFace >= -0.02 { isRgtSideHit = false }
            }
            if isRgtDiagHit {
                var rgtDiagInto = -(fwdX * scrpRgtDiagNorm.X + fwdZ * scrpRgtDiagNorm.Z)
                var rgtDiagFace = rgtX * scrpRgtDiagNorm.X + rgtZ * scrpRgtDiagNorm.Z
                if rgtDiagInto > 0.965 || rgtDiagFace >= -0.02 { isRgtDiagHit = false }
            }

            var isScrpRgt = isRgtSideHit || isRgtDiagHit

            // Tuyệt đối không bật tia lửa cả 2 bên cùng lúc khi đâm thẳng vào tường
            if isScrpLft && isScrpRgt {
                if scrpLftDist < scrpRgtDist - 0.08 {
                    isScrpRgt = false
                } else if scrpRgtDist < scrpLftDist - 0.08 {
                    isScrpLft = false
                } else {
                    isScrpLft = false
                    isScrpRgt = false
                }
            }

            IsScrapingLeft = isScrpLft
            IsScrapingRight = isScrpRgt
            IsScrapingWall = isScrpLft || isScrpRgt
            if IsScrapingWall && vel.Y > 0.0 {
                vel.Y = 0.0
                if KartModel != nil { KartModel<Rigidbody>.Velocity = vel }
            }

            if isScrpLft {
                if isLftSideHit && isLftDiagHit {
                    if scrpLftDist <= scrpLftDiagDist {
                        ScrapeHitPos = scrpLftPos; ScrapeHitNorm = scrpLftNorm; ScrapeDist = scrpLftDist
                    } else {
                        ScrapeHitPos = scrpLftDiagPos; ScrapeHitNorm = scrpLftDiagNorm; ScrapeDist = scrpLftDiagDist
                    }
                } else if isLftSideHit {
                    ScrapeHitPos = scrpLftPos; ScrapeHitNorm = scrpLftNorm; ScrapeDist = scrpLftDist
                } else {
                    ScrapeHitPos = scrpLftDiagPos; ScrapeHitNorm = scrpLftDiagNorm; ScrapeDist = scrpLftDiagDist
                }
            } else if isScrpRgt {
                if isRgtSideHit && isRgtDiagHit {
                    if scrpRgtDist <= scrpRgtDiagDist {
                        ScrapeHitPos = scrpRgtPos; ScrapeHitNorm = scrpRgtNorm; ScrapeDist = scrpRgtDist
                    } else {
                        ScrapeHitPos = scrpRgtDiagPos; ScrapeHitNorm = scrpRgtDiagNorm; ScrapeDist = scrpRgtDiagDist
                    }
                } else if isRgtSideHit {
                    ScrapeHitPos = scrpRgtPos; ScrapeHitNorm = scrpRgtNorm; ScrapeDist = scrpRgtDist
                } else {
                    ScrapeHitPos = scrpRgtDiagPos; ScrapeHitNorm = scrpRgtDiagNorm; ScrapeDist = scrpRgtDiagDist
                }
            } else {
                ScrapeDist = 0.0
            }

            if ScrapeLogTimer > 0.0 {
                ScrapeLogTimer -= dt
            }
            if WallDeflectLogTimer > 0.0 {
                WallDeflectLogTimer -= dt
            }
            if IsScrapingWall && ScrapeLogTimer <= 0.0 {
                ScrapeLogTimer = 0.3
                if IsScrapingLeft {
                    LogInfo("[RacingMovement] ⚡ CẠ TƯỜNG TRÁI! Dist: " + convert.ToString(ScrapeDist))
                } else if IsScrapingRight {
                    LogInfo("[RacingMovement] ⚡ CẠ TƯỜNG PHẢI! Dist: " + convert.ToString(ScrapeDist))
                }
            }
            // --------------------------------------------------------

            // Calculate lateral speed for side probe distance
            var curLat = vel.X * rgtVecFlat.X + vel.Y * rgtVecFlat.Y + vel.Z * rgtVecFlat.Z
            var lateralSpeedMag = math.Abs(curLat) as float
            var ccdSideDist = lateralSpeedMag * dt * CcdSafetyMultiplier
            if ccdSideDist < 0.85 { ccdSideDist = 0.85 }

            var upProbeDist = 0.85

            physics.SingleRaycast(Vector3{pos.X, pos.Y, pos.Z}, Vector3{rgtX, 0.0, rgtZ}, ccdSideDist, nil, false, out var rightEnt, out var rightPos, out var rightDist, out var rightNorm)
            var rightHit = KartGroundProbe.IsValidHit(rightEnt, KartModel as entity<Rigidbody>)

            physics.SingleRaycast(Vector3{pos.X, pos.Y, pos.Z}, Vector3{-rgtX, 0.0, -rgtZ}, ccdSideDist, nil, false, out var leftEnt, out var leftPos, out var leftDist, out var leftNorm)
            var leftHit = KartGroundProbe.IsValidHit(leftEnt, KartModel as entity<Rigidbody>)

            physics.SingleRaycast(Vector3{pos.X, pos.Y, pos.Z}, Vector3{0.0, 1.0, 0.0}, upProbeDist, nil, false, out var upEnt, out var upPos, out var upDist, out var upNorm)
            var upHit = KartGroundProbe.IsValidHit(upEnt, KartModel as entity<Rigidbody>)

            var ccdProbeDist = KartCCD.CalcCcdProbeDist(vel.X, vel.Y, vel.Z, dt, 2.5, CcdSafetyMultiplier)

            physics.SingleRaycast(Vector3{pos.X, pos.Y, pos.Z}, Vector3{fwdVecFlat.X, fwdVecFlat.Y, fwdVecFlat.Z}, ccdProbeDist, nil, false, out var fwdEnt, out var fwdPos, out var fwdDist, out var fwdNorm)
            var fwdHit = KartGroundProbe.IsValidHit(fwdEnt, KartModel as entity<Rigidbody>)

            var hFwdX = fwdX; var hFwdZ = fwdZ   
            var hFwdLen = KartGroundProbe.CalcHorizontalForwardLength(hFwdX, hFwdZ)
            hFwdX /= hFwdLen; hFwdZ /= hFwdLen
            physics.SingleRaycast(Vector3{pos.X, pos.Y, pos.Z}, Vector3{hFwdX, 0.0, hFwdZ}, ccdProbeDist, nil, false, out var hFwdEnt, out var hFwdPos, out var hFwdDist, out var hFwdNorm)
            var hFwdHit = KartGroundProbe.IsValidHit(hFwdEnt, KartModel as entity<Rigidbody>)

            // Continuous collision detection sweep: raycast along actual frame displacement, not only car forward.
            // This catches side-slides and wall scrapes where forward speed can be near zero.
            var sweepMoveSqr = KartCCD.CalcMovementSqrMagnitude(PrevCcdPosition, pos)
            var sweepMoveMag = KartCCD.CalcMovementMagnitude(sweepMoveSqr)
            var sweepDir = KartCCD.CalcSweepDirection(PrevCcdPosition, pos, sweepMoveMag)
            var shouldSweepCcd = KartCCD.ShouldSweepByMovement(sweepMoveSqr, CcdMinExtent)
            physics.SingleRaycast(PrevCcdPosition, sweepDir, sweepMoveMag, nil, false, out var sweepEnt, out var sweepPos, out var sweepDist, out var sweepNorm)
            var sweepHit = shouldSweepCcd && KartGroundProbe.IsValidHit(sweepEnt, KartModel as entity<Rigidbody>)

            var flHit = KartGroundProbe.IsValidHit(flEnt, KartModel as entity<Rigidbody>)
            var frHit = KartGroundProbe.IsValidHit(frEnt, KartModel as entity<Rigidbody>)
            var blHit = KartGroundProbe.IsValidHit(blEnt, KartModel as entity<Rigidbody>)
            var brHit = KartGroundProbe.IsValidHit(brEnt, KartModel as entity<Rigidbody>)
            var hitCount = KartGroundingMath.CountWheelHits(flHit, frHit, blHit, brHit)

            var isStrictlyGrounded = hitCount > 0.0 
            // [DISABLED] Flat spin / drift-spin-in-air feature — tạm tắt
            // if PrevIsGrounded && !isStrictlyGrounded {
            //     var currentKmh = math.Abs(clientFwdSpd) * 36.0
            //     if currentKmh > 50.0 && IsBraking && !IsFlatSpinning && StuntCooldown <= 0.0 {
            //         IsFlatSpinning = true
            //         SpinDir = 1.0
            //         if IsTurningLeft { SpinDir = -1.0 } else if IsTurningRight { SpinDir = 1.0 }
            //     }
            // }

            if isStrictlyGrounded && !PrevIsGrounded {
                if IsFlatSpinning {
                    IsFlatSpinning = false
                    StuntCooldown = 0.5 
                    if AirTime > 0.15 {
                        LandingSlidePwr = 15.0 * SpinDir 
                    }
                }
                if AirTime > 0.15 {
                    var impactForce = AirTime * 1.0
                    if impactForce > 1.0 { impactForce = 1.0 }
                    TargetDropOffset = -impactForce
                    ImpactTimer = 0.4
                    TriggerLandingCameraShake(impactForce)
                }
                // ── LANDING RECOVERY: trigger when coming down from a real stunt ──
                // Condition: was airborne long enough + had a stunt rolling
                if AirTime >= LandingAirThreshold && (math.Abs(StuntCamRoll) > 1.0 || math.Abs(FlatSpinVisualAngle) > 5.0) {
                    LandingRecoverTimer = LandingRecoverDuration
                    // Capture yaw-only anchor: strip the spin pitch/roll from CamQuat
                    // We read current StableVisualQuat yaw and build a clean flat quat
                    var anchorEuler = math.QuaternionToEulerAngle(StableVisualQuat)
                    StableGroundCamQuat = math.EulerAngleToQuaternion(Vector3{0.0, anchorEuler.Y, 0.0})
                }
                // ─────────────────────────────────────────────────────────────────
            }
            PrevIsGrounded = isStrictlyGrounded

            // ===========================================================
            // GOAL #2: WEIGHTED GROUND NORMAL BLENDING
            // Replace "best probe override" with weighted accumulation:
            // - wheel hits dominate
            // - side/up probes add small influence, distance-weighted
            // - wall-like normals (low Y) are ignored/reduced
            // ===========================================================
            var nx = 0.0; var ny = 0.0; var nz = 0.0
            var wSum = 0.0

            // NOTE: This scripting language does not allow nested func definitions.
            // Weighted accumulation is delegated to KartGroundProbe while preserving call order.
            nx = KartGroundProbe.CalcWheelNormalAccum(nx, flHit, flNorm.X, 1.00)
            ny = KartGroundProbe.CalcWheelNormalAccum(ny, flHit, flNorm.Y, 1.00)
            nz = KartGroundProbe.CalcWheelNormalAccum(nz, flHit, flNorm.Z, 1.00)
            wSum = KartGroundProbe.CalcWheelWeightAccum(wSum, flHit, 1.00)

            nx = KartGroundProbe.CalcWheelNormalAccum(nx, frHit, frNorm.X, 1.00)
            ny = KartGroundProbe.CalcWheelNormalAccum(ny, frHit, frNorm.Y, 1.00)
            nz = KartGroundProbe.CalcWheelNormalAccum(nz, frHit, frNorm.Z, 1.00)
            wSum = KartGroundProbe.CalcWheelWeightAccum(wSum, frHit, 1.00)

            nx = KartGroundProbe.CalcWheelNormalAccum(nx, blHit, blNorm.X, 0.90)
            ny = KartGroundProbe.CalcWheelNormalAccum(ny, blHit, blNorm.Y, 0.90)
            nz = KartGroundProbe.CalcWheelNormalAccum(nz, blHit, blNorm.Z, 0.90)
            wSum = KartGroundProbe.CalcWheelWeightAccum(wSum, blHit, 0.90)

            nx = KartGroundProbe.CalcWheelNormalAccum(nx, brHit, brNorm.X, 0.90)
            ny = KartGroundProbe.CalcWheelNormalAccum(ny, brHit, brNorm.Y, 0.90)
            nz = KartGroundProbe.CalcWheelNormalAccum(nz, brHit, brNorm.Z, 0.90)
            wSum = KartGroundProbe.CalcWheelWeightAccum(wSum, brHit, 0.90)

            var wallThreshold = 0.7
            var probeGroundThreshold = 0.35
            var softWallThreshold = 0.18

            if hitCount < 2.0 {
                nx = KartGroundProbe.CalcProbeNormalAccum(nx, rightHit, rightDist, wallThreshold, rightNorm.X, rightNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
                ny = KartGroundProbe.CalcProbeNormalAccum(ny, rightHit, rightDist, wallThreshold, rightNorm.Y, rightNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
                nz = KartGroundProbe.CalcProbeNormalAccum(nz, rightHit, rightDist, wallThreshold, rightNorm.Z, rightNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
                wSum = KartGroundProbe.CalcProbeWeightAccum(wSum, rightHit, rightDist, wallThreshold, rightNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)

                nx = KartGroundProbe.CalcProbeNormalAccum(nx, leftHit, leftDist, wallThreshold, leftNorm.X, leftNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
                ny = KartGroundProbe.CalcProbeNormalAccum(ny, leftHit, leftDist, wallThreshold, leftNorm.Y, leftNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
                nz = KartGroundProbe.CalcProbeNormalAccum(nz, leftHit, leftDist, wallThreshold, leftNorm.Z, leftNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
                wSum = KartGroundProbe.CalcProbeWeightAccum(wSum, leftHit, leftDist, wallThreshold, leftNorm.Y, 0.35, softWallThreshold, probeGroundThreshold, 0.15)
            }

            nx = KartGroundProbe.CalcProbeNormalAccum(nx, upHit, upDist, wallThreshold, upNorm.X, upNorm.Y, 0.25, softWallThreshold, probeGroundThreshold, 0.10)
            ny = KartGroundProbe.CalcProbeNormalAccum(ny, upHit, upDist, wallThreshold, upNorm.Y, upNorm.Y, 0.25, softWallThreshold, probeGroundThreshold, 0.10)
            nz = KartGroundProbe.CalcProbeNormalAccum(nz, upHit, upDist, wallThreshold, upNorm.Z, upNorm.Y, 0.25, softWallThreshold, probeGroundThreshold, 0.10)
            wSum = KartGroundProbe.CalcProbeWeightAccum(wSum, upHit, upDist, wallThreshold, upNorm.Y, 0.25, softWallThreshold, probeGroundThreshold, 0.10)

            SurfaceTransitionTimer = KartGroundProbe.CalcSurfaceTransitionTimerNext(SurfaceTransitionTimer, dt, hitCount)
            if hitCount < 2.0 && SurfaceTransitionTimer > 0.08 {
                var fwdProbeW = 0.22
                if fwdHit && fwdDist < 2.5 {
                    nx = KartGroundProbe.CalcProbeNormalAccum(nx, fwdHit, fwdDist, 2.5, fwdNorm.X, fwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                    ny = KartGroundProbe.CalcProbeNormalAccum(ny, fwdHit, fwdDist, 2.5, fwdNorm.Y, fwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                    nz = KartGroundProbe.CalcProbeNormalAccum(nz, fwdHit, fwdDist, 2.5, fwdNorm.Z, fwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                    wSum = KartGroundProbe.CalcProbeWeightAccum(wSum, fwdHit, fwdDist, 2.5, fwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                } else if hFwdHit && hFwdDist < 2.5 {
                    nx = KartGroundProbe.CalcProbeNormalAccum(nx, hFwdHit, hFwdDist, 2.5, hFwdNorm.X, hFwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                    ny = KartGroundProbe.CalcProbeNormalAccum(ny, hFwdHit, hFwdDist, 2.5, hFwdNorm.Y, hFwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                    nz = KartGroundProbe.CalcProbeNormalAccum(nz, hFwdHit, hFwdDist, 2.5, hFwdNorm.Z, hFwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                    wSum = KartGroundProbe.CalcProbeWeightAccum(wSum, hFwdHit, hFwdDist, 2.5, hFwdNorm.Y, fwdProbeW, softWallThreshold, probeGroundThreshold, 0.10)
                }
            }

            nx = KartGroundProbe.CalcNormalizedAccumValue(nx, wSum, 0.0)
            ny = KartGroundProbe.CalcNormalizedAccumValue(ny, wSum, 1.0)
            nz = KartGroundProbe.CalcNormalizedAccumValue(nz, wSum, 0.0)

            var normalizedNormal = KartGroundProbe.NormalizeNormal(nx, ny, nz)
            nx = normalizedNormal.X; ny = normalizedNormal.Y; nz = normalizedNormal.Z

            var sideHit = KartGroundProbe.IsSideHit(rightHit, leftHit, upHit, fwdHit, hFwdHit, hitCount)
            var raycastHit = hitCount > 0.0 || sideHit
            IsStableGrounded = KartGroundingMath.CalcStableGrounded(hitCount, raycastHit, vel.Y)

            var targetNormal = KartGroundProbe.CalcTargetNormal(hitCount, nx, ny, nz)

            LastValidNormal = KartGroundProbe.BlendNormal(LastValidNormal, targetNormal, dt)

            nx = LastValidNormal.X; ny = LastValidNormal.Y; nz = LastValidNormal.Z
            LastContactNx = nx; LastContactNy = ny; LastContactNz = nz

            // ===========================================================
            // GOAL #5: LIGHTWEIGHT ARCADE SUSPENSION (per-wheel compression)
            // Uses existing 4 corner raycasts (fl/fr/bl/br) and applies a
            // small spring + damping along the blended surface normal.
            // Keeps the controller arcade (no heavy sim / no body roll).
            // ===========================================================
            SuspFL = 0.0; SuspFR = 0.0; SuspBL = 0.0; SuspBR = 0.0
            var suspSum = 0.0
            var suspWSum = 0.0

            // NOTE: No nested funcs allowed; compute per-wheel inline.
            SuspFL = KartGroundingMath.CalcSuspensionCompression(flHit, flNorm.Y, SuspHitMinNy, SuspRestLength, flDist)
            if SuspFL > 0.0 {
                suspSum += SuspFL * 1.00
                suspWSum += 1.00
            }
            SuspFR = KartGroundingMath.CalcSuspensionCompression(frHit, frNorm.Y, SuspHitMinNy, SuspRestLength, frDist)
            if SuspFR > 0.0 {
                suspSum += SuspFR * 1.00
                suspWSum += 1.00
            }
            SuspBL = KartGroundingMath.CalcSuspensionCompression(blHit, blNorm.Y, SuspHitMinNy, SuspRestLength, blDist)
            if SuspBL > 0.0 {
                suspSum += SuspBL * 0.92
                suspWSum += 0.92
            }
            SuspBR = KartGroundingMath.CalcSuspensionCompression(brHit, brNorm.Y, SuspHitMinNy, SuspRestLength, brDist)
            if SuspBR > 0.0 {
                suspSum += SuspBR * 0.92
                suspWSum += 0.92
            }

            var suspAvg = 0.0
            if suspWSum > 0.0001 { suspAvg = suspSum / suspWSum }

            // Damping uses velocity along surface normal (reduces bounce on landings/curbs).
            var vN = vel.X * nx + vel.Y * ny + vel.Z * nz
            var suspForce = KartGroundingMath.CalcSuspensionForce(suspAvg, vN, SuspSpring, SuspDamping, SuspMaxForce)

            var crashPenaltyThreshold = 0.8 
            var wallDot = 0.0
            var isCrashing = false

            var frontCrashHit = false
            var sideScrapeHit = false
            var frontWallDot = 0.0
            var crashNormX = 0.0
            var crashNormZ = 0.0
            var scrapeAccelMult = 1.0
            var scrapeAngleDeg = 0.0

            var frontHitDistLimit = 1.05
            var speedAhead = (CurrentSpeedKmh / 36.0) * dt * 1.8
            if speedAhead > 0.0 { frontHitDistLimit += speedAhead }
            if frontHitDistLimit > 2.5 { frontHitDistLimit = 2.5 }
            if frontHitDistLimit < 1.05 { frontHitDistLimit = 1.05 }

            if hFwdHit && hFwdDist < frontHitDistLimit {
                frontWallDot = hFwdX * hFwdNorm.X + hFwdZ * hFwdNorm.Z
                crashNormX = hFwdNorm.X
                crashNormZ = hFwdNorm.Z
                if frontWallDot < -0.94 {
                    frontCrashHit = true
                } else if frontWallDot < -0.02 {
                    sideScrapeHit = true
                    IsScrapingWall = true
                    ScrapeHitNorm = Vector3{crashNormX, 0.0, crashNormZ}
                    var sideSign = rgtVecFlat.X * crashNormX + rgtVecFlat.Z * crashNormZ
                    if sideSign > 0.0 { IsScrapingLeft = true; IsScrapingRight = false } else { IsScrapingRight = true; IsScrapingLeft = false }
                }
            } else if fwdHit && fwdDist < frontHitDistLimit {
                frontWallDot = fwdVecFlat.X * fwdNorm.X + fwdVecFlat.Z * fwdNorm.Z
                crashNormX = fwdNorm.X
                crashNormZ = fwdNorm.Z
                if frontWallDot < -0.94 {
                    frontCrashHit = true
                } else if frontWallDot < -0.02 {
                    sideScrapeHit = true
                    IsScrapingWall = true
                    ScrapeHitNorm = Vector3{crashNormX, 0.0, crashNormZ}
                    var sideSign = rgtVecFlat.X * crashNormX + rgtVecFlat.Z * crashNormZ
                    if sideSign > 0.0 { IsScrapingLeft = true; IsScrapingRight = false } else { IsScrapingRight = true; IsScrapingLeft = false }
                }
            }

            if !frontCrashHit && ((rightHit && rightDist < 1.30) || (leftHit && leftDist < 1.30)) {
                var rgtValid = false
                if rightHit {
                    var rgtInto = -(fwdVecFlat.X * rightNorm.X + fwdVecFlat.Z * rightNorm.Z)
                    var rgtFace = rgtVecFlat.X * rightNorm.X + rgtVecFlat.Z * rightNorm.Z
                    if rgtInto <= 0.965 && rgtFace < -0.04 { rgtValid = true }
                }
                var lftValid = false
                if leftHit {
                    var lftInto = -(fwdVecFlat.X * leftNorm.X + fwdVecFlat.Z * leftNorm.Z)
                    var lftFace = rgtVecFlat.X * leftNorm.X + rgtVecFlat.Z * leftNorm.Z
                    if lftInto <= 0.965 && lftFace > 0.04 { lftValid = true }
                }

                if rgtValid && lftValid {
                    if rightDist < leftDist { lftValid = false } else { rgtValid = false }
                }

                if rgtValid {
                    sideScrapeHit = true
                    crashNormX = rightNorm.X
                    crashNormZ = rightNorm.Z
                    IsScrapingRight = true
                    IsScrapingLeft = false
                    IsScrapingWall = true
                } else if lftValid {
                    sideScrapeHit = true
                    crashNormX = leftNorm.X
                    crashNormZ = leftNorm.Z
                    IsScrapingLeft = true
                    IsScrapingRight = false
                    IsScrapingWall = true
                }
            }

            if frontCrashHit && !IsReversing {
                // ĐÂM TRỰC DIỆN HOẶC GÓC LỚN (> 23° vào tường)
                isCrashing = true
                wallDot = frontWallDot
                sideScrapeHit = false
                IsScrapingLeft = false
                IsScrapingRight = false
                IsScrapingWall = false
                SyncScrapeEffects()

                var vDotN = vel.X * crashNormX + vel.Z * crashNormZ
                if vDotN < 0.0 {
                    vel.X = vel.X - vDotN * crashNormX
                    vel.Z = vel.Z - vDotN * crashNormZ
                }
                if vel.Y > 0.0 { vel.Y = 0.0 }
                if KartModel != nil {
                    KartModel<Rigidbody>.Velocity = vel
                    KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
                }

                DriveForwardSpeed = KartPhysicsMath.LerpToSpeed(DriveForwardSpeed, 0.0, 10.0, dt)
                if math.Abs(DriveForwardSpeed) < 0.1 { DriveForwardSpeed = 0.0 }

                LastClientFwdSpd = DriveForwardSpeed
                clientFwdSpd = DriveForwardSpeed

                if IsBoosting {
                    IsBoosting = false
                    BoostBlend = 0.0
                    BoostPower = 0.0
                    NitroCamBlend = 0.0
                    NitroCamKickTimer = 0.0
                }
            } else if UseCustomWallScrapeResponse && sideScrapeHit && !IsReversing {
                // CẠ TƯỜNG: giữ collision response gốc, chỉ loại vận tốc đi vào tường.
                isCrashing = false

                if crashNormX != 0.0 || crashNormZ != 0.0 {
                    var vDotScrape = vel.X * crashNormX + vel.Z * crashNormZ
                    if vDotScrape < 0.0 {
                        vel.X = vel.X - vDotScrape * crashNormX
                        vel.Z = vel.Z - vDotScrape * crashNormZ
                    }
                }

                if vel.Y > 0.0 { vel.Y = 0.0 }
                if KartModel != nil { KartModel<Rigidbody>.Velocity = vel }
            }

            // --- CCD RECONCILIATION (Anti-Tunneling Layers 2 & 3) ---
            var ccdSpeedMag = math.Sqrt(vel.X * vel.X + vel.Y * vel.Y + vel.Z * vel.Z) as float
            var hitTriggeredCCD = false
            var ccdHitNormX = 0.0
            var ccdHitNormY = 0.0
            var ccdHitNormZ = 0.0
            var ccdHitPosX = 0.0
            var ccdHitPosY = 0.0
            var ccdHitPosZ = 0.0
            var ccdUseSweepSafePos = false

            // Speed-dependent wall detection (Issue 2 fix)
            var ccdSpeedKmh = KartMath.PhysSpeedToDisplaySpeed(ccdSpeedMag, SpeedUnitScale)
            var dynamicWallThreshold = CcdWallNormalYMax
            if ccdSpeedKmh > 200.0 {
                var speedFactor = (ccdSpeedKmh - 200.0) / 100.0
                if speedFactor > 1.0 { speedFactor = 1.0 }
                dynamicWallThreshold = math.Lerp(CcdWallNormalYMax, 0.65, speedFactor) as float
            }

            if UsePredictiveWallCcd && sweepHit && KartCCD.IsWallNormal(sweepNorm.Y, dynamicWallThreshold) {
                hitTriggeredCCD = true
                ccdUseSweepSafePos = true
                ccdHitNormX = sweepNorm.X
                ccdHitNormY = sweepNorm.Y
                ccdHitNormZ = sweepNorm.Z
                ccdHitPosX = sweepPos.X
                ccdHitPosY = sweepPos.Y
                ccdHitPosZ = sweepPos.Z
            } else if UsePredictiveWallCcd && hFwdHit && KartCCD.IsWallNormal(hFwdNorm.Y, dynamicWallThreshold) && KartCCD.ShouldReconcile(hFwdDist, ccdSpeedMag, dt, CcdTravelThreshold) {
                hitTriggeredCCD = true
                ccdHitNormX = hFwdNorm.X
                ccdHitNormY = hFwdNorm.Y
                ccdHitNormZ = hFwdNorm.Z
                ccdHitPosX = hFwdPos.X
                ccdHitPosY = hFwdPos.Y
                ccdHitPosZ = hFwdPos.Z
            } else if UsePredictiveWallCcd && fwdHit && KartCCD.IsWallNormal(fwdNorm.Y, dynamicWallThreshold) && KartCCD.ShouldReconcile(fwdDist, ccdSpeedMag, dt, CcdTravelThreshold) {
                hitTriggeredCCD = true
                ccdHitNormX = fwdNorm.X
                ccdHitNormY = fwdNorm.Y
                ccdHitNormZ = fwdNorm.Z
                ccdHitPosX = fwdPos.X
                ccdHitPosY = fwdPos.Y
                ccdHitPosZ = fwdPos.Z
            }
            

            if hitTriggeredCCD {
                var ccdDot = fwdVecFlat.X * ccdHitNormX + fwdVecFlat.Z * ccdHitNormZ
                var isHeadOnCrash = frontCrashHit || (ccdDot < -0.965)

                var backoffDist = 0.02
                if isHeadOnCrash { backoffDist = WallStopBackoff }
                var safePos = KartCCD.CalcSafePosition(ccdHitPosX, ccdHitPosY, ccdHitPosZ, ccdHitNormX, ccdHitNormY, ccdHitNormZ, CcdKartRadius + backoffDist)
                if ccdUseSweepSafePos {
                    if isHeadOnCrash {
                        var partialExtent = CcdMinExtent * (1.0 - CcdSkinWidth)
                        safePos = KartCCD.CalcSweepSafePosition(Vector3{ccdHitPosX, ccdHitPosY, ccdHitPosZ}, sweepDir, partialExtent)
                    } else {
                        safePos = KartCCD.CalcSweepSafePosition(Vector3{ccdHitPosX, ccdHitPosY, ccdHitPosZ}, sweepDir, CcdMinExtent * CcdSkinWidth)
                    }
                }
                // === XỬ LÝ VA CHẠM CCD: LOẠI BỎ VẬN TỐC LAO VÀO TƯỜNG ===
                var vDotN = vel.X * ccdHitNormX + vel.Y * ccdHitNormY + vel.Z * ccdHitNormZ
                var newVel = vel
                if vDotN < 0.0 {
                    // Triệt tiêu thành phần vận tốc đâm vào tường, giữ lại vận tốc trượt tiếp tuyến
                    newVel.X = vel.X - vDotN * ccdHitNormX
                    newVel.Y = vel.Y - vDotN * ccdHitNormY
                    newVel.Z = vel.Z - vDotN * ccdHitNormZ
                }

                if isHeadOnCrash {
                    // Đâm trực diện (> 50° vào tường): triệt tiêu vận tốc ngang và phạt tốc độ
                    newVel.X = 0.0
                    newVel.Z = 0.0
                    if ccdHitNormY <= dynamicWallThreshold {
                        if newVel.Y > WallUpVelocityClamp { newVel.Y = WallUpVelocityClamp }
                        clientFwdSpd = clientFwdSpd * WallStopForwardKeep
                        DriveForwardSpeed = DriveForwardSpeed * WallStopForwardKeep
                        LastClientFwdSpd = LastClientFwdSpd * WallStopForwardKeep
                        if IsBoosting { IsBoosting = false }
                        BoostBlend = 0.0
                    }
                    if ccdHitNormY <= dynamicWallThreshold {
                        if !PrevFrame_IsCrashing && CurrentSpeedKmh > 30.0 {
                            TriggerCrashCameraShake()
                        }
                        isCrashing = true
                        if wallDot >= 0.0 { wallDot = -1.0 }
                    }
                    clientFwdSpd = newVel.X * fwdVecFlat.X + newVel.Y * fwdVecFlat.Y + newVel.Z * fwdVecFlat.Z
                    LastClientFwdSpd = clientFwdSpd / (36.0 * SpeedUnitScale)
                    DriveForwardSpeed = clientFwdSpd / (36.0 * SpeedUnitScale)
                } else {
                    // Cạ tường (va chạm xiên / lướt tường): giữ lại vận tốc trượt newVel, KHÔNG phạt tốc độ
                    sideScrapeHit = true
                    isCrashing = false
                    if crashNormX == 0.0 && crashNormZ == 0.0 {
                        crashNormX = ccdHitNormX
                        crashNormZ = ccdHitNormZ
                    }
                    var ccdSideSign = rgtVecFlat.X * ccdHitNormX + rgtVecFlat.Z * ccdHitNormZ
                    if ccdSideSign > 0.0 { IsScrapingLeft = true } else { IsScrapingRight = true }

                    // Giữ cao độ Y nguyên vẹn của xe trên mặt đường, tuyệt đối không teleport nẩy lên trời
                    safePos.Y = pos.Y
                    // Triệt tiêu 100% phản lực nẩy lên Y khi va chạm cạ tường ở tốc độ cao
                    if newVel.Y > 0.0 { newVel.Y = 0.0 }
                    // Giữ xe bám cạnh mép tường, không bị giật lùi vị trí ra phía sau
                    safePos.X = ccdHitPosX + ccdHitNormX * (CcdKartRadius + 0.02)
                    safePos.Z = ccdHitPosZ + ccdHitNormZ * (CcdKartRadius + 0.02)
                }

                KartModel<Transform>.Position = safePos
                KartModel<Rigidbody>.Velocity = newVel
            
                // Update local vel reference for downstream calculations this frame
                vel = newVel
                pos = safePos
            }
            PrevCcdPosition = pos

            // Anti-wall-ride: if airborne near a vertical wall, apply downward pull (Issue 3 fix)
            if hitTriggeredCCD && ccdHitNormY < dynamicWallThreshold {
                vel = KartModel<Rigidbody>.Velocity
                if vel.Y > WallUpVelocityClamp { vel.Y = WallUpVelocityClamp }
                vel.Y -= WallAntiClimbDownForce * dt
                KartModel<Rigidbody>.Velocity = vel
            }
            // --- END CCD RECONCILIATION ---

            // -------------------------------------------------
            // TÍNH TOÁN GIẢM QUYỀN TĂNG TỐC KHI CẠ TƯỜNG (30° ĐẾN 90°)
            // Cạ nhẹ giữ nguyên nhịp và vận tốc tiếp tuyến; chỉ khi mũi xe
            // chĩa mạnh vào tường mới giảm dần quyền bơm tốc.
            // -------------------------------------------------
            if (sideScrapeHit || IsScrapingWall) && !isCrashing {
                var sNormX = 0.0
                var sNormZ = 0.0
                if crashNormX != 0.0 || crashNormZ != 0.0 {
                    sNormX = crashNormX
                    sNormZ = crashNormZ
                } else if ScrapeHitNorm.X != 0.0 || ScrapeHitNorm.Z != 0.0 {
                    sNormX = ScrapeHitNorm.X
                    sNormZ = ScrapeHitNorm.Z
                }

                var sNormLen = math.Sqrt(sNormX * sNormX + sNormZ * sNormZ) as float
                if sNormLen > 0.001 {
                    sNormX /= sNormLen
                    sNormZ /= sNormLen

                    // Thành phần mũi xe hướng vào tường:
                    var intoWall = -(fwdVecFlat.X * sNormX + fwdVecFlat.Z * sNormZ)
                    if intoWall > 0.0001 {
                        if intoWall > 1.0 { intoWall = 1.0 }
                        scrapeAngleDeg = math.ASin(intoWall)
                        var scrapeSeverity = (scrapeAngleDeg - 25.0) / 50.0
                        if scrapeSeverity < 0.0 { scrapeSeverity = 0.0 }
                        if scrapeSeverity > 1.0 { scrapeSeverity = 1.0 }
                        scrapeSeverity = scrapeSeverity * scrapeSeverity
                        scrapeAccelMult = 1.0 - scrapeSeverity * (1.0 - WallScrapeMinAccelMult)
                    }
                }

                if ScrapeLogTimer <= 0.0 {
                    ScrapeLogTimer = 0.4
                    LogInfo("[RacingMovement] ⚡ CẠ TƯỜNG! Góc: " + convert.ToString(math.Round(scrapeAngleDeg)) + "° | Gia tốc còn: " + convert.ToString(math.Round(scrapeAccelMult * 100.0)) + "%")
                }
            }

            // -------------------------------------------------
            // One-shot crash inertia: Tắt CrashPush teleport để tránh đẩy giật xe khi chạy tốc độ cao gần hàng rào
            // -------------------------------------------------
            // UPDATE BLOCK: PUBLISH FRAME-SHARED GROUND/CRASH STATE
            // Dependencies:
            // - Drift reads Frame_IsCrashing and raycastHit immediately after this.
            // - Camera reads ground/air state later in the same frame.
            // -------------------------------------------------
            // Publish frame-shared crash + ground info (used by drift/camera systems).
            Frame_IsStrictlyGrounded = isStrictlyGrounded
            Frame_HitCount = hitCount
            Frame_SurfaceNx = nx
            Frame_SurfaceNy = ny
            Frame_SurfaceNz = nz
            Frame_RaycastHit = raycastHit
            Frame_IsCrashing = isCrashing
            PrevFrame_IsCrashing = isCrashing
            Frame_WallDot = wallDot
            // -------------------------------------------------
            // UPDATE BLOCK: DRIFT STATE / DRIFT BLEND
            // Future target: Kart/KartDrift.fcg
            // Timing notes:
            // - Runs after grounding publishes hit/crash state.
            // - Runs before skidmarks, nitro charge, steering, lateral velocity, visual lean, and camera.
            // -------------------------------------------------
            var rawTurnInput = KartMath.CalcTurnInput(IsTurningLeft, IsTurningRight)
            var turnSharp = 5.5
            if isDrift { turnSharp = 5.0 }
            if rawTurnInput * SmoothedTurnInput < 0.0 {
                turnSharp = 3.6
                if isDrift { turnSharp = 3.2 }
            }
            SmoothedTurnInput = SmoothedTurnInput + (rawTurnInput - SmoothedTurnInput) * (dt * turnSharp)
            if math.Abs(SmoothedTurnInput) < 0.03 && rawTurnInput == 0.0 { SmoothedTurnInput = 0.0 }
            turnInput = SmoothedTurnInput
            // Goal #3: explicit drift state machine owns drift flags.
            // FlatSpin remains a drift-like override mode.
            if IsFlatSpinning { IsBraking = true }

            UpdateDriftFlow(dt, IsBraking)
            UpdateDriftState(dt, isStrictlyGrounded, raycastHit, rawTurnInput)

            isDrift = Frame_IsDrift
            isDriftActive = Frame_IsDriftActive || IsFlatSpinning
            UpdateDriftBlend(dt, isDriftActive)

            // -------------------------------------------------
            // UPDATE BLOCK: SKIDMARK VISUALS
            // Future target: Kart/KartVisual.fcg
            // Timing notes:
            // - Depends on driftActive + hitCount + LastContactNormal from Drift/Grounding.
            // - Should remain visual-only; avoid modifying physics state here in future extraction.
            // -------------------------------------------------
            if SkidSensors == nil && KartModel != nil {
                InitSkidSensors(KartModel)
            }
            if SkidSensors != nil {
                var sCount = list.Length(SkidSensors as List<object>)
                if sCount > 0 {
                    if isDriftActive && (hitCount >= 2.0) {
                        for i = 0, sCount, 1 {
                            var node = SkidSensors[i] as entity<Entity>
                            if KartSkidmark.AppendSkidPoint(node, i, SkidLines, SkidPoints, LastContactNx, LastContactNy, LastContactNz) {
                                var pts = SkidPoints[i] as List<Vector3>
                                start CreateSkidLineAsync(i, pts)
                            }
                        }
                    } else {
                        for i = 0, sCount, 1 {
                            KartSkidmark.ResetSkidSlot(i, SkidLines, SkidPoints)
                        }
                    }
                }
            }

            // -------------------------------------------------
            // UPDATE BLOCK: NITRO CHARGE / DRAIN / BOOST REQUEST / UI VISIBILITY
            // Timing notes:
            // - Depends on drift state and turn input.
            // - Must run before physics speed selection because BoostPower/BoostBlend affect maxSpeed and accelPwr.
            // - UI visibility events remain here because RacingMovement owns cross-platform events.
            // -------------------------------------------------
            isDriftTurningRaw = isDrift && (IsTurningLeft || IsTurningRight)
            var driftChargeSpeedKmh = KartMath.PhysSpeedToDisplaySpeed(math.Abs(DriveForwardSpeed) as float, SpeedUnitScale)
            if CurrentSpeedKmh > driftChargeSpeedKmh { driftChargeSpeedKmh = CurrentSpeedKmh }
            isDriftTurning = isDriftTurningRaw && (driftChargeSpeedKmh >= 25.0) && (DriftTimer >= 0.15)

            if !IsBraking && PrevIsBraking {
                PostDriftBoostTimer = PostDriftNitroBoostTime
                NitroPostCutCooldown = 0.25
                if DriftTimer >= 0.25 {
                    NitroCharge += 15.0
                    if NitroCharge > MaxNitroCharge { NitroCharge = MaxNitroCharge }
                }
            }

            if PrevIsBoosting && !IsBoosting {
                NitroPostCutCooldown = 0.25
            }

            if IsBoosting && !PrevIsBoosting {
                if NitroCharge < 30.0 {
                    NitroBoostTier = 1
                } else if NitroCharge < 80.0 {
                    NitroBoostTier = 2
                } else {
                    NitroBoostTier = 3
                }
            }

            NitroCharge = KartNitro.ClampNitroCharge(NitroCharge, MaxNitroCharge)

            var nitroChargeRate = NitroChargeRate
            if NitroPostCutCooldown > 0.0 {
                nitroChargeRate = NitroChargeRate * 0.40
            } else {
                var chargeSpeedKmh = CurrentSpeedKmh
                var chargeSpeedCap = TopSpeed * 1.5
                if chargeSpeedKmh > chargeSpeedCap { chargeSpeedKmh = chargeSpeedCap }
                if chargeSpeedCap > 0.01 {
                    var chargeSpeedFactor = chargeSpeedKmh / chargeSpeedCap
                    if chargeSpeedFactor < 0.80 { chargeSpeedFactor = 0.80 }
                    if chargeSpeedFactor > 1.50 { chargeSpeedFactor = 1.50 }
                    nitroChargeRate = NitroChargeRate * chargeSpeedFactor
                }
            }

            NitroCharge = KartNitro.ApplyDriftCharge(NitroCharge, isDriftTurning, nitroChargeRate, MaxNitroCharge, dt)
            var nitroDrainRate = KartNitro.CalcBoostDrainRate(NitroDrainRate, NitroBoostTier)
            NitroCharge = KartNitro.ApplyBoostDrain(NitroCharge, IsBoosting, nitroDrainRate, MaxNitroCharge, dt)
            NitroCharge = KartNitro.ClampNitroCharge(NitroCharge, MaxNitroCharge)
            if KartNitro.ShouldStopBoostAfterDrain(NitroCharge, IsBoosting) {
                IsBoosting = false
                NitroBoostTier = 3
            }

            if NitroPostCutCooldown > 0.0 {
                NitroPostCutCooldown -= dt
                if NitroPostCutCooldown < 0.0 { NitroPostCutCooldown = 0.0 }
            }

            NitroTimeActive = KartNitro.UpdateNitroTime(NitroTimeActive, IsBoosting, dt)

            // Goal #4: continuous boost power (0..1) for scalable boost intensity.
            // Keep IsBoosting as the "boost request" flag (UI/network compatibility).
            BoostPowerTarget = KartNitro.CalcBoostPowerTargetFromTier(IsBoosting, NitroBoostTier)
            BoostPower = KartNitro.SmoothBoostPower(BoostPower, BoostPowerTarget, dt)

            if IsBoosting {
                DriftFlowTimer = 0.0
                if DriftState == DriftState_EXIT || DriftState == DriftState_HOLD {
                    DriftState = DriftState_NORMAL
                }
            }

            var shouldShowNitro = KartNitro.ShouldShowNitro(NitroCharge, PostDriftBoostTimer, isDrift)
            if shouldShowNitro && !HasNitro {
                HasNitro = true
                DispatchEventToEntity(ShowNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
            } else if !shouldShowNitro && HasNitro {
                HasNitro = false
                IsBoosting = false
                DispatchEventToEntity(HideNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
            }

            // -------------------------------------------------
            // UPDATE BLOCK: SPEED TARGETS / STEERING INPUT / ORIENTATION
            // Future target: Kart/KartPhysics.fcg plus KartDrift steering helpers
            // Timing notes:
            // - Uses BoostPower/BoostBlend from Nitro block and DriftBlend from Drift block.
            // - PhysicsQuat is authoritative for kart facing; camera/visual read it later.
            // -------------------------------------------------
            var accelInput = 0.0
            if IsRaceStarted && !IsReversing { accelInput = 1.0 }

            var physTopSpeed = KartMath.DisplaySpeedToPhysSpeed(TopSpeed, SpeedUnitScale)
            var physBoostTopSpeed = KartMath.DisplaySpeedToPhysSpeed(BoostTopSpeed, SpeedUnitScale)
            var physReverseSpeed = KartMath.DisplaySpeedToPhysSpeed(ReverseSpeed, SpeedUnitScale)
            var driftSustainSpeed = physTopSpeed * DriftSustainRatio

            // Nitro chỉ bị ngắt bởi input drift/phanh, không tự tắt theo trạng thái drift còn active.

            // ── FEATURE 4 (UPDATED): BOOST RAMP BLEND × BOOST POWER ──────────
            // BoostBlend remains the temporal ramp; BoostPower scales intensity.
            if IsBoosting { IsNitroRecovering = false }
            var boostTarget = BoostPower
            BoostBlend = KartPhysicsMath.CalcBoostBlendNext(BoostBlend, boostTarget, BoostRampIn, BoostRampOut, dt)
            // ─────────────────────────────────────────────────────────────────

            var tierTopMult = KartNitro.CalcBoostTopMult(NitroBoostTier)
            var maxSpeed = KartPhysicsMath.CalcMaxSpeed(physTopSpeed, physBoostTopSpeed, BoostPower, BoostBlend, PostDriftBoostTimer, PostDriftNitroTopMult * tierTopMult, isDriftActive, DriftSustainRatio, DriftBlend, IsTurningLeft, IsTurningRight, TurnSpeedRatio)
            if IsBoosting {
                maxSpeed = physBoostTopSpeed * tierTopMult
                if PostDriftBoostTimer > 0.0 { maxSpeed = maxSpeed * PostDriftNitroTopMult }
            }
            if IsAiAutopilot {
                maxSpeed = KartMath.DisplaySpeedToPhysSpeed(AiDesiredSpeedKmh, SpeedUnitScale)
            }

            var curLatSpdEarly = vel.X * rgtVecFlat.X + vel.Y * rgtVecFlat.Y + vel.Z * rgtVecFlat.Z
            var turnRate = CalcSteerRate(turnInput, isDriftActive, CurrentSpeedKmh, localFwdSpeed, curLatSpdEarly, dt)
            if IsAiAutopilot {
                // AI Autopilot áp dụng góc lái trực tiếp không độ trễ, triệt tiêu hoàn toàn thiếu lái khi vào cua
                turnRate = AiTurnRate
            }

            // ── PROBLEM 2 FIX: removed hardcoded `turnRate *= 3.5` ────────────
            // Steering authority is now integrated in CalcSteerRate() with
            // per-state scaling (grounded/drift/air). Do NOT re-add multiplier here.

            PhysicsQuat = KartSteeringRuntime.ApplySteerRotation(PhysicsQuat, nx, ny, nz, turnRate, dt)

            if raycastHit {
                PhysicsQuat = KartSteeringRuntime.ApplySurfaceAlignment(PhysicsQuat, nx, ny, nz, dt, isDriftActive)
                AirTime = 0.0
            } else {
                AirTime += dt
                PhysicsQuat = KartSteeringRuntime.ApplyAirUpright(PhysicsQuat, FacingAngle, dt, AirTime, isDriftActive)
            }

            // Goal #1: remove dual yaw integration; FacingAngle mirrors PhysicsQuat yaw only.
            var physEuler = math.QuaternionToEulerAngle(PhysicsQuat)
            FacingAngle = KartSteeringRuntime.NormalizeFacingAngle(physEuler.Y)

            // --- ARCADE WALL SCRAPING: CHUYÊN NGHIỆP — CHỈ BẺ HƯỚNG THEO TƯỜNG KHI ĐANG CHẠM TƯỜNG ---
            var hasInstantScrape = sideScrapeHit || IsScrapingWall || IsScrapingLeft || IsScrapingRight
            if hasInstantScrape {
                var hitNx = ScrapeHitNorm.X
                var hitNz = ScrapeHitNorm.Z
                if hitNx == 0.0 && hitNz == 0.0 {
                    hitNx = crashNormX
                    hitNz = crashNormZ
                }
                if hitNx == 0.0 && hitNz == 0.0 {
                    if IsScrapingLeft {
                        hitNx = rgtVecFlat.X
                        hitNz = rgtVecFlat.Z
                    } else if IsScrapingRight {
                        hitNx = -rgtVecFlat.X
                        hitNz = -rgtVecFlat.Z
                    }
                }
                var hitLen = math.Sqrt(hitNx * hitNx + hitNz * hitNz) as float
                if hitLen > 0.001 {
                    var targetNx = hitNx / hitLen
                    var targetNz = hitNz / hitLen
                    if ActiveWallNormX == 0.0 && ActiveWallNormZ == 0.0 {
                        ActiveWallNormX = targetNx
                        ActiveWallNormZ = targetNz
                    } else {
                        // Làm mượt pháp tuyến tường trên tường cong để không bị giật đa giác
                        ActiveWallNormX = math.Lerp(ActiveWallNormX, targetNx, dt * 15.0)
                        ActiveWallNormZ = math.Lerp(ActiveWallNormZ, targetNz, dt * 15.0)
                        var aLen = math.Sqrt(ActiveWallNormX * ActiveWallNormX + ActiveWallNormZ * ActiveWallNormZ) as float
                        if aLen > 0.001 { ActiveWallNormX /= aLen; ActiveWallNormZ /= aLen }
                    }
                    WallScrapeStickTimer = 0.05
                }
            } else {
                WallScrapeStickTimer = 0.0
                ActiveWallNormX = 0.0
                ActiveWallNormZ = 0.0
            }

            var isWallScrapingNow = hasInstantScrape && (ActiveWallNormX != 0.0 || ActiveWallNormZ != 0.0)
            if isWallScrapingNow {
                var wallScrapeNx = ActiveWallNormX
                var wallScrapeNz = ActiveWallNormZ

                var curFwd = math.RotateVector(Vector3{0.0, 0.0, 1.0}, PhysicsQuat)

                // BẺ HƯỚNG TỪ TỪ KHI CẠ HÔNG HOẶC ĐÂM CHÉO VÀO TƯỜNG (intoWall > 0.005)
                var intoWall = -(curFwd.X * wallScrapeNx + curFwd.Z * wallScrapeNz)
                var isQualifySideScrape = CurrentSpeedKmh > 15.0 && !IsReversing && intoWall > 0.005
                if isQualifySideScrape {
                    // Vector tiếp tuyến tường cùng chiều tiến của xe
                    var tanX = -wallScrapeNz
                    var tanZ = wallScrapeNx
                    if curFwd.X * tanX + curFwd.Z * tanZ < 0.0 {
                        tanX = wallScrapeNz
                        tanZ = -wallScrapeNx
                    }

                    // Góc Yaw tiếp tuyến của bờ tường (Degrees)
                    var wallYaw = math.ATan2(tanX, tanZ)
                    var curYaw = physEuler.Y
                    var yawDiff = wallYaw - curYaw
                    while yawDiff > 180.0 { yawDiff -= 360.0 }
                    while yawDiff < -180.0 { yawDiff += 360.0 }

                    // Nếu người chơi đang ấn giữ nút cua đâm ngược vào tường (turnRate ngược dấu yawDiff),
                    // triệt tiêu phần góc xoay đâm vào tường của frame này để mũi xe không bị ghìm kẹt vào tường
                    if turnRate * yawDiff < 0.0 {
                        curYaw -= turnRate * dt
                        yawDiff = wallYaw - curYaw
                        while yawDiff > 180.0 { yawDiff -= 360.0 }
                        while yawDiff < -180.0 { yawDiff += 360.0 }
                    }

                    // Bẻ lái dứt khoát và mượt mà theo tiếp tuyến (cả khi góc cạ nông lẫn góc đâm xiên 30°-68°)
                    var intoFactor = intoWall * 2.2
                    if intoFactor > 1.0 { intoFactor = 1.0 }
                    if intoFactor < 0.35 { intoFactor = 0.35 }

                    var speedScale = CurrentSpeedKmh / 90.0
                    if speedScale < 0.9 { speedScale = 0.9 }
                    if speedScale > 2.2 { speedScale = 2.2 }

                    var alignStep = dt * 9.0 * intoFactor * speedScale
                    if alignStep > 0.26 { alignStep = 0.26 }

                    var deltaYaw = yawDiff * alignStep
                    var minStepDeg = dt * 85.0 * intoFactor * speedScale
                    if math.Abs(yawDiff) > minStepDeg && math.Abs(deltaYaw) < minStepDeg {
                        if yawDiff > 0.0 { deltaYaw = minStepDeg } else { deltaYaw = -minStepDeg }
                    }

                    var newYaw = curYaw + deltaYaw
                    physEuler.Y = newYaw
                    PhysicsQuat = math.EulerAngleToQuaternion(Vector3{physEuler.X, newYaw, physEuler.Z})
                    FacingAngle = KartSteeringRuntime.NormalizeFacingAngle(newYaw)
                    VelocityQuat = math.SlerpQuaternion(VelocityQuat, PhysicsQuat, dt * 18.0)

                    // In log theo dõi bẻ hướng độc lập
                    if WallDeflectLogTimer <= 0.0 {
                        WallDeflectLogTimer = 0.25
                        LogInfo("[RacingMovement] ↪ BẺ LÁI THEO TƯỜNG! Xe: " + convert.ToString(math.Round(FacingAngle)) + "° -> Tường: " + convert.ToString(math.Round(wallYaw)) + "° (Lệch: " + convert.ToString(math.Round(yawDiff)) + "°)")
                    }
                }

                // CHỈ LOẠI BỎ VẬN TỐC ĐÂM VÀO TƯỜNG, TUYỆT ĐỐI KHÔNG ÉP DÍNH VÀO TƯỜNG
                var vDotW = vel.X * wallScrapeNx + vel.Z * wallScrapeNz
                if vDotW < 0.0 {
                    vel.X -= vDotW * wallScrapeNx
                    vel.Z -= vDotW * wallScrapeNz
                }

                // Triệt tiêu 100% phản lực nẩy lên không trung khi cạ/đâm tường ở tốc độ cao
                if vel.Y > 0.0 { vel.Y = 0.0 }
                if KartModel != nil {
                    KartModel<Rigidbody>.Velocity = vel
                    KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
                }

                // Giữ trớn lướt tiếp dọc tường, không bị chết ga dừng xe
                if DriveForwardSpeed < physTopSpeed * 0.55 {
                    DriveForwardSpeed = physTopSpeed * 0.55
                }

                // Tắt trạng thái crash
                isCrashing = false
                Frame_IsCrashing = false
            }

            UIKartYaw = FacingAngle
            UIKartPos = KartModel<Transform>.Position

            var curFwdSpd = DriveForwardSpeed
            // Senior Game Physics: Khi vừa nhả nút Drift (IsBraking vừa chuyển từ true -> false)
            if !IsBraking && PrevIsBraking {
                // 1. Ép ngay vector vận tốc bám 100% theo hướng mũi xe mới
                VelocityQuat = math.SlerpQuaternion(VelocityQuat, PhysicsQuat, 0.35)
                // 2. Giữ lại một phần lateral momentum để exit drift có độ nảy
                DriftSlipMemory = DriftSlipMemory * 0.35
                DriftFlowTimer = 0.0
                TractionRecoveryTimer = 0.0
                // 3. Mini-Turbo theo cấp: giữ drift càng lâu thì thoát cua càng đã.
                if DriftTimer >= 2.0 {
                    curFwdSpd = curFwdSpd + (physTopSpeed * MiniTurboLongBoost)
                } else if DriftTimer >= 1.2 {
                    curFwdSpd = curFwdSpd + (physTopSpeed * MiniTurboMediumBoost)
                } else if DriftTimer >= 0.7 {
                    curFwdSpd = curFwdSpd + (physTopSpeed * MiniTurboShortBoost)
                }
            }

            if curFwdSpd < 0.0 && !IsReversing {
                if IsBoosting {
                    var bounceLimit = -physTopSpeed * 0.3
                    if curFwdSpd < bounceLimit { curFwdSpd = bounceLimit }
                } else {
                    curFwdSpd = 0.0   
                }
            }

            if IsReversing {
                if curFwdSpd > 0.0 {
                    curFwdSpd = KartPhysicsMath.LerpToSpeed(curFwdSpd, 0.0, BrakeLerpRate, dt)
                    if curFwdSpd < 0.01 { curFwdSpd = 0.0 }
                } else {
                    curFwdSpd = KartPhysicsMath.LerpToSpeed(curFwdSpd, -physReverseSpeed, ReverseLerpRate, dt)
                }
                if IsBoosting { IsBoosting = false }
            } else {
                var wasBoosting = PrevIsBoosting

                if IsBoosting && !wasBoosting {
                    // Khi kích hoạt Nitro:
                    // 1. Ép ngay VelocityQuat = PhysicsQuat để toàn bộ lực đẩy phóng thẳng theo đầu xe
                    VelocityQuat = PhysicsQuat
                    // 2. Triệt tiêu toàn bộ quán tính trượt dạt ngang cũ
                    DriftSlipMemory = 0.0
                    DriftFlowTimer = 0.0
                    TractionRecoveryTimer = 0.0
                    // 3. Kick giật tức thời lấy lại đà nếu xe đang chậm/mất trớn (sau va chạm, phanh, quay xe)
                    if curFwdSpd < physTopSpeed * 0.70 {
                        curFwdSpd = curFwdSpd + (physTopSpeed * 0.25)
                        if curFwdSpd > physTopSpeed { curFwdSpd = physTopSpeed }
                    }
                }

                // --- Hậu-nitro: bắt đầu hãm về TopSpeed ---
                if wasBoosting && !IsBoosting && curFwdSpd > physTopSpeed {
                    IsNitroRecovering = true
                }

                // --- Hậu-nitro: Lerp mượt về TopSpeed ---
                if !IsBoosting && IsNitroRecovering && curFwdSpd > physTopSpeed {
                    curFwdSpd = KartPhysicsMath.LerpToSpeed(curFwdSpd, physTopSpeed, AccelLerpRate, dt)
                }
                // --- Khi Drift: hãm tốc độ rõ rệt về mức DriftSustainRatio ---
                if !IsBoosting && isDriftActive {
                    IsNitroRecovering = false
                    var driftBrakeRate = AccelLerpRate * DriftBrakeMult
                    if curFwdSpd > physTopSpeed {
                        driftBrakeRate = AccelLerpRate * DriftOverspeedBrakeMult
                    }
                    curFwdSpd = KartPhysicsMath.LerpToSpeed(curFwdSpd, driftSustainSpeed, driftBrakeRate, dt)
                }
                if isDriftActive && curFwdSpd <= driftSustainSpeed * 1.02 { DriftEntryDecelDone = true }

                if !IsBoosting && IsNitroRecovering && curFwdSpd <= physTopSpeed {
                    IsNitroRecovering = false
                }

                if PostDriftBoostTimer > 0.0 {
                    PostDriftBoostTimer -= dt
                    if PostDriftBoostTimer < 0.0 { PostDriftBoostTimer = 0.0 }
                }

                // --- Gia tốc Lerp-based (MarioKart style) ---
                if maxSpeed < 0.01 { maxSpeed = 0.01 }
                var tractionFactor = KartPhysicsMath.CalcTractionFactor(curLatSpdEarly, maxSpeed, DriftBlend, BoostPower)
                var launchRamp = KartPhysicsMath.CalcAccelerationRamp(curFwdSpd, maxSpeed, 1.0)
                var lerpRate = AccelLerpRate * launchRamp * tractionFactor
                if (sideScrapeHit || IsScrapingWall) && !isCrashing {
                    lerpRate = lerpRate * scrapeAccelMult
                }
                if IsBoosting {
                    var physBoostFastThreshold = KartMath.DisplaySpeedToPhysSpeed(TopSpeed * 1.05, SpeedUnitScale)
                    // Nitro bức tốc cực mạnh khi xe đang dưới tốc độ thường (hồi phục đà thần tốc)
                    var nitroBurstMult = 1.0
                    if curFwdSpd < physTopSpeed {
                        var speedDeficit = 1.0 - (curFwdSpd / physTopSpeed)
                        if speedDeficit > 0.0 {
                            nitroBurstMult = 1.0 + speedDeficit * 2.2
                        }
                    }
                    lerpRate = AccelLerpRate * KartNitro.CalcBoostAccelMult(NitroBoostTier) * tractionFactor * nitroBurstMult
                    if curFwdSpd >= physBoostFastThreshold {
                        lerpRate = AccelLerpRate * KartNitro.CalcBoostDecayMult(NitroBoostTier) * tractionFactor
                    }
                }

                // Keep throttle response while brushing the wall; the angle-scaled
                // scrape drag above is the only forward-speed penalty for side contact.

                var allowAccel = true
                if isCrashing || Frame_IsCrashing { allowAccel = false }
                if !IsBoosting && IsNitroRecovering && curFwdSpd > physTopSpeed { allowAccel = false }
                if IsBraking && !DriftEntryDecelDone && curFwdSpd > driftSustainSpeed * 1.05 { allowAccel = false }

                if allowAccel {
                    if IsAiAutopilot && curFwdSpd > maxSpeed {
                        // AI chủ động hãm phanh gắt để ôm cua an toàn, không bị văng thiếu lái
                        curFwdSpd = KartPhysicsMath.LerpToSpeed(curFwdSpd, maxSpeed, BrakeLerpRate * 2.0, dt)
                    } else {
                        curFwdSpd = KartPhysicsMath.LerpToSpeed(curFwdSpd, maxSpeed, lerpRate, dt)
                    }
                }
            }

            // -------------------------------------------------
            // XỬ LÝ GIẢM TỐC MƯỢT SAU KHI CÁN ĐÍCH (3-5 GIÂY RỒI DỪNG HẲN VẬT LÝ)
            // -------------------------------------------------
            if IsFinishDecelerating && !IsAiAutopilot {
                FinishDecelTimer -= dt
                IsTurningLeft = false
                IsTurningRight = false
                IsBraking = false
                IsBoosting = false
                SmoothedTurnInput = 0.0

                if FinishDecelTimer <= 0.0 || curFwdSpd < 0.1 {
                    FinishDecelTimer = 0.0
                    IsFinishDecelerating = false
                    curFwdSpd = 0.0
                    DriveForwardSpeed = 0.0
                    LastClientFwdSpd = 0.0
                    CurrentSpeedKmh = 0.0
                    UISpeedKmh = 0.0
                    IsExternallyLocked = true
                    
                    // Khóa cứng Rigidbody và đưa về trạng thái Sleep để xe dừng im trên mặt đường
                    if KartModel != nil {
                        KartModel<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}
                        KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
                        KartModel<Rigidbody>.Constrain = 127 as RigidbodyConstrainType // Freeze All
                        physics.Sleep(KartModel as entity<Rigidbody>) // Tắt hoàn toàn mô phỏng vật lý
                    }
                } else {
                    var decelRatio = FinishDecelTimer / FinishDecelDuration
                    // Easing mượt mà (SmoothStep: 3*t^2 - 2*t^3)
                    if decelRatio < 0.0 { decelRatio = 0.0 }
                    if decelRatio > 1.0 { decelRatio = 1.0 }
                    var smoothFactor = decelRatio * decelRatio * (3.0 - 2.0 * decelRatio)
                    curFwdSpd = FinishInitialSpeed * smoothFactor
                }
            }

            // -------------------------------------------------
            // UPDATE BLOCK: DRIVE SPEED COMMIT / VFX STATE SYNC
            // Future target: KartPhysics for speed commit, KartVisual for VFX sync.
            // Timing notes:
            // - Must happen after all code paths that can change IsBoosting/isDrift.
            // - PrevIsBoosting/PrevIsDrift/PrevIsBraking are frame-edge detectors; do not move casually.
            // -------------------------------------------------
            DriveForwardSpeed = curFwdSpd

            // Sync VFX sau mọi chỗ đổi IsBoosting / isDrift trong frame (hết nitro, drift cắt boost…)
            if IsBoosting != PrevIsBoosting {
                SyncNitroEffects()
                if IsBoosting {
                    NitroCamKickTimer = NitroCamKickDuration
                    TriggerNitroInitialKickShake()
                }
            }
            if isDrift != PrevIsDrift { SyncDriftEffects(isDrift) }
            if IsScrapingLeft != PrevIsScrapingLeft || IsScrapingRight != PrevIsScrapingRight {
                SyncScrapeEffects()
            }
            PrevIsBoosting = IsBoosting
            PrevIsDrift = isDrift
            PrevIsBraking = IsBraking
            PrevIsScrapingLeft = IsScrapingLeft
            PrevIsScrapingRight = IsScrapingRight

            // -------------------------------------------------
            // UPDATE BLOCK: VELOCITY ALIGNMENT / LATERAL SLIP / PHYSICS FORCES
            // Future target: Kart/KartPhysics.fcg
            // Timing notes:
            // - Depends on updated DriveForwardSpeed, DriftBlend, BoostPower, IsStableGrounded, surface normal, suspension force.
            // - Writes Rigidbody velocity assist, angular damping, gravity/downforce.
            // Risk notes:
            // - This is one of the most gameplay-feel-sensitive blocks. Extract late.
            // -------------------------------------------------
            // ── PROBLEM 1 FIX: per-state velocity alignment sharpness ─────────
            // Old: always 9.0 grounded, 1.8 drift — too aggressive on ground,
            // killed tire-slip sensation and made drift feel rail-based.
            // New: 3.5 grounded (freer steering inertia), 1.2 drift (visible slip),
            // 0.4 air (momentum carries, no phantom corrections).
            var velAlignSharp = KartPhysics.CalcVelocityAlignSharp(isDriftActive, IsStableGrounded, VelAlignGrounded, VelAlignDrift, VelAlignAir)
            if isDriftActive {
                // Tỉ lệ bám cua theo vận tốc: tốc độ càng cao vector vận tốc uốn theo đầu xe càng nhanh để tránh văng tường
                var driftSpeedT = CurrentSpeedKmh / TopSpeed
                if driftSpeedT < 0.5 { driftSpeedT = 0.5 }
                if driftSpeedT > 1.5 { driftSpeedT = 1.5 }
                var driftAlignT = driftSpeedT - 0.5
                if driftAlignT < 0.0 { driftAlignT = 0.0 }
                if driftAlignT > 1.0 { driftAlignT = 1.0 }
                velAlignSharp = DriftVelAlignLow + (DriftVelAlignHigh - DriftVelAlignLow) * driftAlignT
            } else if IsBoosting {
                velAlignSharp = 32.0
            }
            VelocityQuat = math.SlerpQuaternion(VelocityQuat, PhysicsQuat, dt * velAlignSharp)

            var fwd3DVec = math.RotateVector(Vector3{0.0, 0.0, 1.0}, VelocityQuat)
            var rgt3DVec = math.RotateVector(Vector3{1.0, 0.0, 0.0}, VelocityQuat)
            var fwd3DX = fwd3DVec.X; var fwd3DY = fwd3DVec.Y; var fwd3DZ = fwd3DVec.Z
            var rgt3DX = rgt3DVec.X; var rgt3DY = rgt3DVec.Y; var rgt3DZ = rgt3DVec.Z

            // Goal #1: FacingAngle is derived (telemetry only). PhysicsQuat is authoritative.
            var physYaw = math.QuaternionToEulerAngle(PhysicsQuat).Y
            FacingAngle = physYaw
            var fwdXFlat = math.Sin(physYaw)
            var fwdZFlat = math.Cos(physYaw)
            var rgtXFlat = math.Cos(physYaw)
            var rgtZFlat = -math.Sin(physYaw)

            var curLatSpd = vel.X * rgt3DX + vel.Y * rgt3DY + vel.Z * rgt3DZ
            if Frame_IsCrashing {
                if IsBoosting { IsBoosting = false }
                BoostBlend = 0.0
                NitroCamBlend = 0.0
                NitroCamKickTimer = 0.0
            }
             
            if math.Abs(LandingSlidePwr) > 0.1 {
                curLatSpd += LandingSlidePwr
                LandingSlidePwr = LandingSlidePwr + (0.0 - LandingSlidePwr) * (dt * 5.0) 
                isDrift = true 
            }

            curLatSpd = ProcessArcadeLateral(curLatSpd, turnInput, curFwdSpd, isDriftActive, isStrictlyGrounded, CurrentSpeedKmh, dt)
            if Frame_IsCrashing {
                curLatSpd = 0.0
                DriftSlipMemory = 0.0
                DriftFlowTimer = 0.0
            }

            var slipAngleDeg = 0.0
            if math.Abs(curFwdSpd) > 0.08 {
                slipAngleDeg = math.ATan2(curLatSpd, Abs(curFwdSpd) as float)
            }
            var targetVisualSlip = slipAngleDeg * DriftVisualSlipScale * DriftBlend
            DriftVisualYawOffset = DriftVisualYawOffset + (targetVisualSlip - DriftVisualYawOffset) * (dt * 5.0)
            CamDriftSlipYaw = CamDriftSlipYaw + (targetVisualSlip * 0.35 - CamDriftSlipYaw) * (dt * 4.0)

            var targetVelX = 0.0
            var targetVelY = 0.0
            var targetVelZ = 0.0
            if IsStableGrounded {
                targetVelX = fwd3DX * curFwdSpd + rgt3DX * curLatSpd
                targetVelY = fwd3DY * curFwdSpd + rgt3DY * curLatSpd
                targetVelZ = fwd3DZ * curFwdSpd + rgt3DZ * curLatSpd
            } else {
                targetVelX = fwdXFlat * curFwdSpd + rgtXFlat * curLatSpd
                targetVelY = vel.Y
                targetVelZ = fwdZFlat * curFwdSpd + rgtZFlat * curLatSpd
            }

            // Raycast is a sensor only. The engine owns collision response;
            // prevent velocity assist from re-injecting speed into a wall on
            // the next frame after the engine removed the normal component.
            if !UseCustomWallScrapeResponse && (sideScrapeHit || IsScrapingWall) {
                var wallNx = crashNormX
                var wallNz = crashNormZ
                if wallNx == 0.0 && wallNz == 0.0 {
                    wallNx = ScrapeHitNorm.X
                    wallNz = ScrapeHitNorm.Z
                }
                var wallLen = math.Sqrt(wallNx * wallNx + wallNz * wallNz) as float
                if wallLen > 0.001 {
                    wallNx /= wallLen
                    wallNz /= wallLen
                    var targetDotW = targetVelX * wallNx + targetVelZ * wallNz
                    if targetDotW < 0.0 {
                        targetVelX -= targetDotW * wallNx
                        targetVelZ -= targetDotW * wallNz
                    }
                }
            }

            // Goal #8: reduce hard velocity forcing; blend assist with momentum.
            var assist = KartPhysics.CalcVelocityAssist(isDriftActive, IsStableGrounded, Frame_IsCrashing)
            KartPhysics.ApplyVelocityAssist(KartModel as entity<Rigidbody>, vel, targetVelX, targetVelY, targetVelZ, assist)

            // ── FEATURE 6: ANGULAR VELOCITY DAMPING ──────────────────────────
            // Replace the hard zero-kill with exponential damping so physics
            // explosions can't happen but micro-rotations settle naturally.
            // Grounded: very tight (kart on surface, stays flat).
            // Airborne: looser so the body can respond to landing impulses.
            KartPhysics.ApplyAngularDamping(KartModel as entity<Rigidbody>, IsStableGrounded)
            // ─────────────────────────────────────────────────────────────────

            var isHeadCrash = frontCrashHit || isCrashing || Frame_IsCrashing
            var isSideScrape = (sideScrapeHit || IsScrapingWall) && !isHeadCrash
            if IsStableGrounded {
                // Goal #5: suspension spring pushes away from surface along normal.
                // Khi đâm trực diện/góc lớn: ngắt lò xo phía trước để tránh bốc đầu.
                // Khi chỉ cạ hông nhẹ: GIỮ NGUYÊN lò xo suspension để xe lăn bánh êm ái, không sụp gầm!
                if !isHeadCrash {
                    KartPhysics.ApplySuspensionForce(KartModel as entity<Rigidbody>, nx, ny, nz, suspForce)
                }
                // ── FEATURE 5: HIGH-SPEED DOWNFORCE ──────────────────────────────
                // Adds extra adhesion along the surface normal at high speed.
                // Prevents the kart from "floating" out of corners at top speed.
                var downforceSpeedRatio = KartPhysicsMath.CalcDownforceSpeedRatio(CurrentSpeedKmh, DownforceStart, TopSpeed)
                var extraDownforce = KartPhysicsMath.CalcExtraDownforce(DownforceMax, downforceSpeedRatio)
                var totalGroundForce = KartPhysicsMath.CalcTotalGroundForce(GroundGravity, extraDownforce)
                if isDriftActive {
                    totalGroundForce += DriftDownforceBonus * DriftBlend
                }
                // Chỉ đè thêm lực chống leo tường khi đâm trực diện; cạ hông giữ lực đè bình thường để xe không bị nặng
                if isHeadCrash {
                    totalGroundForce += WallAntiClimbDownForce
                }
                // ─────────────────────────────────────────────────────────────────
                KartPhysics.ApplyGroundForce(KartModel as entity<Rigidbody>, nx, ny, nz, totalGroundForce)
            } else {
                KartPhysics.ApplyAirGravity(KartModel as entity<Rigidbody>, Gravity, ExtraAirGravity)
            }

            // Keep planar physics inside the calibrated arcade envelope.
            // This is a safety net for force spikes; normal target-speed logic
            // remains the primary limiter.
            var maxPhysicsSpeed = KartMath.DisplaySpeedToPhysSpeed(BoostTopSpeed * 1.08, SpeedUnitScale)
            var safeTelemetryVel = KartPhysicsMath.ClampPlanarVelocity(KartModel<Rigidbody>.Velocity, maxPhysicsSpeed)
            if safeTelemetryVel.X != KartModel<Rigidbody>.Velocity.X || safeTelemetryVel.Z != KartModel<Rigidbody>.Velocity.Z {
                KartModel<Rigidbody>.Velocity = safeTelemetryVel
            }

            // Anti-wall-bounce:
            // 1. Đâm trực diện/góc lớn: khóa cứng nảy Y <= 0 để dán chặt xuống đường
            // 2. Cạ hông nhẹ: trượt lướt mượt mà bám theo mặt đường, không bị khựng giật
            if isHeadCrash {
                if safeTelemetryVel.Y > 0.0 {
                    safeTelemetryVel.Y = 0.0
                    KartModel<Rigidbody>.Velocity = safeTelemetryVel
                }
            } else if isSideScrape {
                if safeTelemetryVel.Y > (targetVelY + 0.3) {
                    safeTelemetryVel.Y = targetVelY + 0.3
                    KartModel<Rigidbody>.Velocity = safeTelemetryVel
                }
            } else if IsStableGrounded && safeTelemetryVel.Y > (targetVelY + 1.5) {
                safeTelemetryVel.Y = targetVelY + 1.5
                KartModel<Rigidbody>.Velocity = safeTelemetryVel
            }

            vel = safeTelemetryVel

            // -------------------------------------------------
            // UPDATE BLOCK: SPEEDOMETER / DEBUG TELEMETRY
            // Dependencies:
            // - Measures speed directly from Rigidbody velocity (MarioKart REALCURRENTSPEED style).
            // - LoadUI reads UISpeedKmh from this graph.
            // -------------------------------------------------
            // Stable arcade source: DriveForwardSpeed is the gameplay authority.
            // Rigidbody velocity remains physics-only and is not allowed to break
            // Drift, Nitro, camera, audio, or the HUD when readback is delayed.
            var driveKmh = KartSpeedometer.CalcDriveKmh(DriveForwardSpeed, SpeedUnitScale)
            var speedForDisplayKmh = driveKmh
            if speedForDisplayKmh < 0.0 { speedForDisplayKmh = 0.0 }
            var virtualSpeedCap = BoostTopSpeed
            if virtualSpeedCap < TopSpeed { virtualSpeedCap = TopSpeed }
            if speedForDisplayKmh > virtualSpeedCap { speedForDisplayKmh = virtualSpeedCap }

            var needleSmoothness = KartSpeedometer.CalcNeedleSmoothness(IsReversing, IsStableGrounded)
            CurrentSpeedKmh = KartSpeedometer.CalcCurrentSpeedKmhNext(CurrentSpeedKmh, speedForDisplayKmh, dt, needleSmoothness)
            UISpeedKmh = CurrentSpeedKmh * 0.75

            UpdateNearestWaypoint()
            UpdateWrongWayFromWaypoints(dt)
            UpdateGuidePath(dt)

            
            SpeedDisplayTimer = KartSpeedometer.CalcSpeedDisplayTimerNext(SpeedDisplayTimer, dt)
            if KartSpeedometer.ShouldLogSpeed(SpeedDisplayTimer) {
                SpeedDisplayTimer = KartSpeedometer.ResetSpeedDisplayTimer()
                var wCount  = list.Length(WheelNodes as List<object>)
                // LogInfo(KartSpeedometer.BuildTelemetryMessageFromState(CurrentSpeedKmh, CurrentRollAngle, wCount, isDriftTurning, isDrift, IsReversing, IsBoosting, NitroCharge, MaxNitroCharge))
            }
        }

        // -------------------------------------------------
        // UPDATE BLOCK: MESH VISUAL LEAN / DRIFT YAW / STUNT VISUAL
            // Future target: Kart/KartVisual.fcg
            // Timing notes:
            // - Reads turnInput, isDrift, isDriftActive, AirTime, PhysicsQuat, DriftVisualYawOffset.
            // - Writes MomentNode local rotation and StableVisualQuat used by camera.
            // -------------------------------------------------
            var targetLean = KartVisualMath.CalcLeanTarget(turnInput, isDrift, BaseVisualLean)
            var targetOffset = BaseCamOffset * 0.35 * turnInput
            if isDrift {
                targetOffset = BaseCamOffset * (0.35 + DriftBlend * 1.15) * turnInput
            }
            var leanLerpSpeed = KartVisualMath.CalcLeanLerpSpeed(turnInput, isDrift, IsBoosting, CurrentCamOffset)
            var camLerpSpeed = KartVisualMath.CalcCamOffsetLerpSpeed(turnInput, isDrift, IsBoosting, CurrentCamOffset)

            CurrentVisualLean = KartVisualMath.CalcVisualValueNext(CurrentVisualLean, targetLean, dt, leanLerpSpeed)
            CurrentCamOffset = KartVisualMath.CalcVisualValueNext(CurrentCamOffset, targetOffset, dt, camLerpSpeed)

            var wobbleRoll = KartVisualMath.CalcWobbleRoll(AirTime, isDrift)
            var wobblePitch = KartVisualMath.CalcWobblePitch(AirTime, isDrift)

            var idleSway = 0.0
            if isGrounded {
                var speedRatio = KartMath.CalcClampedSpeedRatio(CurrentSpeedKmh, TopSpeed)
                SwayTimer = KartVisualMath.CalcSwayTimerNext(SwayTimer, dt, speedRatio > 0.01)
                idleSway = KartVisualMath.CalcIdleSway(SwayTimer, speedRatio, turnInput, BaseVisualLean)
            }

            var finalLean = CurrentVisualLean + idleSway

            DriftTimer = KartVisualMath.CalcDriftTimerNext(DriftTimer, isDriftTurningRaw, isGrounded, dt)

            var maxDriftYaw = 6.5    // Giảm góc xoay thân xe khi drift từ 14.0 xuống 6.5 để không bị quăng đuôi
            var targetYaw = KartVisualMath.CalcVisualYawTarget(turnInput, isDriftTurning, DriftTimer, maxDriftYaw)
            var yawLerpSpeed = KartVisualMath.CalcVisualYawLerpSpeed(isDrift)
            CurrentVisualYaw = KartVisualMath.CalcVisualValueNext(CurrentVisualYaw, targetYaw, dt, yawLerpSpeed)

            var stuntPitch = 0.0
            var stuntRoll = 0.0

            if IsFlatSpinning {
                FlatSpinVisualAngle += FlatSpinSpeed * SpinDir * dt
                var cycleAngle = KartVisualMath.CalcFlatSpinCycleAngle(FlatSpinVisualAngle)
                var spinProgress = cycleAngle / 360.0 

                stuntRoll = KartVisualMath.CalcFlatSpinStuntRoll(spinProgress, SpinDir)
                stuntPitch = KartVisualMath.CalcFlatSpinStuntPitch(spinProgress)
                StuntCamRoll = KartVisualMath.CalcFlatSpinCamRoll(spinProgress, SpinDir)

            } else {
                FlatSpinVisualAngle = KartVisualMath.CalcFlatSpinVisualAngleRecover(FlatSpinVisualAngle, dt)
                StuntCamRoll = KartVisualMath.CalcStuntCamRollRecover(StuntCamRoll, dt)
            }

            // ===========================================================
            // TẦNG 1: DYNAMIC STABLE VISUAL QUATERNION (Lọc nhiễu Vật lý)
            // ===========================================================
            var visualSharp = KartVisualMath.CalcVisualSharp(isDriftActive, DriftBlend, IsStableGrounded)
            StableVisualQuat = math.SlerpQuaternion(StableVisualQuat, PhysicsQuat, dt * visualSharp)

            // ===========================================================
            // TẦNG 2: MESH VISUAL ASSIGNMENT (Zero-Jitter Override)
            // ===========================================================
            var kEuler = math.QuaternionToEulerAngle(PhysicsQuat)
            KartModel<Transform>.Rotation = Vector3{kEuler.X, kEuler.Y, kEuler.Z}
            
            if MomentNode != nil {
                // Drift Entry Dip: nhún phuộc + chúi mũi khi drift (chuẩn Asphalt 8)
                var dipPitchTarget = 0.0
                var dipRollTarget = 0.0
                if isDriftActive && (IsTurningLeft || IsTurningRight) {
                    dipPitchTarget = DriftEntryDipPitchMax * DriftBlend
                    if IsTurningLeft {
                        dipRollTarget = DriftEntryDipRollMax * DriftBlend
                    } else {
                        dipRollTarget = -DriftEntryDipRollMax * DriftBlend
                    }
                }
                DriftEntryDipPitch = DriftEntryDipPitch + (dipPitchTarget - DriftEntryDipPitch) * (dt * 5.0)
                DriftEntryDipRoll = DriftEntryDipRoll + (dipRollTarget - DriftEntryDipRoll) * (dt * 5.0)
                if math.Abs(DriftEntryDipPitch) < 0.01 { DriftEntryDipPitch = 0.0 }
                if math.Abs(DriftEntryDipRoll) < 0.01 { DriftEntryDipRoll = 0.0 }

                var nitroSquatPitch = 0.0
                if IsBoosting {
                    nitroSquatPitch = 0.8 + BoostBlend * 0.7
                    if NitroCamKickDuration > 0.01 && NitroCamKickTimer > 0.0 {
                        var visualKick = NitroCamKickTimer / NitroCamKickDuration
                        if visualKick > 1.0 { visualKick = 1.0 }
                        nitroSquatPitch += visualKick * 0.9
                    }
                }
                var finalPitch = wobblePitch + stuntPitch + DriftEntryDipPitch + nitroSquatPitch
                var finalYaw = CurrentVisualYaw + FlatSpinVisualAngle + DriftVisualYawOffset
                var finalRoll = finalLean + wobbleRoll + stuntRoll + DriftEntryDipRoll
                MomentNode<Transform>.LocalRotation = Vector3{finalPitch, finalYaw, finalRoll}
            }
        }

        // ===========================================================
        // TẦNG 3: CINEMATIC CAMERA SYSTEM (CHẠY LIÊN TỤC CẢ KHI CHỜ VÀ KHI ĐUA)
        // ===========================================================
        if MyClientCam != nil && HasSwitchedStartCamera && KartModel != nil {
            var rawCarPos = KartModel<Transform>.Position
            
            var speedRatio = KartMath.CalcClampedSpeedRatio(CurrentSpeedKmh, TopSpeed)

            var cameraBoostActive = IsBoosting
            var nitroCamTarget = 0.0
            if cameraBoostActive {
                nitroCamTarget = BoostPower
                if nitroCamTarget < 0.35 { nitroCamTarget = 0.35 }
            }
            var nitroCamSharp = 2.4
            if nitroCamTarget > NitroCamBlend {
                nitroCamSharp = 9.5
            }
            NitroCamBlend = NitroCamBlend + (nitroCamTarget - NitroCamBlend) * KartMath.CalcExpLerpFactor(nitroCamSharp, dt)
            if NitroCamBlend < 0.005 { NitroCamBlend = 0.0 }
            if NitroCamBlend > 1.0 { NitroCamBlend = 1.0 }
            if NitroCamKickTimer > 0.0 {
                NitroCamKickTimer -= dt
                if NitroCamKickTimer < 0.0 { NitroCamKickTimer = 0.0 }
            }
            var nitroKick = 0.0
            if NitroCamKickDuration > 0.01 && NitroCamKickTimer > 0.0 {
                nitroKick = NitroCamKickTimer / NitroCamKickDuration
                if nitroKick < 0.0 { nitroKick = 0.0 }
                if nitroKick > 1.0 { nitroKick = 1.0 }
                nitroKick = nitroKick * nitroKick
            }
            var nitroTierFeel = 0.82
            if NitroBoostTier == 2 {
                nitroTierFeel = 1.0
            } else if NitroBoostTier >= 3 {
                nitroTierFeel = 1.18
            }
            var nitroFeel = NitroCamBlend * nitroTierFeel
            if nitroFeel > 1.22 { nitroFeel = 1.22 }

            var turnInputForCam = 0.0
            if !isMovementLocked {
                turnInputForCam = KartMath.CalcTurnInput(IsTurningLeft, IsTurningRight)
            }

            CameraModule_DriftLean(dt, isDriftActive, turnInputForCam, cameraBoostActive, DriftBlend)
            CameraModule_VelocityFollow(dt, KartModel<Rigidbody>.Velocity, PhysicsQuat, CurrentSpeedKmh, turnInputForCam, isDriftActive, IsStableGrounded, cameraBoostActive, DriftBlend)
            CameraModule_Airborne(dt, AirTime, StuntCamRoll)
            CameraModule_CinematicLag(dt, speedRatio, cameraBoostActive, AirTime, DriftBlend, NitroTimeActive)

            // Dynamic Velocity-Scaled FOV (Asphalt 8 / AAA speed feel)
            var dynFov = FovMin + (FovMax - FovMin) * speedRatio
            if CurrentSpeedKmh > TopSpeed {
                var overspeed = CurrentSpeedKmh - TopSpeed
                if overspeed > 73.5 {
                    // Dải 315 -> 367.5 km/h: từ 99° lên 108° (warp speed)
                    dynFov = 99.0 + (overspeed - 73.5) * (9.0 / 52.5)
                } else {
                    // Dải 241.5 -> 315 km/h: từ 82° lên 99° (tạo cảm giác tăng tốc liên tục)
                    dynFov = FovMax + overspeed * ((99.0 - FovMax) / 73.5)
                }
                if dynFov > 108.0 { dynFov = 108.0 }
            }

            var effectiveFovBoost = dynFov
            if cameraBoostActive {
                var tierMinFov = 78.0
                if NitroBoostTier == 2 {
                    tierMinFov = 90.0
                } else if NitroBoostTier == 3 {
                    tierMinFov = 98.0
                }
                if effectiveFovBoost < tierMinFov {
                    effectiveFovBoost = tierMinFov
                }
            }   

            var targetFOV = KartCameraMath.CalcFovTarget(speedRatio, isDriftActive, DriftBlend, cameraBoostActive, NitroTimeActive, ShakeTime, FovMin, FovMax, effectiveFovBoost, CamFovBreathAmp)
            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                var sustainFov = FovMin + (FovMax - FovMin) * speedRatio + 8.0 * nitroFeel
                if NitroBoostTier == 2 {
                    sustainFov += 4.0 * NitroCamBlend
                } else if NitroBoostTier >= 3 {
                    sustainFov += 8.0 * NitroCamBlend
                }
                var kickFov = 10.0 * nitroKick * nitroTierFeel
                var nitroFovTarget = sustainFov + kickFov
                if CurrentSpeedKmh > TopSpeed {
                    nitroFovTarget += 4.0 * NitroCamBlend
                }
                if nitroFovTarget > 111.0 { nitroFovTarget = 111.0 }
                if nitroFovTarget > targetFOV { targetFOV = nitroFovTarget }
            }
            var camFovLerp = KartCameraMath.CalcFovLerpSpeed(cameraBoostActive)
            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                camFovLerp = 2.8 + 6.5 * NitroCamBlend + 5.0 * nitroKick
            }
                CurrentFOV = math.Lerp(CurrentFOV, targetFOV, KartMath.CalcExpLerpFactor(camFovLerp, dt))
            MyClientCam<camera.CustomCamera>.FOV = CurrentFOV

            ImpactTimer = KartCameraRuntime.CalcImpactTimerNext(ImpactTimer, dt)
            TargetDropOffset = KartCameraRuntime.CalcTargetDropOffsetNext(TargetDropOffset, ImpactTimer)
            CurrentDropOffset = KartCameraRuntime.CalcDropOffsetNext(CurrentDropOffset, TargetDropOffset, dt, ImpactTimer)

            var shakeIntensity = KartCameraRuntime.CalcShakeIntensity(speedRatio, cameraBoostActive, isDriftActive, DriftBlend, ImpactTimer)
            if cameraBoostActive || CurrentSpeedKmh > TopSpeed {
                var dynShake = 0.25
                if CurrentSpeedKmh > TopSpeed {
                    var overspeed = CurrentSpeedKmh - TopSpeed
                    if overspeed > 73.5 {
                        dynShake = 0.36 + (overspeed - 73.5) * (0.08 / 52.5)
                    } else {
                        dynShake = 0.16 + overspeed * (0.20 / 73.5)
                    }
                    if dynShake > 0.65 { dynShake = 0.65 }
                }
                if cameraBoostActive {
                    var tierMinShake = 0.16
                    if NitroBoostTier == 2 {
                        tierMinShake = 0.22
                    } else if NitroBoostTier == 3 {
                        tierMinShake = 0.30
                    }
                    if dynShake < tierMinShake { dynShake = tierMinShake }
                }
                if dynShake > shakeIntensity {
                    shakeIntensity = dynShake
                }
            }

            var finalShakeX = KartCameraRuntime.CalcShakeX(ShakeTime, shakeIntensity)
            var finalShakeY = KartCameraRuntime.CalcShakeY(ShakeTime, shakeIntensity)
            var finalShakeZ = 0.0
            if shakeIntensity > 0.01 {
                finalShakeZ = (math.Sin(ShakeTime * 88.0) * (shakeIntensity * 0.35)) as float
            }
            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                var nitroRumble = nitroFeel * (0.65 + speedRatio * 0.35)
                if ImpactTimer > 0.0 || CrashCamSnapTimer > 0.0 {
                    nitroRumble = nitroRumble * 0.25
                }
                if nitroRumble > 1.15 { nitroRumble = 1.15 }
                finalShakeX = finalShakeX + ((math.Sin(ShakeTime * 29.0) * 0.045 + math.Sin(ShakeTime * 61.0) * 0.020) * nitroRumble)
                finalShakeY = finalShakeY + ((math.Sin(ShakeTime * 41.0) * 0.030 + math.Cos(ShakeTime * 83.0) * 0.014) * nitroRumble)
                finalShakeZ = finalShakeZ + ((math.Sin(ShakeTime * 53.0) * 0.030 + nitroKick * 0.035) * nitroRumble)
            }

            var camRotSharp = KartCameraRuntime.CalcCamRotSharp(CamRotationSharp, CamCatchUpSharp, cameraBoostActive, 0.0, CamAngularVelocityCap)

            LandingRecoverTimer = KartCameraRuntime.CalcLandingRecoverTimerNext(LandingRecoverTimer, dt)

            var isInLandingRecovery = LandingRecoverTimer > 0.0

            var camAngleDeltaDeg = math.QuaternionAngle(CamQuat, PrevCamQuat)
            if camAngleDeltaDeg < 0.0 { camAngleDeltaDeg = -camAngleDeltaDeg }
            CamAngularVelocity = camAngleDeltaDeg / dt

            camRotSharp = KartCameraRuntime.CalcCamRotSharp(CamRotationSharp, CamCatchUpSharp, cameraBoostActive, CamAngularVelocity, CamAngularVelocityCap)
            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                var nitroCameraLagDamp = 1.0 - NitroCamBlend * 0.16 - nitroKick * 0.12
                if isDriftActive {
                    nitroCameraLagDamp = 1.0 - NitroCamBlend * 0.08
                }
                if nitroCameraLagDamp < 0.70 { nitroCameraLagDamp = 0.70 }
                camRotSharp = camRotSharp * nitroCameraLagDamp
                if camRotSharp < 2.0 { camRotSharp = 2.0 }
            }

            if !IsStableGrounded && AirTime > 0.08 {
                var predDir = Vector3{-LastContactNx, -LastContactNy, -LastContactNz}
                var cPos = rawCarPos
                physics.SingleRaycast(cPos, predDir, PredLandingRayDist, nil, false,
                    out var pEnt, out var pPos, out var pDist, out var pNorm)
                var predOk = KartCameraRuntime.IsPredictiveLandingHitValid(pEnt, KartModel as entity, pNorm.Y, PredLandingMinNy)
                if predOk {
                    PredLandingNormal = pNorm
                }
                PredLandingBlend = KartCameraRuntime.CalcPredictiveLandingBlendNext(PredLandingBlend, predOk, dt, PredLandingSharp)
            } else {
                PredLandingBlend = KartCameraRuntime.CalcPredictiveLandingBlendRecover(PredLandingBlend, dt)
            }

            var camChaseTarget = StableVisualQuat
            if !IsStableGrounded && PredLandingBlend > 0.01 {
                camChaseTarget = KartCameraRuntime.BuildPredictiveCameraTarget(camChaseTarget, PredLandingNormal, PredLandingBlend)
            }
            if isInLandingRecovery {
                var recoveryProgress = KartCameraRuntime.CalcRecoveryProgress(LandingRecoverTimer, LandingRecoverDuration)
                camChaseTarget = KartCameraRuntime.BuildRecoveryCameraTarget(StableVisualQuat, StableGroundCamQuat, LandingRecoverTimer, LandingRecoverDuration)

                var recoverDamp = KartCameraRuntime.CalcRecoverDamp(recoveryProgress)
                StuntCamRoll = KartCameraRuntime.CalcRecoverScaledValue(StuntCamRoll, recoverDamp, 0.15)
                DriftVisualYawOffset = KartCameraRuntime.CalcRecoverScaledValue(DriftVisualYawOffset, recoverDamp, 0.25)
                CamDriftSlipYaw = KartCameraRuntime.CalcRecoverScaledValue(CamDriftSlipYaw, recoverDamp, 0.25)
                camRotSharp = KartCameraRuntime.CalcCamRotSharpAfterRecovery(camRotSharp, recoverDamp)
            }

            CamQuat = math.SlerpQuaternion(CamQuat, camChaseTarget, KartMath.CalcExpLerpFactor(camRotSharp, dt))
            PrevCamQuat = CamQuat

            var fovInertiaZ = KartCameraRuntime.CalcFovInertiaZ(CurrentFOV, FovMin)
            var targetBoostPull = KartCameraRuntime.CalcBoostPull(cameraBoostActive, CamBoostLagPulse)
            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                targetBoostPull = 0.22 * nitroFeel + 0.46 * nitroKick * nitroTierFeel
            }
            var boostPullSharp = 1.2
            if targetBoostPull > CamBoostPullCurrent { boostPullSharp = 7.0 }
            CamBoostPullCurrent = CamBoostPullCurrent + (targetBoostPull - CamBoostPullCurrent) * (dt * boostPullSharp)
            var boostPull = CamBoostPullCurrent

            CamLookAheadOffset = KartCameraRuntime.CalcLookAheadOffsetNext(CamLookAheadOffset, IsStableGrounded, speedRatio, CamLookAheadMax, dt, CamLookAheadSharp)

            if CrashCamSnapTimer > 0.0 {
                CrashCamSnapTimer -= dt
                if CrashCamSnapTimer < 0.0 { CrashCamSnapTimer = 0.0 }
            }
            
            var driftHeightTarget = 0.0
            var driftPitchTarget = 0.0
            var driftYawInwardTarget = 0.0
            var driftRollTarget = 0.0

            if isDriftActive && DriftBlend > 0.05 {
                var speedCamBonus = (CurrentSpeedKmh - 70.0) / 70.0
                if speedCamBonus < 0.0 { speedCamBonus = 0.0 }
                if speedCamBonus > 1.0 { speedCamBonus = 1.0 }

                // Giữ độ cao camera ổn định, không hạ thấp xuống mặt đường khi drift ở tốc độ cao
                driftHeightTarget = CamDriftHeightDropMax * DriftBlend
                driftPitchTarget = CamDriftPitchUpMax * DriftBlend

                // Khi drift: lấy hướng drift theo ActiveDriftDir để giữ góc nghiêng ổn định cả khi counter-steer
                var driftDir = ActiveDriftDir
                if driftDir == 0.0 { driftDir = turnInputForCam }
                if driftDir != 0.0 {
                    driftYawInwardTarget = -driftDir * CamDriftYawInwardMax * DriftBlend
                    // Nghiêng camera rõ rệt theo góc điện ảnh (~10.5° - 15.0° theo vận tốc)
                    driftRollTarget = -driftDir * (10.5 + DriftBlend * 2.5 + speedCamBonus * 2.0)
                }
            } else if turnInputForCam != 0.0 {
                // Nghiêng camera khi cua thường (~4.5°)
                driftRollTarget = -turnInputForCam * 4.5
            }
            if NitroCamBlend > 0.01 {
                var nitroDriftReadability = 1.0 - NitroCamBlend * 0.16
                if nitroDriftReadability < 0.84 { nitroDriftReadability = 0.84 }
                driftYawInwardTarget = driftYawInwardTarget * nitroDriftReadability
                driftRollTarget = driftRollTarget * nitroDriftReadability
            }

            var camDriftLerpIn = 3.5
            var camDriftLerpOut = 2.0
            var camDriftLerp = camDriftLerpIn
            if driftHeightTarget == 0.0 {
                camDriftLerp = camDriftLerpOut
            }
            var camDriftLerpT = 1.0 - math.Exponentiation(2.71828183, -(dt * camDriftLerp))
            CamDriftHeightDrop = CamDriftHeightDrop + (driftHeightTarget - CamDriftHeightDrop) * camDriftLerpT
            CamDriftPitchUp = CamDriftPitchUp + (driftPitchTarget - CamDriftPitchUp) * camDriftLerpT
            CamDriftYawInward = CamDriftYawInward + (driftYawInwardTarget - CamDriftYawInward) * camDriftLerpT

            // Xử lý riêng tốc độ nghiêng camera (Roll): nhạy và dứt khoát khi bẻ lái/drift, êm ái khi trả lái
            var rollLerp = 5.5
            if driftRollTarget == 0.0 {
                rollLerp = 4.2
            }
            var camDriftReversal = (driftRollTarget > 0.5 && CamDriftRoll < -0.5) || (driftRollTarget < -0.5 && CamDriftRoll > 0.5)
            if camDriftReversal { rollLerp = 7.5 }
            var rollLerpT = 1.0 - math.Exponentiation(2.71828183, -(dt * rollLerp))
            CamDriftRoll = CamDriftRoll + (driftRollTarget - CamDriftRoll) * rollLerpT
            if math.Abs(CamDriftHeightDrop) < 0.005 { CamDriftHeightDrop = 0.0 }
            if math.Abs(CamDriftPitchUp) < 0.01 { CamDriftPitchUp = 0.0 }
            if math.Abs(CamDriftYawInward) < 0.01 { CamDriftYawInward = 0.0 }
            if math.Abs(CamDriftRoll) < 0.01 { CamDriftRoll = 0.0 }

            // Góc duy trì camera theo tốc độ: giữ ổn định tầm nhìn xa, không chúc camera xuống đất khi bật Nitro
            var highSpeedFactor = (speedRatio - 0.35) / 0.65
            if highSpeedFactor < 0.0 { highSpeedFactor = 0.0 }
            if highSpeedFactor > 1.0 { highSpeedFactor = 1.0 }

            var speedPitchTarget = highSpeedFactor * 1.0
            var speedBackPull = highSpeedFactor * 0.45

            var nitroHeightTarget = 0.0
            var nitroPitchTarget = speedPitchTarget
            var nitroBackPull = speedBackPull

            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                nitroHeightTarget = 0.0
                nitroBackPull = speedBackPull + (0.15 * NitroCamBlend + 0.20 * nitroKick) * nitroTierFeel
                nitroPitchTarget = speedPitchTarget + 0.8 * NitroCamBlend
                if nitroPitchTarget > 2.2 { nitroPitchTarget = 2.2 }
            }
            var nitroPoseSharp = 4.5
            if nitroHeightTarget < CamNitroHeightDrop || nitroPitchTarget > CamNitroPitchUp {
                nitroPoseSharp = 9.0
            }
            CamNitroHeightDrop = CamNitroHeightDrop + (nitroHeightTarget - CamNitroHeightDrop) * KartMath.CalcExpLerpFactor(nitroPoseSharp, dt)
            CamNitroPitchUp = CamNitroPitchUp + (nitroPitchTarget - CamNitroPitchUp) * KartMath.CalcExpLerpFactor(nitroPoseSharp, dt)
            if math.Abs(CamNitroHeightDrop) < 0.005 { CamNitroHeightDrop = 0.0 }
            if math.Abs(CamNitroPitchUp) < 0.01 { CamNitroPitchUp = 0.0 }

            var camBackZ = -5.2 - fovInertiaZ - CamLagBack - boostPull - nitroBackPull
            if camBackZ > -5.35 { camBackZ = -5.35 }
            var camBackMinZ = -5.85
            if NitroCamBlend > 0.01 || nitroKick > 0.01 || highSpeedFactor > 0.5 {
                camBackMinZ = -5.90 - NitroCamBlend * 0.30 - nitroKick * 0.18 - highSpeedFactor * 0.30
                if camBackMinZ < -6.30 { camBackMinZ = -6.30 }
            }
            if camBackZ < camBackMinZ { camBackZ = camBackMinZ }
            if CrashCamSnapTimer > 0.0 {
                CamBoostPullCurrent = 0.0
            }

            var nitroBobX = 0.0
            var nitroBobY = 0.0
            var nitroBobZ = 0.0
            if NitroCamBlend > 0.01 || nitroKick > 0.01 {
                var bobRumble = nitroFeel * (0.60 + speedRatio * 0.40)
                if ImpactTimer > 0.0 || CrashCamSnapTimer > 0.0 {
                    bobRumble = bobRumble * 0.25
                }
                if bobRumble > 1.18 { bobRumble = 1.18 }
                nitroBobX = (math.Sin(ShakeTime * 35.0) * 0.0035 * bobRumble) as float
                nitroBobY = ((math.Sin(ShakeTime * 25.0) * 0.026 + math.Sin(ShakeTime * 50.0) * 0.010 + math.Cos(ShakeTime * 71.0) * 0.004) * bobRumble - 0.035 * nitroKick) as float
                nitroBobZ = ((math.Sin(ShakeTime * 32.0) * 0.024 + math.Cos(ShakeTime * 59.0) * 0.010) * bobRumble - 0.055 * nitroKick * nitroTierFeel) as float
            }
            var localOffset = Vector3{CurrentCamOffset + CamDriftSide + CamDriftSlipYaw * 0.02 + nitroBobX, BaseCamHeight + CurrentDropOffset + CamDriftHeightDrop + CamNitroHeightDrop + nitroBobY, camBackZ + nitroBobZ}
            
            var rotatedOffset = math.RotateVector(localOffset, CamQuat)
            var lookAheadVec = math.RotateVector(Vector3{0.0, 0.0, CamLookAheadOffset}, CamQuat)
            
            var desiredCamPos = Vector3{ 
                rawCarPos.X + rotatedOffset.X + lookAheadVec.X, 
                rawCarPos.Y + rotatedOffset.Y + lookAheadVec.Y, 
                rawCarPos.Z + rotatedOffset.Z + lookAheadVec.Z}

            var camUp = math.RotateVector(Vector3{0.0, 1.0, 0.0}, CamQuat)
            var camFocusPos = Vector3{rawCarPos.X + camUp.X * 0.65, rawCarPos.Y + camUp.Y * 0.65, rawCarPos.Z + camUp.Z * 0.65}

            var camRayX = desiredCamPos.X - camFocusPos.X
            var camRayY = desiredCamPos.Y - camFocusPos.Y
            var camRayZ = desiredCamPos.Z - camFocusPos.Z
            var camRayLen = math.Sqrt(camRayX * camRayX + camRayY * camRayY + camRayZ * camRayZ) as float
            CurrentCamPos = desiredCamPos
            if camRayLen > 0.10 {
                var camDir = Vector3{camRayX / camRayLen, camRayY / camRayLen, camRayZ / camRayLen}
                var camRgt = math.RotateVector(Vector3{1.0, 0.0, 0.0}, CamQuat)

                var minFraction = 1.0
                var hasHit = false
                var bestNorm = Vector3{0.0, 0.0, 0.0}

                // 1. Center ray
                physics.SingleRaycast(camFocusPos, camDir, camRayLen, nil, false, out var cEnt, out var cPos, out var cDist, out var cNorm)
                if KartGroundProbe.IsValidHit(cEnt, KartModel as entity<Rigidbody>) {
                    var safeDistC = cDist - CamCollisionBuffer
                    if safeDistC < CamCollisionMinDist { safeDistC = CamCollisionMinDist }
                    var fracC = (safeDistC / camRayLen) as float
                    if fracC < minFraction {
                        minFraction = fracC
                        bestNorm = cNorm
                        hasHit = true
                    }
                }

                // 2. Left probe (camera frustum left edge)
                var tgtLft = Vector3{desiredCamPos.X - camRgt.X * 0.45, desiredCamPos.Y - camRgt.Y * 0.45, desiredCamPos.Z - camRgt.Z * 0.45}
                var lRayX = tgtLft.X - camFocusPos.X
                var lRayY = tgtLft.Y - camFocusPos.Y
                var lRayZ = tgtLft.Z - camFocusPos.Z
                var lRayLen = math.Sqrt(lRayX * lRayX + lRayY * lRayY + lRayZ * lRayZ) as float
                if lRayLen > 0.10 {
                    var lDir = Vector3{lRayX / lRayLen, lRayY / lRayLen, lRayZ / lRayLen}
                    physics.SingleRaycast(camFocusPos, lDir, lRayLen, nil, false, out var lEnt, out var lPos, out var lDist, out var lNorm)
                    if KartGroundProbe.IsValidHit(lEnt, KartModel as entity<Rigidbody>) {
                        var safeDistL = lDist - CamCollisionBuffer
                        if safeDistL < CamCollisionMinDist { safeDistL = CamCollisionMinDist }
                        var fracL = (safeDistL / lRayLen) as float
                        if fracL < minFraction {
                            minFraction = fracL
                            bestNorm = lNorm
                            hasHit = true
                        }
                    }
                }

                // 3. Right probe (camera frustum right edge)
                var tgtRgt = Vector3{desiredCamPos.X + camRgt.X * 0.45, desiredCamPos.Y + camRgt.Y * 0.45, desiredCamPos.Z + camRgt.Z * 0.45}
                var rRayX = tgtRgt.X - camFocusPos.X
                var rRayY = tgtRgt.Y - camFocusPos.Y
                var rRayZ = tgtRgt.Z - camFocusPos.Z
                var rRayLen = math.Sqrt(rRayX * rRayX + rRayY * rRayY + rRayZ * rRayZ) as float
                if rRayLen > 0.10 {
                    var rDir = Vector3{rRayX / rRayLen, rRayY / rRayLen, rRayZ / rRayLen}
                    physics.SingleRaycast(camFocusPos, rDir, rRayLen, nil, false, out var rEnt, out var rPos, out var rDist, out var rNorm)
                    if KartGroundProbe.IsValidHit(rEnt, KartModel as entity<Rigidbody>) {
                        var safeDistR = rDist - CamCollisionBuffer
                        if safeDistR < CamCollisionMinDist { safeDistR = CamCollisionMinDist }
                        var fracR = (safeDistR / rRayLen) as float
                        if fracR < minFraction {
                            minFraction = fracR
                            bestNorm = rNorm
                            hasHit = true
                        }
                    }
                }

                if hasHit {
                    if minFraction < 0.0 { minFraction = 0.0 }
                    if minFraction > 1.0 { minFraction = 1.0 }
                    var finalSafeDist = (camRayLen * minFraction) as float
                    if finalSafeDist < CamCollisionMinDist { finalSafeDist = CamCollisionMinDist }
                    if finalSafeDist > camRayLen { finalSafeDist = camRayLen }

                    var safePos = Vector3{
                        camFocusPos.X + camDir.X * finalSafeDist,
                        camFocusPos.Y + camDir.Y * finalSafeDist,
                        camFocusPos.Z + camDir.Z * finalSafeDist}

                    var pushNx = bestNorm.X * 0.20
                    var pushNy = bestNorm.Y * 0.20
                    if bestNorm.Y > 0.60 {
                        pushNy = 0.0
                    }
                    var pushNz = bestNorm.Z * 0.20

                    CurrentCamPos = Vector3{
                        safePos.X + pushNx,
                        safePos.Y + pushNy,
                        safePos.Z + pushNz}
                }
            }

            var camEntity = MyClientCam as entity<Entity>

            var composedQ = KartCameraRuntime.ComposeCameraRotation(CamQuat, CamDriftRoll, StuntCamRoll, CamAirRoll, CamDriftSlipYaw, CamVelocityYaw, CamAirPitch, ShakeTime, shakeIntensity)

            var finalCamEuler = math.QuaternionToEulerAngle(composedQ)
            var targetCamEuler = Vector3{
                finalCamEuler.X + finalShakeX + BaseCamPitch + CamDriftPitchUp + CamNitroPitchUp,
                finalCamEuler.Y + finalShakeY + CamDriftYawInward,
                finalCamEuler.Z + finalShakeZ}

            if IsIntroBlendingToCar {
                IntroBlendTimer += dt
                if IntroBlendTimer >= IntroBlendDuration {
                    IntroBlendTimer = IntroBlendDuration
                    IsIntroBlendingToCar = false
                }
                var blendT = IntroBlendTimer / IntroBlendDuration
                if blendT < 0.0 { blendT = 0.0 }
                if blendT > 1.0 { blendT = 1.0 }

                // SmoothStep Easing (3t^2 - 2t^3): sà xuống và đáp mượt mà vào đuôi xe
                var smoothT = blendT * blendT * (3.0 - 2.0 * blendT)

                var blendedPos = math.LerpVector3(IntroBlendStartPos, CurrentCamPos, smoothT)
                camEntity<Transform>.Position = blendedPos

                var qIntro = math.EulerAngleToQuaternion(IntroBlendStartRot)
                var qTarget = math.EulerAngleToQuaternion(targetCamEuler)
                var blendedQ = math.SlerpQuaternion(qIntro, qTarget, smoothT)
                camEntity<Transform>.Rotation = math.QuaternionToEulerAngle(blendedQ)

                var blendedFOV = math.Lerp(IntroBlendStartFOV, CurrentFOV, smoothT)
                MyClientCam<camera.CustomCamera>.FOV = blendedFOV
            } else {
                camEntity<Transform>.Position = CurrentCamPos
                camEntity<Transform>.Rotation = targetCamEuler
            }
        }



        // -----------------------------------------------------
        // UPDATE BLOCK: NETWORK SYNC TO SERVER PROXY
        // Timing notes:
        // - Runs after gameplay update so server proxy receives latest transform/boost/drift state.
        // - Still runs outside !isMovementLocked block so reset/locked transform can be synced.
        // - Keep inline: current compiler does not support safely passing Event/entity/component access through a network helper.
        // -----------------------------------------------------
        // Đếm ngược 3 giây sau khi về đích để ngắt đồng bộ mạng lên Server
        if CpIsRaceFinished && PostFinishSyncTimer > 0.0 {
            PostFinishSyncTimer -= dt
            if PostFinishSyncTimer < 0.0 { PostFinishSyncTimer = 0.0 }
        }

        SyncTimer -= dt
        if SyncTimer <= 0.0 {
            SyncTimer = 0.033 
            var allowSync = true
            // Ngắt hoàn toàn đồng bộ Server sau 3.0s kể từ khi cán đích
            if CpIsRaceFinished && PostFinishSyncTimer <= 0.0 {
                allowSync = false
            }
            if allowSync {
                var kPos = KartModel<Transform>.Position
                var kVel = KartModel<Rigidbody>.Velocity
                var syncEuler = math.QuaternionToEulerAngle(PhysicsQuat)
                var syncBoost = 0.0
                if IsBoosting { syncBoost = 1.0 }
                var syncDrift = 0.0
                if isDrift { syncDrift = 1.0 }
                std.DispatchEventToEntity(SyncKartStateServer, thisEntity, PlatformType.Server, List<float>{kPos.X, kPos.Y, kPos.Z, syncEuler.Y, kVel.X, kVel.Y, kVel.Z, syncBoost, syncDrift})
            }
        }

        // =====================================================
        // UPDATE BLOCK: KART AUDIO (Engine RPM, Drift, 3 Tier Nitro, Deacc)
        // =====================================================
        if !AudioInited {
            KartAudio.InitAllSounds(out var eSnd, out var sSnd, out var n1, out var n2, out var n3, out var up, out var deacc, out var count, out var go, out var finish)
            EngineSound = eSnd
            SkidSound = sSnd
            Nitro1Sound = n1
            Nitro2Sound = n2
            Nitro3Sound = n3
            AccelSound = up
            DeaccSound = deacc
            CountdownSound = count
            GoSound = go
            FinishSound = finish
            AudioInited = true
        }

        if AudioInited {
            // 1. Âm thanh động cơ: pitch và volume theo vòng tua/tốc độ xe (vẫn phát khi AI Autopilot tự lái)
            var audioMutedOnFinish = CpIsRaceFinished && !IsAiAutopilot
            IsEngineAudioPlaying = KartAudio.UpdateEngine(EngineSound, IsEngineAudioPlaying, CurrentSpeedKmh, TopSpeed, isMovementLocked, IsBoosting, audioMutedOnFinish)

            // 2. Âm thanh Drift: mở volume khi ôm cua rê bánh / phanh drift (giảm nhỏ khi đi thẳng)
            var isDriftingNow = isDriftActive || (IsBraking && CurrentSpeedKmh > 20.0)
            var isSteering = IsTurningLeft || IsTurningRight
            IsSkidAudioPlaying = KartAudio.UpdateDrift(SkidSound, isDriftingNow, IsSkidAudioPlaying, DriftBlend, isSteering, CurrentSpeedKmh)

            // 3. Kích hoạt âm thanh Nitro theo cấp độ (Tier 1/2/3) ngay khi bắt đầu Boost
            if IsBoosting && !PrevIsBoostingAudio {
                var nitroTier = 1
                if NitroBoostTier == 3 {
                    nitroTier = 3
                } else if NitroBoostTier == 2 {
                    nitroTier = 2
                }
                KartAudio.TriggerNitro(nitroTier, Nitro1Sound, Nitro2Sound, Nitro3Sound)
            }
            PrevIsBoostingAudio = IsBoosting

            // 4. Tiếng dồn số / nhả ga / phanh ở tốc độ cao (High Deacc)
            if DeaccAudioCooldown > 0.0 { DeaccAudioCooldown -= dt }
            if DeaccAudioCooldown <= 0.0 && !IsBoosting && CurrentSpeedKmh > 100.0 {
                var shouldTriggerDeacc = false
                if IsBraking {
                    shouldTriggerDeacc = true
                } else if isDriftingNow && (PrevSpeedForAudio - CurrentSpeedKmh) > 2.0 {
                    shouldTriggerDeacc = true
                } else if (PrevSpeedForAudio - CurrentSpeedKmh) > 5.0 {
                    shouldTriggerDeacc = true
                }

                if shouldTriggerDeacc {
                    KartAudio.TriggerDeacc(DeaccSound)
                    DeaccAudioCooldown = 2.5
                }
            }

            // 5. Tiếng thốc ga / lên số (Up)
            if AccelAudioCooldown > 0.0 { AccelAudioCooldown -= dt }
            if AccelAudioCooldown <= 0.0 && !IsBraking && CurrentSpeedKmh > 70.0 && (CurrentSpeedKmh - PrevSpeedForAudio) > 10.0 {
                KartAudio.TriggerAccel(AccelSound)
                AccelAudioCooldown = 3.0
            }

            PrevSpeedForAudio = CurrentSpeedKmh
        }
    }
}


