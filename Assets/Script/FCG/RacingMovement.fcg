//RacingMovement.fcg
import "Math.fcc" as math
import "Physics.fcc" as physics
import "StdLibrary.fcc" as std
import "Time.fcc" as time
import "Camera.fcc" as camera
import "Convert.fcc" as convert
import "List.fcc" as list
import "Strings.fcc" as strings
import "../../../Temp/UGCLanguage/editorGen/EditorGenLib.fcc" as EditorGenLib
import "./Kart/KartVisual.fcg" as KartVisual
import "./Kart/KartNitro.fcg" as KartNitro
import "./Kart/KartMath.fcg" as KartMath
import "./Kart/KartCameraMath.fcg" as KartCameraMath
import "./Kart/KartSteeringMath.fcg" as KartSteeringMath
import "./Kart/KartDriftMath.fcg" as KartDriftMath
import "./Kart/KartVisualMath.fcg" as KartVisualMath
import "./Kart/KartSpeedometer.fcg" as KartSpeedometer
import "./Kart/KartPhysicsMath.fcg" as KartPhysicsMath
import "./Kart/KartPhysics.fcg" as KartPhysics
import "./Kart/KartLifecycle.fcg" as KartLifecycle
import "./Kart/KartGroundingMath.fcg" as KartGroundingMath
import "./Kart/KartSkidmark.fcg" as KartSkidmark
import "./Kart/KartCameraRuntime.fcg" as KartCameraRuntime
import "./Kart/KartDriftState.fcg" as KartDriftState
import "./Kart/KartSteeringRuntime.fcg" as KartSteeringRuntime
import "./Kart/KartGroundProbe.fcg" as KartGroundProbe
import "./Kart/KartCarFactory.fcg" as KartCarFactory
import "./Kart/KartCCD.fcg" as KartCCD
import "./Kart/KartCheckpoint.fcg" as KartCheckpoint
import "./Kart/KartAudio.fcg" as KartAudio
import "./Kart/KartGuidePath.fcg" as KartGuidePath

// ============================================================
// RacingMovement.fcg — Anti-Gravity Arcade Kart
// ============================================================
[platform_client]
graph RacingMovement {

    event RequestRaceState(playerEnt entity<Player>) {}

    // =========================================================
    // REGION: CONFIG / TUNING DATA
    // Dependency notes:
    // - These values are read by Physics, Drift, Nitro, Visual, Camera, and UI speed display.
    // - Phase 0 only: comments/regions only. Do not reorder or retune values here.
    // =========================================================    // THÔNG SỐ XE — Nhập thẳng bằng KM/H (đã đồng bộ với đồng hồ)
    // =========================================================
    SpeedUnitScale      float = 4.0    // Project arcade calibration: 1 physics unit = 144 display km/h (36 x 4)

    TopSpeed            float = 365.0    // Tốc độ tối đa khi chạy thẳng
    AccelLerpRate       float = 0.18     // Tăng tốc arcade (tăng độ bốc xuất phát lúc đầu)
    BoostLerpRate       float = 1.2      // Lerp rate khi đang boost
    BrakeLerpRate       float = 4.5      // Phanh có lực nhưng không làm xe chết tốc đột ngột
    ReverseSpeed        float = 30.0     // Tốc độ tối đa khi chạy lùi (quay lại trước khi tăng 30%)
    ReverseLerpRate     float = 1.0      // Lerp rate khi chạy lùi (quay lại trước khi tăng 30%)
    Grip                float = 0.94     // Giảm độ dính để xe có load/slip tự nhiên
    Steer               float = 1.85     // Cua thường: tăng từ 1.30 lên 1.85 để ôm cua nhạy bén, dứt khoát không bị thiếu lái
    DriftSteer          float = 2.55     // Cua drift: tăng từ 1.90 lên 2.55 để vào drift lanh, nhẹ và ôm cua ngọt (chuẩn Ace Racer / Asphalt 8)
    
    // --- Tỷ lệ tốc độ ---
    TurnSpeedRatio      float = 0.95     // Cua thường: cap 95% TopSpeed
    DriftSustainRatio   float = 0.88     // Giữ đà lướt tốc độ cao (88%), không bị ghìm hụt tốc khi drift
    DriftBrakeMult      float = 1.6      // Hãm drift nhẹ nhàng, giữ trớn lướt xe như Asphalt 8
    DriftOverspeedBrakeMult float = 3.5  // Hãm overspeed mượt hơn sau Nitro
    DriftEntryDecelMult float = 0.15     // Vào drift êm, không bị khựng xe một nhịp
    DriftTurnSpeedRatio float = 0.88     // Ôm cua sâu nhưng vẫn giữ tốc độ cực tốt (88%)

    // --- Arcade drift flow (S-curve / chain / mobile smart drift) ---
    DriftFlowHoldTime   float = 0.05     // Release gần như tức thì; chỉ giữ micro-carry chống gãy xe
    DriftEnterSharp     float = 7.5      // Vào drift nhanh nhạy, bứt góc tức thì
    DriftExitSharp      float = 5.2      // Thu slide dứt khoát (tăng từ 1.8 lên 5.2), nhả nút là thoát drift ngay không bị lết lâu
    DriftLatSlideGain   float = 0.06     // Giảm trượt dạt ngang để xe không bị quăng đuôi
    DriftLatGripKeep    float = 0.88     // Tăng bám ngang khi drift để xe giữ đường chắc chắn
    DriftCentrifugalGain float = 0.04    // Giảm lực ly tâm đẩy văng ngang đuôi xe
    DriftSteerAuthority float = 1.15     // Trợ lực cua drift nhẹ nhàng, thanh thoát
    DriftYawAssist      float = 9.5      // Trợ lực xoay thân xe nhạy bén, hết cảm giác nặng lái
    CounterSteerBoost   float = 0.45     // Trả lái linh hoạt, thoát cua dứt khoát
    DriftSlipRetain     float = 0.15     // Giảm quán tính trượt dạt ngang
    DriftSlipDecay      float = 8.0      // Triệt tiêu quán tính trượt nhanh (tăng từ 4.2 lên 8.0), thoát drift dứt khoát
    // Velocity alignment sharpness per-state
    // Higher = xe thật sự đổi hướng theo yaw nhanh hơn; lower = trượt thẳng nhiều hơn.
    VelAlignGrounded    float = 16.0     // Bám chặt theo hướng đầu xe khi cua thường, triệt tiêu quăng ngang
    VelAlignDrift       float = 18.0     // Drift bám quỹ đạo ôm cua
    VelAlignAir         float = 0.5   // Trên không vẫn giữ quán tính
    DriftVelAlignLow    float = 16.0     // Vận tốc bám sát vòng cua ở tốc độ thấp, chống trôi văng ngang
    DriftVelAlignHigh   float = 26.0     // Vận tốc bám sát vòng cua ở tốc độ cao, cua thật chuẩn xác
    DriftSteerRampFloor float = 0.94     // Phản hồi drift nhanh nhưng không snap
    DriftVelocityAlignSharp float = 1.8  // Vận tốc lệch hướng xe (arcade decouple) [legacy, unused]
    DriftVisualSlipScale float = 0.15    // Giảm góc trượt đuôi xe trên hình ảnh để không bị quăng đuôi
    HighSpeedSteerStart float = 120.0    // Bắt đầu giảm nhạy lái từ 120 km/h để giữ ổn định tốc độ cao
    HighSpeedSteerFloor float = 0.68     // Giữ lại 68% lực lái ở tốc độ tối đa chuẩn AAA
    SteerRampSharp      float = 9.0      // Đánh lái êm ái hơn, bớt giật gắt lúc đầu
    BoostGripMult       float = 1.0 
    BoostSteerMult      float = 1.12     // Nitro vẫn lanh nhưng không mất line ở tốc độ cao
    PostDriftNitroBoostTime float = 3.0  // Cửa sổ nitro mạnh sau drift
    PostDriftNitroAccelMult float = 1.55 // Nitro = hồi momentum sau drift
    PostDriftNitroTopMult   float = 1.06
    MiniTurboShortBoost float = 0.20    // Burst ngắn sau drift tối thiểu
    MiniTurboMediumBoost float = 0.32   // Burst trung bình sau drift
    MiniTurboLongBoost  float = 0.42    // Burst dài sau drift hoàn chỉnh

    Gravity             float = 20.0     // Lực hút Trái Đất kéo xe xuống khi bay (Gravity)
    ExtraAirGravity     float = 5.0      // Lực đè thêm ép xe rớt xuống nhanh hơn (Extra Air Gravity)
    GroundGravity       float = 38.0     // Lực nam châm hút dính xe vào mặt đường (Surface-Normal Gravity)
    DriftDownforceBonus float = 42.0     // Đủ bám mặt đường nhưng vẫn cho thân xe có độ nổi
    Suspension          float = 0.2      // Độ cứng của nhún phuộc (Suspension)

    // --- Lightweight suspension (Goal #5, arcade) ---
    SuspRestLength      float = 0.58     // Desired contact distance when settled (world units) - scaled for 1.6 sphere
    SuspSpring          float = 60.0     // Soft arcade spring strength (non-bouncy)
    SuspDamping         float = 55.0     // Heavy damping to eliminate bouncing/oscillation
    SuspMaxForce        float = 60.0     // Clamp
    SuspHitMinNy        float = 0.22     // Ignore near-walls (normal.Y too low)

    // --- Fake CCD / Anti-Tunneling ---
    UsePredictiveWallCcd bool = false    // Engine collision là authority; tắt raycast CCD để tránh tự đẩy xe trượt
    UseCustomWallScrapeResponse bool = false // Không tự ghi đè vận tốc cạnh tường
    CcdSafetyMultiplier  float = 2.5
    CcdKartRadius        float = 0.80
    CcdTravelThreshold   float = 1.2
    CcdWallNormalYMax    float = 0.3
    CcdMinExtent         float = 0.1      // Lowered threshold for better collision detection at all speeds
    CcdSkinWidth         float = 0.12     // Stop slightly before hit point to avoid embedding
    WallSlideFriction    float = 0.95     // Engine-native wall response; không can thiệp vận tốc tiếp tuyến
    WallScrapeDecelRate  float = 0.32     // Legacy tuning value; side scrape preserves tangent velocity
    WallScrapeMinAccelMult float = 0.96  // Giữ 96% gia tốc khi cạ tường để không bị hụt ga
    WallAlignSharpness   float = 14.0     // Tốc độ bẻ hướng xe song song theo mặt tường (rad/s) khi đâm chéo
    WallUnstickPush      float = 8.0      // Lực đẩy tách khỏi tường khi người chơi bấm cua ngược ra để hết cạ
    WallAntiClimbDownForce float = 120.0     // Ép xe xuống khi va hàng rào/tường để tránh sphere leo mép
    WallUpVelocityClamp  float = -2.0      // Không cho vận tốc Y dương khi đang đâm wall
    WallStopForwardKeep  float = 0.12      // Giữ một phần momentum sau va chạm trực diện
    WallStopBackoff      float = 0.35      // Đẩy tâm collider lùi thêm khỏi wall để tránh leo mép
    CrashPushMinDist     float = 0.5      // Va chạm >=250km/h: bật ra 0.5m
    CrashPushMaxDist     float = 3.5      // 350km/h: bật ra tối đa khoảng 3.5m
    CrashCamNearZ        float = -2.6     // Camera snap gần khi đâm, không lerp

    // --- Nitro (Asphalt 8 style) ---
    BoostTopSpeed       float = 405.0    // Tốc độ tối đa xé gió khi xịt Nitro
    NitroChargeRate     float = 95.0     // Nạp điểm Nitro hồi lại thanh cực nhanh (tăng gần gấp đôi x1.9)
    NitroDrainRate      float = 7.0       // Giảm 30% tiêu hao -> Nitro xịt được lâu hơn (~14s liên tục)
    MaxNitroCharge      float = 100.0     // Dung lượng bình Nitro chuẩn 100%

      // --- Drift traction ---
    DriftGrip           float = 0.86     // Cắt bám khi ấn drift để xe trơn trượt văng đuôi
    DriftGripAir        float = 0.55     // Trên không: giữ momentum ngang
    DriftTimeRequired   float = 1.0      // Thời gian lết tối thiểu (DriftTimeRequired)
    DriftHardBrakeTime  float = 2.0      // Thời gian ấn phanh để xe khựng lại thay vì lết (HardBrakeTime)

    // =========================================================
    // REGION: ORCHESTRATOR-OWNED RUNTIME STATE
    // Dependency notes:
    // - RacingMovement owns major gameplay state; subsystem code should read/write through this graph.
    // - Future extracted files should avoid owning duplicate state unless explicitly planned.
    // =========================================================
    // TRẠNG THÁI (STATE)
    // =========================================================
    FacingAngle     float = 0.0          // Góc quay mặt mũi xe sang trái/phải (Yaw Angle)
    CurrentPitch    float = 0.0          // Góc ngóc đầu hoặc cắm đầu của xe (Pitch Angle)
    CurrentRoll     float = 0.0          // Góc nghiêng lật lườn xe (Roll Angle)
    CurrentSpeedKmh float = 0.0          // Tốc độ smoothed dùng cho camera/visual/gameplay feel (KM/H)
    UISpeedKmh      float = 0.0          // Tốc độ hiển thị ổn định cho ControlUI (KM/H)
    UIKartPos       Vector3 = Vector3{0.0, 0.0, 0.0} // Vị trí xe cho HUD direction arrow
    UIKartYaw       float = 0.0          // Yaw xe cho HUD direction arrow
    RaceStartUiTimer float = 0.0     // 3-2-1 countdown timer for LoadUI
    RaceGoUiTimer    float = 0.0     // GO popup timer for LoadUI
    LobbyTimerSec    int   = 60      // Đếm ngược phòng chờ nhận từ Server
    IsLobbyActive    bool  = true    // Còn trong phòng chờ
    StartCameraDelayTimer float = 0.0  // đợi trước khi chuyển camera sang xe lúc start
    HasSwitchedStartCamera bool = false
    DriveForwardSpeed float = 0.0        // Internal forward speed authority in physics units
    IsFinishDecelerating bool = false    // Đang giảm tốc độ dần sau khi cán đích
    FinishDecelTimer  float = 0.0        // Thời gian còn lại để dừng hẳn sau đích (3-5s)
    FinishDecelDuration float = 4.0      // Tổng thời gian giảm tốc (tính theo tốc độ cán đích)
    FinishInitialSpeed float = 0.0       // Tốc độ lúc vừa cán đích để giảm dần đều

    [preview]
    KartModel       entity<Entity>

    // Waypoint Guide Path (Dải 20 mũi tên dẫn hướng đường đua AAA)
    GuideArrows            List<entity<Entity>> = nil
    GuideArrowsInitialized bool                 = false
    GuideArrowsVisible     bool                 = false
    GuideArrowScale        float                = 1.0     // Kích thước chuẩn mặc định (1.0)


    MyClientCam     entity<camera.CustomCamera> = nil
    TargetHiddenLayer int = -1
    CameraWatchdogTimer float = 0.0

    // Cinematic Intro Flycam (Client-Only phòng chờ, quét động từ IntroCameraRoot)
    IsIntroCamActive           bool  = true
    InitialDefaultCamDuration  float = 20.0    // Thời gian giữ nguyên camera mặc định khi mới vào game (20s)
    InitialDefaultCamTimer     float = 0.0     // Timer đếm thời gian giữ camera mặc định
    HasSwitchedToIntroCam      bool  = false   // Đã bắt đầu chuyển sang chuỗi Intro Camera sau 20s
    IntroShotIndex             int   = 0
    IntroShotTimer             float = 0.0
    IntroShotDuration          float = 3.5     // Thời lượng mỗi góc quay Intro (3.5s x 4 shot = 14s)
    IntroWatchdogTimer         float = 0.0
    HasScannedIntroCameras     bool  = false
    TotalIntroShots            int   = 4

    // Cinematic Track Flyby (Flycam từ WP 51 về WP 1 rồi đáp sau đuôi xe)
    LobbySmoothTimer           float   = 60.0
    HasStartedFinalSectorFlyby bool    = false
    FlybyInitialized           bool    = false
    FlybyRunTimer              float   = 0.0
    FlybyStartWp               int     = 20     // Waypoint bắt đầu Flycam (WP 20 -> WP 1 -> Đuôi xe xuất phát)
    FlybyTotalDuration         float   = 10.0   // Thời gian Flycam lướt từ WP 20 về vạch xuất phát (10 giây cuối)
    FlybyCamHeight             float   = 2.8    // Độ cao camera so với mặt đường
    FlybySpeedMult             float   = 1.0
    FlybyCurrentCamPos         Vector3 = Vector3{0.0, 0.0, 0.0}
    FlybyCurrentCamRot         Vector3 = Vector3{0.0, 0.0, 0.0}
    FlybyDist                  List<float> = nil
    FlybyTotalDist             float   = 0.0
    IntroAllShotsCompleted     bool    = false  // Đã chiếu trọn vẹn 1 lần tất cả góc Intro Camera
    // Cinematic Letterbox UI & Shutter Blackout Transition
    CinematicBarTargetHeight   float   = 0.0    // 0.0: ẩn, 110.0: viền điện ảnh 21:9 khuất nhiều, 400.0: đóng đen kín màn hình
    CinematicBarCurrentHeight  float   = 0.0    // Chiều cao thực tế đang áp dụng (smooth lerp)
    IsIntroShutterActive       bool    = false  // Trạng thái Shutter Blackout giữa Intro và Flycam
    IntroShutterTimer          float   = 0.0    // Timer của Shutter Transition
    IntroShutterDuration       float   = 2.20   // Tổng thời lượng Shutter (0.95s đóng -> nghỉ tĩnh lặng 0.30s -> 0.95s mở)
    IntroShutterCutDone        bool    = false  // Cờ đánh dấu đã cut cam sang WP 20 trong bóng tối

    // Cinematic Swoop-In Transition (Flycam -> Car Chase Cam)
    IsIntroBlendingToCar   bool    = false
    IntroBlendTimer        float   = 0.0
    IntroBlendDuration     float   = 1.7
    IntroBlendStartPos     Vector3 = Vector3{0.0, 0.0, 0.0}
    IntroBlendStartRot     Vector3 = Vector3{0.0, 0.0, 0.0}
    IntroBlendStartFOV     float   = 65.0

    IntroP_Start           List<Vector3> = nil
    IntroP_End             List<Vector3> = nil
    IntroR_Start           List<Vector3> = nil
    IntroR_End             List<Vector3> = nil

    // Skidmarks tracking
    SkidSensors     List<entity<Entity>> = nil
    SkidLines       List<object> = nil
    SkidPoints      List<object> = nil

    // Wheel & Steering visual animation
    WheelNodesInited    bool = false
    ClientVisualCar     entity<Entity> = nil   
    MomentNode          entity<Entity> = nil   
    BaseVisualLean      float = 8.5             // Giam do nghieng than xe khi cua
    BaseCamOffset       float = 0.45            
    BaseSkidWidth       float = 0.4            
    CurrentVisualLean   float = 0.0            
    CurrentVisualYaw    float = 0.0            
    IsFlatSpinning      bool  = false          
    FlatSpinSpeed       float = 400.0          
    FlatSpinVisualAngle float = 0.0            
    SpinDir             float = 1.0            
    StuntCamRoll        float = 0.0            
    LandingSlidePwr     float = 0.0            
    StuntCooldown       float = 0.0            
    UnlockRequestTimer  float = 0.0            
    CurrentCamOffset    float = 0.0            

    // AlphaT8 Camera Additive Modules
    CamDriftRoll       float = 0.0
    CamDriftSide       float = 0.0
    CamVelocityYaw     float = 0.0
    CamAirPitch        float = 0.0
    CamAirRoll         float = 0.0
    CamLagBack         float = 0.0
    CamBoostPullCurrent float = 0.0

    CamDriftRollMax    float = 16.0      // Dutch tilt rõ hơn khi vào drift
    CamDriftSideMax    float = 1.05      // Mở không gian phía trong cua nhưng vẫn giữ xe trong khung
    CamVelocityYawMax  float = 18.0      // Cho camera đọc hướng velocity rõ hơn
    CamAirPitchMax     float = -5.0
    CamLagBackMax      float = 0.80
    CamBoostLagPulse   float = 2.8   // Pulse Nitro rõ nhưng vẫn kiểm soát được khung hình
    CamFovBreathAmp    float = 3.5       // Speed sensation rõ nhưng không gây méo/hoa mắt
    CamCatchUpSharp    float = 15.0
    CamCollisionBuffer float = 0.55     // Kéo camera cách tường/núi một khoảng để tránh xuyên vật thể
    CamCollisionMinDist float = 1.2     // Khoảng gần xe tối thiểu khi camera bị ép sát

    // Camera Base Perspective (AAA Arcade / Asphalt 8 / Ace Racer framing)
    // Nâng camera và lùi xa vừa đủ để triệt tiêu biến dạng góc rộng, giữ dáng xe thon gọn và tầm nhìn rộng
    BaseCamHeight      float = 1.15     // Nâng cao camera lên 1.15m để bao quát rõ mặt đường phía trước qua mui xe
    BaseCamPitch       float = 6.5      // Góc nhìn chúc 6.5° xuống xe và mặt đường phía trước

    // Asphalt 8 / Ace Racer Drift Camera: hạ thêm + ngước thêm + nghiêng Dutch Tilt + liếc vào thân xe
    CamDriftHeightDrop float = 0.0      // Runtime: current Y drop offset khi drift
    CamDriftPitchUp    float = 0.0      // Runtime: current pitch up offset khi drift
    CamDriftYawInward  float = 0.0      // Runtime: current inward yaw pan khi drift (liếc máy quay vào hông/bánh xe)
    CamDriftHeightDropMax float = -0.04 // Giữ độ cao camera ổn định khi drift, không hạ sát đất
    CamDriftPitchUpMax float = 1.2      // Giảm góc chúc thêm khi drift để không mất tầm nhìn xa
    CamDriftYawInwardMax float = 5.0    // Drift: liếc rõ hơn vào thân xe và apex

    // Asphalt 8 / Ace Racer Nitro Camera: giữ tầm nhìn thoáng khi bật Nitro
    CamNitroHeightDrop float = 0.0      // Runtime: current Y drop khi Nitro
    CamNitroPitchUp    float = 0.0      // Runtime: current pitch up khi Nitro
    NitroCamBlend      float = 0.0      // Camera-only boost feel blend; does not affect vehicle physics
    NitroCamKickTimer  float = 0.0      // Short camera punch window after Nitro activation
    NitroCamKickDuration float = 0.52
    CamNitroHeightDropMax float = 0.0   // Không hạ thấp camera khi xịt Nitro
    CamNitroPitchUpMax float = 1.0      // Giữ góc nhìn thẳng thoáng khi Nitro

    // Drift Entry Dip (nhún phuộc + chúi mũi khi vào drift)
    DriftEntryDipPitch float = 0.0      // Runtime: góc chúi mũi xe hiện tại
    DriftEntryDipRoll  float = 0.0      // Runtime: góc ép phuộc bên ngoài cua hiện tại
    DriftEntryDipPitchMax float = -2.4  // Chúi mũi rõ hơn khi chuyển tải vào drift (độ)
    DriftEntryDipRollMax float = 2.0    // Giam do nghieng ep phuoc khi drift

    SteeringNodes       List<entity<Entity>> = nil
    WheelNodes          List<entity<Entity>> = nil
    InitSteerRot       List<object> = nil   
    InitWheelRot       List<object> = nil   
    CurrentRollAngle    float = 0.0
    CurrentSteerAngle   float = 0.0

    // VFX cached lists + state tracking 
    NitroEffects        List<entity<Entity>> = nil
    DriftEffects        List<entity<Entity>> = nil
    ScrapeEffectsL      List<entity<Entity>> = nil
    ScrapeEffectsR      List<entity<Entity>> = nil
    PrevIsBoosting      bool = false
    PrevIsDrift         bool = false
    PrevIsScrapingLeft  bool = false
    PrevIsScrapingRight bool = false
    IsNitroRecovering   bool = false     // Hậu-nitro: Lerp mượt về TopSpeed
    DriftBlend          float = 0.0       // 0–1: vào/ra drift mượt (grip + lái)
    DriftFlowTimer      float = 0.0       // Giữ flow sau khi nhả phanh
    CurrentDynamicGrip  float = 0.95      // Grip động (không binary)
    SteerRamp           float = 0.0       // Ramp lái 0–1
    DriftSlipMemory     float = 0.0       // Inertia trượt ngang (carry qua S-curve)
    DriftVisualYawOffset float = 0.0      // Thân xe vs hướng velocity
    DriftEntryDecelDone bool = false      // Smart drift: chỉ hãm nhẹ lúc vào
    PrevIsBraking       bool = false
    PostDriftBoostTimer float = 0.0       // Nitro recovery window sau drift
    CamDriftSlipYaw     float = 0.0       // Camera lag theo góc trượt
    ActiveDriftDir      float = 0.0       // Khóa hướng drift (giữ đà trôi lết và ổn định camera)

    // Prefab Registry
    CarPrefabList       List<object> = nil

    [preview]
    EquippedCarIndex    int = 1

    [preview]
    ProxyCar        entity<Entity> = nil

    IsRunning       bool = false
    IsRaceStarted   bool = false
    FpsFrameCount       int   = 0
    FpsLastSec          int   = 0
    MeasuredFrameRate   float = 60.0

    // Lock System
    IsExternallyLocked bool = true
    IsLocalResetting bool = false 
    SpawnDropTimer float = 0.0 

    // Respawn Blink System (Ẩn và chớp tắt khi hồi sinh)
    RespawnBlinkTimer       float = 0.0
    RespawnBlinkInterval    float = 0.0
    RespawnBlinkVisible     bool  = true
    RespawnInitialHideTimer float = 0.0 
    RespawnCooldown         float = 0.0

    // Input
    isGrounded bool = true
    IsTurningLeft       bool = false
    IsTurningRight      bool = false
    IsBraking           bool = false    
    IsBrakeBtnPressed   bool = false
    IsDoubleTapDrifting bool = false
    IsReversing         bool = false    

    // Nitro
    HasNitro        bool  = false    
    IsBoosting      bool  = false
    NitroCharge     float = 0.0     
    NitroPostCutCooldown float = 0.0
    NitroBoostTier  int = 3

    // Drift timer 
    DriftTimer      float = 0.0
    NitroTimeActive float = 0.0 
    NitroShakeLoopTimer float = 0.0 

    // =========================================================
    // EXPLICIT STATE MACHINES (Goal #3)
    // =========================================================
    DriftState_NORMAL     int = 0
    DriftState_ENTER      int = 1
    DriftState_HOLD       int = 2
    DriftState_EXIT       int = 3
    DriftState_AIR        int = 4
    DriftState_LANDING    int = 5
    DriftState_CRASH      int = 6

    DriftState            int = 0
    DriftStateTimer       float = 0.0
    JustLandedTimer       float = 0.0

    // Continuous boost power (Goal #4): 0..1 for scalable boost intensity.
    BoostPower            float = 0.0
    BoostPowerTarget      float = 0.0

    // Speedometer debug
    SpeedDisplayTimer float = 0.0

    // Client-side velocity estimation
    PrevPosition      Vector3
    PrevCcdPosition   Vector3
    LastClientFwdSpd  float = 0.0

    // Surface contact memory
    LastContactNx float = 0.0
    LastContactNy float = 1.0
    LastContactNz float = 0.0

    // Suspension state (per-wheel compression 0..1)
    SuspFL float = 0.0
    SuspFR float = 0.0
    SuspBL float = 0.0
    SuspBR float = 0.0

    // Drift lean
    DriftLeanAngle float = 0.0

    // ── CẠ TƯỜNG (WALL SCRAPE) - 2 BÁNH TRƯỚC ───────────────────────
    WheelScrapeRayDist    float = 0.85   // Khoảng cách quét từ trục bánh trước sang 2 bên sườn (m)
    IsScrapingWall        bool  = false  // Đang cạ tường (trái hoặc phải)
    IsScrapingLeft        bool  = false  // Đang cạ tường bên trái
    IsScrapingRight       bool  = false  // Đang cạ tường bên phải
    ScrapeHitPos          Vector3 = Vector3{0.0, 0.0, 0.0} // Tọa độ điểm va chạm cạ tường (dùng spawn tia lửa)
    ScrapeHitNorm         Vector3 = Vector3{0.0, 0.0, 0.0} // Pháp tuyến tường tại điểm cạ
    ScrapeDist            float = 0.0    // Khoảng cách tới tường
    ScrapeLogTimer        float = 0.0    // Cooldown log console để không spam
    WallDeflectLogTimer   float = 0.0    // Cooldown log bẻ hướng theo tường độc lập
    WallScrapeStickTimer  float = 0.0    // Bộ đệm duy trì bám tường chống chattering / giật góc
    ActiveWallNormX       float = 0.0    // Pháp tuyến tường đang bám X
    ActiveWallNormZ       float = 0.0    // Pháp tuyến tường đang bám Z
    ScrapeCamShakeCooldown float = 0.0    // Cooldown rung camera khi cạ tường
    // ────────────────────────────────────────────────────────────────

    // ── TRACTION RECOVERY (Feature 1) ────────────────────────────────
    // Smooth lateral velocity scrub after exiting drift so the kart
    // feels planted instead of floating sideways.
    TractionRecoverySharp float = 16.0   // Trả grip dứt khoát, triệt tiêu trượt ngang nhanh
    TractionRecoveryTimer float = 0.0   // Counts UP from drift-exit; used to ramp recovery blend
    TractionRecoveryWindow float = 0.22  // Hồi phục grip 100% cực nhanh trong 0.22s (giảm từ 0.65s để không bị lết lâu)
    // ────────────────────────────────────────────────────────────────

    // ── DRIFT ENTRY KICK (Feature 2) ─────────────────────────────────
    // One-shot lateral impulse when drift begins to create rear-swing feel.
    DriftEntryKickPower float = 0.16    // Rear swing kick nhạy và bén chuẩn Ace Racer (tăng từ 0.05 lên 0.16)
    DriftEntryKickDone  bool = false    // Guard: only fire once per drift entry
    // ────────────────────────────────────────────────────────────────

    // ── NITRO BOOST RAMP (Feature 4) ─────────────────────────────────
    // Smooth in/out of boost so it doesn't snap instantly.
    BoostRampIn         float = 5.0    // Ramp-in speed (nhanh hơn — cảm giác bóc ngọt)
    BoostRampOut        float = 1.5    // Ramp-out chậm hơn — tắt boost mượt
    BoostBlend          float = 0.0    // 0→1: current boost interpolation factor
    // ────────────────────────────────────────────────────────────────

    // ── HIGH-SPEED DOWNFORCE (Feature 5) ─────────────────────────────
    // Extra surface-normal adhesion that scales with speed.
    DownforceStart      float = 60.0   // Speed (km/h) at which downforce begins (quay lại trước khi tăng 30%)
    DownforceMax        float = 18.0   // Max extra downforce force added on top of GroundGravity
    // ────────────────────────────────────────────────────────────────

    // ── CAMERA LOOK-AHEAD (Feature 3) ────────────────────────────────
    // Shifts camera target forward along velocity direction at high speed.
    CamLookAheadMax     float = 2.8    // Đọc apex sớm hơn ở 230–350 km/h
    CamLookAheadSharp   float = 5.0    // Bám look-ahead nhanh nhưng không giật
    CamLookAheadOffset  float = 0.0    // Current animated look-ahead (world units, forward)
    // ────────────────────────────────────────────────────────────────

    // ── PREDICTIVE LANDING (Goal #6) ─────────────────────────────────
    PredLandingNormal   Vector3 = Vector3{0.0, 1.0, 0.0}
    PredLandingBlend    float = 0.0      // 0..1 while airborne approaching ground
    PredLandingRayDist  float = 6.0
    PredLandingSharp    float = 4.5
    PredLandingMinNy    float = 0.25
    // ────────────────────────────────────────────────────────────────

    // Air timer
    AirTime float = 0.0
    PrevIsGrounded    bool  = true   
    TargetDropOffset  float = 0.0   
    CurrentDropOffset float = 0.0   
    ImpactTimer       float = 0.0   

    // ── LANDING RECOVERY SYSTEM ──────────────────────────────────────
    // Trigger: AirTime > threshold AND stunt active AND just grounded
    LandingRecoverTimer    float = 0.0   // Counts DOWN from LandingRecoverDuration
    LandingRecoverDuration float = 0.65  // Tuning: seconds of stabilized blending
    LandingAirThreshold    float = 0.25  // Min air-time (s) that qualifies as "real" stunt

    // Safe anchor: yaw-only quat captured the moment landing is detected
    StableGroundCamQuat    Quaternion    // Lớp anchor: chỉ giữ yaw, loại bỏ spin pitch/roll

    // Angular velocity clamp (prevents quaternion feedback loop)
    PrevCamQuat            Quaternion    // CamQuat từ frame trước để đo delta góc
    CamAngularVelocity     float = 0.0   // Tốc độ góc ước lượng (rad/s)
    CamAngularVelocityCap  float = 2.6   // Giới hạn whip camera để hình ảnh ổn định
    // ────────────────────────────────────────────────────────────────

    // Idle sway timer
    SwayTimer float = 0.0
    ShakeTime float = 0.0

    // =========================================================
    // FRAME-SHARED STATE (promoted from OnUpdate locals)
    // These are written by one subsystem and read by another
    // within the same frame. Promoting avoids parameter bloat.
    // =========================================================

    // Ground detection results — written by UpdateGroundDetection, read by all
    Frame_IsStrictlyGrounded bool = true   // ≥1 wheel raycast hit
    Frame_HitCount           float = 0.0  // number of corner hits (0–4)
    Frame_SurfaceNx          float = 0.0  // averaged contact normal X
    Frame_SurfaceNy          float = 1.0  // averaged contact normal Y (default up)
    Frame_SurfaceNz          float = 0.0  // averaged contact normal Z
    Frame_RaycastHit         bool = false // any raycast contact this frame
    Frame_IsCrashing         bool = false // front wall collision detected
    PrevFrame_IsCrashing     bool = false // edge detect for one-shot crash inertia
    CrashCamSnapTimer        float = 0.0  // snap camera close after impact
    CrashPushCooldown      float = 0.0  // chống crash impulse lặp khi đang kẹt tường
    Frame_WallDot            float = 0.0  // forward·wallNormal for crash penalty

    // Drift/input results — written by UpdateDrift, read by steering/velocity/camera
    Frame_IsDrift       bool = false  // raw IsBraking||FlatSpin state
    Frame_IsDriftActive bool = false  // drift OR flow-timer active
    Frame_TurnInput     float = 0.0   // -1/0/+1 from left/right flags
    SmoothedTurnInput    float = 0.0   // input lái đã lọc để đảo hướng không snap như xe đồ chơi
    // Speed/physics results -- written by UpdateVelocity, read by camera
    Frame_SpeedRatio    float = 0.0   // CurrentSpeedKmh / TopSpeed clamped 0-1
    Frame_CurFwdSpd     float = 0.0   // DriveForwardSpeed current frame

    // Stunt visual state -- written by UpdateVisualEffects, read by camera
    Frame_StuntRoll     float = 0.0
    Frame_IsDriftTurning bool = false

    // --- 3-TIER QUATERNION ARCHITECTURE ---
    PhysicsQuat         Quaternion             // Lop 1: Huong than / lai
    VelocityQuat        Quaternion             // Lop 1b: Huong momentum
    StableVisualQuat    Quaternion             // Lop 2: Lop muot hoa cho Camera duoi theo
    CamQuat             Quaternion             // Lop 3: Goc quay cuoi cung cua Camera
    
    // --- UNIFIED STATES AND HYSTERESIS ---

    IsStableGrounded    bool = true
    LastValidNormal     Vector3 = Vector3{0.0, 1.0, 0.0}
    SurfaceTransitionTimer float = 0.0  

    CamOffsetX      float = 0.0

    // =========================================================
    // CAMERA CINEMATICS CONFIG (Asphalt/NFS Speed Pack)
    // =========================================================
    FovMin          float = 50.0           
    FovMax          float = 82.0           
    FovBoost        float = 100.0      // Tốc độ cảm nhận mạnh nhưng vẫn giữ đọc đường
    CamFollowSharp  float = 15.0           
    CamRotationSharp float = 12.5
    
    // Internal States
    CurrentCamPos   Vector3                
    CurrentFOV      float = 65.0           
    SyncTimer       float = 0.0            
    IsFirstFrame    bool = true            
    ThisPlayer    entity<Player> = nil

    // =========================================================
    // CHECKPOINT / LAP STATE (updated by server events)
    // =========================================================
    CpCurrentLap        int = 1
    CpTotalLaps         int = 3
    CpPosition          int = 1        // Real-time ranking
    CpNextCheckpoint    int = 1
    CpRespawnX          float = 0.0
    CpRespawnY          float = 0.0
    CpRespawnZ          float = 0.0
    CpRespawnYaw        float = 0.0     // hướng respawn (độ)
    HasCpRespawn        bool = false    // true after passing first checkpoint
    HasSpawnedAtStartSlot bool = false  // true after initial spawn at assigned start slot
    PendingSpawnAtStart  bool = false    // cmd1 tới trước CP sync thì đợi CP_00 rồi spawn lại
    SpawnRetryTimer      float = 0.0
    CpIsRaceFinished    bool = false
    CpFinishPosition    int = 0
    CpFinishTime        float = 0.0
    FirstFinishTimeoutActive bool  = false
    FirstFinishTimer         float = 0.0
    FirstFinishWaitTimer     float = 0.0

    // Checkpoint Lists
    CpTotalCheckpoints  int = 0
    CpCheckpointX       List<float> = nil
    CpCheckpointY       List<float> = nil
    CpCheckpointZ       List<float> = nil

    // Reset Zones (/PointRoot/ResetZones)
    ResetZoneList           List<entity<Entity>> = nil
    ResetZoneCount          int = 0
    HasScannedResetZones    bool = false
    ResetZoneScanRetryTimer float = 0.0

    // =========================================================
    // WAYPOINT DATA (synced from RaceManager for wrong-way detection)
    // =========================================================
    WpTotalWaypoints    int = 0
    WpX                 List<float> = nil
    WpY                 List<float> = nil
    WpZ                 List<float> = nil
    WrongWayTimer       float = 0.0
    IsWrongWay          bool = false
    WrongWayThreshold   float = 2.0       // 1.4s duy trì chạy ngược mới tính
    WrongWaySpeedMin    float = 70.0   // Tốc độ tối thiểu cảnh báo ngược chiều (quay lại trước khi tăng 30%)
    WrongWayDotLimit    float = -0.55     // Tương đương góc lệch > 145° mới tính ngược chiều
    NearestWpSegment    int = 0
    IsAiAutopilot       bool = false      // Trang thai AI tu lai sau khi ve dich
    AiTargetWp          int = 0          // Waypoint muc tieu ma AI dang huong toi
    AiDesiredSpeedKmh   float = 110.0    // Toc do muc tieu linh hoat cua AI
    AiIsDrifting        bool = false      // Co bot dang kich hoat drift
    PostFinishSyncTimer float = 3.0       // Dem nguoc 3.0s sau khi ve dich thi ngat dong bo Server
    AiStuckTimer        float = 0.0       // Dem thoi gian bi chan dung sat tuong
    AiReverseTimer      float = 0.0       // Thoi gian tu dong lui xe khi bi ket
    AiTurnRate          float = 0.0       // Toc do be lai truc tiep cua AI Autopilot

    // GHOST REPLAY SYSTEM
    ReplayRecordTimer       float = 0.0
    ReplayTotalFrames       int = 0
    ReplayPlayFrame         int = 0
    ReplayPlayT             float = 0.0
    ReplayFinalLapStartFrame int = 0
    ReplayChunksPos         List<List<Vector3>>
    ReplayChunksRot         List<List<Quaternion>>
    ReplayChunksSpeed       List<List<float>>
    ReplayChunksSteer       List<List<float>>
    ReplayChunksDrift       List<List<bool>>
    ReplayChunksBoost       List<List<bool>>
    PostFinishCoastTimer    float = 0.0     // 2.0s trượt tự nhiên sau khi cán đích
    ReplayBlendTimer        float = 0.0     // Đếm thời gian hòa nhập vào replay (1.5s)
    ReplayBlendDuration     float = 1.5     // Thời lượng lerp hòa nhập mượt mà
    ReplayBlendStartPos     Vector3
    ReplayBlendStartRot     Quaternion
    
    // =========================================================
    // AUDIO ENTITIES (7 Âm thanh chính thức)
    // =========================================================
    EngineSound         entity<SoundEffect>
    SkidSound           entity<SoundEffect>
    Nitro1Sound         entity<SoundEffect>
    Nitro2Sound         entity<SoundEffect>
    Nitro3Sound         entity<SoundEffect>
    AccelSound          entity<SoundEffect>
    DeaccSound          entity<SoundEffect>
    AudioInited         bool = false
    PrevIsBoostingAudio bool = false
    PrevSpeedForAudio   float = 0.0
    DeaccAudioCooldown  float = 0.0
    AccelAudioCooldown  float = 0.0
    DeaccAudioTimer     float = 0.0
    UpAudioTimer        float = 0.0
    IsEngineAudioPlaying bool = false
    IsSkidAudioPlaying  bool = false
    LastCountdownStep   int = 0
    CountdownSound      entity<SoundEffect>
    GoSound             entity<SoundEffect>
    FinishSound         entity<SoundEffect>

    // =========================================================
    // REGION: NETWORK / CROSS-PLATFORM EVENT DECLARATIONS
    // Dependency notes:
    // - Client sends SyncCarIndex and SyncKartStateServer to RacingMovementServer.
    // - Nitro UI visibility events are dispatched back to the local client UI.
    // - Keep event signatures stable unless all senders/receivers are updated together.
    // =========================================================
    // EVENT SIGNAL (Server)
    // =========================================================
    event ShowNitroButtonServer() {}
    event HideNitroButtonServer() {}
    event SyncKartStateServer(posX float, posY float, posZ float, yaw float, velX float, velY float, velZ float, isBoosting float, isDrifting float) {}
    event SyncCarIndex(carIndex int) {}

    // Checkpoint data: xử lý trong onRaceCommand với cmdType >= 10
    // (không cần event riêng — tái sử dụng onRaceCommand đã đăng ký)
    
    event SetupCameraLayerClient(layerToHide int) {
        TargetHiddenLayer = layerToHide
    }

    // =========================================================
    // REGION: LIFECYCLE / LOCAL CLIENT INIT / SPAWN-RESET COMMANDS
    // =========================================================
    // KHOI TAO
    // =========================================================
    func InitClientLists() {
        if CpCheckpointX == nil {
            CpCheckpointX = list.New(100, 100) as List<float>
            CpCheckpointY = list.New(100, 100) as List<float>
            CpCheckpointZ = list.New(100, 100) as List<float>
        }
        if WpX == nil {
            WpX = list.New(256, 256) as List<float>
            WpY = list.New(256, 256) as List<float>
            WpZ = list.New(256, 256) as List<float>
        }
        if FlybyDist == nil {
            FlybyDist = list.New(64, 64) as List<float>
        }
        InitDefaultIntroCameraData()
        if ReplayChunksPos == nil {
            ReplayChunksPos   = list.New(0, 20) as List<List<Vector3>>
            ReplayChunksRot   = list.New(0, 20) as List<List<Quaternion>>
            ReplayChunksSpeed = list.New(0, 20) as List<List<float>>
            ReplayChunksSteer = list.New(0, 20) as List<List<float>>
            ReplayChunksDrift = list.New(0, 20) as List<List<bool>>
            ReplayChunksBoost = list.New(0, 20) as List<List<bool>>
            ReplayTotalFrames = 0
            ReplayFinalLapStartFrame = 0
        }
    }

    event OnAwake() {
        var p = thisEntity as entity<Player>
        if p == nil { return }
        if p != std.GetLocalPlayer() { return }
        InitClientLists()
        start InitLocalClient()
    }

    async func InitLocalClient() {
        std.WaitForNextFrame()
        FacingAngle   = 0.0
        CurrentPitch  = 0.0
        CurrentRoll   = 0.0
        DriftLeanAngle = 0.0
        
        // Quat Init
        PhysicsQuat      = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
        VelocityQuat     = PhysicsQuat
        StableVisualQuat = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
        CamQuat          = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
        StableGroundCamQuat = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
        PrevCamQuat         = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
        LandingRecoverTimer = 0.0
        CamAngularVelocity  = 0.0
        TractionRecoveryTimer = 0.0
        DriftEntryKickDone = false
        BoostBlend = 0.0
        NitroCamBlend = 0.0
        NitroCamKickTimer = 0.0
        CamLookAheadOffset = 0.0
        CamOffsetX  = 0.0
        FpsLastSec = time.GetLocalTimestamp()
        FpsFrameCount = 0
        MeasuredFrameRate = 60.0

        if CpCheckpointX == nil {
            CpCheckpointX = list.New(100, 100) as List<float>
            CpCheckpointY = list.New(100, 100) as List<float>
            CpCheckpointZ = list.New(100, 100) as List<float>
        }
        if WpX == nil {
            WpX = list.New(256, 256) as List<float>
            WpY = list.New(256, 256) as List<float>
            WpZ = list.New(256, 256) as List<float>
        }
        ScanWaypointMarkersClient()
        if WpTotalWaypoints < 4 {
            LoadDefaultTrackWaypoints()
        }
        ScanStartSlotsClient()

        if ReplayChunksPos == nil {
            ReplayChunksPos   = list.New(0, 20) as List<List<Vector3>>
            ReplayChunksRot   = list.New(0, 20) as List<List<Quaternion>>
            ReplayChunksSpeed = list.New(0, 20) as List<List<float>>
            ReplayChunksSteer = list.New(0, 20) as List<List<float>>
            ReplayChunksDrift = list.New(0, 20) as List<List<bool>>
            ReplayChunksBoost = list.New(0, 20) as List<List<bool>>
            ReplayTotalFrames = 0
            ReplayFinalLapStartFrame = 0
        }

        IsFirstFrame  = true

        // Dùng vị trí KartModel nếu đã có; tránh hardcode tọa độ cũ gây lệch ~140m khi gắn parent
        if KartModel != nil {
            PrevPosition = KartModel<Transform>.Position
            PrevCcdPosition = PrevPosition
        } else {
            PrevPosition = Vector3{0.0, 0.0, 0.0}
            PrevCcdPosition = PrevPosition
        }
        CurrentCamPos = PrevPosition
        CurrentDynamicGrip = Grip

        // Khởi tạo danh sách các góc Intro Camera với dữ liệu thực tế từ Scene
        InitDefaultIntroCameraData()
        ScanIntroCameras()

        // --- TẠO CAMERA MÁY KHÁCH ĐỘC LẬP TỪ RACINGMOVEMENT ---
        if MyClientCam == nil {
            camera.CreateCustomCamera(out var newCam)
            MyClientCam = newCam
        }
        if MyClientCam != nil && TotalIntroShots > 0 {
            MyClientCam<camera.CustomCamera>.FOV = 65.0
            var camEnt = MyClientCam as entity<Entity>
            camEnt<Transform>.Position = IntroP_Start[0]
            camEnt<Transform>.Rotation = IntroR_Start[0]
            // Chưa switch camera ngay: giữ nguyên camera mặc định trong 20s đầu
        }

        // =================================================================
        // O(1) PREFAB INSTANTIATION
        // =================================================================
        if CarPrefabList == nil { InitCarRegistry() }

        var arrayIndex = EquippedCarIndex - 1
        var maxCount = list.Length(CarPrefabList)
        if arrayIndex < 0 || arrayIndex >= maxCount {
            LogError("[RacingMovement] Lỗi Index Xe: " + convert.ToString(EquippedCarIndex) + ". Fallback về xe số 1.")
            arrayIndex = 0
        }

        var carPrefab = CarPrefabList[arrayIndex] as PrefabID
        if carPrefab != nil {
            std.CreateFromPrefab(out var clientCar, carPrefab)
            ClientVisualCar = clientCar

            if ClientVisualCar != nil {
                // Ẩn xe lúc mới tạo, chỉ hiện lên khi toạ độ ô xuất phát đã nạp xong từ Server
                std.SetActive(ClientVisualCar as entity, false)
                var children = std.GetChildren(ClientVisualCar)
                var count = list.Length(children as List<object>)
                for i = 0, count, 1 {
                    var child = children[i] as entity<Entity>
                    if child != nil && strings.Find(child<Entity>.Name, "Moment_", 0) == 0 {
                        MomentNode = child
                        var nameParts = strings.Split(child<Entity>.Name, "_")
                        var partsCount = list.Length(nameParts as List<object>)
                        for j = 1, partsCount, 1 {
                            var keyStr = nameParts[j] as string
                            if j + 1 < partsCount {
                                var valStr = nameParts[j+1] as string
                                convert.StringToFloat(valStr, out var parsedVal, out var parseOk)
                                if parseOk {
                                    if keyStr == "L" { BaseVisualLean = parsedVal 
                                    }else if keyStr == "IL" { BaseVisualLean = -parsedVal 
                                    }else if keyStr == "O" { BaseCamOffset = parsedVal / 100.0 
                                    }else if keyStr == "W" { BaseSkidWidth = parsedVal / 100.0 }
                                }
                            }
                        }
                        break
                    }
                }

                // LogInfo("[RacingMovement] Prefab Car instantiated successfully!")

                NitroEffects = list.New(0, 4) as List<entity<Entity>>
                DriftEffects = list.New(0, 4) as List<entity<Entity>>
                ScrapeEffectsL = list.New(0, 4) as List<entity<Entity>>
                ScrapeEffectsR = list.New(0, 4) as List<entity<Entity>>
                ScanEffects(ClientVisualCar)
                SpawnKartAtRespawn()
            }
        }

        IsRaceStarted = false
        IsExternallyLocked = true 
        IsRunning = true

        // SNAP CAMERA: Nếu đang ở phòng chờ thì giữ góc Intro 1, khi vào game mới snap theo xe
        if MyClientCam != nil {
            var camEnt = MyClientCam as entity<Entity>
            if IsIntroCamActive {
                if HasScannedIntroCameras && TotalIntroShots > 0 {
                    camEnt<Transform>.Position = IntroP_Start[0]
                    camEnt<Transform>.Rotation = IntroR_Start[0]
                }
            } else {
                var initialLocalOffset = Vector3{0.0, 0.2, -4.2}
                var initialWorldOffset = math.RotateVector(initialLocalOffset, CamQuat)
                CurrentCamPos = Vector3{PrevPosition.X + initialWorldOffset.X, PrevPosition.Y + initialWorldOffset.Y, PrevPosition.Z + initialWorldOffset.Z}
                camEnt<Transform>.Position = CurrentCamPos
                var initEuler = math.QuaternionToEulerAngle(CamQuat)
                camEnt<Transform>.Rotation = Vector3{0.0, initEuler.Y, 0.0}
            }
        }

        DispatchEventToEntity(SyncCarIndex, thisEntity, PlatformType.Server, List<int>{EquippedCarIndex})
        // LogInfo("[RacingMovement] Khởi chạy — Anti-Gravity Arcade Kart!")
    }

    func SnapCameraToKartNow() {
        IsIntroBlendingToCar = false
        if KartModel == nil || MyClientCam == nil { return }
        camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0)
        var carPos = KartModel<Transform>.Position
        var resetOffset = math.RotateVector(Vector3{0.0, 0.2, -4.2}, PhysicsQuat)
        CurrentCamPos = Vector3{carPos.X + resetOffset.X, carPos.Y + resetOffset.Y, carPos.Z + resetOffset.Z}
        var camEntity = MyClientCam as entity<Entity>
        camEntity<Transform>.Position = CurrentCamPos
        var resetEuler = math.QuaternionToEulerAngle(PhysicsQuat)
        camEntity<Transform>.Rotation = Vector3{0.0, resetEuler.Y, 0.0}
    }

    func NormalizeYawClient(yaw float) float {
        while yaw > 180.0 { yaw -= 360.0 }
        while yaw < -180.0 { yaw += 360.0 }
        return yaw
    }

    func GetCanonicalStartForwardYawClient() float {
        if CpTotalCheckpoints >= 2 && CpCheckpointX != nil {
            var dx = CpCheckpointX[1] - CpCheckpointX[0]
            var dz = CpCheckpointZ[1] - CpCheckpointZ[0]
            if dx * dx + dz * dz > 1.0 {
                return NormalizeYawClient(math.ATan2(dx, dz))
            }
        }
        if WpTotalWaypoints >= 2 && WpX != nil {
            var dx = WpX[1] - WpX[0]
            var dz = WpZ[1] - WpZ[0]
            if dx * dx + dz * dz > 1.0 {
                return NormalizeYawClient(math.ATan2(dx, dz))
            }
        }
        return 178.3
    }

    func EnforceStartForwardYawClient(yaw float) float {
        var canonical = GetCanonicalStartForwardYawClient()
        var diff = math.Abs(NormalizeYawClient(yaw - canonical))
        if diff > 60.0 {
            return canonical
        }
        return yaw
    }

    func EnforceCorrectStartHeadingClient() {
        if KartModel == nil { return }
        var targetYaw = CpRespawnYaw
        targetYaw = EnforceStartForwardYawClient(targetYaw)
        CpRespawnYaw = targetYaw

        var curRot = KartModel<Transform>.Rotation
        var curYawDiff = math.Abs(NormalizeYawClient(curRot.Y - targetYaw))
        if curYawDiff > 25.0 || math.Abs(curRot.X) > 10.0 || math.Abs(curRot.Z) > 10.0 {
            KartModel<Transform>.Rotation = Vector3{0.0, targetYaw, 0.0}
            PhysicsQuat = math.EulerAngleToQuaternion(Vector3{0.0, targetYaw, 0.0})
            VelocityQuat = PhysicsQuat
            StableVisualQuat = PhysicsQuat
            CamQuat = PhysicsQuat
            StableGroundCamQuat = PhysicsQuat
            PrevCamQuat = PhysicsQuat
            UIKartYaw = targetYaw
            KartModel<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}
            KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
            if ClientVisualCar != nil {
                AttachVisualCarToKart()
            }
            if !IsIntroCamActive {
                SnapCameraToKartNow()
            }
        }
    }

    func EnsureRespawnFromCp0() bool {
        var canonicalYaw = GetCanonicalStartForwardYawClient()
        if HasCpRespawn && (math.Abs(CpRespawnX) > 0.1 || math.Abs(CpRespawnZ) > 0.1) {
            if !IsRaceStarted {
                CpRespawnYaw = EnforceStartForwardYawClient(CpRespawnYaw)
            }
            return true
        }
        if CpTotalCheckpoints <= 0 || CpCheckpointX == nil { return false }
        if math.Abs(CpCheckpointX[0]) < 0.1 && math.Abs(CpCheckpointZ[0]) < 0.1 { return false }
        CpRespawnX = CpCheckpointX[0]
        CpRespawnY = CpCheckpointY[0]
        CpRespawnZ = CpCheckpointZ[0]
        CpRespawnYaw = canonicalYaw
        HasCpRespawn = true
        return true
    }

    func SpawnKartAtRespawn() bool {
        if !EnsureRespawnFromCp0() {
            PendingSpawnAtStart = true
            SpawnRetryTimer = 0.2
            if ClientVisualCar != nil {
                std.SetActive(ClientVisualCar as entity, false)
            }
            return false
        }
        if math.Abs(CpRespawnX) < 0.1 && math.Abs(CpRespawnZ) < 0.1 {
            PendingSpawnAtStart = true
            SpawnRetryTimer = 0.2
            if ClientVisualCar != nil {
                std.SetActive(ClientVisualCar as entity, false)
            }
            return false
        }
        if KartModel == nil {
            var sphereTemplate = EditorGenLib.EResSceneMainScene.Sphere as entity<Entity>
            std.Clone(out var newSphere, sphereTemplate as entity)
            KartModel = newSphere
        }
        if KartModel == nil { return false }
        var spawnPos = Vector3{CpRespawnX, CpRespawnY + 0.85, CpRespawnZ}
        var spawnYaw = CpRespawnYaw
        if !IsRaceStarted {
            spawnYaw = EnforceStartForwardYawClient(spawnYaw)
            CpRespawnYaw = spawnYaw
        }
        KartLifecycle.ConfigureResetKart(KartModel, spawnPos, spawnYaw)
        PhysicsQuat = math.EulerAngleToQuaternion(Vector3{0.0, spawnYaw, 0.0})
        VelocityQuat = PhysicsQuat
        StableVisualQuat = PhysicsQuat
        CamQuat = PhysicsQuat
        StableGroundCamQuat = PhysicsQuat
        PrevCamQuat = PhysicsQuat
        UIKartYaw = spawnYaw
        UIKartPos = spawnPos
        AttachVisualCarToKart()
        PrevPosition = KartModel<Transform>.Position
        PrevCcdPosition = PrevPosition
        CurrentCamPos = PrevPosition
        LandingRecoverTimer = 0.0
        CamAngularVelocity = 0.0
        PendingSpawnAtStart = false
        if ClientVisualCar != nil {
            std.SetActive(ClientVisualCar as entity, true)
        }
        return true
    }

    // Tự động hồi sinh khi xe văng khỏi map (rơi xuống Y < -5.0)
    func TriggerFallOffMapRespawn() {
        if !SpawnKartAtRespawn() { return }
        SnapCameraToKartNow()

        UIKartYaw = CpRespawnYaw
        UIKartPos = Vector3{CpRespawnX, CpRespawnY + 0.85, CpRespawnZ}

        DriveForwardSpeed = 0.0
        CurrentSpeedKmh = 0.0
        UISpeedKmh = 0.0
        LastClientFwdSpd = 0.0

        IsTurningLeft = false
        IsTurningRight = false
        IsBraking = false
        IsBrakeBtnPressed = false
        IsDoubleTapDrifting = false
        IsBoosting = false
        IsReversing = false
        IsNitroRecovering = false
        NitroCharge = NitroCharge * 0.5
        if NitroCharge > 0.05 {
            HasNitro = true
            DispatchEventToEntity(ShowNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
        } else {
            HasNitro = false
            DispatchEventToEntity(HideNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
        }
        NitroShakeLoopTimer = 0.0
        NitroCamBlend = 0.0
        NitroCamKickTimer = 0.0

        DriftBlend = 0.0
        DriftFlowTimer = 0.0
        SteerRamp = 0.0
        DriftSlipMemory = 0.0
        DriftVisualYawOffset = 0.0
        DriftEntryDecelDone = false
        PrevIsBraking = false
        PostDriftBoostTimer = 0.0

        PrevFrame_IsCrashing = false
        Frame_IsCrashing = false
        CrashCamSnapTimer = 0.0
        CrashPushCooldown = 0.0

        LastContactNx = 0.0
        LastContactNy = 1.0
        LastContactNz = 0.0
        AirTime = 0.0
        Frame_IsStrictlyGrounded = true
        IsStableGrounded = true

        RespawnBlinkTimer = 0.0
        RespawnInitialHideTimer = 0.0
        RespawnBlinkInterval = 0.10
        RespawnBlinkVisible = true
        if ClientVisualCar != nil {
            std.SetActive(ClientVisualCar as entity, true)
        }

        RespawnCooldown = 1.5
    }

    event onRaceCommand(cmdType int) {
        InitClientLists()
        if cmdType >= 6000 && cmdType <= 6999 {
            if !IsLobbyActive {
                InitialDefaultCamTimer = 0.0
                HasSwitchedToIntroCam = false
            }
            LobbyTimerSec = cmdType - 6000
            IsLobbyActive = true
            FirstFinishTimeoutActive = false
            FirstFinishTimer = 0.0
            FirstFinishWaitTimer = 0.0
            if math.Abs(LobbySmoothTimer - (LobbyTimerSec as float)) > 1.5 {
                LobbySmoothTimer = LobbyTimerSec as float
            }
            if !HasSwitchedStartCamera {
                IsIntroCamActive = true
            }
        } else if cmdType == 1 {
            IsLobbyActive = false
            IsIntroCamActive = false
            HasStartedFinalSectorFlyby = false
            FlybyInitialized = false
            IntroAllShotsCompleted = false
            IsIntroShutterActive = false
            IntroShutterTimer = 0.0
            IntroShutterCutDone = false
            CinematicBarTargetHeight = 0.0
            CinematicBarCurrentHeight = 0.0
            InitialDefaultCamTimer = 0.0
            HasSwitchedToIntroCam = false
            FlybyRunTimer = 0.0
            FlybySpeedMult = 1.0
            FirstFinishTimeoutActive = false
            FirstFinishTimer = 0.0
            FirstFinishWaitTimer = 0.0
            LastCountdownStep = 0
            RaceStartUiTimer = 0.0
            RaceGoUiTimer = 0.0
            StartCameraDelayTimer = 0.0
            HasSwitchedStartCamera = true
            if MyClientCam != nil { camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0) }
            RespawnBlinkTimer = 0.0
            RespawnBlinkVisible = true
            if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, true) }
            if KartModel == nil {
                SpawnKartAtRespawn()
                SpawnDropTimer = 1.5
                IsExternallyLocked = true
                if KartModel != nil {
                    KartModel<Rigidbody>.Constrain = 112 as RigidbodyConstrainType
                    physics.Wakeup(KartModel as entity<Rigidbody>)
                }
            } else {
                IsExternallyLocked = true
                KartModel<Rigidbody>.Constrain = 127 as RigidbodyConstrainType
                physics.Sleep(KartModel as entity<Rigidbody>)
            }
            if ClientVisualCar != nil && KartModel != nil {
                AttachVisualCarToKart()
            }
            EnforceCorrectStartHeadingClient()
            // Camera đã đáp thẳng vào đuôi xe qua hành trình Flycam: chuyển giao êm ái vào góc nhìn lái
            if MyClientCam != nil && KartModel != nil {
                var camEntity = MyClientCam as entity<Entity>
                IntroBlendStartPos = camEntity<Transform>.Position
                IntroBlendStartRot = camEntity<Transform>.Rotation
                IntroBlendStartFOV = MyClientCam<camera.CustomCamera>.FOV
                if IntroBlendStartFOV < 30.0 || IntroBlendStartFOV > 120.0 {
                    IntroBlendStartFOV = 65.0
                }
                var carPos = KartModel<Transform>.Position
                var camOffset = math.RotateVector(Vector3{0.0, BaseCamHeight, -4.8}, PhysicsQuat)
                var expectedCamPos = Vector3{carPos.X + camOffset.X, carPos.Y + camOffset.Y, carPos.Z + camOffset.Z}
                var dx = IntroBlendStartPos.X - expectedCamPos.X
                var dy = IntroBlendStartPos.Y - expectedCamPos.Y
                var dz = IntroBlendStartPos.Z - expectedCamPos.Z
                var distToTargetSq = dx * dx + dy * dy + dz * dz

                if distToTargetSq > 4.0 {
                    // Nếu vào phòng trễ làm cam chưa kịp tới sát xe, lerp nhanh 0.6s
                    IsIntroBlendingToCar = true
                    IntroBlendTimer = 0.0
                    IntroBlendDuration = 0.6
                } else {
                    // Camera đã lướt tới thẳng vị trí sau xe: chuyển giao tức thì hoàn toàn không khựng nhịp
                    SnapCameraToKartNow()
                }
            } else {
                SnapCameraToKartNow()
            }
        } else if cmdType == 4 || cmdType == 43 {
            if LastCountdownStep == 3 { return }
            IsLobbyActive = false
            IsIntroCamActive = false
            HasStartedFinalSectorFlyby = false
            FlybyInitialized = false
            IsIntroShutterActive = false
            IntroShutterTimer = 0.0
            IntroShutterCutDone = false
            CinematicBarTargetHeight = 0.0
            CinematicBarCurrentHeight = 0.0
            InitialDefaultCamTimer = 0.0
            HasSwitchedToIntroCam = false
            FlybyRunTimer = 0.0
            IsIntroBlendingToCar = false
            RespawnBlinkTimer = 0.0
            RespawnBlinkVisible = true
            if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, true) }
            if KartModel == nil {
                if !SpawnKartAtRespawn() { return }
            }
            // Đảm bảo xe đã tiếp đất vững chắc và tắt vật lý trước khi đếm 3 2 1
            SpawnDropTimer = 0.0
            if KartModel != nil {
                var curPos = KartModel<Transform>.Position
                physics.SingleRaycast(curPos, Vector3{0.0, -1.0, 0.0}, 2.5, nil, false,
                    out var gEnt, out var gPos, out var gDist, out var gNorm)
                if KartGroundProbe.IsValidHit(gEnt, KartModel as entity<Rigidbody>) {
                    KartModel<Transform>.Position = Vector3{curPos.X, gPos.Y + 0.80, curPos.Z}
                }
                KartModel<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}
                KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
                KartModel<Rigidbody>.Constrain = 127 as RigidbodyConstrainType
                physics.Sleep(KartModel as entity<Rigidbody>)
                EnforceCorrectStartHeadingClient()
                if ClientVisualCar != nil {
                    AttachVisualCarToKart()
                }
                SnapCameraToKartNow()
            }
            RaceStartUiTimer = 2.99
            RaceGoUiTimer = 0.0
            StartCameraDelayTimer = 0.0
            if !HasSwitchedStartCamera {
                HasSwitchedStartCamera = true
                if MyClientCam != nil { camera.SwitchCustomCameraClient(MyClientCam, camera.CameraTransitionType.Default, 0.0) }
                SnapCameraToKartNow()
            }
            LastCountdownStep = 3
            KartAudio.TriggerCountdown(CountdownSound)
        } else if cmdType == 42 {
            if LastCountdownStep == 2 { return }
            RaceStartUiTimer = 1.99
            LastCountdownStep = 2
            KartAudio.TriggerCountdown(CountdownSound)
        } else if cmdType == 41 {
            if LastCountdownStep == 1 { return }
            RaceStartUiTimer = 0.99
            LastCountdownStep = 1
            KartAudio.TriggerCountdown(CountdownSound)
        } else if cmdType == 2 {
            if LastCountdownStep == 0 && IsRaceStarted && !IsExternallyLocked { return }
            IsLobbyActive = false
            IsIntroCamActive = false
            HasSwitchedStartCamera = true
            SpawnDropTimer = 0.0
            RaceStartUiTimer = 0.0
            RaceGoUiTimer = 1.2
            LastCountdownStep = 0
            RespawnBlinkTimer = 0.0
            RespawnBlinkVisible = true
            if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, true) }
            if KartModel == nil { SpawnKartAtRespawn() }
            if KartModel != nil {
                EnforceCorrectStartHeadingClient()
                // Mở khóa hoàn toàn vật lý để xe bắt đầu chạy
                KartModel<Rigidbody>.Constrain = 0 as RigidbodyConstrainType
                physics.Wakeup(KartModel as entity<Rigidbody>)
                SnapCameraToKartNow()
            }
            IsExternallyLocked = false
            IsLocalResetting = false 
            IsRaceStarted = true
            NitroCharge = MaxNitroCharge
            HasNitro = true
            DispatchEventToEntity(ShowNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
            KartAudio.TriggerGo(GoSound)
            // LogInfo("[RacingMovement] 🚀 XUẤT PHÁT!")

        } else if cmdType == 3 {
            if KartModel == nil { SpawnKartAtRespawn() }
            IsExternallyLocked = true
            IsLocalResetting = true
            IsRaceStarted = false
            IsAiAutopilot = false
            PostFinishSyncTimer = 3.0
            IsEngineAudioPlaying = false
            IsSkidAudioPlaying = false
            KartAudio.StopAll(EngineSound, SkidSound, Nitro1Sound, Nitro2Sound, Nitro3Sound, AccelSound, DeaccSound, CountdownSound, GoSound, FinishSound)
            
            if KartModel != nil {
                // Nếu đã qua checkpoint, respawn tại checkpoint gần nhất
                if !HasCpRespawn {
                    if CpTotalCheckpoints <= 0 || CpCheckpointX == nil {
                        LogError("[RacingMovement] Không reset: chưa nhận CP_00 từ RaceManager.")
                        return
                    }
                    CpRespawnX = CpCheckpointX[0]
                    CpRespawnY = CpCheckpointY[0]
                    CpRespawnZ = CpCheckpointZ[0]
                    HasCpRespawn = true
                }
                var respawnPos = Vector3{CpRespawnX, CpRespawnY + 0.85, CpRespawnZ}
                var respawnYaw = CpRespawnYaw
                KartLifecycle.ConfigureResetKart(KartModel, respawnPos, respawnYaw)
                
                // Set PhysicsQuat và các cam quat theo hướng mới
                PhysicsQuat = math.EulerAngleToQuaternion(Vector3{0.0, respawnYaw, 0.0})
                VelocityQuat = PhysicsQuat
                StableVisualQuat = PhysicsQuat
                CamQuat = PhysicsQuat
                UIKartYaw = respawnYaw
                UIKartPos = respawnPos

                PrevPosition = KartModel<Transform>.Position
                PrevCcdPosition = PrevPosition
                CurrentCamPos = PrevPosition
                AttachVisualCarToKart()
                SnapCameraToKartNow()
            }
            
            // Respawn visual effect: Ẩn ngay khi reset, sau đó tele và chớp tắt luân phiên
            RespawnBlinkTimer = 1.4
            RespawnInitialHideTimer = 0.2
            RespawnBlinkInterval = 0.10
            RespawnBlinkVisible = false
            if ClientVisualCar != nil {
                std.SetActive(ClientVisualCar as entity, false)
            }
            
            CurrentSpeedKmh = 0.0
            UISpeedKmh = 0.0
            DriveForwardSpeed = 0.0
            IsTurningLeft = false; IsTurningRight = false
            IsBraking = false; IsBrakeBtnPressed = false; IsDoubleTapDrifting = false; IsBoosting = false; IsReversing = false
            IsNitroRecovering = false
            NitroShakeLoopTimer = 0.0
            PrevFrame_IsCrashing = false
            CrashCamSnapTimer = 0.0
            CrashPushCooldown = 0.0
            SmoothedTurnInput = 0.0
            WrongWayTimer = 0.0
            IsWrongWay = false
            NearestWpSegment = 0
            DriftBlend = 0.0
            DriftFlowTimer = 0.0
            SteerRamp = 0.0
            DriftSlipMemory = 0.0
            DriftVisualYawOffset = 0.0
            DriftEntryDecelDone = false
            PrevIsBraking = false
            PostDriftBoostTimer = 0.0
            NitroPostCutCooldown = 0.0
            CamDriftSlipYaw = 0.0
            VelocityQuat = PhysicsQuat
            CurrentDynamicGrip = Grip
            TractionRecoveryTimer = 0.0
            DriftEntryKickDone = false
            BoostBlend = 0.0
            NitroCamBlend = 0.0
            NitroCamKickTimer = 0.0
            CamLookAheadOffset = 0.0
            SyncNitroEffects()
            SyncDriftEffects(false)
            IsScrapingLeft = false; IsScrapingRight = false; IsScrapingWall = false
            PrevIsScrapingLeft = false; PrevIsScrapingRight = false
            SyncScrapeEffects()
            NitroCharge = NitroCharge * 0.5; DriftTimer = 0.0
            NitroBoostTier = 3
            CurrentVisualLean = 0.0; CurrentVisualYaw = 0.0
            IsFlatSpinning = false; FlatSpinVisualAngle = 0.0; StuntCamRoll = 0.0; SpinDir = 1.0; StuntCooldown = 0.0
            LandingSlidePwr = 0.0
            LandingRecoverTimer = 0.0
            StableGroundCamQuat = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
            PrevCamQuat = math.EulerAngleToQuaternion(Vector3{0.0, 0.0, 0.0})
            CamAngularVelocity = 0.0
            CamDriftRoll = 0.0; CamDriftSide = 0.0
            CamVelocityYaw = 0.0
            CamAirPitch = 0.0; CamAirRoll = 0.0
            CamLagBack = 0.0
            CamBoostPullCurrent = 0.0
            CamDriftHeightDrop = 0.0; CamDriftPitchUp = 0.0; CamDriftYawInward = 0.0
            CamNitroHeightDrop = 0.0; CamNitroPitchUp = 0.0
            DriftEntryDipPitch = 0.0; DriftEntryDipRoll = 0.0
            ActiveDriftDir = 0.0

            LastClientFwdSpd = 0.0
            CurrentRollAngle = 0.0
            CurrentSteerAngle = 0.0
            CurrentCamOffset = 0.0
            TargetDropOffset = 0.0
            CurrentDropOffset = 0.0
            ImpactTimer = 0.0
            ShakeTime = 0.0
            SwayTimer = 0.0
            AirTime = 0.0
            PrevIsGrounded = true
            IsStableGrounded = true
            LastValidNormal = Vector3{0.0, 1.0, 0.0}
            SurfaceTransitionTimer = 0.0

            if NitroCharge > 0.05 {
                HasNitro = true
                DispatchEventToEntity(ShowNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
            } else {
                HasNitro = false
                DispatchEventToEntity(HideNitroButtonServer, thisEntity as entity<Player>, PlatformType.Client, nil)
            }
            
            // PhysicsQuat đã được set đúng hướng respawnYaw ở trên (dòng 643)
            // Chỉ cần đồng bộ thêm StableGroundCamQuat và PrevCamQuat
            StableGroundCamQuat = PhysicsQuat
            PrevCamQuat = PhysicsQuat
            
            // std.LogInfo("[Physics] Hard Reset: Sleep active. Velocities purged.")

            start DelayedPhysicsWakeup()
            UnlockRequestTimer = 0.5

        // =========================================================
        // CHECKPOINT PROTOCOL (cmdType encoding from RaceManager)
        // 1xx = set CpCurrentLap (cmdType - 100)
        // 2xx = set CpTotalLaps (cmdType - 200)
        // 3xx = set CpPosition (cmdType - 300)
        // 4xx = set CpNextCheckpoint (cmdType - 400)
        // 5xx = set HasCpRespawn + CpRespawnX encoded (cmdType - 500) /100
        // 6xx = CpRespawnY encoded
        // 7xx = CpRespawnZ encoded
        // 8xx = CpIsRaceFinished, CpFinishPosition (cmdType - 800)
        // 
        // Simplified: dùng range-based encoding
        // cmdType 10 = update lap info (encode: 10 + lap*1000 + pos*100 + nextCP)
        //   -> Không thể do int overflow risk
        //
        // Cách cuối: dùng sequential dispatch với cmdType đơn giản
        // 101..103 = set CpCurrentLap to cmdType-100  (lap 1..3)
        // 201..208 = set CpPosition to cmdType-200     (pos 1..8)
        // 301..310 = set CpNextCheckpoint to cmdType-300
        // 401..403 = set CpTotalLaps to cmdType-400
        // 500     = HasCpRespawn = true (respawn position đã set qua separate calls)
        // 600     = set CpRespawnX (NOT POSSIBLE via int — dùng workaround bên dưới)
        // 900     = Race finished (with position encoded)
        // =========================================================
        } else if cmdType >= 100 && cmdType < 200 {
            // SET LAP: cmdType = 100 + currentLap
            var newLap = cmdType - 100
            if newLap > CpCurrentLap && !CpIsRaceFinished {
                // Sang vòng đua mới -> Lưu mốc bắt đầu của vòng mới (giữ lại trọn vẹn Lap 1)
                ReplayFinalLapStartFrame = ReplayTotalFrames
            }
            CpCurrentLap = newLap
        } else if cmdType >= 200 && cmdType < 300 {
            // SET POSITION: cmdType = 200 + position (nếu đã về đích thì giữ nguyên thứ hạng về đích)
            if !CpIsRaceFinished {
                CpPosition = cmdType - 200
            }
        } else if cmdType >= 300 && cmdType < 400 {
            // SET NEXT CHECKPOINT: cmdType = 300 + nextCP
            CpNextCheckpoint = cmdType - 300
            // Respawn position được Server gửi trực tiếp qua cpIndex=99, không cần tính local nữa
        } else if cmdType >= 400 && cmdType < 500 {
            // SET TOTAL LAPS: cmdType = 400 + totalLaps
            CpTotalLaps = cmdType - 400
        } else if cmdType >= 500 && cmdType < 600 {
            // SET TOTAL CHECKPOINTS: cmdType = 500 + totalCP
            CpTotalCheckpoints = cmdType - 500
        } else if cmdType == 8030 {
            // Người đầu tiên về đích: Bắt đầu đếm ngược 30s + 5s kết thúc trận
            FirstFinishTimeoutActive = true
            FirstFinishTimer = 30.0
            FirstFinishWaitTimer = 5.0
        } else if cmdType >= 900 && cmdType < 1000 {
            // RACE FINISHED: cmdType = 900 + finishPosition
            CpIsRaceFinished = true
            CpFinishPosition = cmdType - 900
            KartAudio.TriggerFinish(FinishSound)
            
            // Kích hoạt AI Autopilot / Ghost Replay tiếp quản xe sau khi cán đích
            IsAiAutopilot = true
            PostFinishSyncTimer = 3.0
            IsFinishDecelerating = false

            // Mở khóa xoay vật lý để xe tiếp tục lăn bánh tự nhiên
            if KartModel != nil {
                KartModel<Rigidbody>.Constrain = 112 as RigidbodyConstrainType
                KartModel<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
                physics.Wakeup(KartModel as entity<Rigidbody>)
            }

            // Xóa toàn bộ input người chơi cũ
            IsTurningLeft = false
            IsTurningRight = false
            IsBraking = false
            IsBoosting = false
            IsReversing = false
            SmoothedTurnInput = 0.0

            // Triệt tiêu hoàn toàn trạng thái Drift khi về đích (không để AI chạy bằng drift)
            DriftState = DriftState_NORMAL
            DriftStateTimer = 0.0
            DriftFlowTimer = 0.0
            DriftBlend = 0.0
            ActiveDriftDir = 0.0
            DriftTimer = 0.0
            DriftSlipMemory = 0.0
            DriftVisualYawOffset = 0.0
            IsFlatSpinning = false
            AiIsDrifting = false
            CurrentVisualYaw = 0.0
            CurrentVisualLean = 0.0

            // Tìm Waypoint gần nhất phía trước để AI bám theo nếu cần
            UpdateNearestWaypoint()
            AiTargetWp = NearestWpSegment + 1
            if AiTargetWp >= WpTotalWaypoints { AiTargetWp = 0 }
            AiStuckTimer = 0.0
            AiReverseTimer = 0.0
            AiTurnRate = 0.0
            PostFinishCoastTimer = 2.0
            ReplayBlendTimer = 0.0
            
            // Tắt hiệu ứng Nitro và Drift ngay khi cán đích
            SyncNitroEffects()
            SyncDriftEffects(false)
            // LogInfo("[Checkpoint] 🏁 FINISHED! AI Autopilot activated. Position: #" + convert.ToString(CpFinishPosition))
        } else if cmdType >= 7000 && cmdType < 7010 {
            var srvIntroShots = cmdType - 7000
            if srvIntroShots > 0 {
                TotalIntroShots = srvIntroShots
            }
            // LogInfo("[IntroCameraSync] Nhận đồng bộ " + convert.ToString(TotalIntroShots) + " góc Intro từ Server!")
        } else if cmdType >= 1000 && cmdType < 1256 {
            WpTotalWaypoints = cmdType - 1000
            // LogInfo("[WaypointSync] TotalWaypoints set to " + convert.ToString(WpTotalWaypoints))
        } else {
            var absVal = cmdType
            if absVal < 0 { absVal = -absVal }
            
            if absVal >= 1000000000 {
                var sign = 1.0
                var raw = cmdType
                if cmdType < 0 {
                    sign = -1.0
                    raw = -cmdType
                }

                if raw >= 2000000000 {
                    // Intro Camera coordinate decode (offset 2,000,000,000)
                    raw = raw - 2000000000
                    var shotIdx = raw / 1000000
                    var rem = raw - (shotIdx * 1000000)
                    var coordType = rem / 100000
                    var intVal = rem - (coordType * 100000)
                    var val = (intVal as float) * 0.1 * sign
                    if IntroP_Start != nil && shotIdx >= 0 && shotIdx < 8 {
                        if coordType == 0 {
                            IntroP_Start[shotIdx] = Vector3{val, IntroP_Start[shotIdx].Y, IntroP_Start[shotIdx].Z}
                        } else if coordType == 1 {
                            IntroP_Start[shotIdx] = Vector3{IntroP_Start[shotIdx].X, val, IntroP_Start[shotIdx].Z}
                        } else if coordType == 2 {
                            IntroP_Start[shotIdx] = Vector3{IntroP_Start[shotIdx].X, IntroP_Start[shotIdx].Y, val}
                        } else if coordType == 3 {
                            IntroP_End[shotIdx] = Vector3{val, IntroP_End[shotIdx].Y, IntroP_End[shotIdx].Z}
                        } else if coordType == 4 {
                            IntroP_End[shotIdx] = Vector3{IntroP_End[shotIdx].X, val, IntroP_End[shotIdx].Z}
                        } else if coordType == 5 {
                            IntroP_End[shotIdx] = Vector3{IntroP_End[shotIdx].X, IntroP_End[shotIdx].Y, val}
                        } else if coordType == 6 {
                            // Cập nhật Yaw Y từ Server nhưng bảo tồn 100% độ nghiêng điện ảnh Pitch X và Roll Z
                            IntroR_Start[shotIdx] = Vector3{IntroR_Start[shotIdx].X, val, IntroR_Start[shotIdx].Z}
                        } else if coordType == 7 {
                            IntroR_End[shotIdx] = Vector3{IntroR_End[shotIdx].X, val, IntroR_End[shotIdx].Z}
                        }
                    }
                } else if raw >= 1500000000 {
                    // Waypoint coordinate decode (offset 1,500,000,000)
                    raw = raw - 1500000000
                    var wpIndex = raw / 1000000
                    var rem = raw - (wpIndex * 1000000)
                    var coordType = rem / 100000
                    var intVal = rem - (coordType * 100000)
                    var val = (intVal as float) * 0.1 * sign
                    if WpX != nil && wpIndex >= 0 && wpIndex < 256 {
                        if coordType == 0 {
                            WpX[wpIndex] = val
                        } else if coordType == 1 {
                            WpY[wpIndex] = val
                        } else if coordType == 2 {
                            WpZ[wpIndex] = val
                            // LogInfo("[WaypointSync] WP" + convert.ToString(wpIndex) + " updated: " + convert.ToString(WpX[wpIndex]) + "," + convert.ToString(WpY[wpIndex]) + "," + convert.ToString(val))
                        }
                    }
                } else {
                    // Checkpoint coordinate decode (offset 1,000,000,000)
                    raw = raw - 1000000000
                    var cpIndex = raw / 1000000
                    var rem = raw - (cpIndex * 1000000)
                    var coordType = rem / 100000
                    var intVal = rem - (coordType * 100000)
                    var val = (intVal as float) * 0.1 * sign
                    if CpCheckpointX != nil {
                        if cpIndex == 99 {
                            if coordType == 0 {
                                CpRespawnX = val
                            } else if coordType == 1 {
                                CpRespawnY = val
                            } else if coordType == 2 {
                                CpRespawnZ = val
                            } else if coordType == 3 {
                                if !IsRaceStarted {
                                    val = EnforceStartForwardYawClient(val)
                                }
                                CpRespawnYaw = val
                                HasCpRespawn = true
                                if !IsRaceStarted && KartModel != nil {
                                    EnforceCorrectStartHeadingClient()
                                }
                                if math.Abs(CpRespawnX) > 0.1 || math.Abs(CpRespawnZ) > 0.1 {
                                    if !HasSpawnedAtStartSlot {
                                        HasSpawnedAtStartSlot = true
                                        PendingSpawnAtStart = false
                                        SpawnKartAtRespawn()
                                        SpawnDropTimer = 1.5
                                        if !IsRaceStarted {
                                            IsExternallyLocked = true
                                        }
                                        if ClientVisualCar != nil { std.SetActive(ClientVisualCar as entity, true) }
                                    }
                                }
                                // LogInfo("[RespawnSync] Pos: " + convert.ToString(CpRespawnX) + "," + convert.ToString(CpRespawnY) + "," + convert.ToString(CpRespawnZ) + " Yaw: " + convert.ToString(CpRespawnYaw))
                            }
                        } else {
                            if coordType == 0 {
                                CpCheckpointX[cpIndex] = val
                            } else if coordType == 1 {
                                CpCheckpointY[cpIndex] = val
                            } else if coordType == 2 {
                                CpCheckpointZ[cpIndex] = val
                                // LogInfo("[CheckpointSync] CP" + convert.ToString(cpIndex) + " updated: " + convert.ToString(CpCheckpointX[cpIndex]) + "," + convert.ToString(CpCheckpointY[cpIndex]) + "," + convert.ToString(val))
                            }
                        }
                    }
                }
            }
        }
    } 

    func InitGuideArrows() {
        if GuideArrowsInitialized { return }
        var template = EditorGenLib.EResSceneMainScene.ArrowSample as entity<Entity>
        if template == nil { return }
        std.SetActive(template as entity, false)
        GuideArrows = list.New(0, 35) as List<entity<Entity>>
        for i = 0, 35, 1 {
            std.Clone(out var a, template as entity)
            if a != nil {
                std.SetActive(a as entity, false)
                list.Append(GuideArrows as List<object>, a as object)
            }
        }
        GuideArrowsInitialized = true
    }

    func UpdateGuidePath(dt float) {
        if !GuideArrowsInitialized {
            InitGuideArrows()
            if !GuideArrowsInitialized { return }
        }

        var shouldShow = IsRaceStarted && !CpIsRaceFinished && !IsExternallyLocked && !IsLocalResetting && !IsIntroCamActive
        if !shouldShow {
            if GuideArrowsVisible {
                KartGuidePath.SetArrowsActive(GuideArrows, false)
                GuideArrowsVisible = false
            }
            return
        }

        if KartModel == nil || WpTotalWaypoints < 2 || WpX == nil || WpZ == nil {
            if GuideArrowsVisible {
                KartGuidePath.SetArrowsActive(GuideArrows, false)
                GuideArrowsVisible = false
            }
            return
        }

        if !GuideArrowsVisible {
            KartGuidePath.SetArrowsActive(GuideArrows, true)
            GuideArrowsVisible = true
        }

        var carPos = KartModel<Transform>.Position
        KartGuidePath.UpdateGuideLine(GuideArrows, carPos, KartModel as entity<Entity>, WpX, WpY, WpZ, WpTotalWaypoints, NearestWpSegment, CurrentSpeedKmh, GuideArrowScale)
    }

    func UpdateWrongWayFromWaypoints(dt float) {
        if WpTotalWaypoints < 2 { IsWrongWay = false; WrongWayTimer = 0.0; return }
        if WpX == nil { IsWrongWay = false; WrongWayTimer = 0.0; return }
        if KartModel == nil { IsWrongWay = false; WrongWayTimer = 0.0; return }

        var vel = KartModel<Rigidbody>.Velocity
        var velLen = math.Sqrt(vel.X * vel.X + vel.Z * vel.Z)
        var speedKmh = KartMath.PhysSpeedToDisplaySpeed(velLen, SpeedUnitScale)
        if speedKmh < WrongWaySpeedMin {
            WrongWayTimer -= dt * 2.0
            if WrongWayTimer < 0.0 { WrongWayTimer = 0.0 }
            IsWrongWay = false
            return
        }

        var seg = NearestWpSegment
        if seg < 0 { seg = 0 }
        if seg >= WpTotalWaypoints { seg = WpTotalWaypoints - 1 }
        var nextSeg = seg + 1
        if nextSeg >= WpTotalWaypoints { nextSeg = 0 }

        var fwdX = WpX[nextSeg] - WpX[seg]
        var fwdZ = WpZ[nextSeg] - WpZ[seg]
        var fwdLen = math.Sqrt(fwdX * fwdX + fwdZ * fwdZ)
        if fwdLen < 0.01 { return }

        fwdX = fwdX / fwdLen
        fwdZ = fwdZ / fwdLen
        var vx = vel.X / velLen
        var vz = vel.Z / velLen
        var dot = vx * fwdX + vz * fwdZ

        if dot < WrongWayDotLimit {
            WrongWayTimer += dt
        } else {
            WrongWayTimer -= dt * 2.0
            if WrongWayTimer < 0.0 { WrongWayTimer = 0.0 }
        }
        IsWrongWay = WrongWayTimer >= WrongWayThreshold
    }

    func UpdateNearestWaypoint() {
        if WpTotalWaypoints < 2 { return }
        if WpX == nil { return }
        if KartModel == nil { return }

        var carPos = KartModel<Transform>.Position
        var bestDistSq = 999999999.0
        var bestSeg = 0
        for seg = 0, WpTotalWaypoints, 1 {
            var wpDx = carPos.X - WpX[seg]
            var wpDz = carPos.Z - WpZ[seg]
            var dSq = wpDx * wpDx + wpDz * wpDz
            if dSq < bestDistSq {
                bestDistSq = dSq
                bestSeg = seg
            }
        }

        var fwdIdx = bestSeg + 1
        if fwdIdx >= WpTotalWaypoints { fwdIdx = 0 }
        var segFwdX = WpX[fwdIdx] - WpX[bestSeg]
        var segFwdZ = WpZ[fwdIdx] - WpZ[bestSeg]
        var toCarX = carPos.X - WpX[bestSeg]
        var toCarZ = carPos.Z - WpZ[bestSeg]
        var dotFwd = toCarX * segFwdX + toCarZ * segFwdZ
        if dotFwd > 0.0 {
            NearestWpSegment = fwdIdx
        } else {
            NearestWpSegment = bestSeg
        }
    }

    // ---------------------------------------------------------
    // POST-FINISH AI AUTOPILOT (Pure Grip Racing + Direct Steering + Anti-Stuck)
    // Tự động điều khiển vô lăng bám đường, giữ tim đường, hãm phanh gắt ôm cua và tự lùi khi cạ tường
    // ---------------------------------------------------------
    func UpdateAiAutopilot(dt float) {
        if WpTotalWaypoints < 2 || WpX == nil || KartModel == nil { return }

        var carPos = KartModel<Transform>.Position

        // 0. XỬ LÝ KẸT TƯỜNG (Stuck Detection & Auto-Reverse Recovery)
        if CurrentSpeedKmh < 6.0 && DriveForwardSpeed > 0.0 {
            AiStuckTimer += dt
        } else {
            AiStuckTimer = 0.0
        }

        if AiStuckTimer > 0.6 {
            // Đã bị chặn đứng quá 0.6s -> Kích hoạt lùi xe trong 1.2s
            AiReverseTimer = 1.2
            AiStuckTimer = 0.0
        }

        if AiReverseTimer > 0.0 {
            AiReverseTimer -= dt
            IsReversing = true
            IsBraking = false
            AiDesiredSpeedKmh = 35.0
            AiTurnRate = -45.0
            SmoothedTurnInput = -1.0
            return
        } else {
            IsReversing = false
        }

        // 1. Kiểm tra Waypoint mục tiêu hợp lệ
        if AiTargetWp < 0 || AiTargetWp >= WpTotalWaypoints {
            AiTargetWp = NearestWpSegment
        }

        var curWp = AiTargetWp
        var nextWp = curWp + 1
        if nextWp >= WpTotalWaypoints { nextWp = 0 }
        var lookaheadWp = nextWp + 1
        if lookaheadWp >= WpTotalWaypoints { lookaheadWp = 0 }

        var curX = WpX[curWp]
        var curZ = WpZ[curWp]
        var dx = curX - carPos.X
        var dz = curZ - carPos.Z
        var distSq = dx * dx + dz * dz

        // Kiểm tra xe đã vượt qua Waypoint hiện tại chưa bằng tích vô hướng
        var toNextX = WpX[nextWp] - curX
        var toNextZ = WpZ[nextWp] - curZ
        var dotPast = (carPos.X - curX) * toNextX + (carPos.Z - curZ) * toNextZ

        // Chuyển sang Waypoint kế tiếp: chỉ chuyển khi ở cự ly gần (< 12m) hoặc đã vượt qua (< 16m)
        // Tránh tình trạng nhảy cóc Waypoint khiến xe đâm thẳng vào tường
        if distSq < 144.0 || (distSq < 256.0 && dotPast > 0.0) {
            AiTargetWp = nextWp
            curWp = nextWp
            nextWp = curWp + 1
            if nextWp >= WpTotalWaypoints { nextWp = 0 }
            lookaheadWp = nextWp + 1
            if lookaheadWp >= WpTotalWaypoints { lookaheadWp = 0 }
            curX = WpX[curWp]
            curZ = WpZ[curWp]
            dx = curX - carPos.X
            dz = curZ - carPos.Z
            distSq = dx * dx + dz * dz
        }

        // 2. Thuật toán Ngắm xa (Lookahead): Pha trộn mượt với Waypoint tiếp theo
        var aimX = curX
        var aimZ = curZ
        if distSq < 400.0 {
            var blendRatio = 0.45
            aimX = curX * (1.0 - blendRatio) + WpX[nextWp] * blendRatio
            aimZ = curZ * (1.0 - blendRatio) + WpZ[nextWp] * blendRatio
        }

        var aimDx = aimX - carPos.X
        var aimDz = aimZ - carPos.Z

        // 3. Tính góc lái theo hướng mục tiêu
        var carFwd = KartModel<Transform>.Forward
        var carYaw = math.ATan2(carFwd.X, carFwd.Z)
        var targetYaw = math.ATan2(aimDx, aimDz)
        var yawDiff = NormalizeYawClient(targetYaw - carYaw)

        // Tính độ gắt của khúc cua tiếp theo
        var seg1X = WpX[nextWp] - curX
        var seg1Z = WpZ[nextWp] - curZ
        var seg2X = WpX[lookaheadWp] - WpX[nextWp]
        var seg2Z = WpZ[lookaheadWp] - WpZ[nextWp]
        var segYaw1 = math.ATan2(seg1X, seg1Z)
        var segYaw2 = math.ATan2(seg2X, seg2Z)
        var futureTurnAngle = math.Abs(NormalizeYawClient(segYaw2 - segYaw1))

        var maxTurnCurvature = math.Abs(yawDiff)
        if futureTurnAngle > maxTurnCurvature { maxTurnCurvature = futureTurnAngle }

        // 4. Hãm tốc độ ôm cua hợp lý (Cruising Speeds an toàn, không phóng bạt mạng)
        if maxTurnCurvature >= 30.0 {
            // Cua gắt: hãm về 45 km/h để ôm cua chắc chắn
            AiDesiredSpeedKmh = 45.0
        } else if maxTurnCurvature >= 15.0 {
            // Cua vừa: giảm về 65 km/h
            AiDesiredSpeedKmh = 65.0
        } else {
            // Đường thẳng / cong nhẹ: chạy êm 85 km/h
            AiDesiredSpeedKmh = 85.0
        }

        // TẮT HOÀN TOÀN DRIFT: Chạy bám đường 100% (Grip Racing)
        IsBraking = false
        IsBoosting = false
        AiIsDrifting = false
        if DriftState != DriftState_NORMAL {
            DriftState = DriftState_NORMAL
            DriftFlowTimer = 0.0
            DriftBlend = 0.0
            ActiveDriftDir = 0.0
            CurrentVisualYaw = 0.0
            CurrentVisualLean = 0.0
        }

        // 5. RAYCAST QUÉT TƯỜNG (4 Tia: 2 Tia Chéo Trước 38° + 2 Tia Ngang Hông 90°)
        var fwdVec = math.RotateVector(Vector3{0.0, 0.0, 1.0}, PhysicsQuat)
        var rgtVec = math.RotateVector(Vector3{1.0, 0.0, 0.0}, PhysicsQuat)
        var rayStart = Vector3{carPos.X, carPos.Y + 0.5, carPos.Z}
        var myKartEnt = KartModel as entity<Entity>

        // Tia chéo trước phải (~38 độ, tầm 7.0m)
        var whiskerDist = 7.0
        var dirRgt = Vector3{fwdVec.X * 0.78 + rgtVec.X * 0.62, 0.0, fwdVec.Z * 0.78 + rgtVec.Z * 0.62}
        physics.SingleRaycast(rayStart, dirRgt, whiskerDist, nil, false, out var hitRgtEnt, out var hitRgtPos, out var hitRgtDist, out var hitRgtNorm)

        // Tia chéo trước trái (~ -38 độ, tầm 7.0m)
        var dirLft = Vector3{fwdVec.X * 0.78 - rgtVec.X * 0.62, 0.0, fwdVec.Z * 0.78 - rgtVec.Z * 0.62}
        physics.SingleRaycast(rayStart, dirLft, whiskerDist, nil, false, out var hitLftEnt, out var hitLftPos, out var hitLftDist, out var hitLftNorm)

        // Tia ngang hông phải (90 độ, tầm 10m)
        var latMaxDist = 10.0
        physics.SingleRaycast(rayStart, Vector3{rgtVec.X, 0.0, rgtVec.Z}, latMaxDist, nil, false, out var latRgtEnt, out var latRgtPos, out var latRgtDist, out var latRgtNorm)

        // Tia ngang hông trái (-90 độ, tầm 10m)
        physics.SingleRaycast(rayStart, Vector3{-rgtVec.X, 0.0, -rgtVec.Z}, latMaxDist, nil, false, out var latLftEnt, out var latLftPos, out var latLftDist, out var latLftNorm)

        var wallSteerPush = 0.0

        // A. Né tường sớm bằng tia chéo phía trước (Whisker Avoidance)
        if hitRgtEnt != nil && hitRgtEnt != myKartEnt && hitRgtDist > 0.05 && hitRgtNorm.Y < 0.6 {
            var rgtForce = (whiskerDist - hitRgtDist) / whiskerDist
            wallSteerPush -= rgtForce * 0.85
            if hitRgtDist < 2.5 && AiDesiredSpeedKmh > 50.0 {
                AiDesiredSpeedKmh = 50.0
            }
        }

        if hitLftEnt != nil && hitLftEnt != myKartEnt && hitLftDist > 0.05 && hitLftNorm.Y < 0.6 {
            var lftForce = (whiskerDist - hitLftDist) / whiskerDist
            wallSteerPush += lftForce * 1.0
            if hitLftDist < 3.0 && AiDesiredSpeedKmh > 38.0 {
                AiDesiredSpeedKmh = 38.0
            }
        }

        // B. Tự động cân bằng giữa tâm làn đường (Lane Centering bằng 2 tia ngang 90 độ)
        var hasLatRgt = (latRgtEnt != nil && latRgtEnt != myKartEnt && latRgtDist > 0.05 && latRgtNorm.Y < 0.6)
        var hasLatLft = (latLftEnt != nil && latLftEnt != myKartEnt && latLftDist > 0.05 && latLftNorm.Y < 0.6)

        if hasLatRgt && hasLatLft {
            var roadWidth = latRgtDist + latLftDist
            if roadWidth > 2.0 && roadWidth < 18.0 {
                var centerOffset = (latRgtDist - latLftDist) / roadWidth
                wallSteerPush += centerOffset * 0.45
            }
        } else if hasLatRgt && latRgtDist < 3.5 {
            wallSteerPush -= ((3.5 - latRgtDist) / 3.5) * 0.6
        } else if hasLatLft && latLftDist < 3.5 {
            wallSteerPush += ((3.5 - latLftDist) / 3.5) * 0.6
        }

        // 6. TÍNH LỰC BẺ LÁI TRỰC TIẾP (Direct Steering Rate cho AI)
        // Không phụ thuộc bộ lọc phím người chơi, triệt tiêu hoàn toàn hiện tượng thiếu lái
        var desiredTurnRate = (yawDiff * 2.8) + (wallSteerPush * 65.0)
        var maxTurnRate = 78.0
        if desiredTurnRate > maxTurnRate { desiredTurnRate = maxTurnRate }
        if desiredTurnRate < -maxTurnRate { desiredTurnRate = -maxTurnRate }
        AiTurnRate = math.Lerp(AiTurnRate, desiredTurnRate, dt * 6.5)

        // Cập nhật visual steering cho bánh xe và vô lăng
        var steerNorm = (yawDiff / 22.0) + wallSteerPush
        if steerNorm > 1.0 { steerNorm = 1.0 }
        if steerNorm < -1.0 { steerNorm = -1.0 }

        if steerNorm > 0.05 {
            IsTurningRight = true
            IsTurningLeft = false
        } else if steerNorm < -0.05 {
            IsTurningLeft = true
            IsTurningRight = false
        } else {
            IsTurningLeft = false
            IsTurningRight = false
        }
        SmoothedTurnInput = steerNorm
    }

    // ---------------------------------------------------------
    // GHOST REPLAY SYSTEM: MULTI-CHUNK ARCHITECTURE (20 Chunks x 30s = 10 phút)
    // ---------------------------------------------------------
    func GetReplayPos(frameIdx int) Vector3 {
        if frameIdx < 0 || frameIdx >= ReplayTotalFrames || ReplayChunksPos == nil { return Vector3{0.0, 0.0, 0.0} }
        var cIdx = frameIdx / 600
        var lIdx = frameIdx % 600
        if cIdx >= list.Length(ReplayChunksPos as List<object>) { return Vector3{0.0, 0.0, 0.0} }
        var chunk = ReplayChunksPos[cIdx]
        if chunk == nil || lIdx >= list.Length(chunk as List<object>) { return Vector3{0.0, 0.0, 0.0} }
        return chunk[lIdx]
    }

    func GetReplayRot(frameIdx int) Quaternion {
        if frameIdx < 0 || frameIdx >= ReplayTotalFrames || ReplayChunksRot == nil { return Quaternion{0.0, 0.0, 0.0, 1.0} }
        var cIdx = frameIdx / 600
        var lIdx = frameIdx % 600
        if cIdx >= list.Length(ReplayChunksRot as List<object>) { return Quaternion{0.0, 0.0, 0.0, 1.0} }
        var chunk = ReplayChunksRot[cIdx]
        if chunk == nil || lIdx >= list.Length(chunk as List<object>) { return Quaternion{0.0, 0.0, 0.0, 1.0} }
        return chunk[lIdx]
    }

    func GetReplaySpeed(frameIdx int) float {
        if frameIdx < 0 || frameIdx >= ReplayTotalFrames || ReplayChunksSpeed == nil { return 0.0 }
        var cIdx = frameIdx / 600
        var lIdx = frameIdx % 600
        if cIdx >= list.Length(ReplayChunksSpeed as List<object>) { return 0.0 }
        var chunk = ReplayChunksSpeed[cIdx]
        if chunk == nil || lIdx >= list.Length(chunk as List<object>) { return 0.0 }
        return chunk[lIdx]
    }

    func GetReplaySteer(frameIdx int) float {
        if frameIdx < 0 || frameIdx >= ReplayTotalFrames || ReplayChunksSteer == nil { return 0.0 }
        var cIdx = frameIdx / 600
        var lIdx = frameIdx % 600
        if cIdx >= list.Length(ReplayChunksSteer as List<object>) { return 0.0 }
        var chunk = ReplayChunksSteer[cIdx]
        if chunk == nil || lIdx >= list.Length(chunk as List<object>) { return 0.0 }
        return chunk[lIdx]
    }

    func GetReplayDrift(frameIdx int) bool {
        if frameIdx < 0 || frameIdx >= ReplayTotalFrames || ReplayChunksDrift == nil { return false }
        var cIdx = frameIdx / 600
        var lIdx = frameIdx % 600
        if cIdx >= list.Length(ReplayChunksDrift as List<object>) { return false }
        var chunk = ReplayChunksDrift[cIdx]
        if chunk == nil || lIdx >= list.Length(chunk as List<object>) { return false }
        return chunk[lIdx]
    }

    func GetReplayBoost(frameIdx int) bool {
        if frameIdx < 0 || frameIdx >= ReplayTotalFrames || ReplayChunksBoost == nil { return false }
        var cIdx = frameIdx / 600
        var lIdx = frameIdx % 600
        if cIdx >= list.Length(ReplayChunksBoost as List<object>) { return false }
        var chunk = ReplayChunksBoost[cIdx]
        if chunk == nil || lIdx >= list.Length(chunk as List<object>) { return false }
        return chunk[lIdx]
    }

    func RecordReplayFrame(dt float) {
        if ReplayChunksPos == nil || KartModel == nil { return }
        ReplayRecordTimer += dt
        if ReplayRecordTimer < 0.05 { return }
        ReplayRecordTimer -= 0.05

        var chunkIdx = ReplayTotalFrames / 600
        if chunkIdx >= 20 { return } // Tối đa 20 Chunks = 10 phút

        // Cấp phát động chunk mới khi chuyển sang chu kỳ 30s tiếp theo
        var numChunks = list.Length(ReplayChunksPos as List<object>)
        if chunkIdx >= numChunks {
            list.Append(ReplayChunksPos as List<object>, list.New(0, 600) as object)
            list.Append(ReplayChunksRot as List<object>, list.New(0, 600) as object)
            list.Append(ReplayChunksSpeed as List<object>, list.New(0, 600) as object)
            list.Append(ReplayChunksSteer as List<object>, list.New(0, 600) as object)
            list.Append(ReplayChunksDrift as List<object>, list.New(0, 600) as object)
            list.Append(ReplayChunksBoost as List<object>, list.New(0, 600) as object)
        }

        var pos = KartModel<Transform>.Position
        var rot = PhysicsQuat
        var isDrift = (DriftState == DriftState_HOLD || DriftState == DriftState_ENTER || DriftBlend > 0.2)

        var posChunk = ReplayChunksPos[chunkIdx] as List<object>
        var rotChunk = ReplayChunksRot[chunkIdx] as List<object>
        var spdChunk = ReplayChunksSpeed[chunkIdx] as List<object>
        var strChunk = ReplayChunksSteer[chunkIdx] as List<object>
        var drfChunk = ReplayChunksDrift[chunkIdx] as List<object>
        var bstChunk = ReplayChunksBoost[chunkIdx] as List<object>

        list.Append(posChunk, pos as object)
        list.Append(rotChunk, rot as object)
        list.Append(spdChunk, CurrentSpeedKmh as object)
        list.Append(strChunk, CurrentSteerAngle as object)
        list.Append(drfChunk, isDrift as object)
        list.Append(bstChunk, IsBoosting as object)

        ReplayTotalFrames += 1
    }

    func FindNearestReplayFrame(pos Vector3) int {
        var bestIdx = 0
        var bestDistSq = 999999.0
        if ReplayTotalFrames <= 0 { return 0 }
        for f = 0, ReplayTotalFrames, 1 {
            var pt = GetReplayPos(f)
            var dx = pt.X - pos.X
            var dy = pt.Y - pos.Y
            var dz = pt.Z - pos.Z
            var dSq = dx * dx + dy * dy + dz * dz
            if dSq < bestDistSq {
                bestDistSq = dSq
                bestIdx = f
            }
        }
        return bestIdx
    }

    func UpdateReplayPlayback(dt float) {
        if ReplayTotalFrames < 10 || KartModel == nil {
            UpdateAiAutopilot(dt)
            return
        }

        // BƯỚC 1: HÒA NHẬP (BLEND) MƯỢT MÀ VÀO QUỸ ĐẠO REPLAY (KHÔNG TELEPORT)
        if ReplayBlendTimer < ReplayBlendDuration {
            if ReplayBlendTimer == 0.0 {
                // Khởi động giai đoạn hòa nhập: Lưu vị trí xe vừa trôi xong và tìm frame replay gần nhất
                ReplayBlendStartPos = KartModel<Transform>.Position
                ReplayBlendStartRot = PhysicsQuat
                ReplayPlayFrame = FindNearestReplayFrame(ReplayBlendStartPos)
                ReplayPlayT = 0.0
            }
            ReplayBlendTimer += dt
            if ReplayBlendTimer > ReplayBlendDuration {
                ReplayBlendTimer = ReplayBlendDuration
            }
        }

        ReplayPlayT += dt / 0.05
        while ReplayPlayT >= 1.0 {
            ReplayPlayT -= 1.0
            ReplayPlayFrame += 1
            if ReplayPlayFrame >= ReplayTotalFrames - 1 {
                // Khi phát hết toàn bộ trận đấu -> Tự lặp lại vòng đua cuối cùng để cruise vô tận
                var loopStart = 0
                if ReplayFinalLapStartFrame > 0 && ReplayFinalLapStartFrame < ReplayTotalFrames - 20 {
                    loopStart = ReplayFinalLapStartFrame
                }
                ReplayPlayFrame = loopStart
            }
        }

        var nextFrame = ReplayPlayFrame + 1
        if nextFrame >= ReplayTotalFrames { nextFrame = ReplayPlayFrame }

        var p0 = GetReplayPos(ReplayPlayFrame)
        var p1 = GetReplayPos(nextFrame)
        var targetPos = math.LerpVector3(p0, p1, ReplayPlayT)

        var q0 = GetReplayRot(ReplayPlayFrame)
        var q1 = GetReplayRot(nextFrame)
        var targetRot = math.SlerpQuaternion(q0, q1, ReplayPlayT)

        // Tính vị trí và góc xoay cuối cùng (lướt mượt mà SmoothStep từ điểm trôi vào quỹ đạo replay)
        var finalPos = targetPos
        var finalRot = targetRot
        if ReplayBlendTimer < ReplayBlendDuration {
            var blendProgress = ReplayBlendTimer / ReplayBlendDuration
            var smoothT = blendProgress * blendProgress * (3.0 - 2.0 * blendProgress)
            finalPos = math.LerpVector3(ReplayBlendStartPos, targetPos, smoothT)
            finalRot = math.SlerpQuaternion(ReplayBlendStartRot, targetRot, smoothT)
        }

        KartModel<Transform>.Position = finalPos
        PhysicsQuat = finalRot
        var eulerRot = math.QuaternionToEulerAngle(finalRot)
        KartModel<Transform>.Rotation = eulerRot
        KartModel<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}

        var s0 = GetReplaySpeed(ReplayPlayFrame)
        var s1 = GetReplaySpeed(nextFrame)
        CurrentSpeedKmh = math.Lerp(s0, s1, ReplayPlayT)
        UISpeedKmh = CurrentSpeedKmh * 0.75

        var st0 = GetReplaySteer(ReplayPlayFrame)
        var st1 = GetReplaySteer(nextFrame)
        CurrentSteerAngle = math.Lerp(st0, st1, ReplayPlayT)

        var isDrifting = GetReplayDrift(ReplayPlayFrame)
        var isBoosting = GetReplayBoost(ReplayPlayFrame)
        IsBoosting = isBoosting

        SyncNitroEffects()
        SyncDriftEffects(isDrifting)

        KartVisual.ApplySteeringWheelVisuals(SteeringNodes, InitSteerRot, CurrentSteerAngle)
        var visualSpeed = KartMath.DisplaySpeedToPhysSpeed(CurrentSpeedKmh, SpeedUnitScale)
        CurrentRollAngle = KartVisualMath.CalcWheelRollAngleNext(CurrentRollAngle, visualSpeed, 1.0, dt, 150.0)
        KartVisual.ApplyWheelRollVisuals(WheelNodes, InitWheelRot, CurrentRollAngle)
    }

    async func DelayedPhysicsWakeup() {
        std.WaitForMillisecond(500)
        if KartModel != nil {
            KartLifecycle.WakeAndZeroKart(KartModel)
            SnapCameraToKartNow()
            IsLocalResetting = false
            IsExternallyLocked = false
            IsRaceStarted = true
            // std.LogInfo("[Physics] KartModel Woken up. Reset unlocked locally.")
        }
    }

    // ---------------------------------------------------------
    // CLIENT-SIDE WP SCAN: quét WP_ markers trực tiếp từ scene
    // Không phụ thuộc server event sync (tránh event flooding)
    func ScanWaypointMarkersClient() {
        InitClientLists()
        // Tìm scene root: đi lên từ Sphere entity hoặc thisEntity
        var anchor = EditorGenLib.EResSceneMainScene.Sphere as entity<Entity>
        var root = anchor
        if root == nil {
            root = thisEntity as entity<Entity>
        }
        if root == nil {
            LoadDefaultTrackWaypoints()
            return
        }
        // Đi lên parent tới root (max 20 cấp tránh infinite loop)
        for step = 0, 20, 1 {
            var parent = std.GetParent(root)
            if parent == nil { break }
            root = parent
        }
        // LogInfo("[WP_ClientScan] Scanning from root: " + root<Entity>.Name)
        WpTotalWaypoints = 0
        ScanWpNodeRecursive(root, 256)
        if WpTotalWaypoints < 4 {
            LoadDefaultTrackWaypoints()
        }
    }

    func ScanWpNodeRecursive(node entity<Entity>, maxWp int) {
        if node == nil { return }
        var nodeName = node<Entity>.Name
        if strings.Find(nodeName, "WP_", 0) == 0 {
            var nameParts = strings.Split(nodeName, "_")
            var partsCount = list.Length(nameParts as List<object>)
            if partsCount >= 2 {
                var idxStr = nameParts[1] as string
                convert.StringToFloat(idxStr, out var parsedIdx, out var parseOk)
                if parseOk {
                    var wpIndex = math.Floor(parsedIdx + 0.5) as int
                    if wpIndex >= 0 && wpIndex < maxWp {
                        var p = node<Transform>.Position
                        WpX[wpIndex] = p.X
                        WpY[wpIndex] = p.Y
                        WpZ[wpIndex] = p.Z
                        // Track max index via WpTotalWaypoints temporarily
                        if wpIndex >= WpTotalWaypoints {
                            WpTotalWaypoints = wpIndex + 1
                        }
                    }
                }
            }
        }
        var children = std.GetChildren(node)
        var count = list.Length(children as List<object>)
        for i = 0, count, 1 {
            var child = children[i] as entity<Entity>
            if child != nil { ScanWpNodeRecursive(child, maxWp) }
        }
    }

    func CalcYawByWaypointAtClient(posX float, posZ float) float {
        if WpTotalWaypoints < 2 || WpX == nil { return 0.0 }
        var bestDistSq = 999999999.0
        var nearestWp = 0

        for i = 0, WpTotalWaypoints, 1 {
            var dx = WpX[i] - posX
            var dz = WpZ[i] - posZ
            var dSq = dx * dx + dz * dz
            if dSq < bestDistSq {
                bestDistSq = dSq
                nearestWp = i
            }
        }

        var nextWp = nearestWp + 1
        if nextWp >= WpTotalWaypoints { nextWp = 0 }
        var yawDx = WpX[nextWp] - WpX[nearestWp]
        var yawDz = WpZ[nextWp] - WpZ[nearestWp]
        var resultYaw = NormalizeYawClient(math.ATan2(yawDx, yawDz))
        return resultYaw
    }

    func ScanStartSlotsClient() {
        var anchor = EditorGenLib.EResSceneMainScene.Sphere as entity<Entity>
        var root = anchor
        if root == nil {
            root = thisEntity as entity<Entity>
        }
        if root == nil { return }
        for step = 0, 20, 1 {
            var parent = std.GetParent(root)
            if parent == nil { break }
            root = parent
        }
        ScanStartSlotNodeRecursive(root)
    }

    func ScanStartSlotNodeRecursive(node entity<Entity>) {
        if node == nil { return }
        var nodeName = node<Entity>.Name
        var isSlotMarker = false
        var idxStr = ""

        if strings.Find(nodeName, "Start_", 0) == 0 || strings.Find(nodeName, "Slot_", 0) == 0 || strings.Find(nodeName, "StartSlot_", 0) == 0 || strings.Find(nodeName, "Point_", 0) == 0 {
            var nameParts = strings.Split(nodeName, "_")
            if list.Length(nameParts as List<object>) >= 2 {
                idxStr = nameParts[1] as string
                isSlotMarker = true
            }
        } else {
            var pNode = std.GetParent(node)
            if pNode != nil {
                var pName = pNode<Entity>.Name
                if strings.Find(pName, "Start", 0) >= 0 || strings.Find(pName, "Point", 0) >= 0 {
                    convert.StringToFloat(nodeName, out var numIdx, out var numOk)
                    if numOk {
                        idxStr = nodeName
                        isSlotMarker = true
                    }
                }
            }
        }

        if isSlotMarker && idxStr != "" {
            convert.StringToFloat(idxStr, out var parsedIdx, out var parseOk)
            if parseOk {
                var slotIndex = math.Floor(parsedIdx + 0.5) as int
                if !HasCpRespawn && (slotIndex == 0 || slotIndex == 1) {
                    var p = node<Transform>.Position
                    if math.Abs(p.X) > 0.1 || math.Abs(p.Z) > 0.1 {
                        CpRespawnX = p.X
                        CpRespawnY = p.Y
                        CpRespawnZ = p.Z
                        var calcYaw = 0.0
                        if WpTotalWaypoints >= 2 {
                            calcYaw = CalcYawByWaypointAtClient(p.X, p.Z)
                        } else {
                            calcYaw = GetCanonicalStartForwardYawClient()
                        }
                        calcYaw = EnforceStartForwardYawClient(calcYaw)
                        CpRespawnYaw = calcYaw
                        HasCpRespawn = true
                    }
                }
            }
        }

        var children = std.GetChildren(node)
        var count = list.Length(children as List<object>)
        for i = 0, count, 1 {
            var child = children[i] as entity<Entity>
            if child != nil { ScanStartSlotNodeRecursive(child) }
        }
    }

