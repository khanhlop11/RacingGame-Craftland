    func TriggerCrashCameraShake() {
        camera.PlayCustomCameraShake(Vector3{0.4, 0.35, 0.2}, 0.55, 25.0, 20, 200, 300)
    }

    func TriggerScrapeCameraShake(isLeft bool, speedKmh float) {
        var xOffset = 0.28
        if isLeft { xOffset = -0.28 }
        var speedRatio = speedKmh / 200.0
        if speedRatio < 0.3 { speedRatio = 0.3 }
        if speedRatio > 1.2 { speedRatio = 1.2 }
        var amp = 0.20 + speedRatio * 0.15
        camera.PlayCustomCameraShake(Vector3{xOffset, 0.12, 0.15}, amp, 28.0, 15, 120, 160)
    }

    func TriggerNitroInitialKickShake() {
        // Cú giật đề-pa Nitro: Dằn nảy trục Y (0.26) và nhún lùi Z (0.08), triệt tiêu trục ngang X để loại bỏ giật lag hai bên
        camera.PlayCustomCameraShake(Vector3{0.03, 0.34, 0.12}, 0.42, 22.0, 30, 260, 480)
    }

    func TriggerLandingCameraShake(impactForce float) {
        var amp = 0.35 * impactForce
        if amp > 0.6 { amp = 0.6 }
        camera.PlayCustomCameraShake(Vector3{0.0, 0.5, 0.0}, amp, 20.0, 20, 180, 260)
    }

    // ---------------------------------------------------------
    // SUBREGION: PHYSICS / SPEED MATH HELPERS
    // Timing notes:
    // - Pure scalar formulas moved to Kart/KartMath.fcg.
    // - Wrappers stay here so existing RacingMovement call sites and state ownership remain stable.
    // ---------------------------------------------------------

    func InitWheelSystem() {
        if ClientVisualCar == nil { return }  
        SteeringNodes = list.New(0, 4) as List<entity<Entity>>
        WheelNodes    = list.New(0, 4) as List<entity<Entity>>
        InitSteerRot  = list.New(0, 4)
        InitWheelRot  = list.New(0, 4)
        ScanWheelNodes(ClientVisualCar)
        WheelNodesInited = true
    }

    func NormalizeAngle180(angle float) float {
        return KartMath.NormalizeAngle180(angle)
    }

    // ---------------------------------------------------------
    // SUBREGION: DRIFT STATE / STEERING / LATERAL SLIP HELPERS
    // Future target: Kart/KartDrift.fcg
    // Execution order notes:
    // - Grounding/crash frame state must be published before UpdateDriftState().
    // - DriftBlend must update before physics velocity/lateral processing and before camera modules.
    // - Nitro charge depends on drift-turning state in the main loop.
    // ---------------------------------------------------------
    func UpdateDriftFlow(dt float, isBrakeHeld bool) {
        if !isBrakeHeld {
            DriftFlowTimer = 0.0
        } else {
            DriftFlowTimer = KartDriftState.CalcFlowTimerNext(DriftFlowTimer, dt, isBrakeHeld, DriftFlowHoldTime)
        }
    }

    // Goal #3: explicit drift state transitions (stable + future-tunable).
    // Keeps existing DriftBlend/DriftFlowTimer feel but centralizes state ownership.
    func UpdateDriftState(dt float, isStrictlyGrounded bool, raycastHit bool, turnInput float) {
        DriftStateTimer += dt

        // Air detection: raycastHit is more stable than IsStableGrounded for transitions.
        var isAir = !raycastHit

        // Crash override forces drift exit without boolean fights.
        if Frame_IsCrashing {
            if DriftState != DriftState_CRASH {
                DriftState = DriftState_CRASH
                DriftStateTimer = 0.0
            }
        } else if DriftState == DriftState_CRASH {
            DriftState = DriftState_NORMAL
            DriftStateTimer = 0.0
        }

        if isAir {
            if DriftState != DriftState_AIR {
                DriftState = DriftState_AIR
                DriftStateTimer = 0.0
            }
        } else {
            if DriftState == DriftState_AIR {
                DriftState = DriftState_LANDING
                DriftStateTimer = 0.0
                JustLandedTimer = 0.12
            }
        }

        JustLandedTimer = KartDriftState.CalcJustLandedTimerNext(JustLandedTimer, dt)

        var hasTurnInput = (IsTurningLeft || IsTurningRight)
        var driftGateSpeedKmh = KartMath.PhysSpeedToDisplaySpeed(math.Abs(DriveForwardSpeed) as float, SpeedUnitScale)
        if CurrentSpeedKmh > driftGateSpeedKmh { driftGateSpeedKmh = CurrentSpeedKmh }
        if KartDriftState.ShouldEnterDrift(IsBraking, isStrictlyGrounded, DriftState, DriftState_HOLD, DriftState_ENTER, DriftState_AIR, DriftState_LANDING, DriftState_CRASH, driftGateSpeedKmh, 30.0, hasTurnInput) {
            DriftState = DriftState_ENTER
            DriftStateTimer = 0.0
            DriftEntryDecelDone = false
            DriftEntryKickDone = false
        } else if KartDriftState.ShouldExitDrift(IsBraking, DriftState, DriftState_HOLD, DriftState_ENTER, DriftState_AIR, DriftState_LANDING, DriftState_CRASH) {
            DriftState = DriftState_EXIT
            DriftStateTimer = 0.0
        }

        // ENTER → HOLD quickly (keeps current smart-drift entry behavior).
        if DriftState == DriftState_ENTER {
            if DriftStateTimer >= 0.02 {
                DriftState = DriftState_HOLD
                DriftStateTimer = 0.0
            }
        }

        // EXIT → NORMAL when flow timer ends.
        if DriftState == DriftState_EXIT {
            if DriftFlowTimer <= 0.0 {
                DriftState = DriftState_NORMAL
                DriftStateTimer = 0.0
            }
        }

        // LANDING is a short bridge back to NORMAL/HOLD to reduce edge-case pops.
        if DriftState == DriftState_LANDING {
            if DriftStateTimer >= 0.10 {
                if IsBraking && isStrictlyGrounded {
                    DriftState = DriftState_HOLD
                } else {
                    DriftState = DriftState_NORMAL
                }
                DriftStateTimer = 0.0
            }
        }

        var driftRaw = KartDriftState.IsDriftRaw(DriftState, DriftState_ENTER, DriftState_HOLD)
        var driftActive = KartDriftState.IsDriftActive(DriftState, DriftState_ENTER, DriftState_HOLD, DriftState_EXIT, DriftFlowTimer)

        Frame_IsDrift = driftRaw
        Frame_IsDriftActive = driftActive
        Frame_TurnInput = turnInput
    }

    func UpdateDriftBlend(dt float, isDriftActive bool) {
        DriftBlend = KartDriftState.CalcBlendNext(DriftBlend, dt, isDriftActive, DriftEnterSharp, DriftExitSharp)
    }

    func CalcTargetGrip(isDriftActive bool, isBoosting bool, isGrounded bool) float {
        return KartDriftMath.CalcTargetGrip(Grip, DriftGrip, DriftGripAir, BoostGripMult, DriftBlend, isDriftActive, isBoosting, isGrounded)
    }

    func CalcHighSpeedSteerFactor(speedKmh float) float {
        return KartMath.CalcHighSpeedSteerFactor(speedKmh, HighSpeedSteerStart, HighSpeedSteerFloor)
    }

    func CalcSteerRate(turnInput float, isDriftActive bool, speedKmh float, localFwdSpeed float, curLatSpd float, dt float) float {
        if turnInput == 0.0 { return 0.0 }

        SteerRamp = KartSteeringMath.CalcSteerRampNext(SteerRamp, turnInput, dt, SteerRampSharp)

        var baseSteer = KartSteeringMath.CalcBaseSteer(Steer, DriftSteer, DriftBlend, isDriftActive, DriftSteerAuthority, IsBoosting, BoostSteerMult, CalcHighSpeedSteerFactor(speedKmh))

        // ── PROBLEM 2 FIX: steering authority integrated here ─────────────
        // The old code had `turnRate *= 3.5` after CalcSteerRate(), which was
        // a global multiplier disconnected from speed/state scaling.
        // Now the 3.5 authority factor is baked in here and is modulated per state:
        // - Grounded normal: full 3.5x
        // - Drift: 2.8x (slightly reduced — rear swing handles cornering)
        // - Airborne: 1.4x (less authority, momentum rules in air)
        var steerAuthority = KartSteeringMath.CalcSteerAuthority(isDriftActive, IsStableGrounded)

        var effectiveSteerRamp = SteerRamp
        if isDriftActive {
            // Khi drift ăn lái 100% tức thì, không có độ trễ ramp-up
            effectiveSteerRamp = DriftSteerRampFloor + (1.0 - DriftSteerRampFloor) * DriftBlend
        }

        var turnRate = turnInput * baseSteer * effectiveSteerRamp * 10.0 * steerAuthority

        if isDriftActive {
            // Tỉ lệ theo vận tốc: tốc độ càng cao bẻ lái drift càng gắt và dứt khoát
            var driftSpeedRatio = speedKmh / TopSpeed
            if driftSpeedRatio < 0.35 { driftSpeedRatio = 0.35 }
            if driftSpeedRatio > 1.50 { driftSpeedRatio = 1.50 }

            // Hệ số bứt góc cơ bản
            var driftSnapMult = 1.02 + (driftSpeedRatio - 0.35) * (0.25 / 1.15)

            // Tăng thêm đến +30% đều theo vận tốc từ 100 km/h (đạt trọn vẹn +30% ở dải tốc độ thực tế ~180-200 km/h)
            var speedBonus = (speedKmh - 100.0) / 100.0
            if speedBonus < 0.0 { speedBonus = 0.0 }
            if speedBonus > 1.0 { speedBonus = 1.0 }
            var speedSteerBoost = 1.0 + speedBonus * 0.30

            turnRate = turnRate * driftSnapMult * speedSteerBoost

            turnRate = KartSteeringMath.ApplyCounterSteerBoost(turnRate, turnInput, curLatSpd, DriftBlend, CounterSteerBoost)
            turnRate = KartSteeringMath.ApplyDriftYawAssist(turnRate, turnInput, speedKmh, TopSpeed, DriftYawAssist, DriftBlend)

            // Trần tốc độ xoay khi drift: 65°/s ở tốc độ thấp, mở rộng đến ~113°/s khi chạy nhanh (giảm bớt gắt)
            var maxDriftTurnRate = (65.0 + (driftSpeedRatio - 0.35) * (22.0 / 1.15)) * speedSteerBoost
            if turnRate > maxDriftTurnRate { turnRate = maxDriftTurnRate }
            if turnRate < -maxDriftTurnRate { turnRate = -maxDriftTurnRate }
        }

        return KartSteeringMath.ApplyReverseSteerFlip(turnRate, localFwdSpeed)
    }

    // Smart drift: hãm nhẹ 1 lần khi vào, sau đó sustain — KHÔNG drain liên tục

    func ProcessArcadeLateral(curLatSpd float, turnInput float, curFwdSpd float, isDriftActive bool, isGrounded bool, speedKmh float, dt float) float {
        var lat = curLatSpd

        var targetGrip = CalcTargetGrip(isDriftActive, IsBoosting, isGrounded)
        CurrentDynamicGrip = KartDriftMath.CalcDynamicGripNext(CurrentDynamicGrip, targetGrip, dt)

        // ── FEATURE 2: DRIFT ENTRY KICK ────────────────────────────────────
        // Fire a one-shot lateral impulse the first frame drift becomes active.
        // This creates an arcade rear-swing feeling without pushing the kart off screen.
        if isDriftActive && !DriftEntryKickDone && turnInput != 0.0 && isGrounded {
            lat = KartDriftMath.CalcEntryKickLat(lat, turnInput, speedKmh, TopSpeed, DriftEntryKickPower)
            DriftEntryKickDone = true
        }
        if !isDriftActive {
            DriftEntryKickDone = false
        }
        // ──────────────────────────────────────────────────────────────────

        // ── FEATURE 1: TRACTION RECOVERY TIMER ───────────────────────────
        // Track how long since drift exited to ramp grip back smoothly.
        TractionRecoveryTimer = KartDriftMath.CalcTractionRecoveryTimerNext(TractionRecoveryTimer, TractionRecoveryWindow, isDriftActive, dt)
        // ──────────────────────────────────────────────────────────────────

        var gripKill = KartDriftMath.CalcGripKill(CurrentDynamicGrip, isDriftActive, IsBoosting, TractionRecoveryTimer, TractionRecoveryWindow, DriftLatGripKeep, dt)
        lat = KartDriftMath.ApplyTractionRecoveryDamp(lat, isDriftActive, TractionRecoveryTimer, TractionRecoveryWindow, TractionRecoverySharp, dt)
        lat = KartDriftMath.ApplyGripKill(lat, gripKill)

        if !isDriftActive {
            var lowSpeedRatio = speedKmh / 90.0
            if lowSpeedRatio > 1.0 { lowSpeedRatio = 1.0 }
            var lowSpeedScrub = (1.0 - lowSpeedRatio) * 22.0 * dt
            lat = lat * (1.0 - lowSpeedScrub)
            ActiveDriftDir = 0.0
        } else {
            if turnInput != 0.0 {
                ActiveDriftDir = turnInput
            }
        }

        if isDriftActive {
            var effectiveTurn = turnInput
            // Drift Momentum Sustain: Nếu nhả nút rẽ nhưng vẫn giữ nút Drift, xe tiếp tục trôi lết theo đà
            if effectiveTurn == 0.0 && IsBraking && ActiveDriftDir != 0.0 {
                effectiveTurn = ActiveDriftDir * 0.75
            }
            if effectiveTurn != 0.0 {
                lat = KartDriftMath.ApplyDriftSlideForces(lat, effectiveTurn, curFwdSpd, speedKmh, TopSpeed, DriftBlend, DriftLatSlideGain, DriftCentrifugalGain, dt)
            }
        }

        if isDriftActive {
            DriftSlipMemory = KartDriftMath.CalcDriftSlipMemoryNext(DriftSlipMemory, lat, dt)
            lat = KartDriftMath.ApplyDriftSlipRetain(lat, DriftSlipMemory, DriftSlipRetain)
        } else {
            lat = KartDriftMath.ApplyDriftExitCarry(lat, DriftSlipMemory, DriftFlowTimer, DriftFlowHoldTime, dt)
            DriftSlipMemory = KartDriftMath.CalcDriftSlipMemoryDecay(DriftSlipMemory, DriftSlipDecay, dt)
        }

        if IsBoosting {
            lat = 0.0
            DriftSlipMemory = 0.0
        }

        return lat
    }

    // ---------------------------------------------------------
    // SUBREGION: CAMERA ADDITIVE MODULE HELPERS
    // Future target: Kart/KartCamera.fcg
    // Execution order notes:
    // - Called after physics/visual state has updated current speed, drift, boost, AirTime, and PhysicsQuat.
    // - Camera should read gameplay state but should not drive physics or drift state.
    // ---------------------------------------------------------
    func CameraModule_DriftLean(dt float, isDrift bool, turnInput float, isBoosting bool, driftBlend float) {
        CamDriftSide = KartCameraRuntime.CalcDriftSideNext(CamDriftSide, dt, isDrift, turnInput, isBoosting, driftBlend, CamDriftSideMax, CamDriftSide)
    }

    func CameraModule_VelocityFollow(dt float, vel Vector3, physicsQuat Quaternion, speedKmh float, turnInput float, isDrift bool, isStableGrounded bool, isBoosting bool, driftBlend float) {
        CamVelocityYaw = KartCameraRuntime.CalcVelocityYawNext(CamVelocityYaw, dt, vel, physicsQuat, speedKmh, turnInput, isDrift, isStableGrounded, isBoosting, driftBlend, CamVelocityYawMax)
    }

    func CameraModule_Airborne(dt float, airTime float, stuntRoll float) {
        CamAirPitch = KartCameraRuntime.CalcAirPitchNext(CamAirPitch, dt, airTime, CamAirPitchMax)
        CamAirRoll = KartCameraRuntime.CalcAirRollNext(CamAirRoll, dt, airTime, stuntRoll)
    }

    func CameraModule_CinematicLag(dt float, speedRatio float, isBoosting bool, airTime float, driftBlend float, nitroTimeActive float) {
        CamLagBack = KartCameraRuntime.CalcLagBackNext(CamLagBack, dt, speedRatio, isBoosting, airTime, driftBlend, CamLagBackMax, CamBoostLagPulse, nitroTimeActive)
    }

    // ---------------------------------------------------------
    // SUBREGION: CINEMATIC INTRO FLYCAM (CLIENT ONLY)
    // - Quét động từ nhánh mẹ IntroCameraRoot trong Scene
    // - Tự động nhận diện các cặp IntroCam{N}_Start và IntroCam{N}_End
    // - Chạy luân phiên mượt mà (smoothstep lerp vị trí + slerp góc quay)
    // ---------------------------------------------------------
    func InitDefaultIntroCameraData() {
        if IntroP_Start == nil {
            IntroP_Start = list.New(8, 8) as List<Vector3>
            IntroP_End   = list.New(8, 8) as List<Vector3>
            IntroR_Start = list.New(8, 8) as List<Vector3>
            IntroR_End   = list.New(8, 8) as List<Vector3>
        }
        for initI = 0, 8, 1 {
            IntroP_Start[initI] = Vector3{0.0, 0.0, 0.0}
            IntroP_End[initI]   = Vector3{0.0, 0.0, 0.0}
            IntroR_Start[initI] = Vector3{0.0, 0.0, 0.0}
            IntroR_End[initI]   = Vector3{0.0, 0.0, 0.0}
        }
        // Dữ liệu góc quay chuẩn điện ảnh quét trực tiếp từ Scene Studio (đầy đủ Pitch, Yaw, Roll):
        // Shot 0: IntroCam1 (Góc nghiêng điện ảnh khởi động)
        IntroP_Start[0] = Vector3{156.29, 63.55, 65.58}
        IntroR_Start[0] = Vector3{339.57, 213.76, 27.57}
        IntroP_End[0]   = Vector3{-175.46, 90.64, -130.71}
        IntroR_End[0]   = Vector3{4.03, 149.64, 348.90}

        // Shot 1: IntroCam2 (Góc nghiêng Dutch Angle sắc nét)
        IntroP_Start[1] = Vector3{200.99, 11.35, -462.72}
        IntroR_Start[1] = Vector3{341.12, 203.51, 51.92}
        IntroP_End[1]   = Vector3{278.77, 10.74, -559.38}
        IntroR_End[1]   = Vector3{19.07, 264.02, 340.63}

        // Shot 2: IntroCam3 (Góc cận trực diện đường đua)
        IntroP_Start[2] = Vector3{-0.74, 0.16, -34.95}
        IntroR_Start[2] = Vector3{0.0, 0.0, 0.0}
        IntroP_End[2]   = Vector3{1.14, 1.50, -60.65}
        IntroR_End[2]   = Vector3{345.57, 357.44, 0.0}

        // Shot 3: IntroCam4 (Toàn cảnh lướt nhanh)
        IntroP_Start[3] = Vector3{109.11, 25.98, -616.30}
        IntroR_Start[3] = Vector3{17.20, 316.40, 12.31}
        IntroP_End[3]   = Vector3{-140.06, 17.28, -432.80}
        IntroR_End[3]   = Vector3{9.51, 204.79, 4.36}

        TotalIntroShots = 4
    }

    func ScanIntroCameras() {
        if HasScannedIntroCameras && TotalIntroShots > 0 { return }

        // Đảm bảo dữ liệu mặc định chuẩn từ Scene luôn sẵn sàng
        if IntroP_Start == nil || TotalIntroShots <= 0 {
            InitDefaultIntroCameraData()
        }

        // Tìm scene root: đi lên từ Sphere entity (giống hệt ScanWaypointMarkersClient)
        // 1. ƯU TIÊN SỐ 1: Quét trực tiếp từ ERes IntroCameraRoot hoặc PointRoot
        var sceneRoot = EditorGenLib.EResSceneMainScene.IntroCameraRoot as entity<Entity>
        if sceneRoot == nil {
            sceneRoot = EditorGenLib.EResSceneMainScene.PointRoot as entity<Entity>
        }

        // 2. Dự phòng: nếu ERes chưa sẵn sàng thì đi lên từ Sphere hoặc thisEntity
        if sceneRoot == nil {
            var anchor = EditorGenLib.EResSceneMainScene.Sphere as entity<Entity>
            sceneRoot = anchor
            if sceneRoot == nil {
                sceneRoot = thisEntity as entity<Entity>
            }
            if sceneRoot != nil {
                for step = 0, 20, 1 {
                    var p = std.GetParent(sceneRoot)
                    if p == nil { break }
                    sceneRoot = p
                }
            }
        }
        if sceneRoot == nil { return }

        var rawStartP = list.New(9, 9) as List<Vector3>
        var rawEndP   = list.New(9, 9) as List<Vector3>
        var rawStartR = list.New(9, 9) as List<Vector3>
        var rawEndR   = list.New(9, 9) as List<Vector3>
        var hasStart  = list.New(9, 9) as List<bool>
        var hasEnd    = list.New(9, 9) as List<bool>
        for initI = 0, 9, 1 {
            rawStartP[initI] = Vector3{0.0, 0.0, 0.0}
            rawEndP[initI]   = Vector3{0.0, 0.0, 0.0}
            rawStartR[initI] = Vector3{0.0, 0.0, 0.0}
            rawEndR[initI]   = Vector3{0.0, 0.0, 0.0}
            hasStart[initI]  = false
            hasEnd[initI]    = false
        }

        ScanIntroMarkersRecursive(sceneRoot, rawStartP, rawEndP, rawStartR, rawEndR, hasStart, hasEnd)

        // Sắp xếp các shot hợp lệ vào IntroP_Start/End liên tục từ index 0
        var validShots = 0
        for s = 1, 9, 1 {
            if hasStart[s] && hasEnd[s] {
                IntroP_Start[validShots] = rawStartP[s]
                IntroP_End[validShots]   = rawEndP[s]
                IntroR_Start[validShots] = rawStartR[s]
                IntroR_End[validShots]   = rawEndR[s]
                validShots += 1
            }
        }
        if hasStart[0] && hasEnd[0] {
            IntroP_Start[validShots] = rawStartP[0]
            IntroP_End[validShots]   = rawEndP[0]
            IntroR_Start[validShots] = rawStartR[0]
            IntroR_End[validShots]   = rawEndR[0]
            validShots += 1
        }

        if validShots > 0 {
            TotalIntroShots = validShots
            HasScannedIntroCameras = true
            if MyClientCam != nil {
                var camEnt = MyClientCam as entity<Entity>
                camEnt<Transform>.Position = IntroP_Start[0]
                camEnt<Transform>.Rotation = IntroR_Start[0]
                // Chưa switch camera ngay: giữ nguyên camera mặc định trong 20s đầu
            }
        }
    }

    func ScanIntroMarkersRecursive(node entity<Entity>,
        startP List<Vector3>, endP List<Vector3>,
        startR List<Vector3>, endR List<Vector3>,
        hasS List<bool>, hasE List<bool>) {
        if node == nil { return }
        var nodeName = node<Entity>.Name
        
        // Nhận diện marker IntroCam (hỗ trợ cả có khoảng trắng thừa ở đuôi tên như IntroCam1_Start )
        if strings.Find(nodeName, "Intro", 0) >= 0 {
            var isStart = strings.Find(nodeName, "Start", 0) >= 0
            var isEnd   = strings.Find(nodeName, "End", 0) >= 0
            if isStart || isEnd {
                for s = 0, 9, 1 {
                    var sStr = convert.ToString(s)
                    if strings.Find(nodeName, sStr, 0) >= 0 {
                        if isStart {
                            startP[s] = node<Transform>.Position
                            startR[s] = node<Transform>.Rotation
                            hasS[s] = true
                        } else if isEnd {
                            endP[s] = node<Transform>.Position
                            endR[s] = node<Transform>.Rotation
                            hasE[s] = true
                        }
                        break
                    }
                }
            }
        }

        var children = std.GetChildren(node)
        var count = list.Length(children as List<object>)
        for i = 0, count, 1 {
            var child = children[i] as entity<Entity>
            if child != nil {
                ScanIntroMarkersRecursive(child, startP, endP, startR, endR, hasS, hasE)
            }
        }
    }

    // =========================================================
    // RESET ZONES SYSTEM (/PointRoot/ResetZones)
    // Tự động quét toàn bộ đối tượng con trong nhóm /PointRoot/ResetZones
    // Không cần đặt tên cụ thể, chỉ cần đặt trong ResetZones là xe lọt vào sẽ tự hồi sinh
    // =========================================================
    func ScanResetZones() {
        if HasScannedResetZones && ResetZoneCount > 0 { return }
        if ResetZoneList == nil {
            ResetZoneList = list.New(64, 64) as List<entity<Entity>>
        }
        ResetZoneCount = 0

        var anchor = EditorGenLib.EResSceneMainScene.Sphere as entity<Entity>
        var sceneRoot = anchor
        if sceneRoot == nil { sceneRoot = thisEntity as entity<Entity> }
        if sceneRoot != nil {
            for step = 0, 20, 1 {
                var p = std.GetParent(sceneRoot)
                if p == nil { break }
                sceneRoot = p
            }
        }
        if sceneRoot == nil { return }

        var rzRoot = FindSceneNodeByName(sceneRoot, "ResetZones")
        if rzRoot != nil {
            CollectResetZoneChildren(rzRoot)
            if ResetZoneCount > 0 {
                HasScannedResetZones = true
            }
        }
    }

    func FindSceneNodeByName(node entity<Entity>, targetName string) entity<Entity> {
        if node == nil { return nil }
        if node<Entity>.Name == targetName { return node }
        var children = std.GetChildren(node)
        var count = list.Length(children as List<object>)
        for i = 0, count, 1 {
            var child = children[i] as entity<Entity>
            if child != nil {
                var res = FindSceneNodeByName(child, targetName)
                if res != nil { return res }
            }
        }
        return nil
    }

    func CollectResetZoneChildren(parent entity<Entity>) {
        if parent == nil { return }
        var children = std.GetChildren(parent)
        var count = list.Length(children as List<object>)
        for i = 0, count, 1 {
            var child = children[i] as entity<Entity>
            if child != nil {
                if ResetZoneCount < 64 {
                    ResetZoneList[ResetZoneCount] = child
                    ResetZoneCount += 1
                }
                CollectResetZoneChildren(child)
            }
        }
    }

    func IsCarInsideResetZones() bool {
        if ResetZoneCount <= 0 || ResetZoneList == nil || KartModel == nil { return false }
        var carPos = KartModel<Transform>.Position

        for i = 0, ResetZoneCount, 1 {
            var zone = ResetZoneList[i]
            if zone != nil {
                var zPos = zone<Transform>.Position
                var zScale = zone<Transform>.Scale
                var halfX = zScale.X * 0.5
                var halfY = zScale.Y * 0.5
                var halfZ = zScale.Z * 0.5

                if halfX > 0.5 && halfY > 0.5 && halfZ > 0.5 {
                    var dx = carPos.X - zPos.X
                    var dy = carPos.Y - zPos.Y
                    var dz = carPos.Z - zPos.Z

                    if math.Abs(dy) <= halfY {
                        var yawDeg = zone<Transform>.Rotation.Y
                        var checkInside = false
                        if math.Abs(yawDeg) < 0.1 {
                            if math.Abs(dx) <= halfX && math.Abs(dz) <= halfZ {
                                checkInside = true
                            }
                        } else {
                            var rad = -yawDeg * 0.0174532925
                            var cosA = math.Cos(rad)
                            var sinA = math.Sin(rad)
                            var localX = dx * cosA - dz * sinA
                            var localZ = dx * sinA + dz * cosA
                            if math.Abs(localX) <= halfX && math.Abs(localZ) <= halfZ {
                                checkInside = true
                            }
                        }

                        if checkInside || physics.IsInsideBox(KartModel as entity, zPos, zScale.X, zScale.Z, zScale.Y, zone<Transform>.Rotation) {
                            return true
                        }
                    }
                }
            }
        }
        return false
    }

