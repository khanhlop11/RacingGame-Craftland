    IsReversing         bool = false
    IsFrontBlocked      bool = false    // Bị chặn mũi khi đâm trực diện tường cụt (khóa ga tiến tự động)
    WallImpactCooldown  float = 0.0     // Chốt chặn hồi chiêu rung camera va chạm (Asphalt 8 CrashCamSnapTimer)
    BlockedWallNx       float = 0.0     // Pháp tuyến X của tường đang bị kẹt mũi
    BlockedWallNz       float = 0.0     // Pháp tuyến Z của tường đang bị kẹt mũi

    // ------------------------------------------------------------------------
    // CỔNG SỰ KIỆN NÚT BẤM UI
    // ------------------------------------------------------------------------
    event onTurnL()  { IsTurningLeft  = true;  IsTurningRight = false; LocalAfkTimer = 0.0; IsLocalBotTakeover = false; LocalTakeoverWpIdx = -1 }
    event offTurnL() { IsTurningLeft  = false }
    event onTurnR()  { IsTurningRight = true;  IsTurningLeft  = false; LocalAfkTimer = 0.0; IsLocalBotTakeover = false; LocalTakeoverWpIdx = -1 }
    event offTurnR() { IsTurningRight = false }
    event onBrake()  { 
        IsBraking = true
        BrakeTapTimer = 0.40
        LocalAfkTimer = 0.0
        IsLocalBotTakeover = false
        LocalTakeoverWpIdx = -1
    }
    event offBrake() { IsBraking = false }
    event onBoost()  { 
        LocalAfkTimer = 0.0
        IsLocalBotTakeover = false
        LocalTakeoverWpIdx = -1
        if CurrentNitro > 5.0 {
            IsBoosting = true 
        }
    }
    event offBoost() { IsBoosting     = false }
    event onReverse()  { IsReversing  = true; LocalAfkTimer = 0.0; IsLocalBotTakeover = false; LocalTakeoverWpIdx = -1 }
    event offReverse() { IsReversing  = false }

    // Sự kiện Cần điều khiển Joystick (trên Mobile & bàn phím PC map qua Joystick)
    event OnJoyStickMove(p entity<Player>, delta Vector2) {
        if p != std.GetLocalPlayer() { return }

        if delta.X < -0.15 || delta.X > 0.15 || delta.Y < -0.2 || delta.Y > 0.2 {
            LocalAfkTimer = 0.0
            IsLocalBotTakeover = false
            LocalTakeoverWpIdx = -1
        }

        // delta.X: rẽ trái/phải (-1.0 .. 1.0)
        if delta.X < -0.15 {
            IsTurningLeft = true
            IsTurningRight = false
        } else if delta.X > 0.15 {
            IsTurningRight = true
            IsTurningLeft = false
        } else {
            IsTurningLeft = false
            IsTurningRight = false
        }

        // delta.Y: kéo lùi kích hoạt Phanh / Drift / Lùi xe
        if delta.Y < -0.3 {
            if !IsBraking {
                BrakeTapTimer = 0.40
            }
            IsBraking = true
        } else {
            IsBraking = false
        }
    }

    // ------------------------------------------------------------------------
    // TỰ ĐỘNG CHUYỂN GIAO QUYỀN CHỦ PHÒNG (HOST MIGRATION) & BOT TIẾP QUẢN KHI OUT GAME
    // ------------------------------------------------------------------------
    func CheckHostMigrationAndTakeover() {
        var localP = std.GetLocalPlayer()
        if localP == nil { return }

        var allPlayersList = std.GetAllPlayers()
        var pCountLocal = list.Length(allPlayersList as List<object>)
        if pCountLocal <= 0 { return }

        var foundSlot = 0
        for myI = 0, pCountLocal, 1 {
            if allPlayersList[myI] == localP {
                foundSlot = myI
                break
            }
        }
        MyRoomSlot = foundSlot
        if MyRoomSlot == 0 {
            IsRoomHost = true
        }

        // Khi chỉ còn 1 người chơi trong phòng (mọi đối thủ đã out game) -> Chuyển thành Bot ngay lập tức (0s)
        // Tính lại WpIdx theo vị trí hiện tại để Bot tiếp tục chạy tại chỗ, không bị kéo về vạch xuất phát
        if pCountLocal <= 1 {
            var wpCountMig = list.Length(WpPositions as List<object>)

            if OpponentIsHuman1 || OpponentIsRemoteBot1 {
                OpponentIsHuman1 = false
                OpponentIsRemoteBot1 = false
                if wpCountMig > 0 {
                    var bw1 = 0
                    var bd1 = 999999.0
                    for wi1 = 0, wpCountMig, 1 {
                        var ww1 = WpPositions[wi1]
                        var dwx1 = ww1.X - OpponentPos1.X
                        var dwz1 = ww1.Z - OpponentPos1.Z
                        var dd1 = dwx1 * dwx1 + dwz1 * dwz1
                        if dd1 < bd1 { bd1 = dd1; bw1 = wi1 }
                    }
                    OpponentWpIdx1 = (bw1 + 1) % wpCountMig
                }
                if OpponentSpeedMs1 < 5.0 { OpponentSpeedMs1 = 7.6 }
            }

            if OpponentIsHuman2 || OpponentIsRemoteBot2 {
                OpponentIsHuman2 = false
                OpponentIsRemoteBot2 = false
                if wpCountMig > 0 {
                    var bw2 = 0
                    var bd2 = 999999.0
                    for wi2 = 0, wpCountMig, 1 {
                        var ww2 = WpPositions[wi2]
                        var dwx2 = ww2.X - OpponentPos2.X
                        var dwz2 = ww2.Z - OpponentPos2.Z
                        var dd2 = dwx2 * dwx2 + dwz2 * dwz2
                        if dd2 < bd2 { bd2 = dd2; bw2 = wi2 }
                    }
                    OpponentWpIdx2 = (bw2 + 1) % wpCountMig
                }
                if OpponentSpeedMs2 < 5.0 { OpponentSpeedMs2 = 7.6 }
            }

            if OpponentIsHuman3 || OpponentIsRemoteBot3 {
                OpponentIsHuman3 = false
                OpponentIsRemoteBot3 = false
                if wpCountMig > 0 {
                    var bw3 = 0
                    var bd3 = 999999.0
                    for wi3 = 0, wpCountMig, 1 {
                        var ww3 = WpPositions[wi3]
                        var dwx3 = ww3.X - OpponentPos3.X
                        var dwz3 = ww3.Z - OpponentPos3.Z
                        var dd3 = dwx3 * dwx3 + dwz3 * dwz3
                        if dd3 < bd3 { bd3 = dd3; bw3 = wi3 }
                    }
                    OpponentWpIdx3 = (bw3 + 1) % wpCountMig
                }
                if OpponentSpeedMs3 < 5.0 { OpponentSpeedMs3 = 7.6 }
            }

            if OpponentIsHuman4 || OpponentIsRemoteBot4 {
                OpponentIsHuman4 = false
                OpponentIsRemoteBot4 = false
                if wpCountMig > 0 {
                    var bw4 = 0
                    var bd4 = 999999.0
                    for wi4 = 0, wpCountMig, 1 {
                        var ww4 = WpPositions[wi4]
                        var dwx4 = ww4.X - OpponentPos4.X
                        var dwz4 = ww4.Z - OpponentPos4.Z
                        var dd4 = dwx4 * dwx4 + dwz4 * dwz4
                        if dd4 < bd4 { bd4 = dd4; bw4 = wi4 }
                    }
                    OpponentWpIdx4 = (bw4 + 1) % wpCountMig
                }
                if OpponentSpeedMs4 < 5.0 { OpponentSpeedMs4 = 7.6 }
            }
        }
    }

    event OnPlayerQuit(player entity<Player>) {
        CheckHostMigrationAndTakeover()
    }

    // ------------------------------------------------------------------------
    // SỰ KIỆN MẠNG MULTIPLAYER CLIENT <-> SERVER
    // ------------------------------------------------------------------------
    event SyncCarIndex(carIndex int) {}
    event SyncKartStateServer(posX float, posY float, posZ float, yaw float, velX float, velY float, velZ float, score float, isDrifting float) {}

    event SyncOpponentClient(pIndex int, carIndex int, posX float, posY float, posZ float, yaw float, velX float, velZ float, isDrifting int, senderUid string) {
        var localP = std.GetLocalPlayer()
        if localP == nil { return }
        if (thisEntity as entity<Player>) != localP { return }

        // Khi nhận được gói Bot Relay (isDrifting == 2) từ Host qua Server: Reset fail-safe timer và xác nhận máy khách
        if isDrifting == 2 {
            IsRoomHost = false
            LastBotPacketTimer = 0.0
        }

        // BOT RELAY: isDrifting==2 -> Gói dữ liệu Bot từ Host qua Server
        if isDrifting == 2 {
            var botSlotR = pIndex
            if botSlotR < 1 || botSlotR > 4 { return }
            if botSlotR == MyRoomSlot { return } // Bỏ qua nếu gói Bot trùng slot của chính máy mình

            var rcvScoreBot = 0.0
            if senderUid != "" {
                convert.StringToFloat(senderUid, out var parsedScoreBot, out var sOkBot)
                if sOkBot { rcvScoreBot = parsedScoreBot }
            }

            var botVelR = Vector3{velX, 0.0, velZ}
            var latencyBot = 0.05
            var predBotX = posX + velX * latencyBot
            var predBotZ = posZ + velZ * latencyBot
            var botServerPos = Vector3{predBotX, posY, predBotZ}

            if botSlotR == 1 {
                OpponentScore1 = rcvScoreBot
                if OpponentCar1 == nil {
                    OpponentCar1 = SpawnCarModelForSlot(1)
                    OpponentPos1 = botServerPos
                    OpponentVel1 = botVelR
                    OpponentTargetVel1 = botVelR
                    OpponentYaw1 = yaw
                    OpponentTargetYaw1 = yaw
                    OpponentErr1 = Vector3{0.0, 0.0, 0.0}
                    if OpponentCar1 != nil {
                        OpponentCar1<Transform>.Position = Vector3{botServerPos.X, botServerPos.Y - 0.25, botServerPos.Z}
                        OpponentCar1<Transform>.Rotation = Vector3{0.0, yaw, 0.0}
                        std.SetActive(OpponentCar1 as entity, true)
                    }
                }
                OpponentActive1 = true
                OpponentIdleTimer1 = 0.0
                OpponentIsRemoteBot1 = true
                OpponentIsHuman1 = false
                var e1x = botServerPos.X - OpponentPos1.X
                var e1y = botServerPos.Y - OpponentPos1.Y
                var e1z = botServerPos.Z - OpponentPos1.Z
                var d2_1 = e1x * e1x + e1z * e1z
                if d2_1 > 225.0 || math.Abs(e1y) > 4.0 {
                    OpponentPos1 = botServerPos
                    OpponentVel1 = botVelR
                    OpponentYaw1 = yaw
                    OpponentErr1 = Vector3{0.0, 0.0, 0.0}
                } else {
                    OpponentErr1 = Vector3{e1x, e1y, e1z}
                }
                OpponentTargetVel1 = botVelR
                OpponentTargetYaw1 = yaw
            } else if botSlotR == 2 {
                OpponentScore2 = rcvScoreBot
                if OpponentCar2 == nil {
                    OpponentCar2 = SpawnCarModelForSlot(2)
                    OpponentPos2 = botServerPos
                    OpponentVel2 = botVelR
                    OpponentTargetVel2 = botVelR
                    OpponentYaw2 = yaw
                    OpponentTargetYaw2 = yaw
                    OpponentErr2 = Vector3{0.0, 0.0, 0.0}
                    if OpponentCar2 != nil {
                        OpponentCar2<Transform>.Position = Vector3{botServerPos.X, botServerPos.Y - 0.25, botServerPos.Z}
                        OpponentCar2<Transform>.Rotation = Vector3{0.0, yaw, 0.0}
                        std.SetActive(OpponentCar2 as entity, true)
                    }
                }
                OpponentActive2 = true
                OpponentIdleTimer2 = 0.0
                OpponentIsRemoteBot2 = true
                OpponentIsHuman2 = false
                var e2x = botServerPos.X - OpponentPos2.X
                var e2y = botServerPos.Y - OpponentPos2.Y
                var e2z = botServerPos.Z - OpponentPos2.Z
                var d2_2 = e2x * e2x + e2z * e2z
                if d2_2 > 225.0 || math.Abs(e2y) > 4.0 {
                    OpponentPos2 = botServerPos
                    OpponentVel2 = botVelR
                    OpponentYaw2 = yaw
                    OpponentErr2 = Vector3{0.0, 0.0, 0.0}
                } else {
                    OpponentErr2 = Vector3{e2x, e2y, e2z}
                }
                OpponentTargetVel2 = botVelR
                OpponentTargetYaw2 = yaw
            } else if botSlotR == 3 {
                OpponentScore3 = rcvScoreBot
                if OpponentCar3 == nil {
                    OpponentCar3 = SpawnCarModelForSlot(3)
                    OpponentPos3 = botServerPos
                    OpponentVel3 = botVelR
                    OpponentTargetVel3 = botVelR
                    OpponentYaw3 = yaw
                    OpponentTargetYaw3 = yaw
                    OpponentErr3 = Vector3{0.0, 0.0, 0.0}
                    if OpponentCar3 != nil {
                        OpponentCar3<Transform>.Position = Vector3{botServerPos.X, botServerPos.Y - 0.25, botServerPos.Z}
                        OpponentCar3<Transform>.Rotation = Vector3{0.0, yaw, 0.0}
                        std.SetActive(OpponentCar3 as entity, true)
                    }
                }
                OpponentActive3 = true
                OpponentIdleTimer3 = 0.0
                OpponentIsRemoteBot3 = true
                OpponentIsHuman3 = false
                var e3x = botServerPos.X - OpponentPos3.X
                var e3y = botServerPos.Y - OpponentPos3.Y
                var e3z = botServerPos.Z - OpponentPos3.Z
                var d2_3 = e3x * e3x + e3z * e3z
                if d2_3 > 225.0 || math.Abs(e3y) > 4.0 {
                    OpponentPos3 = botServerPos
                    OpponentVel3 = botVelR
                    OpponentYaw3 = yaw
                    OpponentErr3 = Vector3{0.0, 0.0, 0.0}
                } else {
                    OpponentErr3 = Vector3{e3x, e3y, e3z}
                }
                OpponentTargetVel3 = botVelR
                OpponentTargetYaw3 = yaw
            } else if botSlotR == 4 {
                OpponentScore4 = rcvScoreBot
                if OpponentCar4 == nil {
                    OpponentCar4 = SpawnCarModelForSlot(4)
                    OpponentPos4 = botServerPos
                    OpponentVel4 = botVelR
                    OpponentTargetVel4 = botVelR
                    OpponentYaw4 = yaw
                    OpponentTargetYaw4 = yaw
                    OpponentErr4 = Vector3{0.0, 0.0, 0.0}
                    if OpponentCar4 != nil {
                        OpponentCar4<Transform>.Position = Vector3{botServerPos.X, botServerPos.Y - 0.25, botServerPos.Z}
                        OpponentCar4<Transform>.Rotation = Vector3{0.0, yaw, 0.0}
                        std.SetActive(OpponentCar4 as entity, true)
                    }
                }
                OpponentActive4 = true
                OpponentIdleTimer4 = 0.0
                OpponentIsRemoteBot4 = true
                OpponentIsHuman4 = false
                var e4x = botServerPos.X - OpponentPos4.X
                var e4y = botServerPos.Y - OpponentPos4.Y
                var e4z = botServerPos.Z - OpponentPos4.Z
                var d2_4 = e4x * e4x + e4z * e4z
                if d2_4 > 225.0 || math.Abs(e4y) > 4.0 {
                    OpponentPos4 = botServerPos
                    OpponentVel4 = botVelR
                    OpponentYaw4 = yaw
                    OpponentErr4 = Vector3{0.0, 0.0, 0.0}
                } else {
                    OpponentErr4 = Vector3{e4x, e4y, e4z}
                }
                OpponentTargetVel4 = botVelR
                OpponentTargetYaw4 = yaw
            }
            return
        }

        var rcvScore = 0.0
        if senderUid != "" {
            convert.StringToFloat(senderUid, out var parsedScore, out var sOk)
            if sOk {
                rcvScore = parsedScore
            }
        }

        var key = convert.ToString(pIndex)

        var slot = -1
        if OpponentUID1 == key {
            slot = 1
        } else if OpponentUID2 == key {
            slot = 2
        } else if OpponentUID3 == key {
            slot = 3
        } else if OpponentUID4 == key {
            slot = 4
        } else {
            // Cố định slot tương ứng nếu là Bot (pIndex >= 2)
            if pIndex == 2 && OpponentUID2 == "" {
                slot = 2
                OpponentUID2 = key
            } else if pIndex == 3 && OpponentUID3 == "" {
                slot = 3
                OpponentUID3 = key
            } else if pIndex == 4 && OpponentUID4 == "" {
                slot = 4
                OpponentUID4 = key
            } else if pIndex == 0 || pIndex == 1 {
                if OpponentUID1 == "" {
                    slot = 1
                    OpponentUID1 = key
                } else if OpponentUID2 == "" {
                    slot = 2
                    OpponentUID2 = key
                }
            } else {
                if OpponentUID1 == "" {
                    slot = 1
                    OpponentUID1 = key
                } else if OpponentUID2 == "" {
                    slot = 2
                    OpponentUID2 = key
                } else if OpponentUID3 == "" {
                    slot = 3
                    OpponentUID3 = key
                } else if OpponentUID4 == "" {
                    slot = 4
                    OpponentUID4 = key
                }
            }
        }

        if slot < 1 || slot > 4 { return }

        var targetVel = Vector3{velX, 0.0, velZ}

        // Bù độ trễ mạng (Latency Forward Extrapolation - Asphalt 8 Dead-Reckoning):
        // Dự đoán vị trí của xe đối thủ tại thời điểm hiện tại: P_pred = P_packet + V * dt_latency
        var latency = 0.05
        var predX = posX + velX * latency
        var predZ = posZ + velZ * latency
        var serverPos = Vector3{predX, posY, predZ}

        if slot == 1 {
            OpponentScore1 = rcvScore
            OpponentPIndex1 = pIndex
            if OpponentCar1 == nil {
                OpponentCar1 = SpawnCarModelForSlot(1)
                OpponentPos1 = serverPos
                OpponentVel1 = targetVel
                OpponentTargetVel1 = targetVel
                OpponentYaw1 = yaw
                OpponentTargetYaw1 = yaw
                OpponentErr1 = Vector3{0.0, 0.0, 0.0}
                if OpponentCar1 != nil {
                    OpponentCar1<Transform>.Position = Vector3{OpponentPos1.X, OpponentPos1.Y - 0.25, OpponentPos1.Z}
                    OpponentCar1<Transform>.Rotation = Vector3{0.0, OpponentYaw1, 0.0}
                    std.SetActive(OpponentCar1 as entity, true)
                }
            }
            OpponentActive1 = true
            OpponentIdleTimer1 = 0.0
            OpponentIsHuman1 = true
            OpponentIsRemoteBot1 = false
            OpponentCarIndex1 = carIndex

            var errX = serverPos.X - OpponentPos1.X
            var errY = serverPos.Y - OpponentPos1.Y
            var errZ = serverPos.Z - OpponentPos1.Z
            var d2 = errX * errX + errZ * errZ
            if d2 > 225.0 || math.Abs(errY) > 4.0 {
                OpponentPos1 = serverPos
                OpponentVel1 = targetVel
                OpponentYaw1 = yaw
                OpponentErr1 = Vector3{0.0, 0.0, 0.0}
            } else {
                OpponentErr1 = Vector3{errX, errY, errZ}
            }
            OpponentTargetVel1 = targetVel
            OpponentTargetYaw1 = yaw
            if (OpponentDot1Widget as entity) != nil {
                OpponentDot1Widget<hud.UIWidget>.IsVisible = true
            }
        } else if slot == 2 {
            OpponentScore2 = rcvScore
            OpponentPIndex2 = pIndex
            if OpponentCar2 == nil {
                OpponentCar2 = SpawnCarModelForSlot(2)
                OpponentPos2 = serverPos
                OpponentVel2 = targetVel
                OpponentTargetVel2 = targetVel
                OpponentYaw2 = yaw
                OpponentTargetYaw2 = yaw
                OpponentErr2 = Vector3{0.0, 0.0, 0.0}
                if OpponentCar2 != nil {
                    OpponentCar2<Transform>.Position = Vector3{OpponentPos2.X, OpponentPos2.Y - 0.25, OpponentPos2.Z}
                    OpponentCar2<Transform>.Rotation = Vector3{0.0, OpponentYaw2, 0.0}
                    std.SetActive(OpponentCar2 as entity, true)
                }
            }
            OpponentActive2 = true
            OpponentIdleTimer2 = 0.0
            OpponentIsHuman2 = true
            OpponentIsRemoteBot2 = false
            OpponentCarIndex2 = carIndex

            var errX = serverPos.X - OpponentPos2.X
            var errY = serverPos.Y - OpponentPos2.Y
            var errZ = serverPos.Z - OpponentPos2.Z
            var d2 = errX * errX + errZ * errZ
            if d2 > 225.0 || math.Abs(errY) > 4.0 {
                OpponentPos2 = serverPos
                OpponentVel2 = targetVel
                OpponentYaw2 = yaw
                OpponentErr2 = Vector3{0.0, 0.0, 0.0}
            } else {
                OpponentErr2 = Vector3{errX, errY, errZ}
            }
            OpponentTargetVel2 = targetVel
            OpponentTargetYaw2 = yaw
            if (OpponentDot2Widget as entity) != nil {
                OpponentDot2Widget<hud.UIWidget>.IsVisible = true
            }
        } else if slot == 3 {
            OpponentScore3 = rcvScore
            OpponentPIndex3 = pIndex
            if OpponentCar3 == nil {
                OpponentCar3 = SpawnCarModelForSlot(3)
                OpponentPos3 = serverPos
                OpponentVel3 = targetVel
                OpponentTargetVel3 = targetVel
                OpponentYaw3 = yaw
                OpponentTargetYaw3 = yaw
                OpponentErr3 = Vector3{0.0, 0.0, 0.0}
                if OpponentCar3 != nil {
                    OpponentCar3<Transform>.Position = Vector3{OpponentPos3.X, OpponentPos3.Y - 0.25, OpponentPos3.Z}
                    OpponentCar3<Transform>.Rotation = Vector3{0.0, OpponentYaw3, 0.0}
                    std.SetActive(OpponentCar3 as entity, true)
                }
            }
            OpponentActive3 = true
            OpponentIdleTimer3 = 0.0
            OpponentIsHuman3 = true
            OpponentIsRemoteBot3 = false
            OpponentCarIndex3 = carIndex

            var errX = serverPos.X - OpponentPos3.X
            var errY = serverPos.Y - OpponentPos3.Y
            var errZ = serverPos.Z - OpponentPos3.Z
            var d2 = errX * errX + errZ * errZ
            if d2 > 225.0 || math.Abs(errY) > 4.0 {
                OpponentPos3 = serverPos
                OpponentVel3 = targetVel
                OpponentYaw3 = yaw
                OpponentErr3 = Vector3{0.0, 0.0, 0.0}
            } else {
                OpponentErr3 = Vector3{errX, errY, errZ}
            }
            OpponentTargetVel3 = targetVel
            OpponentTargetYaw3 = yaw
            if (OpponentDot3Widget as entity) != nil {
                OpponentDot3Widget<hud.UIWidget>.IsVisible = true
            }
        } else if slot == 4 {
            OpponentScore4 = rcvScore
            OpponentPIndex4 = pIndex
            if OpponentCar4 == nil {
                OpponentCar4 = SpawnCarModelForSlot(4)
                OpponentPos4 = serverPos
                OpponentVel4 = targetVel
                OpponentTargetVel4 = targetVel
                OpponentYaw4 = yaw
                OpponentTargetYaw4 = yaw
                OpponentErr4 = Vector3{0.0, 0.0, 0.0}
                if OpponentCar4 != nil {
                    OpponentCar4<Transform>.Position = Vector3{OpponentPos4.X, OpponentPos4.Y - 0.25, OpponentPos4.Z}
                    OpponentCar4<Transform>.Rotation = Vector3{0.0, OpponentYaw4, 0.0}
                    std.SetActive(OpponentCar4 as entity, true)
                }
            }
            OpponentActive4 = true
            OpponentIdleTimer4 = 0.0
            OpponentIsHuman4 = true
            OpponentIsRemoteBot4 = false
            OpponentCarIndex4 = carIndex

            var errX = serverPos.X - OpponentPos4.X
            var errY = serverPos.Y - OpponentPos4.Y
            var errZ = serverPos.Z - OpponentPos4.Z
            var d2 = errX * errX + errZ * errZ
            if d2 > 225.0 || math.Abs(errY) > 4.0 {
                OpponentPos4 = serverPos
                OpponentVel4 = targetVel
                OpponentYaw4 = yaw
                OpponentErr4 = Vector3{0.0, 0.0, 0.0}
            } else {
                OpponentErr4 = Vector3{errX, errY, errZ}
            }
            OpponentTargetVel4 = targetVel
            OpponentTargetYaw4 = yaw
            if (OpponentDot4Widget as entity) != nil {
                OpponentDot4Widget<hud.UIWidget>.IsVisible = true
            }
        }
    }

    // ------------------------------------------------------------------------
    // KHỞI TẠO XE (ON AWAKE)
    // ------------------------------------------------------------------------
    event OnAwake() {
        start InitControllerRoutine()
    }

    async func InitControllerRoutine() {
        std.WaitForNextFrame()

        var localP = std.GetLocalPlayer()
        if localP == nil || (thisEntity as entity<Player>) != localP { return }
        if localP != nil {
            // Ẩn toàn bộ UI nhân vật mặc định của Free Fire (nhân vật bị bỏ qua hoàn toàn)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.MovingJoystick, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Sprint, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Attack, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Jump, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Crouch, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Prone, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Bag, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.MedicalProps, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.WeaponSlot, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.Emote, std.ThreeStatusSwitch.Close)
            player.SetDefaultUIStatus(localP, player.DefaultUIType.MiniMap, std.ThreeStatusSwitch.Close)

            // Khởi tạo Custom UI điều khiển xe (ControlUI) nếu chưa có
            if (ControlUIEntity as entity) == nil {
                hud.CreateCustomUIClient(out var ui, EditorGenLib.EResUI.ControlUI)
                ControlUIEntity = ui
            }
            if (ControlUIEntity as entity) != nil {
                DriveUIRoot = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot")
                if (DriveUIRoot as entity) == nil {
                    DriveUIRoot = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot")
                }
                if (DriveUIRoot as entity) != nil {
                    DriveUIRoot<hud.UIWidget>.IsVisible = true
                    DriveUIRoot<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                }

                SpeedTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/txt_Speed")
                SpeedNeedleWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/SpeedNeedle")
                BoostBtnWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/BoostButton")
                if (BoostBtnWidget as entity) != nil {
                    BoostBtnWidget<hud.UIWidget>.IsVisible = true
                }
                var btnLeft = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/TurnLeft")
                if (btnLeft as entity) != nil { btnLeft<hud.UIWidget>.IsVisible = true }
                var btnRight = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/TurnRight")
                if (btnRight as entity) != nil { btnRight<hud.UIWidget>.IsVisible = true }
                var btnBrake = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/BrakeButton")
                if (btnBrake as entity) != nil { btnBrake<hud.UIWidget>.IsVisible = true }
                var btnRev = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/ReverseButton")
                if (btnRev as entity) != nil { btnRev<hud.UIWidget>.IsVisible = true }
                var btnReset = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/ResetButton")
                if (btnReset as entity) == nil {
                    btnReset = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/ResetButton")
                }
                if (btnReset as entity) == nil {
                    btnReset = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/Nút bấm")
                }
                if (btnReset as entity) != nil {
                    btnReset<hud.UIWidget>.IsVisible = true
                }

                StartRootWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/Start")
                if (StartRootWidget as entity) == nil { StartRootWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "Start") }
                if (StartRootWidget as entity) != nil {
                    StartRootWidget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    StartRootWidget<hud.UIWidget>.IsVisible = true
                }
                var lobbyNode = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/LobbyTimer")
                if (lobbyNode as entity) == nil { lobbyNode = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "LobbyTimer") }
                if (lobbyNode as entity) != nil {
                    lobbyNode<hud.UIWidget>.IsVisible = false
                    lobbyNode<hud.UIWidget>.AnchorPosition = Vector3{9999.0, 9999.0, 0.0}
                }

                CountGoWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/Start/go")
                if (CountGoWidget as entity) == nil { CountGoWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "Start/go") }
                if (CountGoWidget as entity) != nil {
                    var szGo = CountGoWidget<hud.UIWidget>.SizeDelta
                    if szGo.X > 10.0 && szGo.Y > 10.0 { CountGoBaseSize = szGo }
                    CountGoWidget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    CountGoWidget<hud.UIWidget>.IsVisible = false
                }
                Count3Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/Start/3")
                if (Count3Widget as entity) == nil { Count3Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "Start/3") }
                if (Count3Widget as entity) != nil {
                    var sz3 = Count3Widget<hud.UIWidget>.SizeDelta
                    if sz3.X > 10.0 && sz3.Y > 10.0 { Count3BaseSize = sz3 }
                    Count3Widget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    Count3Widget<hud.UIWidget>.IsVisible = false
                }
                Count2Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/Start/2")
                if (Count2Widget as entity) == nil { Count2Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "Start/2") }
                if (Count2Widget as entity) != nil {
                    var sz2 = Count2Widget<hud.UIWidget>.SizeDelta
                    if sz2.X > 10.0 && sz2.Y > 10.0 { Count2BaseSize = sz2 }
                    Count2Widget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    Count2Widget<hud.UIWidget>.IsVisible = false
                }
                Count1Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/Start/1")
                if (Count1Widget as entity) == nil { Count1Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "Start/1") }
                if (Count1Widget as entity) != nil {
                    var sz1 = Count1Widget<hud.UIWidget>.SizeDelta
                    if sz1.X > 10.0 && sz1.Y > 10.0 { Count1BaseSize = sz1 }
                    Count1Widget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    Count1Widget<hud.UIWidget>.IsVisible = false
                }

                var oldLap = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/Lap")
                if (oldLap as entity) == nil { oldLap = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/Lap") }
                if (oldLap as entity) != nil {
                    oldLap<hud.UIWidget>.IsVisible = false
                    oldLap<hud.UIWidget>.AnchorPosition = Vector3{9999.0, 9999.0, 0.0}
                }

                var nitroFrame = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/NitroBar_Frame")
                if (nitroFrame as entity) == nil {
                    nitroFrame = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/NitroBar_Frame")
                }
                if (nitroFrame as entity) != nil {
                    nitroFrame<hud.UIWidget>.IsVisible = true
                }

                NitroBarWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/NitroBar_Frame/NitroBar")
                if (NitroBarWidget as entity) == nil {
                    NitroBarWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/NitroBar_Frame/NitroBar")
                }
                if (NitroBarWidget as entity) == nil {
                    NitroBarWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "NitroBar")
                }
                if (NitroBarWidget as entity) != nil {
                    NitroBarWidget<hud.UIWidget>.IsVisible = true
                    NitroBarWidget<hud.UIWidgetImage>.FillAmount = 1.0
                }

                NitroGlowHeadWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/NitroBar_Frame/NitroGlowHead")
                if (NitroGlowHeadWidget as entity) == nil {
                    NitroGlowHeadWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/NitroBar_Frame/NitroGlowHead")
                }
                if (NitroGlowHeadWidget as entity) == nil {
                    NitroGlowHeadWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "NitroGlowHead")
                }
                if (NitroGlowHeadWidget as entity) != nil {
                    NitroGlowHeadWidget<hud.UIWidget>.IsVisible = true
                }

                LapTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/txt_Lap")
                if (LapTextWidget as entity) == nil {
                    LapTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/txt_Lap")
                }
                if (LapTextWidget as entity) != nil {
                    LapTextWidget<hud.UIWidgetLabel>.Content = "LAP 1/2"
                }

                PositionTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/txt_Position")
                if (PositionTextWidget as entity) == nil {
                    PositionTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/txt_Position")
                }
                if (PositionTextWidget as entity) != nil {
                    PositionTextWidget<hud.UIWidgetLabel>.Content = "1/5"
                }

                WrongWayWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/WrongWayWarning")
                if (WrongWayWidget as entity) == nil {
                    WrongWayWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/WrongWayWarning")
                }
                if (WrongWayWidget as entity) != nil {
                    WrongWayWidget<hud.UIWidget>.IsVisible = false
                }

                TimerTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/txt_timer")
                if (TimerTextWidget as entity) == nil {
                    TimerTextWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "txt_timer")
                }
                if (TimerTextWidget as entity) != nil {
                    TimerTextWidget<hud.UIWidgetLabel>.Content = "00:00.00"
                }

                FinishBannerWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/finish")
                if (FinishBannerWidget as entity) == nil {
                    FinishBannerWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "finish")
                }
                if (FinishBannerWidget as entity) != nil {
                    FinishBannerWidget<hud.UIWidget>.IsVisible = false
                }

                // Khởi tạo Rotating Minimap
                MinimapBgWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg")
                if (MinimapBgWidget as entity) == nil {
                    MinimapBgWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg")
                }
                if (MinimapBgWidget as entity) != nil {
                    MinimapBgWidget<hud.UIWidget>.IsVisible = true
                }

                MiniMapWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg/MiniMap")
                if (MiniMapWidget as entity) == nil {
                    MiniMapWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg/MiniMap")
                }
                if (MiniMapWidget as entity) != nil {
                    MiniMapWidget<hud.UIWidget>.IsVisible = true
                }

                CurrentPlayerDotWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg/CurrentPlayerDot")
                if (CurrentPlayerDotWidget as entity) == nil {
                    CurrentPlayerDotWidget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg/CurrentPlayerDot")
                }
                if (CurrentPlayerDotWidget as entity) != nil {
                    CurrentPlayerDotWidget<hud.UIWidget>.IsVisible = true
                    CurrentPlayerDotWidget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    CurrentPlayerDotWidget<hud.UIWidget>.Angle = 0.0
                }

                OpponentDot1Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg/MiniMap/OpponentDot_1")
                if (OpponentDot1Widget as entity) == nil { OpponentDot1Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg/MiniMap/OpponentDot_1") }
                if (OpponentDot1Widget as entity) != nil { OpponentDot1Widget<hud.UIWidget>.IsVisible = true }

                OpponentDot2Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg/MiniMap/OpponentDot_2")
                if (OpponentDot2Widget as entity) == nil { OpponentDot2Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg/MiniMap/OpponentDot_2") }
                if (OpponentDot2Widget as entity) != nil { OpponentDot2Widget<hud.UIWidget>.IsVisible = true }

                OpponentDot3Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg/MiniMap/OpponentDot_3")
                if (OpponentDot3Widget as entity) == nil { OpponentDot3Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg/MiniMap/OpponentDot_3") }
                if (OpponentDot3Widget as entity) != nil { OpponentDot3Widget<hud.UIWidget>.IsVisible = true }

                OpponentDot4Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "/DriveUIRoot/MinimapBg/MiniMap/OpponentDot_4")
                if (OpponentDot4Widget as entity) == nil { OpponentDot4Widget = hud.GetWidgetByPath(localP as PlayerOrSpectator, ControlUIEntity, "DriveUIRoot/MinimapBg/MiniMap/OpponentDot_4") }
                if (OpponentDot4Widget as entity) != nil { OpponentDot4Widget<hud.UIWidget>.IsVisible = true }
            }
        }

        // Quét dữ liệu đường đua động từ ERes (Zero toạ độ cố định)
        raceRules.ScanTrackData(out var cps, out var wps, out var starts, out var startYaws)
        CpPositions = cps
        WpPositions = wps
        StartPositions = starts
        StartYaws = startYaws
        RaceTrackInitialized = true

        // Lấy chiếc hộp được đăng ký tĩnh trong EResSceneMainScene
        if TargetBox == nil {
            TargetBox = EditorGenLib.EResSceneMainScene.VehicleChassis_Box as entity<Entity>
        }

        if TargetBox != nil {
            TargetBox<Collider>.PhysicalLayer = 2
            TargetBox<Rigidbody>.Constrain = 112
            TargetBox<Rigidbody>.UseGravity = false
            physics.Wakeup(TargetBox as entity<Rigidbody>)

            // Ẩn khối hộp vật lý TargetBox
            TargetBox<Visibility>.IsVisible = false

            // Tạo model xe thể thao CR001 (Lamborghini) độc lập (Asphalt 8 Decoupled Visual Rig)
            if VisualCar == nil {
                var carPrefab = EditorGenLib.EResPrefab.CR001 as PrefabID
                if carPrefab != nil {
                    std.CreateFromPrefab(out var spawnedCar, carPrefab)
                    VisualCar = spawnedCar
                    if VisualCar != nil {
                        SetupCarVisualModel(VisualCar)
                        var spawnPos = TargetBox<Transform>.Position
                        VisualCar<Transform>.Position = Vector3{spawnPos.X, spawnPos.Y - 0.25, spawnPos.Z}
                        VisualCar<Transform>.Rotation = TargetBox<Transform>.Rotation
                    }
                }
            }

            // Đặt xe tại ô xuất phát Start_01
            if list.Length(StartPositions as List<object>) > 0 {
                var spawnP = StartPositions[0]
                TargetBox<Transform>.Position = Vector3{spawnP.X, spawnP.Y + 0.65, spawnP.Z}
                if list.Length(StartYaws as List<object>) > 0 {
                    CurrentYaw = StartYaws[0]
                }
                if math.Abs(CurrentYaw) < 5.0 {
                    CurrentYaw = 180.0
                }
                TargetBox<Transform>.Rotation = Vector3{0.0, CurrentYaw, 0.0}
                physics.MovePosition(TargetBox as entity<Rigidbody>, TargetBox<Transform>.Position)
            } else {
                CurrentYaw = TargetBox<Transform>.Rotation.Y
                if math.Abs(CurrentYaw) < 5.0 {
                    CurrentYaw = 180.0
                }
            }
            if VisualCar != nil {
                VisualCar<Transform>.Position = Vector3{TargetBox<Transform>.Position.X, TargetBox<Transform>.Position.Y - 0.25, TargetBox<Transform>.Position.Z}
                VisualCar<Transform>.Rotation = TargetBox<Transform>.Rotation
            }
            CurrentSpeedMs = 0.0
            CurrentSpeedKmh = 0.0
            VisualDriftAngle = 0.0
            IsDrifting = false

            if localP != nil {
                localP<vcam>.SyncVehicleState(CurrentYaw, CurrentPitch, 0.0, false, 0.0, false, false)
                localP<vcam>.SnapToTarget()
            }
        }

        // KHỞI TẠO 4 XE ĐỐI THỦ MULTIPLAYER / AI BOT (AUTO-FILL 5 XE CHUẨN)
        var sCount = list.Length(StartPositions as List<object>)
        var initWpCount = list.Length(WpPositions as List<object>)
        var initRoadMask = List<int>{1}

        if sCount > 1 {
            var c1 = SpawnCarModelForSlot(1)
            OpponentCar1 = c1
            if OpponentCar1 != nil {
                var sp1 = StartPositions[1]
                var sy1 = 180.0
                if list.Length(StartYaws as List<object>) > 1 { sy1 = StartYaws[1] }
                if math.Abs(sy1) < 5.0 { sy1 = 180.0 }

                var targetY1 = sp1.Y + 0.65
                physics.SingleRaycast(Vector3{sp1.X, sp1.Y + 2.5, sp1.Z}, Vector3{0.0, -1.0, 0.0}, 8.0, initRoadMask, false, out var spEnt1, out var spPos1, out var spDist1, out var spNorm1)
                if spEnt1 != nil { targetY1 = spPos1.Y + 0.65 }

                OpponentPos1 = Vector3{sp1.X, targetY1, sp1.Z}
                OpponentYaw1 = sy1
                OpponentCar1<Transform>.Position = Vector3{OpponentPos1.X, OpponentPos1.Y - 0.25, OpponentPos1.Z}
                OpponentCar1<Transform>.Rotation = Vector3{0.0, OpponentYaw1, 0.0}
                std.SetActive(OpponentCar1 as entity, true)
                OpponentActive1 = true
                OpponentIsHuman1 = false
                OpponentIdleTimer1 = 0.0

                if initWpCount > 0 {
                    var bestW1 = 0
                    var bestD2_1 = 999999.0
                    for w1 = 0, initWpCount, 1 {
                        var wp1 = WpPositions[w1]
                        var ddx1 = wp1.X - sp1.X
                        var ddz1 = wp1.Z - sp1.Z
                        var d2_1 = ddx1 * ddx1 + ddz1 * ddz1
                        if d2_1 < bestD2_1 { bestD2_1 = d2_1; bestW1 = w1 }
                    }
                    OpponentWpIdx1 = (bestW1 + 1) % initWpCount
                }
            }
        }
        if sCount > 2 {
            var c2 = SpawnCarModelForSlot(2)
            OpponentCar2 = c2
            if OpponentCar2 != nil {
                var sp2 = StartPositions[2]
                var sy2 = 180.0
                if list.Length(StartYaws as List<object>) > 2 { sy2 = StartYaws[2] }
                if math.Abs(sy2) < 5.0 { sy2 = 180.0 }

                var targetY2 = sp2.Y + 0.65
                physics.SingleRaycast(Vector3{sp2.X, sp2.Y + 2.5, sp2.Z}, Vector3{0.0, -1.0, 0.0}, 8.0, initRoadMask, false, out var spEnt2, out var spPos2, out var spDist2, out var spNorm2)
                if spEnt2 != nil { targetY2 = spPos2.Y + 0.65 }

                OpponentPos2 = Vector3{sp2.X, targetY2, sp2.Z}
                OpponentYaw2 = sy2
                OpponentCar2<Transform>.Position = Vector3{OpponentPos2.X, OpponentPos2.Y - 0.25, OpponentPos2.Z}
                OpponentCar2<Transform>.Rotation = Vector3{0.0, OpponentYaw2, 0.0}
                std.SetActive(OpponentCar2 as entity, true)
                OpponentActive2 = true
                OpponentIsHuman2 = false
                OpponentIdleTimer2 = 0.0

                if initWpCount > 0 {
                    var bestW2 = 0
                    var bestD2_2 = 999999.0
                    for w2 = 0, initWpCount, 1 {
                        var wp2 = WpPositions[w2]
                        var ddx2 = wp2.X - sp2.X
                        var ddz2 = wp2.Z - sp2.Z
                        var d2_2 = ddx2 * ddx2 + ddz2 * ddz2
                        if d2_2 < bestD2_2 { bestD2_2 = d2_2; bestW2 = w2 }
                    }
                    OpponentWpIdx2 = (bestW2 + 1) % initWpCount
                }
            }
        }
        if sCount > 3 {
            var c3 = SpawnCarModelForSlot(3)
            OpponentCar3 = c3
            if OpponentCar3 != nil {
                var sp3 = StartPositions[3]
                var sy3 = 180.0
                if list.Length(StartYaws as List<object>) > 3 { sy3 = StartYaws[3] }
                if math.Abs(sy3) < 5.0 { sy3 = 180.0 }

                var targetY3 = sp3.Y + 0.65
                physics.SingleRaycast(Vector3{sp3.X, sp3.Y + 2.5, sp3.Z}, Vector3{0.0, -1.0, 0.0}, 8.0, initRoadMask, false, out var spEnt3, out var spPos3, out var spDist3, out var spNorm3)
                if spEnt3 != nil { targetY3 = spPos3.Y + 0.65 }

                OpponentPos3 = Vector3{sp3.X, targetY3, sp3.Z}
                OpponentYaw3 = sy3
                OpponentCar3<Transform>.Position = Vector3{OpponentPos3.X, OpponentPos3.Y - 0.25, OpponentPos3.Z}
                OpponentCar3<Transform>.Rotation = Vector3{0.0, OpponentYaw3, 0.0}
                std.SetActive(OpponentCar3 as entity, true)
                OpponentActive3 = true
                OpponentIsHuman3 = false
                OpponentIdleTimer3 = 0.0

                if initWpCount > 0 {
                    var bestW3 = 0
                    var bestD2_3 = 999999.0
                    for w3 = 0, initWpCount, 1 {
                        var wp3 = WpPositions[w3]
                        var ddx3 = wp3.X - sp3.X
                        var ddz3 = wp3.Z - sp3.Z
                        var d2_3 = ddx3 * ddx3 + ddz3 * ddz3
                        if d2_3 < bestD2_3 { bestD2_3 = d2_3; bestW3 = w3 }
                    }
                    OpponentWpIdx3 = (bestW3 + 1) % initWpCount
                }
            }
        }
        if sCount > 4 {
            var c4 = SpawnCarModelForSlot(4)
            OpponentCar4 = c4
            if OpponentCar4 != nil {
                var sp4 = StartPositions[4]
                var sy4 = 180.0
                if list.Length(StartYaws as List<object>) > 4 { sy4 = StartYaws[4] }
                if math.Abs(sy4) < 5.0 { sy4 = 180.0 }

                var targetY4 = sp4.Y + 0.65
                physics.SingleRaycast(Vector3{sp4.X, sp4.Y + 2.5, sp4.Z}, Vector3{0.0, -1.0, 0.0}, 8.0, initRoadMask, false, out var spEnt4, out var spPos4, out var spDist4, out var spNorm4)
                if spEnt4 != nil { targetY4 = spPos4.Y + 0.65 }

                OpponentPos4 = Vector3{sp4.X, targetY4, sp4.Z}
                OpponentYaw4 = sy4
                OpponentCar4<Transform>.Position = Vector3{OpponentPos4.X, OpponentPos4.Y - 0.25, OpponentPos4.Z}
                OpponentCar4<Transform>.Rotation = Vector3{0.0, OpponentYaw4, 0.0}
                std.SetActive(OpponentCar4 as entity, true)
                OpponentActive4 = true
                OpponentIsHuman4 = false
                OpponentIdleTimer4 = 0.0

                if initWpCount > 0 {
                    var bestW4 = 0
                    var bestD2_4 = 999999.0
                    for w4 = 0, initWpCount, 1 {
                        var wp4 = WpPositions[w4]
                        var ddx4 = wp4.X - sp4.X
                        var ddz4 = wp4.Z - sp4.Z
                        var d2_4 = ddx4 * ddx4 + ddz4 * ddz4
                        if d2_4 < bestD2_4 { bestD2_4 = d2_4; bestW4 = w4 }
                    }
                    OpponentWpIdx4 = (bestW4 + 1) % initWpCount
                }
            }
        }

        // Khởi tạo điểm số tiến độ ban đầu cho Bot (Chuẩn 100% theo toạ độ Checkpoint)
        var cpCountInit = list.Length(CpPositions as List<object>)
        if cpCountInit >= 2 {
            var c0 = CpPositions[0]
            var c1 = CpPositions[1]
            if sCount > 1 { OpponentScore1 = raceRules.CalcContinuousProgress(1, 0, OpponentPos1, c0, c1) }
            if sCount > 2 { OpponentScore2 = raceRules.CalcContinuousProgress(1, 0, OpponentPos2, c0, c1) }
            if sCount > 3 { OpponentScore3 = raceRules.CalcContinuousProgress(1, 0, OpponentPos3, c0, c1) }
            if sCount > 4 { OpponentScore4 = raceRules.CalcContinuousProgress(1, 0, OpponentPos4, c0, c1) }
        }
        BotLastCpIdx1 = 0
        BotNextCpIdx1 = 1
        BotLastCpIdx2 = 0
        BotNextCpIdx2 = 1
        BotLastCpIdx3 = 0
        BotNextCpIdx3 = 1
        BotLastCpIdx4 = 0
        BotNextCpIdx4 = 1

        // Đặt vị trí xuất phát cho 4 chấm đối thủ trên Rotating Minimap ngay khi tải phòng
        if (OpponentDot1Widget as entity) != nil {
            var mX1 = OpponentPos1.X * MinimapScaleX + MinimapOffsetX
            var mY1 = OpponentPos1.Z * MinimapScaleY + MinimapOffsetY
            OpponentDot1Widget<hud.UIWidget>.AnchorPosition = Vector3{mX1, mY1, 0.0}
            OpponentDot1Widget<hud.UIWidget>.IsVisible = true
        }
        if (OpponentDot2Widget as entity) != nil {
            var mX2 = OpponentPos2.X * MinimapScaleX + MinimapOffsetX
            var mY2 = OpponentPos2.Z * MinimapScaleY + MinimapOffsetY
            OpponentDot2Widget<hud.UIWidget>.AnchorPosition = Vector3{mX2, mY2, 0.0}
            OpponentDot2Widget<hud.UIWidget>.IsVisible = true
        }
        if (OpponentDot3Widget as entity) != nil {
            var mX3 = OpponentPos3.X * MinimapScaleX + MinimapOffsetX
            var mY3 = OpponentPos3.Z * MinimapScaleY + MinimapOffsetY
            OpponentDot3Widget<hud.UIWidget>.AnchorPosition = Vector3{mX3, mY3, 0.0}
            OpponentDot3Widget<hud.UIWidget>.IsVisible = true
        }
        if (OpponentDot4Widget as entity) != nil {
            var mX4 = OpponentPos4.X * MinimapScaleX + MinimapOffsetX
            var mY4 = OpponentPos4.Z * MinimapScaleY + MinimapOffsetY
            OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
            OpponentDot4Widget<hud.UIWidget>.IsVisible = true
        }

        // Khởi tạo âm thanh đếm ngược 3-2-1 và GO
        playable.CreateSoundClient(out var cSnd, EditorGenLib.EResSound.Three_Two_One as SoundEffectType, animation.LoopType.Default, false)
        CountdownSound = cSnd
        if (CountdownSound as entity) != nil {
            CountdownSound<SoundEffect>.Is3D = false
            CountdownSound<SoundEffect>.Volume = 100
        }
        playable.CreateSoundClient(out var gSnd, EditorGenLib.EResSound.Go as SoundEffectType, animation.LoopType.Default, false)
        GoSound = gSnd
        if (GoSound as entity) != nil {
            GoSound<SoundEffect>.Is3D = false
            GoSound<SoundEffect>.Volume = 100
        }

        CountdownTimer = 3.0
        GoTimer = 0.0
        LastCountdownStep = 4
        IsRaceStarted = false
        RaceTimer = 0.0

        LastTimestamp = time.GetLocalTimestamp()
        IsInitialized = true

        // Đăng ký skin xe lên Server cho phòng Online Multiplayer
        std.DispatchEventToEntity(SyncCarIndex, thisEntity, PlatformType.Server, List<int>{1})
    }

    func FindNodeRecursive(node entity<Entity>, targetName string) entity<Entity> {
        if node == nil { return nil }
        if node<Entity>.Name == targetName { return node }
        var children = std.GetChildren(node)
        var count = list.Length(children as List<object>)
        for i = 0, count, 1 {
            var child = children[i] as entity<Entity>
            if child != nil {
                var found = FindNodeRecursive(child, targetName)
                if found != nil { return found }
            }
        }
        return nil
    }

    // ------------------------------------------------------------------------
    // HỆ THỐNG SKIN PREFAB MULTIPLAYER (CHUẨN ASPHALT 8 PREFAB REGISTRY)
    // Mỗi slot xe đối thủ/người chơi có thể mang một Prefab skin độc lập
    // Hoàn toàn không phụ thuộc vào CarToClone trong scene
    // ------------------------------------------------------------------------
    func GetCarPrefabBySlot(slot int) PrefabID {
        if slot == 2 {
            return EditorGenLib.EResPrefab.CR002
        } else if slot == 3 {
            return EditorGenLib.EResPrefab.CR003
        } else if slot == 4 {
            return EditorGenLib.EResPrefab.CR001
        }
        return EditorGenLib.EResPrefab.CR001
    }

    func SetupCarVisualModel(car entity<Entity>) {
        if car == nil { return }
        std.SetActive(car as entity, true)
    }

    func SpawnCarModelForSlot(slot int) entity<Entity> {
        var carPrefab = EditorGenLib.EResPrefab.CR001 as PrefabID
        if carPrefab != nil {
            std.CreateFromPrefab(out var carEnt, carPrefab)
            if carEnt != nil {
                SetupCarVisualModel(carEnt)
                return carEnt
            }
        }
        return nil
    }

    func UpdateSingleBot(botCar entity<Entity>, botIdx int, dt float) {
        if botCar == nil { return }
        var wpCount = list.Length(WpPositions as List<object>)
        if wpCount < 2 { return }

        var curPos = OpponentPos1
        var curYaw = OpponentYaw1
        var curPitch = OpponentPitch1
        var curRoll = OpponentRoll1
        var airImpulse = OpponentAirImpulse1
        var curSpeed = OpponentSpeedMs1
        var topSpeed = OpponentTopSpeedMs1
        var wpIdx = OpponentWpIdx1
        var botLap = OpponentLap1
        var isHuman = OpponentIsHuman1
        var lastCp = BotLastCpIdx1
        var nextCp = BotNextCpIdx1
        var curOffset = BotCurLaneOffset1
        var targetOffset = BotTargetLaneOffset1
        var wallCooldown = BotWallCooldown1

        if botIdx == 2 {
            curPos = OpponentPos2
            curYaw = OpponentYaw2
            curPitch = OpponentPitch2
            curRoll = OpponentRoll2
            airImpulse = OpponentAirImpulse2
            curSpeed = OpponentSpeedMs2
            topSpeed = OpponentTopSpeedMs2
            wpIdx = OpponentWpIdx2
            botLap = OpponentLap2
            isHuman = OpponentIsHuman2
            lastCp = BotLastCpIdx2
            nextCp = BotNextCpIdx2
            curOffset = BotCurLaneOffset2
            targetOffset = BotTargetLaneOffset2
            wallCooldown = BotWallCooldown2
        } else if botIdx == 3 {
            curPos = OpponentPos3
            curYaw = OpponentYaw3
            curPitch = OpponentPitch3
            curRoll = OpponentRoll3
            airImpulse = OpponentAirImpulse3
            curSpeed = OpponentSpeedMs3
            topSpeed = OpponentTopSpeedMs3
            wpIdx = OpponentWpIdx3
            botLap = OpponentLap3
            isHuman = OpponentIsHuman3
            lastCp = BotLastCpIdx3
            nextCp = BotNextCpIdx3
            curOffset = BotCurLaneOffset3
            targetOffset = BotTargetLaneOffset3
            wallCooldown = BotWallCooldown3
        } else if botIdx == 4 {
            curPos = OpponentPos4
            curYaw = OpponentYaw4
            curPitch = OpponentPitch4
            curRoll = OpponentRoll4
            airImpulse = OpponentAirImpulse4
            curSpeed = OpponentSpeedMs4
            topSpeed = OpponentTopSpeedMs4
            wpIdx = OpponentWpIdx4
            botLap = OpponentLap4
            isHuman = OpponentIsHuman4
            lastCp = BotLastCpIdx4
            nextCp = BotNextCpIdx4
            curOffset = BotCurLaneOffset4
            targetOffset = BotTargetLaneOffset4
            wallCooldown = BotWallCooldown4
        }

        if isHuman { return }

        if wallCooldown > 0.0 {
            wallCooldown = wallCooldown - dt
            if wallCooldown < 0.0 { wallCooldown = 0.0 }
        }

        if airImpulse > 0.0 {
            airImpulse = airImpulse - dt * 2.0
            if airImpulse < 0.0 { airImpulse = 0.0 }
        }

        // TÍNH ĐIỂM TIẾN ĐỘ THEO CHECKPOINT (CHUẨN 100% CÔNG THỨC NGƯỜI CHƠI)
        var totalCps = list.Length(CpPositions as List<object>)
        var score = 0.0
        if totalCps >= 2 {
            if nextCp >= totalCps { nextCp = 0 }
            if lastCp >= totalCps { lastCp = 0 }
            var hitBotCp = raceRules.CheckCheckpointHit(curPos, CpPositions, nextCp)
            if hitBotCp {
                lastCp = nextCp
                nextCp = nextCp + 1
                if nextCp >= totalCps {
                    nextCp = 0
                    botLap = botLap + 1
                }
            }
            var currCpPos = CpPositions[lastCp]
            var nxtCpPos = CpPositions[nextCp]
            score = raceRules.CalcContinuousProgress(botLap, lastCp, curPos, currCpPos, nxtCpPos)
        }

        if !IsRaceStarted {
            botCar<Transform>.Position = Vector3{curPos.X, curPos.Y - 0.25, curPos.Z}
            botCar<Transform>.Rotation = Vector3{0.0, curYaw, 0.0}
            if botIdx == 1 {
                OpponentScore1 = score
                if (OpponentDot1Widget as entity) != nil {
                    var mX1 = curPos.X * MinimapScaleX + MinimapOffsetX
                    var mY1 = curPos.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot1Widget<hud.UIWidget>.AnchorPosition = Vector3{mX1, mY1, 0.0}
                    OpponentDot1Widget<hud.UIWidget>.IsVisible = true
                }
            } else if botIdx == 2 {
                OpponentScore2 = score
                if (OpponentDot2Widget as entity) != nil {
                    var mX2 = curPos.X * MinimapScaleX + MinimapOffsetX
                    var mY2 = curPos.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot2Widget<hud.UIWidget>.AnchorPosition = Vector3{mX2, mY2, 0.0}
                    OpponentDot2Widget<hud.UIWidget>.IsVisible = true
                }
            } else if botIdx == 3 {
                OpponentScore3 = score
                if (OpponentDot3Widget as entity) != nil {
                    var mX3 = curPos.X * MinimapScaleX + MinimapOffsetX
                    var mY3 = curPos.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot3Widget<hud.UIWidget>.AnchorPosition = Vector3{mX3, mY3, 0.0}
                    OpponentDot3Widget<hud.UIWidget>.IsVisible = true
                }
            } else if botIdx == 4 {
                OpponentScore4 = score
                if (OpponentDot4Widget as entity) != nil {
                    var mX4 = curPos.X * MinimapScaleX + MinimapOffsetX
                    var mY4 = curPos.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
                    OpponentDot4Widget<hud.UIWidget>.IsVisible = true
                }
            }
            return
        }

        // DYNAMIC RUBBER-BANDING (ASPHALT 8 CATCH-UP LOGIC)

        // Lấy điểm cao nhất của các người chơi thật làm mốc Rubber-Banding
        var maxHumanScore = ContinuousScore
        if OpponentIsHuman1 && OpponentScore1 > maxHumanScore { maxHumanScore = OpponentScore1 }
        if OpponentIsHuman2 && OpponentScore2 > maxHumanScore { maxHumanScore = OpponentScore2 }
        if OpponentIsHuman3 && OpponentScore3 > maxHumanScore { maxHumanScore = OpponentScore3 }
        if OpponentIsHuman4 && OpponentScore4 > maxHumanScore { maxHumanScore = OpponentScore4 }

        var refScore = maxHumanScore
        var scoreGap = score - refScore
        var speedMod = 1.0
        var accelRate = 3.0

        if scoreGap > 600.0 {
            // Bot đang dẫn trước người chơi khá xa (> 60m): Hãm nhẹ 12% tốc độ
            speedMod = 0.88
            accelRate = 2.0
        } else if scoreGap < -500.0 {
            // Bot đang bị người chơi bỏ rơi (> 50m): Kích hoạt Catch-Up Boost tăng tốc
            speedMod = 1.18
            accelRate = 4.5
        }

        var effectiveTop = topSpeed * speedMod
        if curSpeed < effectiveTop {
            curSpeed = curSpeed + accelRate * dt
            if curSpeed > effectiveTop { curSpeed = effectiveTop }
        } else if curSpeed > effectiveTop {
            curSpeed = curSpeed - 3.0 * dt
            if curSpeed < effectiveTop { curSpeed = effectiveTop }
        }

        // Watchdog chống kẹt waypoint (Fail-safe)
        var stuckTimer = BotStuckTimer1
        var lastWp = BotLastWpIdx1
        if botIdx == 2 {
            stuckTimer = BotStuckTimer2
            lastWp = BotLastWpIdx2
        } else if botIdx == 3 {
            stuckTimer = BotStuckTimer3
            lastWp = BotLastWpIdx3
        } else if botIdx == 4 {
            stuckTimer = BotStuckTimer4
            lastWp = BotLastWpIdx4
        }

        if wpIdx >= wpCount { wpIdx = 0 }
        var maxStuckTime = 2.0
        if wpCount <= 80 { maxStuckTime = 3.5 }
        if wpIdx == lastWp {
            stuckTimer = stuckTimer + dt
            if stuckTimer > maxStuckTime {
                // Kẹt quá lâu tại 1 waypoint: Cưỡng chế nhảy sang điểm tiếp theo
                wpIdx = (wpIdx + 1) % wpCount
                stuckTimer = 0.0
            }
        } else {
            stuckTimer = 0.0
            lastWp = wpIdx
        }

        var tWp = WpPositions[wpIdx]
        var dx = tWp.X - curPos.X
        var dz = tWp.Z - curPos.Z
        var distSq = dx * dx + dz * dz

        // Vector đoạn đường tới waypoint tiếp theo để bắt sự kiện đã lái vượt qua
        var nextWpIdx = (wpIdx + 1) % wpCount
        var nextWp = WpPositions[nextWpIdx]
        var segX = nextWp.X - tWp.X
        var segZ = nextWp.Z - tWp.Z
        var pastX = curPos.X - tWp.X
        var pastZ = curPos.Z - tWp.Z
        // Ngưỡng khoảng cách nhận diện đã qua Waypoint (Tự động thích ứng Waypoint dày 5m hoặc thưa 25m)
        var arrivalDistSq = 36.0
        var passDistSq = 100.0
        var wpPickInterval = 6
        if wpCount <= 80 {
            arrivalDistSq = 324.0
            passDistSq = 625.0
            wpPickInterval = 1
        }

        var isPassedFwd = (distSq < passDistSq) && ((pastX * segX + pastZ * segZ) > 0.0)

        if distSq < arrivalDistSq || isPassedFwd {
            wpIdx = nextWpIdx
            if wpIdx == 0 {
                botLap = botLap + 1
            }
            stuckTimer = 0.0
            lastWp = wpIdx
            tWp = WpPositions[wpIdx]
            // Đổi làn mượt mà: Với Waypoint dày 5m, đổi làn mục tiêu mỗi ~30m (6 waypoints) để xe uốn lượn tự nhiên
            if wpIdx % wpPickInterval == 0 {
                if wallCooldown <= 0.0 {
                    targetOffset = math.RandomFloat(-4.8, 4.8)
                } else {
                    targetOffset = 0.0
                }
            }
            nextWpIdx = (wpIdx + 1) % wpCount
            nextWp = WpPositions[nextWpIdx]
            segX = nextWp.X - tWp.X
            segZ = nextWp.Z - tWp.Z
        }

        // Nội suy mượt mà sang làn mục tiêu (tốc độ chuyển làn tự nhiên)
        var blendLaneRate = 1.6 * dt
        if blendLaneRate > 0.35 { blendLaneRate = 0.35 }
        curOffset = curOffset + (targetOffset - curOffset) * blendLaneRate

        // Tính vector pháp tuyến ngang vuông góc với hướng đường đua
        var segLen = math.Sqrt(segX * segX + segZ * segZ)
        var aimX = tWp.X
        var aimZ = tWp.Z
        if segLen > 0.5 {
            var normX = -segZ / segLen
            var normZ = segX / segLen
            aimX = tWp.X + normX * curOffset
            aimZ = tWp.Z + normZ * curOffset
        }
        dx = aimX - curPos.X
        dz = aimZ - curPos.Z

        if botIdx == 1 {
            BotStuckTimer1 = stuckTimer
            BotLastWpIdx1 = lastWp
        } else if botIdx == 2 {
            BotStuckTimer2 = stuckTimer
            BotLastWpIdx2 = lastWp
        } else if botIdx == 3 {
            BotStuckTimer3 = stuckTimer
            BotLastWpIdx3 = lastWp
        } else if botIdx == 4 {
            BotStuckTimer4 = stuckTimer
            BotLastWpIdx4 = lastWp
        }

        var desiredYaw = math.ATan2(dx, dz)
        var yawDiff = desiredYaw - curYaw
        while yawDiff > 180.0 { yawDiff = yawDiff - 360.0 }
        while yawDiff < -180.0 { yawDiff = yawDiff + 360.0 }

        var turnSpeed = 120.0
        var absYawDiff = math.Abs(yawDiff)
        if absYawDiff > 40.0 {
            // Cua gắt: Giảm tốc độ mạnh và tăng tốc độ bẻ lái để bán kính ôm cua nhỏ (tránh văng rộng)
            if curSpeed > 4.5 {
                curSpeed = curSpeed - 6.0 * dt
                if curSpeed < 4.5 { curSpeed = 4.5 }
            }
            turnSpeed = 160.0
        } else if absYawDiff > 20.0 {
            if curSpeed > 7.0 {
                curSpeed = curSpeed - 3.5 * dt
            }
            turnSpeed = 130.0
        }
        var maxTurn = turnSpeed * dt
        if yawDiff > maxTurn { yawDiff = maxTurn }
        if yawDiff < -maxTurn { yawDiff = -maxTurn }
        curYaw = curYaw + yawDiff

        var fwdX = math.Sin(curYaw)
        var fwdZ = math.Cos(curYaw)
        var rgtX = math.Cos(curYaw)
        var rgtZ = -math.Sin(curYaw)
        var moveDist = curSpeed * dt

        var bHitWall = false
        var minHitDist = 999999.0
        var bWallNorm = Vector3{0.0, 0.0, 0.0}
        var isFrontHit = false
        var bWallMask = List<int>{0}
        var probeY = curPos.Y + 0.25

        var bLeftAngX = fwdX * 0.94 - rgtX * 0.34
        var bLeftAngZ = fwdZ * 0.94 - rgtZ * 0.34
        var bRightAngX = fwdX * 0.94 + rgtX * 0.34
        var bRightAngZ = fwdZ * 0.94 + rgtZ * 0.34

        var bCastDist = moveDist + 1.20
        if bCastDist < 1.40 { bCastDist = 1.40 }

        var bCenterStart    = Vector3{curPos.X + fwdX * 0.50, probeY, curPos.Z + fwdZ * 0.50}
        var bLeftStart      = Vector3{curPos.X + fwdX * 0.50 - rgtX * 0.60, probeY, curPos.Z + fwdZ * 0.50 - rgtZ * 0.60}
        var bRightStart     = Vector3{curPos.X + fwdX * 0.50 + rgtX * 0.60, probeY, curPos.Z + fwdZ * 0.50 + rgtZ * 0.60}
        var bSideLeftStart  = Vector3{curPos.X - rgtX * 0.55, probeY, curPos.Z - rgtZ * 0.55}
        var bSideRightStart = Vector3{curPos.X + rgtX * 0.55, probeY, curPos.Z + rgtZ * 0.55}

        physics.SingleRaycast(bCenterStart, Vector3{fwdX, 0.0, fwdZ}, bCastDist, bWallMask, false, out var bcEnt, out var bcPos, out var bcDist, out var bcNorm)
        physics.SingleRaycast(bLeftStart, Vector3{bLeftAngX, 0.0, bLeftAngZ}, bCastDist, bWallMask, false, out var blEnt, out var blPos, out var blDist, out var blNorm)
        physics.SingleRaycast(bRightStart, Vector3{bRightAngX, 0.0, bRightAngZ}, bCastDist, bWallMask, false, out var brEnt, out var brPos, out var brDist, out var brNorm)
        physics.SingleRaycast(bSideLeftStart, Vector3{-rgtX, 0.0, -rgtZ}, 0.75, bWallMask, false, out var bslEnt, out var bslPos, out var bslDist, out var bslNorm)
        physics.SingleRaycast(bSideRightStart, Vector3{rgtX, 0.0, rgtZ}, 0.75, bWallMask, false, out var bsrEnt, out var bsrPos, out var bsrDist, out var bsrNorm)

        if bcEnt != nil && bcEnt != botCar && (TargetBox == nil || bcEnt != TargetBox) && (OpponentCar1 == nil || bcEnt != OpponentCar1) && (OpponentCar2 == nil || bcEnt != OpponentCar2) && (OpponentCar3 == nil || bcEnt != OpponentCar3) && (OpponentCar4 == nil || bcEnt != OpponentCar4) && bcNorm.Y < 0.65 {
            if bcDist < minHitDist {
                minHitDist = bcDist
                bHitWall = true
                bWallNorm = bcNorm
                isFrontHit = true
            }
        }
        if blEnt != nil && blEnt != botCar && (TargetBox == nil || blEnt != TargetBox) && (OpponentCar1 == nil || blEnt != OpponentCar1) && (OpponentCar2 == nil || blEnt != OpponentCar2) && (OpponentCar3 == nil || blEnt != OpponentCar3) && (OpponentCar4 == nil || blEnt != OpponentCar4) && blNorm.Y < 0.65 {
            if blDist < minHitDist {
                minHitDist = blDist
                bHitWall = true
                bWallNorm = blNorm
                isFrontHit = true
            }
        }
        if brEnt != nil && brEnt != botCar && (TargetBox == nil || brEnt != TargetBox) && (OpponentCar1 == nil || brEnt != OpponentCar1) && (OpponentCar2 == nil || brEnt != OpponentCar2) && (OpponentCar3 == nil || brEnt != OpponentCar3) && (OpponentCar4 == nil || brEnt != OpponentCar4) && brNorm.Y < 0.65 {
            if brDist < minHitDist {
                minHitDist = brDist
                bHitWall = true
                bWallNorm = brNorm
                isFrontHit = true
            }
        }
        if bslEnt != nil && bslEnt != botCar && (TargetBox == nil || bslEnt != TargetBox) && (OpponentCar1 == nil || bslEnt != OpponentCar1) && (OpponentCar2 == nil || bslEnt != OpponentCar2) && (OpponentCar3 == nil || bslEnt != OpponentCar3) && (OpponentCar4 == nil || bslEnt != OpponentCar4) && bslNorm.Y < 0.65 {
            if bslDist < minHitDist {
                minHitDist = bslDist
                bHitWall = true
                bWallNorm = bslNorm
                isFrontHit = false
            }
        }
        if bsrEnt != nil && bsrEnt != botCar && (TargetBox == nil || bsrEnt != TargetBox) && (OpponentCar1 == nil || bsrEnt != OpponentCar1) && (OpponentCar2 == nil || bsrEnt != OpponentCar2) && (OpponentCar3 == nil || bsrEnt != OpponentCar3) && (OpponentCar4 == nil || bsrEnt != OpponentCar4) && bsrNorm.Y < 0.65 {
            if bsrDist < minHitDist {
                minHitDist = bsrDist
                bHitWall = true
                bWallNorm = bsrNorm
                isFrontHit = false
            }
        }

        if bHitWall {
            var maxMove = minHitDist - 0.45
            if maxMove < 0.0 { maxMove = 0.0 }
            if moveDist > maxMove { moveDist = maxMove }
        }

        var pushOutX = 0.0
        var pushOutZ = 0.0

        if bHitWall {
            var bwLen = math.Sqrt(bWallNorm.X * bWallNorm.X + bWallNorm.Z * bWallNorm.Z)
            if bwLen > 0.001 {
                var bnx = bWallNorm.X / bwLen
                var bnz = bWallNorm.Z / bwLen
                var vDotN = fwdX * bnx + fwdZ * bnz

                if wallCooldown > 0.0 {
                    pushOutX = bnx * 0.15
                    pushOutZ = bnz * 0.15

                    var slideX = fwdX - vDotN * bnx
                    var slideZ = fwdZ - vDotN * bnz
                    var sLen = math.Sqrt(slideX * slideX + slideZ * slideZ)
                    if sLen > 0.001 {
                        slideX = slideX / sLen
                        slideZ = slideZ / sLen
                        var targetWallYaw = math.ATan2(slideX, slideZ)
                        var yawDiffW = targetWallYaw - curYaw
                        while yawDiffW > 180.0 { yawDiffW = yawDiffW - 360.0 }
                        while yawDiffW < -180.0 { yawDiffW = yawDiffW + 360.0 }
                        var steerRateW = 20.0 * dt
                        if steerRateW > 0.80 { steerRateW = 0.80 }
                        curYaw = curYaw + yawDiffW * steerRateW
                        while curYaw > 180.0 { curYaw = curYaw - 360.0 }
                        while curYaw < -180.0 { curYaw = curYaw + 360.0 }
                        fwdX = math.Sin(curYaw)
                        fwdZ = math.Cos(curYaw)
                        rgtX = math.Cos(curYaw)
                        rgtZ = -math.Sin(curYaw)
                    }
                    curSpeed = curSpeed * 0.98
                } else if vDotN < -0.55 {
                    var refX = fwdX - 2.0 * vDotN * bnx
                    var refZ = fwdZ - 2.0 * vDotN * bnz
                    var rLen = math.Sqrt(refX * refX + refZ * refZ)
                    if rLen > 0.001 {
                        refX = refX / rLen
                        refZ = refZ / rLen
                        curYaw = math.ATan2(refX, refZ)
                        while curYaw > 180.0 { curYaw = curYaw - 360.0 }
                        while curYaw < -180.0 { curYaw = curYaw + 360.0 }
                        fwdX = math.Sin(curYaw)
                        fwdZ = math.Cos(curYaw)
                        rgtX = math.Cos(curYaw)
                        rgtZ = -math.Sin(curYaw)
                    }

                    curSpeed = curSpeed * 0.45
                    if curSpeed < 3.5 { curSpeed = 3.5 }

                    pushOutX = bnx * 0.50
                    pushOutZ = bnz * 0.50

                    curOffset = 0.0
                    targetOffset = 0.0
                    wallCooldown = 0.80
                    stuckTimer = stuckTimer + 0.6
                    airImpulse = 0.28
                } else if vDotN < -0.01 {
                    var slideX = fwdX - vDotN * bnx
                    var slideZ = fwdZ - vDotN * bnz
                    var sLen = math.Sqrt(slideX * slideX + slideZ * slideZ)
                    if sLen > 0.001 {
                        slideX = slideX / sLen
                        slideZ = slideZ / sLen
                        var targetWallYaw = math.ATan2(slideX, slideZ)
                        var yawDiffW = targetWallYaw - curYaw
                        while yawDiffW > 180.0 { yawDiffW = yawDiffW - 360.0 }
                        while yawDiffW < -180.0 { yawDiffW = yawDiffW + 360.0 }
                        var steerRateW = 18.0 * dt
                        if steerRateW > 0.75 { steerRateW = 0.75 }
                        curYaw = curYaw + yawDiffW * steerRateW
                        while curYaw > 180.0 { curYaw = curYaw - 360.0 }
                        while curYaw < -180.0 { curYaw = curYaw + 360.0 }
                        fwdX = math.Sin(curYaw)
                        fwdZ = math.Cos(curYaw)
                        rgtX = math.Cos(curYaw)
                        rgtZ = -math.Sin(curYaw)
                    }

                    curSpeed = curSpeed * 0.95
                    pushOutX = bnx * 0.20
                    pushOutZ = bnz * 0.20
                    curOffset = curOffset * 0.85
                    targetOffset = 0.0
                    wallCooldown = 0.35
                } else {
                    pushOutX = bnx * 0.10
                    pushOutZ = bnz * 0.10
                }
            }
        }

        var newX = curPos.X + fwdX * moveDist + pushOutX
        var newZ = curPos.Z + fwdZ * moveDist + pushOutZ

        // Raycast gầm dò mặt đường chuẩn xác cho xe Bot (Chấm dứt hiện tượng bay trên không)
        var rayStart = Vector3{newX, curPos.Y + 3.0, newZ}
        var roadMask = List<int>{1}
        physics.SingleRaycast(rayStart, Vector3{0.0, -1.0, 0.0}, 14.0, roadMask, false, out var rEnt, out var rPos, out var rDist, out var rNorm)
        var hitGround = (rEnt != nil)
        var groundHitPos = rPos
        var groundHitNorm = rNorm
        if !hitGround {
            var defMask = List<int>{0}
            physics.SingleRaycast(rayStart, Vector3{0.0, -1.0, 0.0}, 14.0, defMask, false, out var rEnt2, out var rPos2, out var rDist2, out var rNorm2)
            if rEnt2 != nil && rNorm2.Y >= 0.70 {
                hitGround = true
                groundHitPos = rPos2
                groundHitNorm = rNorm2
            }
        }
        var targetY = curPos.Y
        if hitGround {
            targetY = groundHitPos.Y + 0.65 + airImpulse
        } else {
            targetY = tWp.Y + 0.65 + airImpulse
        }
        var newY = curPos.Y + (targetY - curPos.Y) * 14.0 * dt
        curPos = Vector3{newX, newY, newZ}

        var pitch = 0.0
        var roll = -yawDiff * 0.2
        if hitGround && groundHitNorm.Y > 0.4 {
            var fwdSlope = fwdX * groundHitNorm.X + fwdZ * groundHitNorm.Z
            // Độ nghiêng mũi xe theo dốc mặt đường (chuẩn Player Car: math.ATan2)
            pitch = math.ATan2(fwdSlope, groundHitNorm.Y)
            if airImpulse > 0.0 { pitch = pitch - (airImpulse * 16.0) }
            if pitch > 35.0 { pitch = 35.0 }
            if pitch < -35.0 { pitch = -35.0 }

            var rgtSlope = rgtX * groundHitNorm.X + rgtZ * groundHitNorm.Z
            var bankRoll = math.ATan2(-rgtSlope, groundHitNorm.Y)
            roll = bankRoll - yawDiff * 0.15
        } else {
            var dy = targetY - curPos.Y
            pitch = -dy * 3.5
            if airImpulse > 0.0 { pitch = pitch - (airImpulse * 16.0) }
            if pitch > 20.0 { pitch = 20.0 }
            if pitch < -20.0 { pitch = -20.0 }
        }
        if roll > 25.0 { roll = 25.0 }
        if roll < -25.0 { roll = -25.0 }

        botCar<Transform>.Position = Vector3{curPos.X, curPos.Y - 0.25, curPos.Z}
        botCar<Transform>.Rotation = Vector3{pitch, curYaw, roll}

        var botVel = Vector3{fwdX * curSpeed, 0.0, fwdZ * curSpeed}

        if botIdx == 1 {
            OpponentPos1 = curPos
            OpponentYaw1 = curYaw
            OpponentPitch1 = pitch
            OpponentRoll1 = roll
            OpponentAirImpulse1 = airImpulse
            OpponentSpeedMs1 = curSpeed
            OpponentVel1 = botVel
            OpponentWpIdx1 = wpIdx
            OpponentLap1 = botLap
            BotLastCpIdx1 = lastCp
            BotNextCpIdx1 = nextCp
            OpponentScore1 = score
            BotCurLaneOffset1 = curOffset
            BotTargetLaneOffset1 = targetOffset
            BotWallCooldown1 = wallCooldown
            BotStuckTimer1 = stuckTimer
            if (OpponentDot1Widget as entity) != nil {
                var mX1 = curPos.X * MinimapScaleX + MinimapOffsetX
                var mY1 = curPos.Z * MinimapScaleY + MinimapOffsetY
                OpponentDot1Widget<hud.UIWidget>.AnchorPosition = Vector3{mX1, mY1, 0.0}
                OpponentDot1Widget<hud.UIWidget>.IsVisible = true
            }
        } else if botIdx == 2 {
            OpponentPos2 = curPos
            OpponentYaw2 = curYaw
            OpponentPitch2 = pitch
            OpponentRoll2 = roll
            OpponentAirImpulse2 = airImpulse
            OpponentSpeedMs2 = curSpeed
            OpponentVel2 = botVel
            OpponentWpIdx2 = wpIdx
            OpponentLap2 = botLap
            BotLastCpIdx2 = lastCp
            BotNextCpIdx2 = nextCp
            OpponentScore2 = score
            BotCurLaneOffset2 = curOffset
            BotTargetLaneOffset2 = targetOffset
            BotWallCooldown2 = wallCooldown
            BotStuckTimer2 = stuckTimer
            if (OpponentDot2Widget as entity) != nil {
                var mX2 = curPos.X * MinimapScaleX + MinimapOffsetX
                var mY2 = curPos.Z * MinimapScaleY + MinimapOffsetY
                OpponentDot2Widget<hud.UIWidget>.AnchorPosition = Vector3{mX2, mY2, 0.0}
                OpponentDot2Widget<hud.UIWidget>.IsVisible = true
            }
        } else if botIdx == 3 {
            OpponentPos3 = curPos
            OpponentYaw3 = curYaw
            OpponentPitch3 = pitch
            OpponentRoll3 = roll
            OpponentAirImpulse3 = airImpulse
            OpponentSpeedMs3 = curSpeed
            OpponentVel3 = botVel
            OpponentWpIdx3 = wpIdx
            OpponentLap3 = botLap
            BotLastCpIdx3 = lastCp
            BotNextCpIdx3 = nextCp
            OpponentScore3 = score
            BotCurLaneOffset3 = curOffset
            BotTargetLaneOffset3 = targetOffset
            BotWallCooldown3 = wallCooldown
            BotStuckTimer3 = stuckTimer
            if (OpponentDot3Widget as entity) != nil {
                var mX3 = curPos.X * MinimapScaleX + MinimapOffsetX
                var mY3 = curPos.Z * MinimapScaleY + MinimapOffsetY
                OpponentDot3Widget<hud.UIWidget>.AnchorPosition = Vector3{mX3, mY3, 0.0}
                OpponentDot3Widget<hud.UIWidget>.IsVisible = true
            }
        } else if botIdx == 4 {
            OpponentPos4 = curPos
            OpponentYaw4 = curYaw
            OpponentPitch4 = pitch
            OpponentRoll4 = roll
            OpponentAirImpulse4 = airImpulse
            OpponentSpeedMs4 = curSpeed
            OpponentVel4 = botVel
            OpponentWpIdx4 = wpIdx
            OpponentLap4 = botLap
            BotLastCpIdx4 = lastCp
            BotNextCpIdx4 = nextCp
            OpponentScore4 = score
            BotCurLaneOffset4 = curOffset
            BotTargetLaneOffset4 = targetOffset
            BotWallCooldown4 = wallCooldown
            BotStuckTimer4 = stuckTimer
            if (OpponentDot4Widget as entity) != nil {
                var mX4 = curPos.X * MinimapScaleX + MinimapOffsetX
                var mY4 = curPos.Z * MinimapScaleY + MinimapOffsetY
                OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
                OpponentDot4Widget<hud.UIWidget>.IsVisible = true
            }
        }
    }

    func UpdateRemoteOpponents(dt float) {
        var wpCount = list.Length(WpPositions as List<object>)
        var runBotsLocally = IsRoomHost

        if !IsRoomHost && IsRaceStarted {
            LastBotPacketTimer = LastBotPacketTimer + dt
        }

        // Slot 1
        if OpponentIsHuman1 {
            OpponentIdleTimer1 = OpponentIdleTimer1 + dt
            if OpponentIdleTimer1 > 1.5 {
                OpponentIsHuman1 = false
                OpponentIsRemoteBot1 = false
                if wpCount > 0 {
                    var bestWp1 = 0
                    var bestD2_1 = 999999.0
