            if OpponentCar3 != nil {
                std.SetActive(OpponentCar3 as entity, true)
                OpponentCar3<Transform>.Position = Vector3{OpponentPos3.X, OpponentPos3.Y - 0.25, OpponentPos3.Z}
                OpponentCar3<Transform>.Rotation = Vector3{OpponentPitch3, OpponentYaw3, OpponentRoll3}
            }
            if (OpponentDot3Widget as entity) != nil {
                var mX3 = OpponentPos3.X * MinimapScaleX + MinimapOffsetX
                var mY3 = OpponentPos3.Z * MinimapScaleY + MinimapOffsetY
                OpponentDot3Widget<hud.UIWidget>.AnchorPosition = Vector3{mX3, mY3, 0.0}
                OpponentDot3Widget<hud.UIWidget>.IsVisible = true
            }
        } else {
            if runBotsLocally {
                UpdateSingleBot(OpponentCar3, 3, dt)
            } else {
                if OpponentCar3 != nil && OpponentActive3 {
                    OpponentCar3<Transform>.Position = Vector3{OpponentPos3.X, OpponentPos3.Y - 0.25, OpponentPos3.Z}
                    OpponentCar3<Transform>.Rotation = Vector3{OpponentPitch3, OpponentYaw3, OpponentRoll3}
                    std.SetActive(OpponentCar3 as entity, true)
                }
                if (OpponentDot3Widget as entity) != nil {
                    var mX3 = OpponentPos3.X * MinimapScaleX + MinimapOffsetX
                    var mY3 = OpponentPos3.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot3Widget<hud.UIWidget>.AnchorPosition = Vector3{mX3, mY3, 0.0}
                    OpponentDot3Widget<hud.UIWidget>.IsVisible = true
                }
            }
        }

        // Slot 4
        if OpponentIsHuman4 {
            OpponentIdleTimer4 = OpponentIdleTimer4 + dt
            if OpponentIdleTimer4 > 1.5 {
                OpponentIsHuman4 = false
                OpponentIsRemoteBot4 = false
                if wpCount > 0 {
                    var bestWp4 = 0
                    var bestD2_4 = 999999.0
                    for w4 = 0, wpCount, 1 {
                        var wp4 = WpPositions[w4]
                        var dx4 = wp4.X - OpponentPos4.X
                        var dz4 = wp4.Z - OpponentPos4.Z
                        var d2_4 = dx4 * dx4 + dz4 * dz4
                        if d2_4 < bestD2_4 { bestD2_4 = d2_4; bestWp4 = w4 }
                    }
                    OpponentWpIdx4 = (bestWp4 + 1) % wpCount
                }
                OpponentSpeedMs4 = 7.6
            } else {
                if OpponentIdleTimer4 > 0.25 {
                    var decel4 = 3.0 * dt
                    if decel4 > 0.5 { decel4 = 0.5 }
                    OpponentTargetVel4 = Vector3{OpponentTargetVel4.X * (1.0 - decel4), 0.0, OpponentTargetVel4.Z * (1.0 - decel4)}
                }

                var velBlend4 = 12.0 * dt
                if velBlend4 > 0.6 { velBlend4 = 0.6 }
                var curVx4 = OpponentVel4.X + (OpponentTargetVel4.X - OpponentVel4.X) * velBlend4
                var curVz4 = OpponentVel4.Z + (OpponentTargetVel4.Z - OpponentVel4.Z) * velBlend4
                OpponentVel4 = Vector3{curVx4, 0.0, curVz4}

                var oldPy4 = OpponentPos4.Y
                var nPx4 = OpponentPos4.X + curVx4 * dt
                var nPz4 = OpponentPos4.Z + curVz4 * dt

                var corrRate4 = 8.0 * dt
                if corrRate4 > 0.35 { corrRate4 = 0.35 }
                var corrX4 = OpponentErr4.X * corrRate4
                var corrY4 = OpponentErr4.Y * corrRate4
                var corrZ4 = OpponentErr4.Z * corrRate4
                nPx4 = nPx4 + corrX4
                var nPy4 = OpponentPos4.Y + corrY4
                nPz4 = nPz4 + corrZ4
                OpponentErr4 = Vector3{OpponentErr4.X - corrX4, OpponentErr4.Y - corrY4, OpponentErr4.Z - corrZ4}
                OpponentPos4 = Vector3{nPx4, nPy4, nPz4}

                var yawDiff4 = OpponentTargetYaw4 - OpponentYaw4
                while yawDiff4 > 180.0 { yawDiff4 = yawDiff4 - 360.0 }
                while yawDiff4 < -180.0 { yawDiff4 = yawDiff4 + 360.0 }
                var rotBlend4 = 12.0 * dt
                if rotBlend4 > 0.6 { rotBlend4 = 0.6 }
                OpponentYaw4 = OpponentYaw4 + yawDiff4 * rotBlend4

                var vy4 = (nPy4 - oldPy4) / dt
                var hSpd4 = math.Sqrt(curVx4 * curVx4 + curVz4 * curVz4)
                var targetPitch4 = 0.0
                if hSpd4 > 1.0 {
                    targetPitch4 = math.ATan2(vy4, hSpd4)
                    if targetPitch4 > 35.0 { targetPitch4 = 35.0 }
                    if targetPitch4 < -35.0 { targetPitch4 = -35.0 }
                }
                OpponentPitch4 = OpponentPitch4 + (targetPitch4 - OpponentPitch4) * 12.0 * dt
                var targetRoll4 = -yawDiff4 * 0.25
                if targetRoll4 > 25.0 { targetRoll4 = 25.0 }
                if targetRoll4 < -25.0 { targetRoll4 = -25.0 }
                OpponentRoll4 = OpponentRoll4 + (targetRoll4 - OpponentRoll4) * 10.0 * dt

                if OpponentCar4 != nil {
                    std.SetActive(OpponentCar4 as entity, true)
                    OpponentCar4<Transform>.Position = Vector3{OpponentPos4.X, OpponentPos4.Y - 0.25, OpponentPos4.Z}
                    OpponentCar4<Transform>.Rotation = Vector3{OpponentPitch4, OpponentYaw4, OpponentRoll4}
                }
                if (OpponentDot4Widget as entity) != nil {
                    var mX4 = OpponentPos4.X * MinimapScaleX + MinimapOffsetX
                    var mY4 = OpponentPos4.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
                    OpponentDot4Widget<hud.UIWidget>.IsVisible = true
                }
            }
        } else if OpponentIsRemoteBot4 {
            OpponentIdleTimer4 = OpponentIdleTimer4 + dt
            if OpponentIdleTimer4 > 2.5 {
                var decelBot4 = 4.0 * dt
                if decelBot4 > 0.5 { decelBot4 = 0.5 }
                OpponentTargetVel4 = Vector3{0.0, 0.0, 0.0}
                OpponentVel4 = Vector3{OpponentVel4.X * (1.0 - decelBot4), 0.0, OpponentVel4.Z * (1.0 - decelBot4)}
            }
            var velBlend4 = 12.0 * dt
            if velBlend4 > 0.6 { velBlend4 = 0.6 }
            var curVx4 = OpponentVel4.X + (OpponentTargetVel4.X - OpponentVel4.X) * velBlend4
            var curVz4 = OpponentVel4.Z + (OpponentTargetVel4.Z - OpponentVel4.Z) * velBlend4
            OpponentVel4 = Vector3{curVx4, 0.0, curVz4}

            var oldPy4 = OpponentPos4.Y
            var nPx4 = OpponentPos4.X + curVx4 * dt
            var nPz4 = OpponentPos4.Z + curVz4 * dt

            var corrRate4 = 8.0 * dt
            if corrRate4 > 0.35 { corrRate4 = 0.35 }
            var corrX4 = OpponentErr4.X * corrRate4
            var corrY4 = OpponentErr4.Y * corrRate4
            var corrZ4 = OpponentErr4.Z * corrRate4
            nPx4 = nPx4 + corrX4
            var nPy4 = OpponentPos4.Y + corrY4
            nPz4 = nPz4 + corrZ4
            OpponentErr4 = Vector3{OpponentErr4.X - corrX4, OpponentErr4.Y - corrY4, OpponentErr4.Z - corrZ4}
            OpponentPos4 = Vector3{nPx4, nPy4, nPz4}

            var yawDiff4 = OpponentTargetYaw4 - OpponentYaw4
            while yawDiff4 > 180.0 { yawDiff4 = yawDiff4 - 360.0 }
            while yawDiff4 < -180.0 { yawDiff4 = yawDiff4 + 360.0 }
            var rotBlend4 = 12.0 * dt
            if rotBlend4 > 0.6 { rotBlend4 = 0.6 }
            OpponentYaw4 = OpponentYaw4 + yawDiff4 * rotBlend4

            var vy4 = (nPy4 - oldPy4) / dt
            var hSpd4 = math.Sqrt(curVx4 * curVx4 + curVz4 * curVz4)
            var targetPitch4 = 0.0
            if hSpd4 > 1.0 {
                targetPitch4 = math.ATan2(vy4, hSpd4)
                if targetPitch4 > 35.0 { targetPitch4 = 35.0 }
                if targetPitch4 < -35.0 { targetPitch4 = -35.0 }
            }
            OpponentPitch4 = OpponentPitch4 + (targetPitch4 - OpponentPitch4) * 12.0 * dt
            var targetRoll4 = -yawDiff4 * 0.25
            if targetRoll4 > 25.0 { targetRoll4 = 25.0 }
            if targetRoll4 < -25.0 { targetRoll4 = -25.0 }
            OpponentRoll4 = OpponentRoll4 + (targetRoll4 - OpponentRoll4) * 10.0 * dt

            if OpponentCar4 != nil {
                std.SetActive(OpponentCar4 as entity, true)
                OpponentCar4<Transform>.Position = Vector3{OpponentPos4.X, OpponentPos4.Y - 0.25, OpponentPos4.Z}
                OpponentCar4<Transform>.Rotation = Vector3{OpponentPitch4, OpponentYaw4, OpponentRoll4}
            }
            if (OpponentDot4Widget as entity) != nil {
                var mX4 = OpponentPos4.X * MinimapScaleX + MinimapOffsetX
                var mY4 = OpponentPos4.Z * MinimapScaleY + MinimapOffsetY
                OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
                OpponentDot4Widget<hud.UIWidget>.IsVisible = true
            }
        } else {
            if runBotsLocally {
                UpdateSingleBot(OpponentCar4, 4, dt)
            } else {
                if OpponentCar4 != nil && OpponentActive4 {
                    OpponentCar4<Transform>.Position = Vector3{OpponentPos4.X, OpponentPos4.Y - 0.25, OpponentPos4.Z}
                    OpponentCar4<Transform>.Rotation = Vector3{OpponentPitch4, OpponentYaw4, OpponentRoll4}
                    std.SetActive(OpponentCar4 as entity, true)
                }
                if (OpponentDot4Widget as entity) != nil {
                    var mX4 = OpponentPos4.X * MinimapScaleX + MinimapOffsetX
                    var mY4 = OpponentPos4.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
                    OpponentDot4Widget<hud.UIWidget>.IsVisible = true
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // KHÔI PHỤC VỊ TRÍ XE (RESET VỀ VẠCH XUẤT PHÁT)
    // ------------------------------------------------------------------------
    func ResetToStart() {
        if TargetBox == nil {
            TargetBox = EditorGenLib.EResSceneMainScene.VehicleChassis_Box as entity<Entity>
            if TargetBox == nil { return }
        }

        var spawnPos = raceRules.GetRespawnPosition(LastPassedCpIndex, CpPositions, StartPositions)
        var spawnYaw = raceRules.GetRespawnYaw(LastPassedCpIndex, CpPositions, StartYaws)
        var hasSpawn = true

        TargetBox<Transform>.Position = spawnPos
        TargetBox<Transform>.Rotation = Vector3{0.0, spawnYaw, 0.0}
        TargetBox<Collider>.PhysicalLayer = 2
        physics.MovePosition(TargetBox as entity<Rigidbody>, spawnPos)
        if VisualCar != nil {
            VisualCar<Transform>.Position = Vector3{spawnPos.X, spawnPos.Y - 0.25, spawnPos.Z}
            VisualCar<Transform>.Rotation = Vector3{0.0, spawnYaw, 0.0}
        }

        TargetBox<Rigidbody>.Velocity = Vector3{0.0, 0.0, 0.0}
        TargetBox<Rigidbody>.AngularVelocity = Vector3{0.0, 0.0, 0.0}
        physics.Wakeup(TargetBox as entity<Rigidbody>)

        CurrentYaw = spawnYaw
        CurrentPitch = 0.0
        CurrentRoll = 0.0
        CurrentSpeedMs = 0.0
        CurrentSpeedKmh = 0.0
        VisualDriftAngle = 0.0
        VerticalVelocity = 0.0
        IsDrifting = false
        IsBoosting = false
        BrakeTapTimer = 0.0
        DriftStraightTimer = 0.0
        MiniTurboTimer = 0.0
        DriftDuration = 0.0
        PrevIsDrifting = false
        PrevIsGrounded = true
        LastGroundedRgtSlope = 0.0
        LastGroundedFwdSlope = 0.0
        IsFlatSpinning = false
        FlatSpinAngle = 0.0
        IsBarrelRolling = false
        BarrelRollAngle = 0.0
        IsInSlipstream = false
        CurrentNitro = MaxNitro
        WrongWayTimer = 0.0
        IsWrongWayActive = false
        if (WrongWayWidget as entity) != nil {
            WrongWayWidget<hud.UIWidget>.IsVisible = false
        }

        // Reset trạng thái tự lái AFK và tìm lại Waypoint gần nhất phía trước vị trí hồi sinh
        LocalAfkTimer = 0.0
        IsLocalBotTakeover = false
        LocalTakeoverWpIdx = -1
        SteerInput = 0.0

        var wpCountReset = list.Length(WpPositions as List<object>)
        if wpCountReset >= 2 {
            var bestD2 = 999999.0
            var bestW = 0
            for w = 0, wpCountReset, 1 {
                var wpP = WpPositions[w]
                var dX = wpP.X - spawnPos.X
                var dZ = wpP.Z - spawnPos.Z
                var d2 = dX * dX + dZ * dZ
                if d2 < bestD2 { bestD2 = d2; bestW = w }
            }
            var fX = math.Sin(spawnYaw)
            var fZ = math.Cos(spawnYaw)
            var toWpX = WpPositions[bestW].X - spawnPos.X
            var toWpZ = WpPositions[bestW].Z - spawnPos.Z
            if (toWpX * fX + toWpZ * fZ) > 0.0 {
                LocalTakeoverWpIdx = bestW
            } else {
                LocalTakeoverWpIdx = (bestW + 1) % wpCountReset
            }
        }

        if !IsRaceStarted && EnableAIBots {
            CountdownTimer = 3.0
            GoTimer = 0.0
            LastCountdownStep = 4

            var sCount = list.Length(StartPositions as List<object>)
            if sCount > 1 {
                var sp1 = StartPositions[1]
                var sy1 = 180.0
                if list.Length(StartYaws as List<object>) > 1 { sy1 = StartYaws[1] }
                OpponentPos1 = Vector3{sp1.X, sp1.Y + 0.65, sp1.Z}
                OpponentYaw1 = sy1
                OpponentSpeedMs1 = 0.0
                OpponentWpIdx1 = 1
                OpponentLap1 = 1
                if OpponentCar1 != nil {
                    OpponentCar1<Transform>.Position = Vector3{OpponentPos1.X, OpponentPos1.Y - 0.25, OpponentPos1.Z}
                    OpponentCar1<Transform>.Rotation = Vector3{0.0, OpponentYaw1, 0.0}
                }
            }
            if sCount > 2 {
                var sp2 = StartPositions[2]
                var sy2 = 180.0
                if list.Length(StartYaws as List<object>) > 2 { sy2 = StartYaws[2] }
                OpponentPos2 = Vector3{sp2.X, sp2.Y + 0.65, sp2.Z}
                OpponentYaw2 = sy2
                OpponentSpeedMs2 = 0.0
                OpponentWpIdx2 = 1
                OpponentLap2 = 1
                if OpponentCar2 != nil {
                    OpponentCar2<Transform>.Position = Vector3{OpponentPos2.X, OpponentPos2.Y - 0.25, OpponentPos2.Z}
                    OpponentCar2<Transform>.Rotation = Vector3{0.0, OpponentYaw2, 0.0}
                }
            }
            if sCount > 3 {
                var sp3 = StartPositions[3]
                var sy3 = 180.0
                if list.Length(StartYaws as List<object>) > 3 { sy3 = StartYaws[3] }
                OpponentPos3 = Vector3{sp3.X, sp3.Y + 0.65, sp3.Z}
                OpponentYaw3 = sy3
                OpponentSpeedMs3 = 0.0
                OpponentWpIdx3 = 1
                OpponentLap3 = 1
                if OpponentCar3 != nil {
                    OpponentCar3<Transform>.Position = Vector3{OpponentPos3.X, OpponentPos3.Y - 0.25, OpponentPos3.Z}
                    OpponentCar3<Transform>.Rotation = Vector3{0.0, OpponentYaw3, 0.0}
                }
            }
            if sCount > 4 {
                var sp4 = StartPositions[4]
                var sy4 = 180.0
                if list.Length(StartYaws as List<object>) > 4 { sy4 = StartYaws[4] }
                OpponentPos4 = Vector3{sp4.X, sp4.Y + 0.65, sp4.Z}
                OpponentYaw4 = sy4
                OpponentSpeedMs4 = 0.0
                OpponentWpIdx4 = 1
                OpponentLap4 = 1
                if OpponentCar4 != nil {
                    OpponentCar4<Transform>.Position = Vector3{OpponentPos4.X, OpponentPos4.Y - 0.25, OpponentPos4.Z}
                    OpponentCar4<Transform>.Rotation = Vector3{0.0, OpponentYaw4, 0.0}
                }
            }
        }

        var localP = std.GetLocalPlayer()
        if localP != nil {
            localP<vcam>.SyncVehicleState(CurrentYaw, CurrentPitch, 0.0, false, 0.0, false, false)
            localP<vcam>.SnapToTarget()
        }
    }

    // ------------------------------------------------------------------------
    // VÒNG LẶP ĐIỀU KHIỂN CHÍNH (ON UPDATE)
    // ------------------------------------------------------------------------
    event OnUpdate() {
        // Chỉ chạy trên client của người chơi cục bộ
        var localP = std.GetLocalPlayer()
        if (thisEntity as entity<Player>) != localP { return }

        if TargetBox == nil {
            TargetBox = EditorGenLib.EResSceneMainScene.VehicleChassis_Box as entity<Entity>
            if TargetBox == nil { return }
        }

        // Tính Delta Time
        var now = time.GetLocalTimestamp()
        var dtMs = now - LastTimestamp
        LastTimestamp = now
        var dt = 0.033
        if dtMs > 0 && dtMs < 200 { dt = (dtMs as float) / 1000.0 }

        // Định kỳ kiểm tra chuyển giao quyền Host (Host Migration) và quét người chơi thoát phòng
        HostCheckTimer = HostCheckTimer + dt
        if HostCheckTimer >= 0.3 {
            HostCheckTimer = 0.0
            CheckHostMigrationAndTakeover()
        }

        // --------------------------------------------------------------------
        // CHUỖI ĐẾM NGƯỢC XUẤT PHÁT 3 - 2 - 1 - GO! (ASPHALT 8 START COUNTDOWN)
        // --------------------------------------------------------------------
        if !IsRaceStarted {
            CheckHostMigrationAndTakeover()

            if CountdownTimer > 0.0 {
                CountdownTimer = CountdownTimer - dt
                if CountdownTimer <= 0.0 {
                    CountdownTimer = 0.0
                    IsRaceStarted = true
                    GoTimer = 1.0
                    if LastCountdownStep != 0 {
                        LastCountdownStep = 0
                        if (GoSound as entity) != nil { playable.Play(GoSound as entity<Playable>, true) }
                    }
                }
            }
        } else if GoTimer > 0.0 {
            GoTimer = GoTimer - dt
            if GoTimer <= 0.0 {
                GoTimer = 0.0
            }
        }

        // Cập nhật hoạt ảnh và âm thanh đếm ngược
        if !IsRaceStarted {
            if (StartRootWidget as entity) != nil {
                StartRootWidget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                StartRootWidget<hud.UIWidget>.IsVisible = true
            }
            if CountdownTimer > 2.0 {
                // SỐ 3
                if LastCountdownStep != 3 {
                    LastCountdownStep = 3
                    if (CountdownSound as entity) != nil { playable.Play(CountdownSound as entity<Playable>, true) }
                }
                var stepFrac = CountdownTimer - 2.0
                var popScale = 1.0 + stepFrac * 0.35
                if (Count3Widget as entity) != nil {
                    Count3Widget<hud.UIWidget>.IsVisible = true
                    Count3Widget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    Count3Widget<hud.UIWidget>.SizeDelta = Vector2{Count3BaseSize.X * popScale, Count3BaseSize.Y * popScale}
                    Count3Widget<hud.UIWidgetImage>.Alpha = 1.0
                }
                if (Count2Widget as entity) != nil { Count2Widget<hud.UIWidget>.IsVisible = false }
                if (Count1Widget as entity) != nil { Count1Widget<hud.UIWidget>.IsVisible = false }
                if (CountGoWidget as entity) != nil { CountGoWidget<hud.UIWidget>.IsVisible = false }
            } else if CountdownTimer > 1.0 {
                // SỐ 2
                if LastCountdownStep != 2 {
                    LastCountdownStep = 2
                    if (CountdownSound as entity) != nil { playable.Play(CountdownSound as entity<Playable>, true) }
                }
                var stepFrac = CountdownTimer - 1.0
                var popScale = 1.0 + stepFrac * 0.35
                if (Count2Widget as entity) != nil {
                    Count2Widget<hud.UIWidget>.IsVisible = true
                    Count2Widget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    Count2Widget<hud.UIWidget>.SizeDelta = Vector2{Count2BaseSize.X * popScale, Count2BaseSize.Y * popScale}
                    Count2Widget<hud.UIWidgetImage>.Alpha = 1.0
                }
                if (Count3Widget as entity) != nil { Count3Widget<hud.UIWidget>.IsVisible = false }
                if (Count1Widget as entity) != nil { Count1Widget<hud.UIWidget>.IsVisible = false }
                if (CountGoWidget as entity) != nil { CountGoWidget<hud.UIWidget>.IsVisible = false }
            } else if CountdownTimer > 0.0 {
                // SỐ 1
                if LastCountdownStep != 1 {
                    LastCountdownStep = 1
                    if (CountdownSound as entity) != nil { playable.Play(CountdownSound as entity<Playable>, true) }
                }
                var stepFrac = CountdownTimer
                var popScale = 1.0 + stepFrac * 0.35
                if (Count1Widget as entity) != nil {
                    Count1Widget<hud.UIWidget>.IsVisible = true
                    Count1Widget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                    Count1Widget<hud.UIWidget>.SizeDelta = Vector2{Count1BaseSize.X * popScale, Count1BaseSize.Y * popScale}
                    Count1Widget<hud.UIWidgetImage>.Alpha = 1.0
                }
                if (Count3Widget as entity) != nil { Count3Widget<hud.UIWidget>.IsVisible = false }
                if (Count2Widget as entity) != nil { Count2Widget<hud.UIWidget>.IsVisible = false }
                if (CountGoWidget as entity) != nil { CountGoWidget<hud.UIWidget>.IsVisible = false }
            }
        } else if GoTimer > 0.0 {
            // CHỮ "GO!": Phóng to tràn màn hình (1.0x -> 3.5x) và mờ dần biến mất
            var progress = 1.0 - (GoTimer / 1.0)
            if progress < 0.0 { progress = 0.0 }
            if progress > 1.0 { progress = 1.0 }
            var scale = 1.0 + progress * 2.5
            var alpha = GoTimer / 1.0
            if alpha < 0.0 { alpha = 0.0 }
            if alpha > 1.0 { alpha = 1.0 }

            if (StartRootWidget as entity) != nil {
                StartRootWidget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                StartRootWidget<hud.UIWidget>.IsVisible = true
            }
            if (CountGoWidget as entity) != nil {
                CountGoWidget<hud.UIWidget>.IsVisible = true
                CountGoWidget<hud.UIWidget>.AnchorPosition = Vector3{0.0, 0.0, 0.0}
                CountGoWidget<hud.UIWidget>.SizeDelta = Vector2{CountGoBaseSize.X * scale, CountGoBaseSize.Y * scale}
                CountGoWidget<hud.UIWidgetImage>.Alpha = alpha
            }
            if (Count3Widget as entity) != nil { Count3Widget<hud.UIWidget>.IsVisible = false }
            if (Count2Widget as entity) != nil { Count2Widget<hud.UIWidget>.IsVisible = false }
            if (Count1Widget as entity) != nil { Count1Widget<hud.UIWidget>.IsVisible = false }
        } else {
            // Kết thúc đếm ngược, ẩn toàn bộ
            if (CountGoWidget as entity) != nil { CountGoWidget<hud.UIWidget>.IsVisible = false }
            if (Count3Widget as entity) != nil { Count3Widget<hud.UIWidget>.IsVisible = false }
            if (Count2Widget as entity) != nil { Count2Widget<hud.UIWidget>.IsVisible = false }
            if (Count1Widget as entity) != nil { Count1Widget<hud.UIWidget>.IsVisible = false }
            if (StartRootWidget as entity) != nil { StartRootWidget<hud.UIWidget>.IsVisible = false }
        }

        // --------------------------------------------------------------------
        // HỆ THỐNG BÌNH NITRO & HIỂN THỊ (ASPHALT 8 NITRO SYSTEM)
        // --------------------------------------------------------------------
        if IsBoosting {
            if CurrentNitro > 0.0 {
                CurrentNitro = CurrentNitro - NitroDrainRate * dt
                if CurrentNitro <= 0.0 {
                    CurrentNitro = 0.0
                    IsBoosting = false
                }
            } else {
                IsBoosting = false
            }
        } else {
            if IsDrifting {
                CurrentNitro = CurrentNitro + NitroDriftChargeRate * dt
            } else if CurrentSpeedKmh > 50.0 {
                CurrentNitro = CurrentNitro + NitroPassiveChargeRate * dt
            }
            if CurrentNitro > MaxNitro { CurrentNitro = MaxNitro }
        }

        var nitroRatio = CurrentNitro / MaxNitro
        if nitroRatio < 0.0 { nitroRatio = 0.0 }
        if nitroRatio > 1.0 { nitroRatio = 1.0 }

        if (NitroBarWidget as entity) != nil {
            NitroBarWidget<hud.UIWidgetImage>.FillAmount = nitroRatio
        }
        if (NitroGlowHeadWidget as entity) != nil {
            var headX = -237.0 + nitroRatio * 450.0
            NitroGlowHeadWidget<hud.UIWidget>.AnchorPosition = Vector3{headX, -11.5, 0.0}
        }

        // Đếm lùi bộ đệm nhấp phanh (Tap-to-drift buffer window)
        if BrakeTapTimer > 0.0 {
            BrakeTapTimer = BrakeTapTimer - dt
            if BrakeTapTimer < 0.0 { BrakeTapTimer = 0.0 }
        }

        // Đếm lùi xung lực Mini-Turbo
        if MiniTurboTimer > 0.0 {
            MiniTurboTimer = MiniTurboTimer - dt
            if MiniTurboTimer < 0.0 { MiniTurboTimer = 0.0 }
        }

        // Đếm lùi chốt chặn hồi chiêu rung camera va chạm (Asphalt 8 CrashCamSnapTimer)
        if WallImpactCooldown > 0.0 {
            WallImpactCooldown = WallImpactCooldown - dt
            if WallImpactCooldown < 0.0 { WallImpactCooldown = 0.0 }
        }

        // 2. KÍCH HOẠT / HỦY CHẾ ĐỘ DRIFT (CHỈ HOẠT ĐỘNG KHI ĐANG BÁM ĐƯỜNG)
        var isCarGrounded = PrevIsGrounded
        var hasTurnInput = IsTurningLeft || IsTurningRight || (IsLocalBotTakeover && math.Abs(SteerInput) > 0.15)

        if isCarGrounded {
            if !IsDrifting {
                // Vào Drift khi: Có lệnh phanh (nhấn hoặc nhấp trong 0.4s) VÀ có bẻ lái VÀ tốc độ > 25 km/h VÀ đang chạm đất
                if (IsBraking || BrakeTapTimer > 0.0) && hasTurnInput && CurrentSpeedKmh > 25.0 {
                    IsDrifting = true
                    DriftStraightTimer = 0.0
                    DriftDuration = 0.0
                }
            } else {
                // Khi đang Drift: tích lũy thời lượng drift
                DriftDuration = DriftDuration + dt

                // Nếu xe chạy thẳng (buông lái), bắt đầu đếm thời gian thoát drift
                if !hasTurnInput {
                    DriftStraightTimer = DriftStraightTimer + dt
                } else {
                    DriftStraightTimer = 0.0
                }

                // Thoát Drift:
                // 1) Bấm Nitro (Boost) bứt tốc thoát cua
                // 2) Hoặc chạy thẳng liên tục quá 0.35s (hết góc cua)
                // 3) Hoặc xe đã dừng lại / đi lùi (CurrentSpeedMs <= 0.1)
                if IsBoosting || DriftStraightTimer > 0.35 || CurrentSpeedMs <= 0.1 {
                    IsDrifting = false
                    DriftStraightTimer = 0.0
                }
            }
        } else {
            // ĐANG LƠ LỬNG TRÊN KHÔNG: TUYỆT ĐỐI CẤM KÍCH HOẠT HOẶC DUY TRÌ DRIFT MẶT ĐẤT
            IsDrifting = false
            DriftStraightTimer = 0.0
            DriftDuration = 0.0
        }

        // Bắt sự kiện thoát Drift -> Kích hoạt Mini-Turbo Boost (0.35s)
        if PrevIsDrifting && !IsDrifting {
            if DriftDuration >= 0.40 {
                MiniTurboTimer = 0.35
                CurrentNitro = CurrentNitro + 6.0
                if CurrentNitro > MaxNitro { CurrentNitro = MaxNitro }
            }
            DriftDuration = 0.0
        }
        PrevIsDrifting = IsDrifting

        // 3. TÍNH TOÁN VẬN TỐC MỤC TIÊU & GIA TỐC (ASPHALT 8 SPEED & ACCELERATION)
        var targetSpeedMs = 0.0

        if !IsRaceStarted {
            // ĐANG ĐẾM NGƯỢC XUẤT PHÁT: KHÓA GA, TRIỆT TIÊU VẬN TỐC, CẤM BOOST/DRIFT
            targetSpeedMs = 0.0
            CurrentSpeedMs = 0.0
            VerticalVelocity = 0.0
            IsBoosting = false
            IsDrifting = false
        } else if !isCarGrounded {
            // --- KHI ĐANG LƠ LỬNG TRÊN KHÔNG (ASPHALT 8 BALLISTIC AIRBORNE FLIGHT) ---
            // 1. Phanh trên không: KHÔNG DỪNG XE, KHÔNG ĐI LÙI, chỉ ngắt Nitro nếu đang xịt
            if IsBraking {
                IsBoosting = false
            }

            // 2. Tự động nạp năng lượng Nitro khi bay (Asphalt 8 Air Time Jump Gain)
            if !IsBoosting {
                CurrentNitro = CurrentNitro + 16.0 * dt
                if CurrentNitro > MaxNitro { CurrentNitro = MaxNitro }
            }

            // 3. Bảo toàn vận tốc quán tính bay theo đường đạn (Ballistic Forward Velocity)
            if IsBoosting {
                // Đang xịt Nitro trên không: luồng phụt phản lực đẩy tăng tốc bay
                var airBoostTopMs = BoostSpeedKmh / 3.6
                if CurrentSpeedMs < airBoostTopMs {
                    CurrentSpeedMs = CurrentSpeedMs + 14.0 * dt
                    if CurrentSpeedMs > airBoostTopMs { CurrentSpeedMs = airBoostTopMs }
                }
            } else {
                // Bay tự do theo quán tính: bảo toàn tốc độ, lực cản không khí nhẹ
                if CurrentSpeedMs > 0.0 {
                    CurrentSpeedMs = CurrentSpeedMs - 0.35 * dt
                    if CurrentSpeedMs < 0.0 { CurrentSpeedMs = 0.0 }
                } else if CurrentSpeedMs < 0.0 {
                    CurrentSpeedMs = CurrentSpeedMs + 1.5 * dt
                    if CurrentSpeedMs > 0.0 { CurrentSpeedMs = 0.0 }
                }
            }
        } else {
            // --- KHI ĐANG CHẠM ĐẤT (GROUND DRIVING) ---
            if IsBraking || IsReversing {
                // Phanh dứt khoát và đi lùi CHỈ hoạt động khi 4 bánh đang chạm mặt đường
                if CurrentSpeedMs > 0.2 {
                    targetSpeedMs = 0.0
                    CurrentSpeedMs = CurrentSpeedMs - BrakeRate * dt
                    if CurrentSpeedMs < 0.0 { CurrentSpeedMs = 0.0 }
                } else {
                    IsFrontBlocked = false // Người chơi chủ động lùi xe -> mở khóa chặn
                    var maxRevMs = -(ReverseSpeedKmh / 3.6)
                    targetSpeedMs = maxRevMs
                    CurrentSpeedMs = CurrentSpeedMs - 12.0 * dt
                    if CurrentSpeedMs < maxRevMs { CurrentSpeedMs = maxRevMs }
                }
            } else if IsFrontBlocked {
                // ĐANG CẮM ĐẦU TRỰC DIỆN VÀO TƯỜNG CHẮN (ASPHALT 8 HEAD-ON STALL):
                // Triệt tiêu hoàn toàn ga tiến tự động, xe nằm yên sát vách tường.
                // Chỉ cho phép lăn bánh khi người chơi de lùi hoặc bẻ lái quay đầu xe ra ngoài!
                targetSpeedMs = 0.0
                CurrentSpeedMs = 0.0
                IsBoosting = false
            } else if IsBoosting {
                MiniTurboTimer = 0.0
                targetSpeedMs = BoostSpeedKmh / 3.6
                if CurrentSpeedMs < targetSpeedMs {
                    CurrentSpeedMs = CurrentSpeedMs + BoostAccelRate * dt
                    if CurrentSpeedMs > targetSpeedMs { CurrentSpeedMs = targetSpeedMs }
                }
            } else if MiniTurboTimer > 0.0 {
                var turboTopMs = (TopSpeedKmh + 18.0) / 3.6
                targetSpeedMs = turboTopMs
                if CurrentSpeedMs < targetSpeedMs {
                    CurrentSpeedMs = CurrentSpeedMs + 35.0 * dt
                    if CurrentSpeedMs > targetSpeedMs { CurrentSpeedMs = targetSpeedMs }
                }
            } else if IsDrifting {
                var driftTopMs = (TopSpeedKmh * 0.82) / 3.6
                targetSpeedMs = driftTopMs
                if CurrentSpeedMs > targetSpeedMs {
                    CurrentSpeedMs = CurrentSpeedMs - DriftDecelRate * dt
                    if CurrentSpeedMs < targetSpeedMs { CurrentSpeedMs = targetSpeedMs }
                } else if CurrentSpeedMs < targetSpeedMs {
                    CurrentSpeedMs = CurrentSpeedMs + AccelRate * dt
                    if CurrentSpeedMs > targetSpeedMs { CurrentSpeedMs = targetSpeedMs }
                }
            } else {
                var normalTopKmh = TopSpeedKmh
                    var normalAccel = AccelRate
                    if IsInSlipstream {
                        normalTopKmh = TopSpeedKmh * 1.07
                        normalAccel = 18.0
                    }
                    targetSpeedMs = normalTopKmh / 3.6

                    if CurrentSpeedMs < 0.0 {
                        CurrentSpeedMs = CurrentSpeedMs + BrakeRate * dt
                        if CurrentSpeedMs > 0.0 { CurrentSpeedMs = 0.0 }
                    } else if CurrentSpeedMs < targetSpeedMs {
                        CurrentSpeedMs = CurrentSpeedMs + normalAccel * dt
                        if CurrentSpeedMs > targetSpeedMs { CurrentSpeedMs = targetSpeedMs }
                    } else if CurrentSpeedMs > targetSpeedMs {
                        CurrentSpeedMs = CurrentSpeedMs - CoastDecelRate * dt
                        if CurrentSpeedMs < targetSpeedMs { CurrentSpeedMs = targetSpeedMs }
                    }

                    // Hỗ trợ lực kéo leo dốc (Asphalt 8 Ramp Climb Assist): bù ga khi lên dốc gắt, đảm bảo tối thiểu ~85 km/h
                    if CurrentSpeedMs > 0.0 && LastGroundedFwdSlope > 0.04 {
                        var minClimbMs = 23.6 // ~85 km/h
                        if CurrentSpeedMs < minClimbMs {
                            CurrentSpeedMs = CurrentSpeedMs + 30.0 * dt
                            if CurrentSpeedMs > minClimbMs { CurrentSpeedMs = minClimbMs }
                        }
                    }
                }
            }

        CurrentSpeedKmh = CurrentSpeedMs * 3.6

        // NHẬN DIỆN VÀ TIẾP QUẢN TỰ LÁI KHI NGƯỜI CHƠI AFK (LOCAL AFK TAKEOVER)
        if IsRaceStarted && !IsRaceFinished {
            if !IsTurningLeft && !IsTurningRight && !IsBraking && !IsBoosting && !IsReversing {
                LocalAfkTimer = LocalAfkTimer + dt
                if LocalAfkTimer > 5.0 {
                    IsLocalBotTakeover = true
                }
            } else {
                LocalAfkTimer = 0.0
                IsLocalBotTakeover = false
            }
        } else {
            LocalAfkTimer = 0.0
            IsLocalBotTakeover = false
        }

        // 4. TÍNH TOÁN GÓC BẺ LÁI & HƯỚNG QUỸ ĐẠO (STEERING YAW & AIR LEAN)
        var targetSteer = 0.0
        if IsTurningLeft  { targetSteer = targetSteer - 1.0 }
        if IsTurningRight { targetSteer = targetSteer + 1.0 }

        if IsLocalBotTakeover {
            var wpCountTakeover = list.Length(WpPositions as List<object>)
            if wpCountTakeover >= 2 {
                var cPos = TargetBox<Transform>.Position

                // Khi mới bắt đầu Takeover HOẶC khi cự ly tới waypoint hiện tại quá xa (> 25m do respawn/va chạm):
                // Tìm lại Waypoint hợp lệ gần nhất ngay phía trước hướng mũi xe
                var needFindWp = (LocalTakeoverWpIdx < 0) || (LocalTakeoverWpIdx >= wpCountTakeover)
                if !needFindWp {
                    var curWpP = WpPositions[LocalTakeoverWpIdx]
                    var cWpDx = curWpP.X - cPos.X
                    var cWpDz = curWpP.Z - cPos.Z
                    if (cWpDx * cWpDx + cWpDz * cWpDz) > 625.0 {
                        needFindWp = true
                    }
                }

                if needFindWp {
                    var bestD2 = 999999.0
                    var bestW = 0
                    for w = 0, wpCountTakeover, 1 {
                        var wpP = WpPositions[w]
                        var dX = wpP.X - cPos.X
                        var dZ = wpP.Z - cPos.Z
                        var d2 = dX * dX + dZ * dZ
                        if d2 < bestD2 { bestD2 = d2; bestW = w }
                    }
                    var fX = math.Sin(CurrentYaw)
                    var fZ = math.Cos(CurrentYaw)
                    var toWpX = WpPositions[bestW].X - cPos.X
                    var toWpZ = WpPositions[bestW].Z - cPos.Z
                    if (toWpX * fX + toWpZ * fZ) > 0.0 {
                        LocalTakeoverWpIdx = bestW
                    } else {
                        LocalTakeoverWpIdx = (bestW + 1) % wpCountTakeover
                    }
                }

                var tWp = WpPositions[LocalTakeoverWpIdx]
                var tDx = tWp.X - cPos.X
                var tDz = tWp.Z - cPos.Z
                var distSq = tDx * tDx + tDz * tDz

                var nextWpIdx = (LocalTakeoverWpIdx + 1) % wpCountTakeover
                var nextWp = WpPositions[nextWpIdx]
                var segX = nextWp.X - tWp.X
                var segZ = nextWp.Z - tWp.Z
                var pastX = cPos.X - tWp.X
                var pastZ = cPos.Z - tWp.Z

                // Ngưỡng phát hiện đã đi qua Waypoint (thích ứng 5m hoặc 25m)
                var arrivalDistSq = 36.0
                var passDistSq = 100.0
                if wpCountTakeover <= 80 {
                    arrivalDistSq = 324.0
                    passDistSq = 625.0
                }
                var isPassedFwd = (distSq < passDistSq) && ((pastX * segX + pastZ * segZ) > 0.0)

                if distSq < arrivalDistSq || isPassedFwd {
                    LocalTakeoverWpIdx = nextWpIdx
                    tWp = WpPositions[LocalTakeoverWpIdx]
                    tDx = tWp.X - cPos.X
                    tDz = tWp.Z - cPos.Z
                }

                // Cự ly ngắm lái thích ứng tốc độ chuẩn Asphalt 8 (20m - 26m theo khoảng cách thực tế)
                var targetLookDist = 20.0
                if CurrentSpeedKmh > 100.0 {
                    targetLookDist = 26.0
                }
                var targetLookDistSq = targetLookDist * targetLookDist

                // Quét tìm Waypoint phía trước có khoảng cách thực tế đạt chuẩn Look-Ahead (không phụ thuộc mật độ waypoint)
                var steerWpIdx = (LocalTakeoverWpIdx + 1) % wpCountTakeover
                var maxScan = 15
                if wpCountTakeover < maxScan { maxScan = wpCountTakeover }
                for s = 1, maxScan, 1 {
                    var cIdx = (LocalTakeoverWpIdx + s) % wpCountTakeover
                    var cWp = WpPositions[cIdx]
                    var cdX = cWp.X - cPos.X
                    var cdZ = cWp.Z - cPos.Z
                    steerWpIdx = cIdx
                    if (cdX * cdX + cdZ * cdZ) >= targetLookDistSq {
                        break
                    }
                }

                var steerWp = WpPositions[steerWpIdx]
                var sDx = steerWp.X - cPos.X
                var sDz = steerWp.Z - cPos.Z

                var desiredYaw = math.ATan2(sDx, sDz)
                var yawDiff = desiredYaw - CurrentYaw
                while yawDiff > 180.0 { yawDiff = yawDiff - 360.0 }
                while yawDiff < -180.0 { yawDiff = yawDiff + 360.0 }

                // Chuẩn hóa góc bẻ lái thuần Asphalt 8 (Ghidra Decompile: clamp(yawDiff / 40.0, -1.0, 1.0))
                var targetSteerVal = yawDiff / 40.0
                if targetSteerVal > 1.0 { targetSteerVal = 1.0 }
                if targetSteerVal < -1.0 { targetSteerVal = -1.0 }
                targetSteer = targetSteerVal

                // Quét tìm 2 điểm mốc trên đường ray: Mốc 1 (~12m) và Mốc 2 (~25m) để đo độ uốn cung đường thực tế
                var midWpIdx = (LocalTakeoverWpIdx + 1) % wpCountTakeover
                var farWpIdx = steerWpIdx
                var midFound = false
                for m = 1, maxScan, 1 {
                    var mIdx = (LocalTakeoverWpIdx + m) % wpCountTakeover
                    var mWp = WpPositions[mIdx]
                    var mdX = mWp.X - cPos.X
                    var mdZ = mWp.Z - cPos.Z
                    if !midFound {
                        midWpIdx = mIdx
                        if (mdX * mdX + mdZ * mdZ) >= 144.0 { // >= 12m
                            midFound = true
                        }
                    }
                }

                // Bảo đảm mốc xa wpFar luôn nằm sau mốc giữa wpMid ít nhất 1 waypoint (chống suy biến vector seg2)
                if farWpIdx == midWpIdx {
                    farWpIdx = (midWpIdx + 1) % wpCountTakeover
                }

                var wpMid = WpPositions[midWpIdx]
                var wpFar = WpPositions[farWpIdx]

                var seg1X = wpMid.X - tWp.X
                var seg1Z = wpMid.Z - tWp.Z
                var seg2X = wpFar.X - wpMid.X
                var seg2Z = wpFar.Z - wpMid.Z

                var trackYaw1 = math.ATan2(seg1X, seg1Z)
                var trackYaw2 = math.ATan2(seg2X, seg2Z)
                var trackCurveAngle = trackYaw2 - trackYaw1
                while trackCurveAngle > 180.0 { trackCurveAngle = trackCurveAngle - 360.0 }
                while trackCurveAngle < -180.0 { trackCurveAngle = trackCurveAngle + 360.0 }
                var roadCurvature = math.Abs(trackCurveAngle)

                // Góc lệch giữa hướng tiếp tuyến đường đua và hướng mũi xe hiện tại
                var alignDiff = trackYaw1 - CurrentYaw
                while alignDiff > 180.0 { alignDiff = alignDiff - 360.0 }
                while alignDiff < -180.0 { alignDiff = alignDiff + 360.0 }
                var headingMisalign = math.Abs(alignDiff)

                // Chống cạ tường: Nếu xe đang bị kẹt vách tường (IsFrontBlocked), mở khóa để xe bẻ lái thoát ra
                if IsFrontBlocked {
                    IsFrontBlocked = false
                }

                // CƠ CHẾ DRIFT CHUẨN ASPHALT 8 (CHỈ KÍCH HOẠT KHI ĐƯỜNG ĐUA THỰC SỰ UỐN CONG):
                // 1. Chỉ vào Drift khi: Đoạn đường phía trước uốn cong thật sự (roadCurvature > 18°)
                //    VÀ xe đang có góc bẻ lái vào cua (headingMisalign > 14°)
                //    VÀ xe đang chạy tốc độ cao (> 35 km/h) trên mặt đất.
                // 2. Thoát Drift dứt khoát khi:
                //    - Đoạn đường đã duỗi thẳng (roadCurvature < 8° hoặc roadCurvature < 12° và headingMisalign < 8°)
                //    - Hoặc xe bị tụt tốc độ chậm (< 30 km/h) mất trớn drift
                //    - Hoặc xe rời khỏi mặt đất (bay lên không)
                // 3. Trên đường thẳng (roadCurvature ≈ 0°): Drift TUYỆT ĐỐI KHÔNG BAO GIỜ BỊ KÍCH HOẠT NHẦM!
                if isCarGrounded {
                    if CurrentSpeedKmh < 30.0 {
                        if IsDrifting {
                            IsDrifting = false
                            DriftStraightTimer = 0.0
                        }
                    } else if roadCurvature > 18.0 && headingMisalign > 14.0 {
                        if !IsDrifting {
                            IsDrifting = true
                            DriftStraightTimer = 0.0
                            DriftDuration = 0.0
                        }
                    } else if roadCurvature < 8.0 || (roadCurvature < 12.0 && headingMisalign < 8.0) {
                        if IsDrifting {
                            IsDrifting = false
                            DriftStraightTimer = 0.0
                        }
                    }
                } else {
                    IsDrifting = false
                }
            }
        }

        // Nội suy mượt vô lăng (Lerp Factor)
        var steerLerp = 10.0 * dt
        if IsDrifting { steerLerp = 18.0 * dt }
        if steerLerp > 1.0 { steerLerp = 1.0 }
        SteerInput = SteerInput + (targetSteer - SteerInput) * steerLerp

        if isCarGrounded {
            if !IsFrontBlocked {
                // Khi đang chạm đất bình thường: bẻ lái xoay góc Yaw hướng đi bình thường
                var activeTurnSpeed = SteerTurnSpeed
                if IsDrifting || (IsBraking && hasTurnInput) { activeTurnSpeed = DriftTurnSpeed }

                var absSpd = CurrentSpeedMs
                if absSpd < 0.0 { absSpd = -absSpd }

                // Độ nhạy lái thích ứng tốc độ chuẩn Asphalt 8 (Speed-Sensitive Steering Rate):
                // Khi dừng xe hoặc đi chậm (< 36 km/h) HOẶC khi đang DRIFT: độ nhạy lái đạt tối đa (turnFactor = 1.0) để ôm cua thoát cua tức thì!
                // Khi chạy tốc độ cao không drift: giảm dần độ nhạy lái để xe đầm chắc trên đường thẳng
                var baseTopMs = TopSpeedKmh / 3.6
                var turnFactor = 1.0
                if !IsDrifting && absSpd > 10.0 {
                    var highSpdFactor = (absSpd - 10.0) / (baseTopMs - 10.0)
                    if highSpdFactor > 1.0 { highSpdFactor = 1.0 }
                    turnFactor = 1.0 - (highSpdFactor * 0.35)
                }

                // Đi lùi: đảo chiều vô lăng theo chuẩn xe hơi
                if CurrentSpeedMs < -0.1 {
                    turnFactor = -turnFactor
                }

                CurrentYaw = CurrentYaw + SteerInput * activeTurnSpeed * turnFactor * dt
                while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
                while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }
            }
        } else {
            // ĐANG LƠ LỬNG TRÊN KHÔNG: Uốn nhẹ góc bay (Asphalt 8 In-Air Yaw Steering: 25 deg/s)
            // Giúp xe uốn lượn chuyển hướng bay mềm mại trên không mà không bị quay ngoắt giật cục
            var airTurnSpeed = 25.0
            CurrentYaw = CurrentYaw + SteerInput * airTurnSpeed * dt
            while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
            while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }
        }

        // 5. GÓC NGHIÊNG THÂN XE VISUAL DRIFT & HÒA NHẬP TỰ NHIÊN KHI DỪNG / LÙI
        var targetVisualDrift = 0.0
        if isCarGrounded && (IsDrifting || (IsBraking && hasTurnInput)) && CurrentSpeedMs > 2.0 {
            // Trượt vểnh đuôi theo hướng bẻ lái (drift 1 góc tối đa 22°): rẽ trái góc dương, rẽ phải góc âm
            targetVisualDrift = SteerInput * 22.0
        }
        var driftLerp = 8.0 * dt
        if driftLerp > 1.0 { driftLerp = 1.0 }
        VisualDriftAngle = VisualDriftAngle + (targetVisualDrift - VisualDriftAngle) * driftLerp

        // Chuyển giao êm ái góc trượt vào CurrentYaw khi xe giảm tốc về 0 hoặc lùi (chống giật bẻ góc)
        if CurrentSpeedMs <= 0.5 && math.Abs(VisualDriftAngle) > 0.02 {
            var blendStep = VisualDriftAngle * 10.0 * dt
            CurrentYaw = CurrentYaw + blendStep
            VisualDriftAngle = VisualDriftAngle - blendStep
            while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
            while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }
        }
        if CurrentSpeedMs <= 0.05 && CurrentSpeedMs >= -0.05 {
            CurrentYaw = CurrentYaw + VisualDriftAngle
            VisualDriftAngle = 0.0
            while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
            while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }
        }

        // 6. ÁP ĐẶT HƯỚNG DI CHUYỂN
        var fwdX = math.Sin(CurrentYaw)
        var fwdZ = math.Cos(CurrentYaw)
        var rgtX = math.Cos(CurrentYaw)
        var rgtZ = -math.Sin(CurrentYaw)

        // Tính cự ly di chuyển khung hình này
        var frameMoveDist = CurrentSpeedMs * dt
        var curPos = TargetBox<Transform>.Position

        // 7. BẮN TIA CHỐNG XUYÊN TƯỜNG & BẺ HƯỚNG XE (WALL DEFLECTION & STEERING ALIGNMENT)
        var hitWall = false
        var wallNorm = Vector3{0.0, 0.0, 0.0}
        var wallMask = List<int>{0}
        var probeY = curPos.Y + 0.25

        // =========================================================================
        // XỬ LÝ TRẠNG THÁI KẸT MŨI VÀO TƯỜNG (ASPHALT 8 LOCKED NOSE PIVOT)
        // Khi bị kẹt: đầu xe cố định tại tường, đuôi xe xoay quanh tâm mũi khi giữ phím lái.
        // Luôn hoạt động độc lập, không phụ thuộc kết quả raycast từng khung hình -> Triệt tiêu 100% bug đơ vô lăng!
        // =========================================================================
        if isCarGrounded && IsFrontBlocked {
            CurrentSpeedMs = 0.0
            frameMoveDist = 0.0
            IsBoosting = false

            if math.Abs(SteerInput) > 0.05 {
                var noseX = curPos.X + fwdX * 1.6
                var noseZ = curPos.Z + fwdZ * 1.6

                // Tốc độ xoay tâm đầu xe: 26°/s (độ đầm chuẩn Asphalt 8, xoay thoát kẹt dứt khoát ~1.2s)
                var pivotTurnRate = 26.0
                var deltaYaw = SteerInput * pivotTurnRate * dt
                CurrentYaw = CurrentYaw + deltaYaw
                while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
                while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }

                fwdX = math.Sin(CurrentYaw)
                fwdZ = math.Cos(CurrentYaw)
                rgtX = math.Cos(CurrentYaw)
                rgtZ = -math.Sin(CurrentYaw)

                // Cố định tâm mũi xe tại vị trí tiếp xúc mặt tường
                curPos.X = noseX - fwdX * 1.6
                curPos.Z = noseZ - fwdZ * 1.6

                // Kiểm tra góc mở với pháp tuyến tường đã lưu
                var unblockDot = fwdX * BlockedWallNx + fwdZ * BlockedWallNz
                if unblockDot >= -0.78 {
                    // ĐÃ ĐẠT GÓC TRẦN CẠ TƯỜNG (mở góc ~39° với mép tường, đã quay ~51° so với góc đâm ban đầu):
                    // Thoát kẹt và bắt đầu lăn bánh nhẹ nhàng
                    IsFrontBlocked = false
                    CurrentSpeedMs = 2.0
                    frameMoveDist = CurrentSpeedMs * dt

                    // Lực đẩy tách tường nhẹ
                    curPos.X = curPos.X + BlockedWallNx * 0.15
                    curPos.Z = curPos.Z + BlockedWallNz * 0.15
                }
            }
        }

        // Nhánh 7A: Quét 3 tia đuôi xe khi de lùi chống xuyên tường sau (Rear Wall Collision)
        if CurrentSpeedMs < 0.0 {
            var rearDist = math.Abs(frameMoveDist) + 0.40
            if rearDist < 0.50 { rearDist = 0.50 }
            var rearDir = Vector3{-fwdX, 0.0, -fwdZ}

            var rearCenter = Vector3{curPos.X - fwdX * 1.5, probeY, curPos.Z - fwdZ * 1.5}
            var rearLeft   = Vector3{curPos.X - fwdX * 1.3 - rgtX * 0.80, probeY, curPos.Z - fwdZ * 1.3 - rgtZ * 0.80}
            var rearRight  = Vector3{curPos.X - fwdX * 1.3 + rgtX * 0.80, probeY, curPos.Z - fwdZ * 1.3 + rgtZ * 0.80}

            physics.SingleRaycast(rearCenter, rearDir, rearDist, wallMask, false, out var rcEnt, out var rcPos, out var rcDist, out var rcNorm)
            physics.SingleRaycast(rearLeft, rearDir, rearDist, wallMask, false, out var rlEnt, out var rlPos, out var rlDist, out var rlNorm)
            physics.SingleRaycast(rearRight, rearDir, rearDist, wallMask, false, out var rrEnt, out var rrPos, out var rrDist, out var rrNorm)

            if rcEnt != nil && rcEnt != TargetBox && rcNorm.Y < 0.65 {
                CurrentSpeedMs = 0.0
                frameMoveDist = 0.0
            } else if rlEnt != nil && rlEnt != TargetBox && rlNorm.Y < 0.65 {
                CurrentSpeedMs = 0.0
                frameMoveDist = 0.0
            } else if rrEnt != nil && rrEnt != TargetBox && rrNorm.Y < 0.65 {
                CurrentSpeedMs = 0.0
                frameMoveDist = 0.0
            }
        }

        // Nhánh 7B: Quét 5 tia phía trước và hai sườn (Front & Side Wall Collision)
        if CurrentSpeedMs > 0.0 || IsFrontBlocked {
            var castDist = frameMoveDist + 1.45
            if castDist < 1.50 { castDist = 1.50 }
            var fwdDir = Vector3{fwdX, 0.0, fwdZ}

            // Quét 5 tia: Mũi giữa, Mũi trái chếch 20°, Mũi phải chếch 20°, Sườn trái, Sườn phải
            var leftAngX = fwdX * 0.94 - rgtX * 0.34
            var leftAngZ = fwdZ * 0.94 - rgtZ * 0.34
            var rightAngX = fwdX * 0.94 + rgtX * 0.34
            var rightAngZ = fwdZ * 0.94 + rgtZ * 0.34

            var centerStart    = Vector3{curPos.X + fwdX * 0.6, probeY, curPos.Z + fwdZ * 0.6}
            var leftStart      = Vector3{curPos.X + fwdX * 0.6 - rgtX * 0.65, probeY, curPos.Z + fwdZ * 0.6 - rgtZ * 0.65}
            var rightStart     = Vector3{curPos.X + fwdX * 0.6 + rgtX * 0.65, probeY, curPos.Z + fwdZ * 0.6 + rgtZ * 0.65}
            var sideLeftStart  = Vector3{curPos.X - rgtX * 0.60, probeY, curPos.Z - rgtZ * 0.60}
            var sideRightStart = Vector3{curPos.X + rgtX * 0.60, probeY, curPos.Z + rgtZ * 0.60}

            physics.SingleRaycast(centerStart, fwdDir, castDist, wallMask, false, out var cEnt, out var cPos, out var cDist, out var cNorm)
            physics.SingleRaycast(leftStart, Vector3{leftAngX, 0.0, leftAngZ}, castDist, wallMask, false, out var lEnt, out var lPos, out var lDist, out var lNorm)
            physics.SingleRaycast(rightStart, Vector3{rightAngX, 0.0, rightAngZ}, castDist, wallMask, false, out var rEnt, out var rPos, out var rDist, out var rNorm)
            physics.SingleRaycast(sideLeftStart, Vector3{-rgtX, 0.0, -rgtZ}, 0.75, wallMask, false, out var slEnt, out var slPos, out var slDist, out var slNorm)
            physics.SingleRaycast(sideRightStart, Vector3{rgtX, 0.0, rgtZ}, 0.75, wallMask, false, out var srEnt, out var srPos, out var srDist, out var srNorm)

            if cEnt != nil && cEnt != TargetBox && cNorm.Y < 0.65 {
                hitWall = true
                wallNorm = cNorm
            } else if lEnt != nil && lEnt != TargetBox && lNorm.Y < 0.65 {
                hitWall = true
                wallNorm = lNorm
            } else if rEnt != nil && rEnt != TargetBox && rNorm.Y < 0.65 {
                hitWall = true
                wallNorm = rNorm
            } else if slEnt != nil && slEnt != TargetBox && slNorm.Y < 0.65 {
                hitWall = true
                wallNorm = slNorm
            } else if srEnt != nil && srEnt != TargetBox && srNorm.Y < 0.65 {
                hitWall = true
                wallNorm = srNorm
            }
        }

        if hitWall {
            var wLen = math.Sqrt(wallNorm.X * wallNorm.X + wallNorm.Z * wallNorm.Z)
            if wLen > 0.001 {
                var nx = wallNorm.X / wLen
                var nz = wallNorm.Z / wLen
                var vDotN = fwdX * nx + fwdZ * nz

                if !isCarGrounded {
                    // =========================================================================
                    // NHÁNH 1: VA CHẠM TƯỜNG TRÊN KHÔNG (ASPHALT 8 AIRBORNE WALL REBOUND)
                    // Xe tuyệt đối không bám trượt tường trên cao mà bị HẤT BẬT NẢY (Deflection) ra xa
                    // =========================================================================
                    if vDotN < 0.0 {
                        // 1. Phản xạ vector vận tốc trên mặt phẳng ngang XZ: R = V - 2 * (V . N) * N
                        var refX = fwdX - 2.0 * vDotN * nx
                        var refZ = fwdZ - 2.0 * vDotN * nz
                        var rLen = math.Sqrt(refX * refX + refZ * refZ)
                        if rLen > 0.001 {
                            refX = refX / rLen
                            refZ = refZ / rLen
                            CurrentYaw = math.ATan2(refX, refZ)
                            while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
                            while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }
                            fwdX = math.Sin(CurrentYaw)
                            fwdZ = math.Cos(CurrentYaw)
                            rgtX = math.Cos(CurrentYaw)
                            rgtZ = -math.Sin(CurrentYaw)
                        }

                        // 2. Đẩy văng dứt khoát ra xa vách tường (0.45m) chống kẹt lún collider
                        curPos.X = curPos.X + nx * 0.45
                        curPos.Z = curPos.Z + nz * 0.45

                        // 3. Triệt tiêu xung lực bốc cao, ép xe rơi tự nhiên xuống đất chống kẹt lơ lửng trên không
                        if VerticalVelocity > 0.0 {
                            VerticalVelocity = -2.0
                        }

                        // 4. Mất đà nảy va chạm: bảo toàn 70% tốc độ, ngắt Nitro
                        CurrentSpeedMs = CurrentSpeedMs * 0.70
                        frameMoveDist = CurrentSpeedMs * dt
                        IsBoosting = false

                        if WallImpactCooldown <= 0.0 && CurrentSpeedMs > 10.0 {
                            WallImpactCooldown = 1.5
                            if localP != nil {
                                localP<vcam>.TriggerWallImpact(wallNorm, 0.35)
                            }
                        }
                    } else {
                        // Đang trôi dạt ra xa mép tường nhưng sườn còn chạm: đẩy nhẹ ra ngoài
                        curPos.X = curPos.X + nx * 0.20
                        curPos.Z = curPos.Z + nz * 0.20
                    }
                } else {
                    // =========================================================================
                    // NHÁNH 2: VA CHẠM TƯỜNG DƯỚI ĐẤT (ASPHALT 8 KINEMATIC WALL COLLISION)
                    // =========================================================================
                    if IsFrontBlocked {
                        // Xe đang trong trạng thái kẹt: liên tục cập nhật pháp tuyến tường mới nhất
                        BlockedWallNx = nx
                        BlockedWallNz = nz
                        CurrentSpeedMs = 0.0
                        frameMoveDist = 0.0
                        IsBoosting = false
                    } else if vDotN < -0.78 {
                        // =====================================================================
                        // ĐÂM TRỰC DIỆN / GÓC GẮT VÀO TƯỜNG (INITIAL WALL IMPACT):
                        // Khóa cứng đầu xe tại điểm va chạm, đuôi xe chỉ bị văng một tí xíu dưới 8 độ!
                        // Camera rung chấn 1 LẦN DUY NHẤT có chốt chặn hồi chiêu (Asphalt 8 CrashCamSnapTimer)!
                        // =====================================================================
                        var preImpactSpeed = CurrentSpeedMs
                        CurrentSpeedMs = 0.0
                        frameMoveDist = 0.0
                        IsBoosting = false
                        IsFrontBlocked = true // Khóa chặt đầu xe tại tường
                        BlockedWallNx = nx
                        BlockedWallNz = nz

                        // Chốt chặn Asphalt 8: Chỉ rung camera khi có tốc độ đâm thực sự (> 10 m/s ~ 36 km/h) và đã qua thời gian hồi chốt chặn
                        if WallImpactCooldown <= 0.0 && preImpactSpeed > 10.0 {
                            WallImpactCooldown = 1.5 // Khóa rung trong 1.5 giây chống giật lặp lại
                            if localP != nil {
                                localP<vcam>.TriggerWallImpact(wallNorm, 0.35)
                            }
                        }

                        // Phân rã tiếp tuyến để xác định hướng văng đuôi xe
                        var slideX = fwdX - vDotN * nx
                        var slideZ = fwdZ - vDotN * nz
                        var sLen = math.Sqrt(slideX * slideX + slideZ * slideZ)
                        if sLen > 0.001 {
                            slideX = slideX / sLen
                            slideZ = slideZ / sLen
                        }
                        var targetWallYaw = math.ATan2(slideX, slideZ)
                        var yawDiff = targetWallYaw - CurrentYaw
                        while yawDiff > 180.0 { yawDiff = yawDiff - 360.0 }
                        while yawDiff < -180.0 { yawDiff = yawDiff - 360.0 }

                        // Bẻ đuôi qua dưới 8 độ (chuẩn 6.5 độ) theo quán tính nảy va chạm ban đầu
                        var kickAngle = 6.5
                        if yawDiff < 0.0 { kickAngle = -6.5 }
                        if math.Abs(yawDiff) < 6.5 { kickAngle = yawDiff }
                        CurrentYaw = CurrentYaw + kickAngle
                        while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
                        while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }

                        fwdX = math.Sin(CurrentYaw)
                        fwdZ = math.Cos(CurrentYaw)
                        rgtX = math.Cos(CurrentYaw)
                        rgtZ = -math.Sin(CurrentYaw)
                    } else if vDotN < -0.01 {
                        // =====================================================================
                        // CẠ SƯỜN LƯỚT TIẾP TUYẾN DỌC THEO BỜ TƯỜNG (ASPHALT 8 WALL-RIDE GLIDE):
                        // Chỉ kích hoạt khi xe đang chạy đua và chạm sườn ở góc nông (không phải đâm trực diện)
                        // =====================================================================
                        IsFrontBlocked = false

                        var slideX = fwdX - vDotN * nx
                        var slideZ = fwdZ - vDotN * nz
                        var sLen = math.Sqrt(slideX * slideX + slideZ * slideZ)
                        if sLen > 0.001 {
                            slideX = slideX / sLen
                            slideZ = slideZ / sLen
                        }

                        var targetWallYaw = math.ATan2(slideX, slideZ)
                        var yawDiff = targetWallYaw - CurrentYaw
                        while yawDiff > 180.0 { yawDiff = yawDiff - 360.0 }
                        while yawDiff < -180.0 { yawDiff = yawDiff + 360.0 }

                        var steerRate = 20.0 * dt
                        if steerRate > 0.80 { steerRate = 0.80 }
                        CurrentYaw = CurrentYaw + yawDiff * steerRate
                        while CurrentYaw > 180.0 { CurrentYaw = CurrentYaw - 360.0 }
                        while CurrentYaw < -180.0 { CurrentYaw = CurrentYaw + 360.0 }

                        fwdX = math.Sin(CurrentYaw)
                        fwdZ = math.Cos(CurrentYaw)
                        rgtX = math.Cos(CurrentYaw)
                        rgtZ = -math.Sin(CurrentYaw)

                        // Bảo toàn 96% tốc độ lướt tường
                        CurrentSpeedMs = CurrentSpeedMs * 0.96
                        frameMoveDist = CurrentSpeedMs * dt
                    } else {
                        // vDotN >= -0.01: Xe đang song song hoặc tách khỏi tường
                    }
                }
            }
        } else {
            // Không trúng tường nào phía trước khung hình này
            if IsFrontBlocked {
                var dotBlocked = fwdX * BlockedWallNx + fwdZ * BlockedWallNz
                if dotBlocked >= -0.78 || CurrentSpeedMs > 0.5 {
                    IsFrontBlocked = false
                }
            }
        }

        // Quét hút đuôi gió đối thủ phía trước (Slipstream / Drafting cự ly <= 30m, góc <= 25 độ)
        IsInSlipstream = false
        if CurrentSpeedKmh >= 50.0 {
            for k = 1, 5, 1 {
                var isActiveOpp = false
                var oppP = OpponentPos1
                if k == 1 {
                    isActiveOpp = EnableAIBots || OpponentActive1
                    oppP = OpponentPos1
                } else if k == 2 {
                    isActiveOpp = EnableAIBots || OpponentActive2
                    oppP = OpponentPos2
                } else if k == 3 {
                    isActiveOpp = EnableAIBots || OpponentActive3
                    oppP = OpponentPos3
                } else if k == 4 {
                    isActiveOpp = EnableAIBots || OpponentActive4
                    oppP = OpponentPos4
                }

                if isActiveOpp {
                    var dx = oppP.X - curPos.X
                    var dy = oppP.Y - curPos.Y
                    var dz = oppP.Z - curPos.Z
                    var d2 = dx * dx + dy * dy + dz * dz
                    if d2 < 900.0 && d2 > 4.0 && math.Abs(dy) < 4.0 {
                        var dist = math.Sqrt(d2)
                        var dotFwd = (fwdX * dx + fwdZ * dz) / dist
                        if dotFwd > 0.90 {
                            IsInSlipstream = true
                        }
                    }
                }
            }
        }

        // Nạp Nitro khi núp gió (+15 điểm/s) nếu không đang xịt nitro
        if IsInSlipstream && !IsBoosting {
            CurrentNitro = CurrentNitro + 15.0 * dt
            if CurrentNitro > MaxNitro { CurrentNitro = MaxNitro }
        }

        // 8. TÍNH TOÁN VỊ TRÍ ĐÍCH TRÊN MẶT PHẲNG NGANG (X, Z)
        // Khi bay trên không: bổ sung lực tạt ngang theo phím lái (Asphalt 8 Air Lateral Shift: 9.0 m/s)
        var airLateralDist = 0.0
        if !isCarGrounded && !hitWall {
            var airLateralSpeed = 9.0
            airLateralDist = SteerInput * airLateralSpeed * dt
        }

        var nextX = curPos.X + (fwdX * frameMoveDist) + (rgtX * airLateralDist)
        var nextZ = curPos.Z + (fwdZ * frameMoveDist) + (rgtZ * airLateralDist)

        // 9. BẮN 4 TIA RAYCAST GẦM TRỰC DIỆN TẠI VỊ TRÍ ĐÍCH (X, Z) TRÊN LỚP 1 (ROAD)
        // Đo chính xác tuyệt đối cao độ mặt đường dưới 4 bánh xe tại vị trí xe sắp tới
        chassisLib.UpdateChassisAtPos(TargetBox, Vector3{nextX, curPos.Y, nextZ}, CurrentYaw, RideHeight, out var isGrounded, out var chassisTargetY, out var groundNormal)

        var deltaY = chassisTargetY - curPos.Y
        var isRampDrop = (deltaY < -1.5)
        var actualGrounded = isGrounded && (!isRampDrop) && (VerticalVelocity <= 0.5)

        // Bắt sự kiện cất cánh rời dốc bay vào không trung (Takeoff)
        if PrevIsGrounded && !actualGrounded {
            if CurrentSpeedMs >= 7.0 {
                if IsDrifting {
                    // Flat Spin (Xoay 360° ngang trên không)
                    IsFlatSpinning = true
                    FlatSpinAngle = 0.0
                    if SteerInput < -0.1 {
                        FlatSpinDir = -1.0
                    } else {
                        FlatSpinDir = 1.0
                    }
                } else if math.Abs(LastGroundedRgtSlope) > 0.28 {
                    // Barrel Roll (Lộn xoắn ốc 360° theo dốc xoắn)
                    IsBarrelRolling = true
                    BarrelRollAngle = 0.0
                    if LastGroundedRgtSlope < 0.0 {
                        BarrelRollDir = 1.0
                    } else {
                        BarrelRollDir = -1.0
                    }
                }

                // Hỗ trợ phóng dốc (Ramp Launch Impulse theo độ dốc dốc đã lưu)
                if LastGroundedFwdSlope > 0.04 {
                    var launchSpeed = CurrentSpeedMs * LastGroundedFwdSlope * 1.15
                    if launchSpeed < 6.0 { launchSpeed = 6.0 }
                    if launchSpeed > 24.0 { launchSpeed = 24.0 }
                    VerticalVelocity = launchSpeed
                } else if math.Abs(LastGroundedRgtSlope) > 0.28 {
                    VerticalVelocity = 10.0
                } else {
                    VerticalVelocity = 0.0
                }
            } else {
                // Tốc độ thấp hoặc đang de lùi rớt mép: Rơi tự do tự nhiên dưới tác dụng trọng lực, tuyệt đối cấm bay bổng
                VerticalVelocity = 0.0
                IsFlatSpinning = false
                IsBarrelRolling = false
            }
        }

        // 10. ĐỘ CAO GẦM XE & RƠI TỰ DO (ARCADE GRAVITY & GROUND ATTACHMENT)
        var nextY = curPos.Y
        var preLandingSpeed = math.Abs(VerticalVelocity) as float
        if actualGrounded {
            nextY = chassisTargetY
            VerticalVelocity = 0.0
        } else {
            // Xe đang bay trên không (Airborne / Jump): Trọng lực arcade bay bổng (Air Hang Time)
            var gravity = 14.0
            VerticalVelocity = VerticalVelocity - gravity * dt
            if VerticalVelocity < -35.0 { VerticalVelocity = -35.0 }
            nextY = curPos.Y + VerticalVelocity * dt
            if isGrounded && nextY <= chassisTargetY {
                nextY = chassisTargetY
                preLandingSpeed = math.Abs(VerticalVelocity) as float
                VerticalVelocity = 0.0
                actualGrounded = true
            }
        }

        // Bắt sự kiện tiếp đất (Landing)
        if !PrevIsGrounded && actualGrounded {
            if localP != nil {
                localP<vcam>.TriggerLandingImpact(preLandingSpeed)
            }
            var completedStunt = false
            if IsFlatSpinning {
                if math.Abs(FlatSpinAngle) >= 300.0 {
                    completedStunt = true
                }
                IsFlatSpinning = false
                FlatSpinAngle = 0.0
            }
            if IsBarrelRolling {
                if math.Abs(BarrelRollAngle) >= 300.0 {
                    completedStunt = true
                }
                IsBarrelRolling = false
                BarrelRollAngle = 0.0
            }

            if completedStunt {
                // Nạp đầy 100% bình Nitro khi biểu diễn thành công Stunt
                CurrentNitro = MaxNitro
            }
        }
        PrevIsGrounded = actualGrounded

        // 11. NHÀO LỘN TRÊN KHÔNG & TỰ ĐỘNG CÂN BẰNG TIẾP ĐẤT (AIR STUNTS & AUTO-LANDING ALIGNMENT)
        if !actualGrounded {
            // Xoay Stunts trên không
            if IsFlatSpinning {
                FlatSpinAngle = FlatSpinAngle + FlatSpinDir * 650.0 * dt
            }
            if IsBarrelRolling {
                BarrelRollAngle = BarrelRollAngle + BarrelRollDir * 540.0 * dt
            }

            // Đo cự ly tới mặt đất phía dưới
            var distToGround = 999.0
            if isGrounded {
                distToGround = curPos.Y - chassisTargetY
            }

            // Auto-Landing Alignment (< 4.0m): nắn thẳng góc xoay về bội số 360° và nắn mũi xe song song mặt đất
            if distToGround < 4.0 && distToGround > -1.0 {
                if IsFlatSpinning {
                    var nearestFlat = (math.Round(FlatSpinAngle / 360.0) as float) * 360.0
                    FlatSpinAngle = FlatSpinAngle + (nearestFlat - FlatSpinAngle) * 14.0 * dt
                }
                if IsBarrelRolling {
                    var nearestRoll = (math.Round(BarrelRollAngle / 360.0) as float) * 360.0
                    BarrelRollAngle = BarrelRollAngle + (nearestRoll - BarrelRollAngle) * 14.0 * dt
                }

                var alignFwdSlope = fwdX * groundNormal.X + fwdZ * groundNormal.Z
                var alignRgtSlope = rgtX * groundNormal.X + rgtZ * groundNormal.Z
                var targetLandingPitch = math.ATan2(alignFwdSlope, groundNormal.Y)
                var targetLandingRoll = math.ATan2(-alignRgtSlope, groundNormal.Y)

                CurrentPitch = CurrentPitch + (targetLandingPitch - CurrentPitch) * 12.0 * dt
                CurrentRoll = CurrentRoll + (targetLandingRoll - CurrentRoll) * 12.0 * dt
            } else {
                // Đang bay cao trên không: Mũi xe từ từ cân bằng về 0
                CurrentPitch = CurrentPitch + (0.0 - CurrentPitch) * 4.0 * dt

                // Nghiêng lượn thân xe trái/phải theo phím lái (Asphalt 8 Air Steer Lean)
                var targetAirRoll = -SteerInput * 18.0
                CurrentRoll = CurrentRoll + (targetAirRoll - CurrentRoll) * 8.0 * dt
            }
        } else {
            // Đang bám đường: lưu độ dốc dọc và ngang, nghiêng xe theo mặt đường
            var fwdSlope = fwdX * groundNormal.X + fwdZ * groundNormal.Z
            var rgtSlope = rgtX * groundNormal.X + rgtZ * groundNormal.Z
            LastGroundedFwdSlope = fwdSlope
            LastGroundedRgtSlope = rgtSlope

            var targetPitch = math.ATan2(fwdSlope, groundNormal.Y)
            var targetRoll = math.ATan2(-rgtSlope, groundNormal.Y)

            if targetPitch > 45.0 { targetPitch = 45.0 }
            if targetPitch < -45.0 { targetPitch = -45.0 }
            if targetRoll > 45.0 { targetRoll = 45.0 }
            if targetRoll < -45.0 { targetRoll = -45.0 }

            CurrentPitch = CurrentPitch + (targetPitch - CurrentPitch) * 16.0 * dt
            CurrentRoll = CurrentRoll + (targetRoll - CurrentRoll) * 14.0 * dt
        }

        // 12. ÁP ĐẶT XOAY THÂN XE (PITCH, YAW, ROLL) VÀ TỊNH TIẾN VẬT LÝ XE
        var finalBodyYaw = CurrentYaw + VisualDriftAngle + FlatSpinAngle
        var finalRoll = CurrentRoll + BarrelRollAngle
        TargetBox<Transform>.Rotation = Vector3{CurrentPitch, finalBodyYaw, finalRoll}

        var nextPos = Vector3{nextX, nextY, nextZ}
        TargetBox<Transform>.Position = nextPos

        physics.MovePosition(TargetBox as entity<Rigidbody>, nextPos)

        if VisualCar != nil {
            VisualCar<Transform>.Position = Vector3{nextPos.X, nextPos.Y - 0.25, nextPos.Z}
            VisualCar<Transform>.Rotation = Vector3{CurrentPitch, finalBodyYaw, finalRoll}
        }

        var rbVel = TargetBox<Rigidbody>.Velocity
        rbVel.X = fwdX * CurrentSpeedMs
        rbVel.Y = VerticalVelocity
        rbVel.Z = fwdZ * CurrentSpeedMs
        TargetBox<Rigidbody>.Velocity = rbVel

        // Cập nhật điểm tiến độ liên tục thời gian thực (Asphalt 8 Continuous Progress Score)
        var totalCpsCountImmediate = list.Length(CpPositions as List<object>)
        if totalCpsCountImmediate >= 2 {
            var currCp = CpPositions[LastPassedCpIndex]
            var nxtCp = CpPositions[NextCpIndex]
            ContinuousScore = raceRules.CalcContinuousProgress(CurrentLap, LastPassedCpIndex, nextPos, currCp, nxtCp)
        }

        // Gửi trạng thái xe và điểm số xếp hạng lên Server chu kỳ 0.05s (20Hz) để relay cho người chơi khác
        NetworkSyncTimer = NetworkSyncTimer + dt
        if NetworkSyncTimer >= 0.05 {
            NetworkSyncTimer = 0.0
            var dVal = 0.0
            if IsDrifting { dVal = 1.0 }
            std.DispatchEventToEntity(SyncKartStateServer, thisEntity, PlatformType.Server, List<float>{nextPos.X, nextPos.Y, nextPos.Z, finalBodyYaw, rbVel.X, rbVel.Y, rbVel.Z, ContinuousScore, dVal})

            // Host relay toạ độ & điểm số của các xe Bot lên Server để đồng bộ tuyệt đối cho các máy khách
            if IsRoomHost {
                if OpponentActive1 && !OpponentIsHuman1 {
                    std.DispatchEventToEntity(SyncKartStateServer, thisEntity, PlatformType.Server, List<float>{OpponentPos1.X, OpponentPos1.Y, OpponentPos1.Z, OpponentYaw1, OpponentVel1.X, 0.0, OpponentVel1.Z, OpponentScore1, 101.0})
                }
                if OpponentActive2 && !OpponentIsHuman2 {
                    std.DispatchEventToEntity(SyncKartStateServer, thisEntity, PlatformType.Server, List<float>{OpponentPos2.X, OpponentPos2.Y, OpponentPos2.Z, OpponentYaw2, OpponentVel2.X, 0.0, OpponentVel2.Z, OpponentScore2, 102.0})
                }
                if OpponentActive3 && !OpponentIsHuman3 {
                    std.DispatchEventToEntity(SyncKartStateServer, thisEntity, PlatformType.Server, List<float>{OpponentPos3.X, OpponentPos3.Y, OpponentPos3.Z, OpponentYaw3, OpponentVel3.X, 0.0, OpponentVel3.Z, OpponentScore3, 103.0})
                }
                if OpponentActive4 && !OpponentIsHuman4 {
                    std.DispatchEventToEntity(SyncKartStateServer, thisEntity, PlatformType.Server, List<float>{OpponentPos4.X, OpponentPos4.Y, OpponentPos4.Z, OpponentYaw4, OpponentVel4.X, 0.0, OpponentVel4.Z, OpponentScore4, 104.0})
                }
            }
        }

        // 8. CẬP NHẬT ĐỒNG HỒ TỐC ĐỘ (SPEEDOMETER HUD)
        var displaySpeedKmh = CurrentSpeedKmh
        if displaySpeedKmh < 0.0 { displaySpeedKmh = -displaySpeedKmh }

        if (SpeedTextWidget as entity) != nil {
            SpeedTextWidget<UIWidgetLabel>.Content = convert.ToString(math.Floor(displaySpeedKmh) as int) + " KM/H"
        }
        if (SpeedNeedleWidget as entity) != nil {
            var speedRatio = displaySpeedKmh / 230.0
            if speedRatio > 1.0 { speedRatio = 1.0 }
            if speedRatio < 0.0 { speedRatio = 0.0 }
            var targetAngle = 120.0 - (speedRatio * 242.0)
            SpeedNeedleWidget<hud.UIWidget>.Angle = targetAngle
        }

        // 9. ĐỒNG BỘ TRẠNG THÁI XE & CAMERA THEO THỜI GIAN THỰC (CHUẨN ASPHALT 8)
        if localP != nil {
            var isStuntingNow = IsFlatSpinning || IsBarrelRolling
            localP<vcam>.SyncVehicleState(CurrentYaw, CurrentPitch, CurrentSpeedMs, IsDrifting, VisualDriftAngle, IsBoosting, isStuntingNow)
        }

        // 10. HỆ THỐNG LUẬT ĐUA ASPHALT 8 (CHECKPOINT, VÒNG ĐUA, ĐỒNG HỒ, THỨ HẠNG & SAI CHIỀU)
        if RaceTrackInitialized {
            // A. Đồng hồ bấm giờ trận đua
            if IsRaceStarted && !IsRaceFinished {
                RaceTimer = RaceTimer + dt
                if (TimerTextWidget as entity) != nil {
                    TimerTextWidget<hud.UIWidgetLabel>.Content = raceRules.FormatTimer(RaceTimer)
                }
            } else if !IsRaceStarted {
                if (TimerTextWidget as entity) != nil {
                    TimerTextWidget<hud.UIWidgetLabel>.Content = "00:00:000"
                }
            }

            // B. Kiểm tra qua Checkpoint kế tiếp & đếm vòng
            var hitCp = raceRules.CheckCheckpointHit(nextPos, CpPositions, NextCpIndex)
            if hitCp {
                LastPassedCpIndex = NextCpIndex
                NextCpIndex = NextCpIndex + 1
                var totalCps = list.Length(CpPositions as List<object>)
                if NextCpIndex >= totalCps {
                    NextCpIndex = 0
                    CurrentLap = CurrentLap + 1
                    if CurrentLap > TotalLaps {
                        CurrentLap = TotalLaps
                        IsRaceFinished = true
                        if (FinishBannerWidget as entity) != nil {
                            FinishBannerWidget<hud.UIWidget>.IsVisible = true
                        }
                        if (LapTextWidget as entity) != nil {
                            LapTextWidget<hud.UIWidgetLabel>.Content = "FINISH"
                        }
                    }
                }
                if !IsRaceFinished && (LapTextWidget as entity) != nil {
                    LapTextWidget<hud.UIWidgetLabel>.Content = "LAP " + convert.ToString(CurrentLap) + "/" + convert.ToString(TotalLaps)
                }
            }

            // C. Điểm tiến độ liên tục thời gian thực (Asphalt 8 Continuous Progress Score)
            var totalCpsCount = list.Length(CpPositions as List<object>)
            if totalCpsCount >= 2 {
                var currCp = CpPositions[LastPassedCpIndex]
                var nxtCp = CpPositions[NextCpIndex]
                ContinuousScore = raceRules.CalcContinuousProgress(CurrentLap, LastPassedCpIndex, nextPos, currCp, nxtCp)
            }

            // D. Kiểm tra chạy ngược chiều (Asphalt 8 Wrong-Way Detection)
            var isPointingWrong = raceRules.IsWrongWayDirection(nextPos, CurrentYaw, WpPositions, CpPositions, LastPassedCpIndex)
            if displaySpeedKmh > 8.0 && isPointingWrong {
                WrongWayTimer = WrongWayTimer + dt
            } else {
                WrongWayTimer = WrongWayTimer - dt * 2.0
                if WrongWayTimer < 0.0 { WrongWayTimer = 0.0 }
            }
            var isWrong = WrongWayTimer >= 0.75
            if isWrong != IsWrongWayActive {
                IsWrongWayActive = isWrong
                if (WrongWayWidget as entity) != nil {
                    WrongWayWidget<hud.UIWidget>.IsVisible = isWrong
                }
            }

            // E. Cập nhật bản đồ nhỏ (Rotating Minimap)
            if (MiniMapWidget as entity) != nil {
                var cosA = math.Cos(CurrentYaw)
                var sinA = math.Sin(CurrentYaw)

                var carMapX = nextPos.X * MinimapScaleX + MinimapOffsetX
                var carMapY = nextPos.Z * MinimapScaleY + MinimapOffsetY

                var rotX = carMapX * cosA - carMapY * sinA
                var rotY = carMapX * sinA + carMapY * cosA

                MiniMapWidget<hud.UIWidget>.Angle = CurrentYaw
                MiniMapWidget<hud.UIWidget>.AnchorPosition = Vector3{-rotX, -rotY, 0.0}
            }

            // F. CẬP NHẬT 4 XE ĐỐI THỦ MULTIPLAYER / AI BOT
            if EnableAIBots {
                UpdateSingleBot(OpponentCar1, 1, dt)
                UpdateSingleBot(OpponentCar2, 2, dt)
                UpdateSingleBot(OpponentCar3, 3, dt)
                UpdateSingleBot(OpponentCar4, 4, dt)

                // G. CẬP NHẬT 4 CHẤM ĐỐI THỦ TRÊN ROTATING MINIMAP
                if (OpponentDot1Widget as entity) != nil {
                    var mX1 = OpponentPos1.X * MinimapScaleX + MinimapOffsetX
                    var mY1 = OpponentPos1.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot1Widget<hud.UIWidget>.AnchorPosition = Vector3{mX1, mY1, 0.0}
                    OpponentDot1Widget<hud.UIWidget>.IsVisible = true
                }
                if (OpponentDot2Widget as entity) != nil {
                    var mX2 = OpponentPos2.X * MinimapScaleX + MinimapOffsetX
                    var mY2 = OpponentPos2.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot2Widget<hud.UIWidget>.AnchorPosition = Vector3{mX2, mY2, 0.0}
                    OpponentDot2Widget<hud.UIWidget>.IsVisible = true
                }
                if (OpponentDot3Widget as entity) != nil {
                    var mX3 = OpponentPos3.X * MinimapScaleX + MinimapOffsetX
                    var mY3 = OpponentPos3.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot3Widget<hud.UIWidget>.AnchorPosition = Vector3{mX3, mY3, 0.0}
                    OpponentDot3Widget<hud.UIWidget>.IsVisible = true
                }
                if (OpponentDot4Widget as entity) != nil {
                    var mX4 = OpponentPos4.X * MinimapScaleX + MinimapOffsetX
                    var mY4 = OpponentPos4.Z * MinimapScaleY + MinimapOffsetY
                    OpponentDot4Widget<hud.UIWidget>.AnchorPosition = Vector3{mX4, mY4, 0.0}
                    OpponentDot4Widget<hud.UIWidget>.IsVisible = true
                }

                // H. TÍNH TOÁN BẢNG XẾP HẠNG THỜI GIAN THỰC (1/5 ĐẾN 5/5)
                var myRank = 1
                if OpponentScore1 > ContinuousScore { myRank = myRank + 1 }
                if OpponentScore2 > ContinuousScore { myRank = myRank + 1 }
                if OpponentScore3 > ContinuousScore { myRank = myRank + 1 }
                if OpponentScore4 > ContinuousScore { myRank = myRank + 1 }

                if (PositionTextWidget as entity) != nil {
                    PositionTextWidget<hud.UIWidgetLabel>.Content = convert.ToString(myRank) + "/5"
                }
            } else {
                // ONLINE MULTIPLAYER NỘI SUY ĐỘNG HỌC (DEAD-RECKONING 60 FPS)
                UpdateRemoteOpponents(dt)

                var totalActiveOpponents = 0
                var myRank = 1

                if OpponentActive1 {
                    totalActiveOpponents = totalActiveOpponents + 1
                    if OpponentScore1 > ContinuousScore {
                        myRank = myRank + 1
                    } else if OpponentScore1 == ContinuousScore && OpponentPIndex1 == 0 {
                        myRank = myRank + 1
                    }
                }
                if OpponentActive2 {
                    totalActiveOpponents = totalActiveOpponents + 1
                    if OpponentScore2 > ContinuousScore {
                        myRank = myRank + 1
                    } else if OpponentScore2 == ContinuousScore && OpponentPIndex2 == 0 {
                        myRank = myRank + 1
                    }
                }
                if OpponentActive3 {
                    totalActiveOpponents = totalActiveOpponents + 1
                    if OpponentScore3 > ContinuousScore {
                        myRank = myRank + 1
                    } else if OpponentScore3 == ContinuousScore && OpponentPIndex3 == 0 {
                        myRank = myRank + 1
                    }
                }
                if OpponentActive4 {
                    totalActiveOpponents = totalActiveOpponents + 1
                    if OpponentScore4 > ContinuousScore {
                        myRank = myRank + 1
                    } else if OpponentScore4 == ContinuousScore && OpponentPIndex4 == 0 {
                        myRank = myRank + 1
                    }
                }

                var totalPlayers = 1 + totalActiveOpponents

                // TÍNH TOÁN THỨ HẠNG CHO TỪNG XE BOT / ĐỐI THỦ (1st ĐẾN 5th)
                if OpponentActive1 {
                    var r1 = 1
                    if ContinuousScore > OpponentScore1 { r1 = r1 + 1 }
                    if OpponentActive2 && OpponentScore2 > OpponentScore1 { r1 = r1 + 1 }
                    if OpponentActive3 && OpponentScore3 > OpponentScore1 { r1 = r1 + 1 }
                    if OpponentActive4 && OpponentScore4 > OpponentScore1 { r1 = r1 + 1 }
                    OpponentRank1 = r1
                }
                if OpponentActive2 {
                    var r2 = 1
                    if ContinuousScore > OpponentScore2 { r2 = r2 + 1 }
                    if OpponentActive1 && OpponentScore1 > OpponentScore2 { r2 = r2 + 1 }
                    if OpponentActive3 && OpponentScore3 > OpponentScore2 { r2 = r2 + 1 }
                    if OpponentActive4 && OpponentScore4 > OpponentScore2 { r2 = r2 + 1 }
                    OpponentRank2 = r2
                }
                if OpponentActive3 {
                    var r3 = 1
                    if ContinuousScore > OpponentScore3 { r3 = r3 + 1 }
                    if OpponentActive1 && OpponentScore1 > OpponentScore3 { r3 = r3 + 1 }
                    if OpponentActive2 && OpponentScore2 > OpponentScore3 { r3 = r3 + 1 }
                    if OpponentActive4 && OpponentScore4 > OpponentScore3 { r3 = r3 + 1 }
                    OpponentRank3 = r3
                }
                if OpponentActive4 {
                    var r4 = 1
                    if ContinuousScore > OpponentScore4 { r4 = r4 + 1 }
                    if OpponentActive1 && OpponentScore1 > OpponentScore4 { r4 = r4 + 1 }
                    if OpponentActive2 && OpponentScore2 > OpponentScore4 { r4 = r4 + 1 }
                    if OpponentActive3 && OpponentScore3 > OpponentScore4 { r4 = r4 + 1 }
                    OpponentRank4 = r4
                }

                if (PositionTextWidget as entity) != nil {
                    PositionTextWidget<hud.UIWidgetLabel>.Content = convert.ToString(myRank) + "/" + convert.ToString(totalPlayers)
                }
            }
        }
    }
}
